---
export interface SpecItem {
  planName: string;
  planId?: string;
  isPopular?: boolean;
  databases: string;
  subdomains: string;
  migrations: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  specs: SpecItem[];
}

const {
  title = "Plan Technical Specifications",
  subtitle = "Detailed database limits, subdomain allocations, and included standard migration assistance for each tier.",
  specs
} = Astro.props;
---

<div class="row mt-5 pt-3 justify-content-center" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
  <div class="col-lg-10 col-12">
    <div class="specs-comparison-card p-4 p-md-5 rounded-4 shadow-sm" style="background: #ffffff; border: 1px solid rgba(220, 226, 235, 0.85); box-shadow: 0 10px 30px rgba(0,0,0,0.04);">
      <div class="text-center mb-4">
        <span class="pre-title" style="color: #ff501a; font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; display: inline-block; margin-bottom: 6px;">Technical Comparison</span>
        <h3 class="title mb-2" style="font-size: 26px; font-weight: 800; color: #111827;">{title}</h3>
        <p class="text-muted small mb-0" style="font-size: 14px; max-width: 600px; margin: 0 auto;">{subtitle}</p>
      </div>

      <div class="table-responsive">
        <table class="table align-middle text-center mb-0 specs-table" style="font-size: 14.5px; border-collapse: separate; border-spacing: 0;">
          <thead>
            <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
              <th scope="col" class="text-start py-3 px-4 font-weight-bold" style="color: #1e293b; border-top-left-radius: 8px;">Plan</th>
              <th scope="col" class="py-3 px-3 font-weight-bold" style="color: #1e293b;">Databases</th>
              <th scope="col" class="py-3 px-3 font-weight-bold" style="color: #1e293b;">Subdomains</th>
              <th scope="col" class="py-3 px-4 font-weight-bold" style="color: #1e293b; border-top-right-radius: 8px;">Included Standard Migrations</th>
            </tr>
          </thead>
          <tbody>
            {specs.map((item, idx) => {
              const isRec = item.isPopular || item.planName.toLowerCase().includes('starter') && !item.planName.toLowerCase().includes('wordpress starter') || item.planName.toLowerCase().includes('essential');
              return (
                <tr 
                  style={isRec 
                    ? "background: rgba(255, 80, 26, 0.03); border-bottom: 1px solid #fed7aa;" 
                    : (idx === specs.length - 1 ? "" : "border-bottom: 1px solid #f1f5f9;")}
                >
                  <td class="text-start py-3 px-4 font-weight-bold" style={isRec ? "color: #ff501a;" : "color: #0f172a;"}>
                    {item.planName}
                    {isRec && (
                      <span class="badge ms-2" style="background: #ff501a; color: #ffffff; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 9999px;">Recommended</span>
                    )}
                  </td>
                  <td class="py-3 px-3" style={isRec ? "font-weight: 700; color: #111827;" : "color: #475569;"}>
                    {item.databases}
                  </td>
                  <td class="py-3 px-3" style={isRec ? "font-weight: 700; color: #111827;" : "color: #475569;"}>
                    {item.subdomains}
                  </td>
                  <td class="py-3 px-4">
                    <span 
                      class="badge" 
                      style={isRec 
                        ? "background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 6px;"
                        : "background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 6px;"}
                    >
                      {item.migrations}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="mt-4 pt-2 text-center text-muted" style="font-size: 12.5px;">
        <i class="ri-shield-check-line text-success me-1"></i>
        <span>All migrations are performed with zero downtime by our hosting specialists upon request.</span>
      </div>
    </div>
  </div>
</div>

