---
// Hostamble Main Footer with Distinct Categories, Payment Gateways Strip & Giant Typography
---

<footer class="aceorbit-footer-one ace-footer footer-style-default">
    <div class="footer-top">
        <div class="container aceorbit-animated-shape">
            <div class="row g-4 g-lg-5">
                
                <!-- COLUMN 1: Brand & Direct Contact -->
                <div class="col-xl-3 col-lg-3 col-md-12 col-12">
                    <div class="ace-footer-widget brand-widget">
                        <div class="logo mb-3">
                            <a href="/" title="Hostamble Home">
                                <img alt="Hostamble Logo" class="logo-light" src="/assets/images/amble.png" />
                            </a>
                        </div>
                        <p class="description">
                            Hostamble offers superior, high-speed, and reliable cloud hosting powered by NVMe SSDs and 24/7 technical support worldwide.
                        </p>
                        
                        <!-- Direct Contact List -->
                        <div class="widget-information mt-3">
                            <ul class="information-list">
                                <li>
                                    <i class="ri-map-pin-line text-primary"></i>
                                    <span>Asia, India</span>
                                </li>
                                <li>
                                    <i class="ri-phone-line text-primary"></i>
                                    <a href="tel:+916284719083">(+91) 628 471 9083</a>
                                </li>
                                <li>
                                    <i class="ri-mail-line text-primary"></i>
                                    <a href="mailto:support@hostamble.com" target="_blank" rel="noopener noreferrer">support@hostamble.com</a>
                                </li>
                                <li>
                                    <i class="ri-whatsapp-line text-success"></i>
                                    <a href="https://wa.me/916284719083?text=Hi%20Hostamble%20Support%2C%20I%20need%20assistance" target="_blank" rel="noopener noreferrer">WhatsApp 24/7 Live Desk</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- COLUMN 2: Hosting (Separate Category) -->
                <div class="col-xl-2 col-lg-2 col-md-3 col-6">
                    <div class="ace-footer-widget">
                        <h5 class="widget-title">Hosting</h5>
                        <div class="inner">
                            <ul class="footer-link link-hover">
                                <li><a href="/shared-hosting">Shared Hosting</a></li>
                                <li><a href="/wordpress-hosting">WordPress Hosting</a></li>
                                <li><a href="/vps-hosting">VPS Servers</a></li>
                                <li><a href="/n8n-hosting">N8N Automation</a></li>
                                <li><a href="/shared-hosting#features">NVMe LiteSpeed</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- COLUMN 3: Domain (Separate Category) -->
                <div class="col-xl-2 col-lg-2 col-md-3 col-6">
                    <div class="ace-footer-widget">
                        <h5 class="widget-title">Domain</h5>
                        <div class="inner">
                            <ul class="footer-link link-hover">
                                <li><a href="/domain-search">Domain Search</a></li>
                                <li><a href="/transfer-domain">Domain Transfer</a></li>
                                <li><a href="/tld-pricing">TLD Pricing List</a></li>
                                <li><a href="/domain-search">Free DNS Management</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- COLUMN 4: Services (Separate Category) -->
                <div class="col-xl-2 col-lg-2 col-md-3 col-6">
                    <div class="ace-footer-widget">
                        <h5 class="widget-title">Services</h5>
                        <div class="inner">
                            <ul class="footer-link link-hover">
                                <li><a href="/ssl-certificates">SSL Certificates</a></li>
                                <li><a href="/business-email">Business Email</a></li>
                                <li><a href="/google-workspace">Google Workspace</a></li>
                                <li><a href="/contacts">Free Migration</a></li>
                                <li><a href="/shared-hosting#features">BitNinja Security</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- COLUMN 5: Company (Separate Category) -->
                <div class="col-xl-3 col-lg-3 col-md-3 col-6">
                    <div class="ace-footer-widget">
                        <h5 class="widget-title">Company</h5>
                        <div class="inner">
                            <ul class="footer-link link-hover">
                                <li><a href="/about-us">About Us</a></li>
                                <li><a href="/contacts">Contact Us</a></li>
                                <li><a href="/login">Client Login</a></li>
                                <li><a href="/register">Create Account</a></li>
                                <li><a href="https://hostamble.com/dash/submitticket.php?step=2&deptid=1" target="_blank" rel="noopener noreferrer">Submit Ticket</a></li>
                                <li><a href="/legal-agreement">Terms of Service</a></li>
                                <li><a href="/privacy-policy">Privacy Policy</a></li>
                                <li><a href="/refund-and-cancellation-policy">Refund Policy</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Subtle Decorative Shapes -->
            <div class="shape-dot-wrapper shape-wrapper d-md-block d-none" aria-hidden="true">
                <div class="shape-image shape-image-1"><img alt="Shape Thumb" src="/assets/images/shape2101.png" /></div>
                <div class="shape-image shape-image-2"><img alt="Shape Thumb" src="/assets/images/shape35.png" /></div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         Payment Gateways & Payment Acceptance Strip
         Features PhonePe, Cashfree, PayU, CCAvenue, PayPal + Binance/WhatsApp note
         ========================================================= -->
    <div class="footer-payment-strip">
        <div class="container">
            <div class="row align-items-center g-3">
                
                <div class="col-lg-8 col-12">
                    <div class="payment-accept-wrapper">
                        <span class="payment-accept-label">We accept</span>
                        
                        <div class="payment-badges-row">
                            <!-- PhonePe Badge -->
                            <div class="payment-badge-card" title="Pay with PhonePe UPI">
                                <img src="/assets/images/payments/phonepe.svg" alt="PhonePe" loading="lazy" />
                            </div>

                            <!-- Cashfree Badge -->
                            <div class="payment-badge-card" title="Pay with Cashfree Payments">
                                <img src="/assets/images/payments/cashfree.svg" alt="Cashfree" loading="lazy" />
                            </div>

                            <!-- PayU Badge -->
                            <div class="payment-badge-card" title="Pay with PayU">
                                <img src="/assets/images/payments/payu.svg" alt="PayU" loading="lazy" />
                            </div>

                            <!-- CCAvenue Badge -->
                            <div class="payment-badge-card" title="Pay with CCAvenue">
                                <img src="/assets/images/payments/ccavenue.svg" alt="CCAvenue" loading="lazy" />
                            </div>

                            <!-- PayPal Badge -->
                            <div class="payment-badge-card" title="Pay with PayPal (International)">
                                <img src="/assets/images/payments/paypal.svg" alt="PayPal" loading="lazy" />
                            </div>
                        </div>
                    </div>

                    <!-- Payment Instruction Note -->
                    <p class="payment-subtext">
                        International payments: <strong>PayPal</strong>. To pay with Binance, <a href="/contacts">contact us</a> or <a href="https://wa.me/916284719083?text=Hi%2C%20I%20want%20to%20pay%20via%20Binance%20for%20Hostamble" target="_blank" rel="noopener noreferrer">message us on WhatsApp</a> first.
                    </p>
                </div>

                <div class="col-lg-4 col-12 text-lg-end text-start">
                    <div class="payment-right-meta">
                        <span class="gst-notice-pill">
                            <i class="ri-information-line"></i>
                            <span>Prices exclude GST</span>
                        </span>
                        <span class="ssl-guarantee-pill">
                            <i class="ri-shield-check-line text-success"></i>
                            <span>256-Bit Encrypted Checkout</span>
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Giant Edge-to-Edge Typography Display (HOSTAMBLE) -->
    <div class="footer-giant-brand-wrap" aria-hidden="true">
        <span class="footer-giant-brand-text">HOSTAMBLE</span>
    </div>

    <!-- Sleek Bottom Legal & Copyright Bar -->
    <div class="copyright-area copyright-default">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-lg-4 col-md-6 col-12 text-center text-md-start">
                    <p class="copyright-text">
                        &copy; 2020 &ndash; 2026 <a href="/">Hostamble Web Services</a>. All rights reserved.
                    </p>
                </div>

                <div class="col-lg-5 col-md-6 col-12 text-center">
                    <ul class="footer-bottom-links">
                        <li><a href="/privacy-policy">Privacy policy</a></li>
                        <li class="separator">&bull;</li>
                        <li><a href="/legal-agreement">Terms of service</a></li>
                        <li class="separator">&bull;</li>
                        <li><a href="/refund-and-cancellation-policy">Refund policy</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-12 text-center text-lg-end">
                    <button 
                        type="button" 
                        class="footer-scroll-top-btn" 
                        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
                        title="Back to top"
                    >
                        <span>Back to top</span>
                        <span class="top-arrow-circle" aria-hidden="true">
                            <i class="ri-arrow-up-line"></i>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
  /* Footer Category Typography & Spacing */
  .ace-footer-widget .widget-title {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-weight: 800;
    font-size: 18px;
    color: #ffffff;
    margin-bottom: 22px;
    letter-spacing: -0.01em;
    position: relative;
    padding-bottom: 8px;
  }

  .ace-footer-widget .widget-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-primary, #ff501a);
    border-radius: 1px;
  }

  .ace-footer-widget .footer-link li {
    margin-bottom: 10px;
  }

  .ace-footer-widget .footer-link a {
    color: #9aa5b8;
    font-size: 14.5px;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .ace-footer-widget .footer-link a:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  .widget-information .information-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #9aa5b8;
    font-size: 14px;
    margin-bottom: 10px;
  }

  .widget-information .information-list a {
    color: #9aa5b8;
    transition: color 0.2s ease;
  }

  .widget-information .information-list a:hover {
    color: var(--color-primary, #ff501a);
  }

  /* =========================================================
     Payment Gateways Strip
     ========================================================= */
  .footer-payment-strip {
    padding: 28px 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(14, 17, 24, 0.5);
  }

  .payment-accept-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .payment-accept-label {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 16px;
    font-weight: 800;
    color: #ffffff;
    margin-right: 6px;
  }

  .payment-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .payment-badge-card {
    background: #ffffff;
    border-radius: 8px;
    padding: 5px 14px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .payment-badge-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 80, 26, 0.25);
  }

  .payment-badge-card img {
    height: 22px;
    width: auto;
    max-width: 100px;
    object-fit: contain;
    display: block;
  }

  .payment-subtext {
    color: #8c96a7;
    font-size: 13.5px;
    margin: 0;
    line-height: 1.5;
  }

  .payment-subtext strong {
    color: #ffffff;
  }

  .payment-subtext a {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .payment-subtext a:hover {
    color: var(--color-primary, #ff501a);
  }

  .payment-right-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  @media only screen and (min-width: 992px) {
    .payment-right-meta {
      align-items: flex-end;
    }
  }

  .gst-notice-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #cbd5e1;
    font-size: 13.5px;
    font-weight: 600;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
  }

  .ssl-guarantee-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #8c96a7;
    font-size: 12.5px;
  }

  /* Giant Brand Typography Display */
  .footer-giant-brand-wrap {
    width: 100%;
    overflow: hidden;
    padding: 36px 0 6px;
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
    pointer-events: none;
    background: transparent;
  }

  .footer-giant-brand-text {
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(60px, 15.6vw, 240px);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-primary, #ff501a);
    text-align: center;
    margin: 0;
    padding: 0;
    width: 100%;
    white-space: nowrap;
    opacity: 0.98;
  }

  /* Bottom Copyright & Links Strip */
  .copyright-area {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 22px 0;
  }

  .copyright-text {
    color: #8c96a7;
    font-size: 13.5px;
    margin: 0;
  }

  .copyright-text a {
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .copyright-text a:hover {
    color: var(--color-primary, #ff501a);
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-bottom-links a {
    color: #8c96a7;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-bottom-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-bottom-links .separator {
    color: #4a5468;
    font-size: 12px;
  }

  .footer-scroll-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: #8c96a7;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    padding: 0;
  }

  .top-arrow-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: all 0.25s ease;
  }

  .footer-scroll-top-btn:hover {
    color: #ffffff;
  }

  .footer-scroll-top-btn:hover .top-arrow-circle {
    background: var(--color-primary, #ff501a);
    border-color: var(--color-primary, #ff501a);
    transform: translateY(-2px);
  }

  @media only screen and (max-width: 991px) {
    .footer-payment-strip {
      padding: 24px 0 20px;
    }
    .payment-right-meta {
      margin-top: 8px;
    }
    .footer-bottom-links {
      justify-content: center;
      margin: 6px 0;
    }
    .footer-scroll-top-btn {
      justify-content: center;
    }
  }

  @media only screen and (max-width: 575px) {
    .footer-giant-brand-wrap {
      padding: 20px 0 0px;
    }
    .payment-accept-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .footer-bottom-links {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
</style>
