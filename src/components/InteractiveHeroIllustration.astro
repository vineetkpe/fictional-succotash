---
// Interactive Hero Illustration with 3D Parallax & Floating Telemetry Badges
---

<div class="hero-interactive-stage" id="heroInteractiveStage">
  <div class="stage-3d-card" id="stage3dCard">
    <!-- Base Authentic Artwork (Kept exactly as it is) -->
    <img 
      src="/assets/images/banner06.png" 
      alt="Hostamble WordPress Web Hosting Platform" 
      class="base-illustration" 
      loading="eager"
      decoding="async"
    />

    <!-- Floating Badge 1: 99.9% Uptime (Top Left over analytics chart) -->
    <div class="hero-float-card card-uptime" style="--depth: 42px; --delay: 0s;">
      <div class="card-icon-wrap icon-green">
        <span class="pulse-beacon"></span>
        <i class="ri-pulse-line" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">99.9% Uptime</div>
        <div class="card-value">Zero-Downtime Live</div>
      </div>
      <!-- Mini Sparkline SVG -->
      <svg class="mini-sparkline" viewBox="0 0 40 16" aria-hidden="true">
        <path d="M 2 12 Q 10 4, 18 10 T 30 5 T 38 7" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Floating Badge 2: LiteSpeed Turbo (Top Right above bar graph) -->
    <div class="hero-float-card card-litespeed" style="--depth: 55px; --delay: 1.2s;">
      <div class="card-icon-wrap icon-orange">
        <i class="ri-rocket-2-fill" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">LiteSpeed Turbo</div>
        <div class="card-value">10x Faster PHP</div>
      </div>
      <span class="boost-badge">SUPERCHARGED</span>
    </div>

    <!-- Floating Badge 3: Free SSL Security (Bottom Left near developer) -->
    <div class="hero-float-card card-security" style="--depth: 35px; --delay: 2.4s;">
      <div class="card-icon-wrap icon-cyan">
        <i class="ri-shield-check-fill" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">Free Auto SSL</div>
        <div class="card-value">256-Bit TLS Secured</div>
      </div>
    </div>

    <!-- Floating Badge 4: 1-Click Install (Bottom Right near presenter) -->
    <div class="hero-float-card card-install" style="--depth: 48px; --delay: 0.8s;">
      <div class="card-icon-wrap icon-amber">
        <i class="ri-flashlight-fill" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">1-Click Auto Deploy</div>
        <div class="card-value">Instant Activation</div>
      </div>
    </div>

    <!-- Floating Particle Spark Orbs -->
    <div class="spark-orb spark-1"></div>
    <div class="spark-orb spark-2"></div>
    <div class="spark-orb spark-3"></div>
    <div class="spark-orb spark-4"></div>
  </div>
</div>

<script>
  // 3D Parallax Tilt Script
  const stage = document.getElementById('heroInteractiveStage');
  const card = document.getElementById('stage3dCard');

  if (stage && card) {
    const stageEl = stage;
    const cardEl = card;
    let bounds = stageEl.getBoundingClientRect();
    let isHovering = false;

    function updateBounds() {
      bounds = stageEl.getBoundingClientRect();
    }

    window.addEventListener('resize', updateBounds);
    window.addEventListener('scroll', updateBounds, { passive: true });

    stageEl.addEventListener('mouseenter', () => {
      isHovering = true;
      cardEl.style.transition = 'transform 0.15s ease-out';
    });

    stageEl.addEventListener('mousemove', (e) => {
      if (!isHovering) return;
      const x = e.clientX - bounds.left;
      const y = e.clientY - bounds.top;

      const normX = (x / bounds.width) - 0.5; // -0.5 to 0.5
      const normY = (y / bounds.height) - 0.5;

      // Subtle 3D tilt angles
      const rotateY = normX * 18; // Max 9 deg
      const rotateX = -normY * 14; // Max 7 deg

      cardEl.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

      // Dynamic parallax on floating cards
      const floatCards = stageEl.querySelectorAll<HTMLElement>('.hero-float-card');
      floatCards.forEach((fc) => {
        const depth = parseFloat(fc.style.getPropertyValue('--depth') || '30');
        const moveX = normX * depth * 0.45;
        const moveY = normY * depth * 0.45;
        fc.style.transform = `translate3d(${moveX.toFixed(1)}px, ${moveY.toFixed(1)}px, ${depth}px)`;
      });
    });

    stageEl.addEventListener('mouseleave', () => {
      isHovering = false;
      cardEl.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
      cardEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';

      const floatCards = stageEl.querySelectorAll<HTMLElement>('.hero-float-card');
      floatCards.forEach((fc) => {
        const depth = parseFloat(fc.style.getPropertyValue('--depth') || '30');
        fc.style.transform = `translate3d(0px, 0px, ${depth}px)`;
      });
    });
  }
</script>

<style>
  .hero-interactive-stage {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    perspective: 1200px;
    user-select: none;
  }

  .stage-3d-card {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Base artwork */
  .base-illustration {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
    filter: drop-shadow(0 18px 40px rgba(255, 80, 26, 0.08));
    pointer-events: none;
  }

  /* ========================================================
     FLOATING LIVE TELEMETRY BADGES
     ======================================================== */
  .hero-float-card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(230, 235, 245, 0.95);
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(17, 24, 39, 0.08),
                0 2px 6px rgba(0, 0, 0, 0.04);
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out, box-shadow 0.25s ease;
    animation: cardBob 4.2s ease-in-out infinite alternate;
    animation-delay: var(--delay, 0s);
    z-index: 8;
  }

  .hero-float-card:hover {
    box-shadow: 0 14px 30px rgba(255, 80, 26, 0.18),
                0 4px 10px rgba(0, 0, 0, 0.06);
    border-color: rgba(255, 80, 26, 0.4);
  }

  @keyframes cardBob {
    0% {
      margin-top: 0px;
    }
    100% {
      margin-top: -6px;
    }
  }

  /* Positioning of each card */
  .card-uptime {
    top: 14%;
    left: 4%;
  }

  .card-litespeed {
    top: 10%;
    right: 4%;
  }

  .card-security {
    bottom: 22%;
    left: 4%;
  }

  .card-install {
    bottom: 20%;
    right: 4%;
  }

  /* Compact screens */
  @media (max-width: 767px) {
    .card-uptime {
      top: 6%;
      left: 0%;
      padding: 6px 10px;
    }
    .card-litespeed {
      top: 4%;
      right: 0%;
      padding: 6px 10px;
    }
    .card-security {
      bottom: 12%;
      left: 0%;
      padding: 6px 10px;
    }
    .card-install {
      bottom: 10%;
      right: 0%;
      padding: 6px 10px;
    }
  }

  @media (max-width: 480px) {
    .hero-float-card {
      scale: 0.85;
    }
  }

  .card-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }

  .card-icon-wrap i {
    font-size: 17px;
  }

  .icon-green {
    background: rgba(16, 185, 129, 0.14);
    color: #10b981;
  }

  .icon-orange {
    background: rgba(255, 80, 26, 0.14);
    color: #ff501a;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.14);
    color: #06b6d4;
  }

  .icon-amber {
    background: rgba(245, 158, 11, 0.14);
    color: #f59e0b;
  }

  .pulse-beacon {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
    animation: beaconPulse 1.8s infinite;
  }

  @keyframes beaconPulse {
    0% {
      transform: scale(0.9);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.4;
    }
    100% {
      transform: scale(0.9);
      opacity: 1;
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
  }

  .card-label {
    font-size: 11px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
    white-space: nowrap;
  }

  .card-value {
    font-size: 10px;
    font-weight: 500;
    color: #6b7280;
    line-height: 1.2;
    white-space: nowrap;
  }

  .mini-sparkline {
    width: 34px;
    height: 14px;
    margin-left: 2px;
    flex-shrink: 0;
  }

  .boost-badge {
    font-size: 9px;
    font-weight: 800;
    color: #ff501a;
    background: rgba(255, 80, 26, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  @media (max-width: 575px) {
    .boost-badge,
    .mini-sparkline {
      display: none;
    }
  }

  /* Floating particle spark orbs */
  .spark-orb {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff501a;
    box-shadow: 0 0 10px #ff501a;
    pointer-events: none;
    animation: sparkFloat 5s ease-in-out infinite alternate;
  }

  .spark-1 {
    top: 25%;
    left: 45%;
    animation-duration: 4.2s;
  }

  .spark-2 {
    top: 60%;
    right: 32%;
    background: #06b6d4;
    box-shadow: 0 0 10px #06b6d4;
    animation-duration: 5.6s;
    animation-delay: 1.5s;
  }

  .spark-3 {
    top: 40%;
    right: 22%;
    animation-duration: 3.8s;
    animation-delay: 0.7s;
  }

  .spark-4 {
    top: 68%;
    left: 25%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation-duration: 4.8s;
    animation-delay: 2.1s;
  }

  @keyframes sparkFloat {
    0% {
      transform: translate(0, 0) scale(0.8);
      opacity: 0.4;
    }
    50% {
      transform: translate(12px, -14px) scale(1.3);
      opacity: 0.9;
    }
    100% {
      transform: translate(-10px, 8px) scale(0.9);
      opacity: 0.5;
    }
  }
</style>
