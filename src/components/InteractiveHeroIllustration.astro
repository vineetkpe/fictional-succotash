---
// Interactive Hero Illustration overlaying banner06.png
---

<div class="hero-interactive-stage" id="heroInteractiveStage">
  <div class="stage-3d-card" id="stage3dCard">
    <!-- Base Authentic Artwork -->
    <img 
      src="/assets/images/banner06.png" 
      alt="Hostamble WordPress Web Hosting Platform" 
      class="base-illustration" 
      loading="eager"
      decoding="async"
    />

    <!-- Animated Cyber Data Circuit Stream SVG -->
    <svg class="data-streams-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="streamGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ff501a" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#ff9800" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id="streamGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#10b981" stop-opacity="0.9" />
        </linearGradient>
        <filter id="glowFilter" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="0.8" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Stream 1: Analytics to WordPress Core -->
      <path class="flow-path flow-path-1" d="M 28 36 C 36 34, 42 42, 50.8 45.8" filter="url(#glowFilter)" />
      <!-- Stream 2: WordPress Core to Bar Chart -->
      <path class="flow-path flow-path-2" d="M 50.8 45.8 C 58 44, 62 30, 72 26" filter="url(#glowFilter)" />
      <!-- Stream 3: WordPress Core to Laptop -->
      <path class="flow-path flow-path-3" d="M 50.8 45.8 C 46 54, 38 60, 32 68" filter="url(#glowFilter)" />
    </svg>

    <!-- Interactive WordPress Core Emblem & Energy Hub -->
    <div class="wp-core-anchor" id="wpCoreAnchor" title="Click to trigger WordPress Turbo Boost!">
      <!-- Pulsing Radar Energy Wave -->
      <div class="wp-radar-wave wave-1"></div>
      <div class="wp-radar-wave wave-2"></div>

      <!-- Outer Spinning Dashed Orbit Ring -->
      <div class="wp-orbit-ring"></div>

      <!-- Center Moving WordPress Core Disc -->
      <div class="wp-interactive-disc" id="wpInteractiveDisc">
        <svg class="wp-logo-svg" viewBox="0 0 100 100" aria-label="WordPress Logo">
          <!-- Outer circle -->
          <circle cx="50" cy="50" r="46" fill="#ff501a" class="wp-circle-bg" />
          <circle cx="50" cy="50" r="43" fill="none" stroke="#ffffff" stroke-width="2.5" opacity="0.6" stroke-dasharray="6 3" class="wp-circle-dash" />
          <!-- Inner WordPress 'W' Logo Vector -->
          <path 
            fill="#ffffff" 
            d="M50,8.3 C27,8.3 8.3,27 8.3,50 C8.3,64.2 15.4,76.8 26.2,84.4 L13.7,50.1 C13.7,50.1 13.7,50.1 13.7,50 C13.7,46 16.6,44.7 16.6,44.7 C18.7,43.3 19.3,46.8 19.3,46.8 L30.9,79.1 L37.9,59.3 L32.3,44.7 C32.3,44.7 30.2,43.3 32.3,43.3 C34.4,43.3 37.2,44.7 37.2,44.7 L48.3,75.3 L56.7,51.8 L51.9,44.7 C51.9,44.7 49.8,43.3 51.9,43.3 C54,43.3 56.8,44.7 56.8,44.7 L69,79.1 L80.3,46.8 C80.3,46.8 81,43.3 83.1,44.7 C85.2,46.1 84.5,50 84.5,50.1 L72.7,84.1 C84,76.4 91.7,64.1 91.7,50 C91.7,27 73,8.3 50,8.3 Z M50,89.7 C44.8,89.7 39.9,88.4 35.6,86.1 L48.3,50.6 L61.3,86.4 C57.8,88.5 54,89.7 50,89.7 Z" 
          />
        </svg>

        <!-- Dynamic Live Ping Dot -->
        <span class="wp-live-dot"></span>
      </div>

      <!-- Hover / Click Popover Tooltip -->
      <div class="wp-popover" id="wpPopover">
        <div class="popover-badge">⚡ LITESPEED TURBO</div>
        <div class="popover-title">WordPress 6.7 Ultra-Fast</div>
        <div class="popover-stats">
          <span>Response: <strong>0.19s</strong></span>
          <span class="sep">•</span>
          <span>Cache: <strong>100% Hit</strong></span>
        </div>
      </div>
    </div>

    <!-- Floating Badge 1: 99.9% Uptime (Top Left over analytics chart) -->
    <div class="hero-float-card card-uptime" style="--depth: 42px; --delay: 0s;">
      <div class="card-icon-wrap icon-green">
        <span class="pulse-beacon"></span>
        <i class="ri-pulse-line" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">99.9% Uptime</div>
        <div class="card-value">Zero-Downtime Live</div>
      </div>
      <!-- Mini Sparkline SVG -->
      <svg class="mini-sparkline" viewBox="0 0 40 16" aria-hidden="true">
        <path d="M 2 12 Q 10 4, 18 10 T 30 5 T 38 7" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Floating Badge 2: LiteSpeed Turbo (Top Right above bar graph) -->
    <div class="hero-float-card card-litespeed" style="--depth: 55px; --delay: 1.2s;">
      <div class="card-icon-wrap icon-orange">
        <i class="ri-rocket-2-fill" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">LiteSpeed Turbo</div>
        <div class="card-value">10x Faster PHP</div>
      </div>
      <span class="boost-badge">SUPERCHARGED</span>
    </div>

    <!-- Floating Badge 3: Free SSL Security (Bottom Left near developer) -->
    <div class="hero-float-card card-security" style="--depth: 35px; --delay: 2.4s;">
      <div class="card-icon-wrap icon-cyan">
        <i class="ri-shield-check-fill" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">Free Auto SSL</div>
        <div class="card-value">256-Bit TLS Secured</div>
      </div>
    </div>

    <!-- Floating Badge 4: 1-Click Install (Bottom Right near presenter) -->
    <div class="hero-float-card card-install" style="--depth: 48px; --delay: 0.8s;">
      <div class="card-icon-wrap icon-amber">
        <i class="ri-flashlight-fill" aria-hidden="true"></i>
      </div>
      <div class="card-content">
        <div class="card-label">1-Click Auto Deploy</div>
        <div class="card-value">Instant Activation</div>
      </div>
    </div>

    <!-- Floating Particle Spark Orbs -->
    <div class="spark-orb spark-1"></div>
    <div class="spark-orb spark-2"></div>
    <div class="spark-orb spark-3"></div>
    <div class="spark-orb spark-4"></div>
  </div>

  <!-- Interactive Hint Pill -->
  <div class="hero-stage-hint" aria-hidden="true">
    <i class="ri-cursor-line" aria-hidden="true"></i>
    <span>Move cursor for 3D tilt · Tap WordPress logo to boost</span>
  </div>
</div>

<script>
  // 3D Parallax Tilt & Interactive Ripple Script
  const stage = document.getElementById('heroInteractiveStage');
  const card = document.getElementById('stage3dCard');
  const wpDisc = document.getElementById('wpInteractiveDisc');
  const wpAnchor = document.getElementById('wpCoreAnchor');

  if (stage && card) {
    const stageEl = stage;
    const cardEl = card;
    let bounds = stageEl.getBoundingClientRect();
    let isHovering = false;

    function updateBounds() {
      bounds = stageEl.getBoundingClientRect();
    }

    window.addEventListener('resize', updateBounds);
    window.addEventListener('scroll', updateBounds, { passive: true });

    stageEl.addEventListener('mouseenter', () => {
      isHovering = true;
      cardEl.style.transition = 'transform 0.15s ease-out';
    });

    stageEl.addEventListener('mousemove', (e) => {
      if (!isHovering) return;
      const x = e.clientX - bounds.left;
      const y = e.clientY - bounds.top;

      const normX = (x / bounds.width) - 0.5; // -0.5 to 0.5
      const normY = (y / bounds.height) - 0.5;

      // Subtle 3D tilt angles
      const rotateY = normX * 18; // Max 9 deg
      const rotateX = -normY * 14; // Max 7 deg

      cardEl.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

      // Dynamic parallax on floating cards
      const floatCards = stageEl.querySelectorAll<HTMLElement>('.hero-float-card');
      floatCards.forEach((fc) => {
        const depth = parseFloat(fc.style.getPropertyValue('--depth') || '30');
        const moveX = normX * depth * 0.45;
        const moveY = normY * depth * 0.45;
        fc.style.transform = `translate3d(${moveX.toFixed(1)}px, ${moveY.toFixed(1)}px, ${depth}px)`;
      });
    });

    stageEl.addEventListener('mouseleave', () => {
      isHovering = false;
      cardEl.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
      cardEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';

      const floatCards = stageEl.querySelectorAll<HTMLElement>('.hero-float-card');
      floatCards.forEach((fc) => {
        const depth = parseFloat(fc.style.getPropertyValue('--depth') || '30');
        fc.style.transform = `translate3d(0px, 0px, ${depth}px)`;
      });
    });

    // Tap/Click on WordPress Logo triggers celebration boost!
    if (wpAnchor && wpDisc) {
      wpAnchor.addEventListener('click', () => {
        wpDisc.classList.add('boost-spin');
        wpAnchor.classList.add('boost-active');

        // Create ripple shockwave
        const ripple = document.createElement('div');
        ripple.className = 'click-shockwave';
        wpAnchor.appendChild(ripple);

        setTimeout(() => {
          wpDisc.classList.remove('boost-spin');
          wpAnchor.classList.remove('boost-active');
          ripple.remove();
        }, 1200);
      });
    }
  }
</script>

<style>
  .hero-interactive-stage {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    perspective: 1200px;
    user-select: none;
  }

  .stage-3d-card {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Base artwork */
  .base-illustration {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
    filter: drop-shadow(0 18px 40px rgba(255, 80, 26, 0.08));
    pointer-events: none;
  }

  /* Animated Cyber Data Circuit Streams */
  .data-streams-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .flow-path {
    fill: none;
    stroke-width: 0.6;
    stroke-linecap: round;
    stroke-dasharray: 4 6;
    animation: flowData 2.5s linear infinite;
  }

  .flow-path-1 {
    stroke: url(#streamGrad1);
    animation-duration: 2.2s;
  }

  .flow-path-2 {
    stroke: url(#streamGrad2);
    animation-duration: 1.8s;
  }

  .flow-path-3 {
    stroke: url(#streamGrad1);
    animation-duration: 2.8s;
  }

  @keyframes flowData {
    from {
      stroke-dashoffset: 20;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* ========================================================
     WORDPRESS CORE EMBLEM & ENERGY HUB (Anchor: 50.8%, 45.8%)
     ======================================================== */
  .wp-core-anchor {
    position: absolute;
    left: 50.8%;
    top: 45.8%;
    transform: translate(-50%, -50%) translateZ(40px);
    width: 86px;
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
  }

  @media (max-width: 575px) {
    .wp-core-anchor {
      width: 66px;
      height: 66px;
    }
  }

  /* Pulsing Radar Wave */
  .wp-radar-wave {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 80, 26, 0.5);
    pointer-events: none;
    animation: radarPulse 3s cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
  }

  .wave-2 {
    animation-delay: 1.5s;
    border-color: rgba(255, 152, 0, 0.4);
  }

  @keyframes radarPulse {
    0% {
      transform: scale(0.7);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* Spinning Dashed Orbit Ring */
  .wp-orbit-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px dashed rgba(255, 80, 26, 0.7);
    animation: spinRing 14s linear infinite;
    pointer-events: none;
    box-shadow: 0 0 15px rgba(255, 80, 26, 0.3);
  }

  @keyframes spinRing {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Center Moving WordPress Disc */
  .wp-interactive-disc {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 35% 35%, #ff7844, #e53935 70%, #b71c1c);
    box-shadow: 0 8px 24px rgba(255, 80, 26, 0.45),
                inset 0 2px 4px rgba(255, 255, 255, 0.6);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    animation: wpFloat 3.6s ease-in-out infinite alternate;
  }

  @media (max-width: 575px) {
    .wp-interactive-disc {
      width: 46px;
      height: 46px;
    }
  }

  .wp-core-anchor:hover .wp-interactive-disc {
    transform: scale(1.18);
    box-shadow: 0 12px 32px rgba(255, 80, 26, 0.7),
                0 0 20px rgba(255, 120, 68, 0.6);
  }

  .wp-interactive-disc.boost-spin {
    animation: turboSpin 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes wpFloat {
    0% {
      transform: translateY(-2px);
    }
    100% {
      transform: translateY(3px);
    }
  }

  @keyframes turboSpin {
    0% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.3) rotate(360deg);
    }
    100% {
      transform: scale(1) rotate(720deg);
    }
  }

  .wp-logo-svg {
    width: 78%;
    height: 78%;
    display: block;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }

  .wp-circle-bg {
    fill: #ff501a;
  }

  /* Live beacon dot */
  .wp-live-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
    border: 2px solid #ffffff;
    box-shadow: 0 0 8px #10b981;
    animation: liveBlink 1.4s ease-in-out infinite;
  }

  @keyframes liveBlink {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  /* Click shockwave ripple */
  .click-shockwave {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 4px solid #ff501a;
    animation: shockwaveExpand 0.9s ease-out forwards;
    pointer-events: none;
  }

  @keyframes shockwaveExpand {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(3.5);
      opacity: 0;
    }
  }

  /* Popover Tooltip */
  .wp-popover {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: rgba(18, 20, 30, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 80, 26, 0.4);
    border-radius: 10px;
    padding: 8px 14px;
    min-width: 190px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 25;
  }

  .wp-popover::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px;
    border-style: solid;
    border-color: rgba(18, 20, 30, 0.92) transparent transparent transparent;
  }

  .wp-core-anchor:hover .wp-popover,
  .wp-core-anchor.boost-active .wp-popover {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .popover-badge {
    font-size: 9px;
    font-weight: 800;
    color: #ff501a;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }

  .popover-title {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .popover-stats {
    font-size: 11px;
    color: #9ca3af;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .popover-stats strong {
    color: #10b981;
  }

  .popover-stats .sep {
    color: #4b5563;
  }

  /* ========================================================
     FLOATING LIVE TELEMETRY BADGES
     ======================================================== */
  .hero-float-card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(230, 235, 245, 0.95);
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(17, 24, 39, 0.08),
                0 2px 6px rgba(0, 0, 0, 0.04);
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out, box-shadow 0.25s ease;
    animation: cardBob 4.2s ease-in-out infinite alternate;
    animation-delay: var(--delay, 0s);
    z-index: 8;
  }

  .hero-float-card:hover {
    box-shadow: 0 14px 30px rgba(255, 80, 26, 0.18),
                0 4px 10px rgba(0, 0, 0, 0.06);
    border-color: rgba(255, 80, 26, 0.4);
  }

  @keyframes cardBob {
    0% {
      margin-top: 0px;
    }
    100% {
      margin-top: -6px;
    }
  }

  /* Positioning of each card */
  .card-uptime {
    top: 14%;
    left: 4%;
  }

  .card-litespeed {
    top: 10%;
    right: 4%;
  }

  .card-security {
    bottom: 22%;
    left: 4%;
  }

  .card-install {
    bottom: 20%;
    right: 4%;
  }

  /* Compact screens */
  @media (max-width: 767px) {
    .card-uptime {
      top: 6%;
      left: 0%;
      padding: 6px 10px;
    }
    .card-litespeed {
      top: 4%;
      right: 0%;
      padding: 6px 10px;
    }
    .card-security {
      bottom: 12%;
      left: 0%;
      padding: 6px 10px;
    }
    .card-install {
      bottom: 10%;
      right: 0%;
      padding: 6px 10px;
    }
  }

  @media (max-width: 480px) {
    .hero-float-card {
      scale: 0.85;
    }
  }

  .card-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }

  .card-icon-wrap i {
    font-size: 17px;
  }

  .icon-green {
    background: rgba(16, 185, 129, 0.14);
    color: #10b981;
  }

  .icon-orange {
    background: rgba(255, 80, 26, 0.14);
    color: #ff501a;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.14);
    color: #06b6d4;
  }

  .icon-amber {
    background: rgba(245, 158, 11, 0.14);
    color: #f59e0b;
  }

  .pulse-beacon {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
    animation: beaconPulse 1.8s infinite;
  }

  @keyframes beaconPulse {
    0% {
      transform: scale(0.9);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.4;
    }
    100% {
      transform: scale(0.9);
      opacity: 1;
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
  }

  .card-label {
    font-size: 11px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
    white-space: nowrap;
  }

  .card-value {
    font-size: 10px;
    font-weight: 500;
    color: #6b7280;
    line-height: 1.2;
    white-space: nowrap;
  }

  .mini-sparkline {
    width: 34px;
    height: 14px;
    margin-left: 2px;
    flex-shrink: 0;
  }

  .boost-badge {
    font-size: 9px;
    font-weight: 800;
    color: #ff501a;
    background: rgba(255, 80, 26, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  @media (max-width: 575px) {
    .boost-badge,
    .mini-sparkline {
      display: none;
    }
  }

  /* Floating particle spark orbs */
  .spark-orb {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff501a;
    box-shadow: 0 0 10px #ff501a;
    pointer-events: none;
    animation: sparkFloat 5s ease-in-out infinite alternate;
  }

  .spark-1 {
    top: 25%;
    left: 45%;
    animation-duration: 4.2s;
  }

  .spark-2 {
    top: 60%;
    right: 32%;
    background: #06b6d4;
    box-shadow: 0 0 10px #06b6d4;
    animation-duration: 5.6s;
    animation-delay: 1.5s;
  }

  .spark-3 {
    top: 40%;
    right: 22%;
    animation-duration: 3.8s;
    animation-delay: 0.7s;
  }

  .spark-4 {
    top: 68%;
    left: 25%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation-duration: 4.8s;
    animation-delay: 2.1s;
  }

  @keyframes sparkFloat {
