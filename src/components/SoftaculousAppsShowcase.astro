<!-- Component Styles -->
<style>
  .ace-just-one {
    background-color: #ffffff;
    background-image: url(/assets/images/services.jpg);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    position: relative;
    padding: 85px 0 95px;
  }

  /* Decorative Ambient Blobs */
  .apps-glow-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
    opacity: 0.45;
  }
  .glow-blob-1 {
    top: 5%;
    left: -5%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.16) 0%, rgba(255, 80, 26, 0) 70%);
  }
  .glow-blob-2 {
    bottom: 5%;
    right: -5%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.14) 0%, rgba(6, 182, 212, 0) 70%);
  }

  /* Eyebrow Pill */
  .apps-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 80, 26, 0.08);
    border: 1px solid rgba(255, 80, 26, 0.22);
    border-radius: 30px;
    font-size: 11px;
    font-weight: 700;
  }
  .apps-pulse-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff501a;
    box-shadow: 0 0 6px #ff501a;
    animation: beaconPulse 1.8s infinite;
  }
  .apps-eyebrow-text {
    color: #ff501a;
    letter-spacing: 0.05em;
  }
  .apps-eyebrow-tag {
    background: #ff501a;
    color: #ffffff;
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 800;
  }

  @keyframes beaconPulse {
    0%, 100% { transform: scale(0.9); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  /* Stats Strip */
  .apps-stats-strip {
    margin-top: 10px;
  }
  .app-stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 10px;
    font-size: 13px;
    color: #1e293b;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  /* Filter Navigation */
  .apps-filter-nav {
    display: flex;
    align-items: center;
  }
  .app-filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .app-filter-pill:hover {
    border-color: #ff501a;
    color: #ff501a;
    transform: translateY(-1px);
  }
  .app-filter-pill.active {
    background: #ff501a;
    border-color: #ff501a;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(255, 80, 26, 0.28);
  }
  .filter-count-badge {
    background: rgba(255, 255, 255, 0.25);
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 700;
