          <!-- Card 1: WooCommerce / WordPress -->
          <div class="app-card" data-category="ecommerce cms" data-app-id="woocommerce">
            <div class="app-card-inner">
              <span class="app-badge badge-popular">POPULAR</span>
              <div class="app-icon-wrap">
                <img src="/assets/images/logo1.png" alt="WooCommerce & WordPress Logo" loading="lazy" />
              </div>
              <h4 class="app-name">WooCommerce</h4>
              <p class="app-category">eCommerce &amp; Store</p>
