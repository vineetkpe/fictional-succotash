        badge: "PHP ARTISAN",
        badgeColor: "#ef4444",
        category: "Modern Web Application",
        icon: "ri-code-s-slash-line",
        iconColor: "#ff2d20",
        isIcon: true,
        desc: "Rapid application scaffolding for PHP developers with expressive syntax, robust Eloquent ORM, integrated queues, and automated Composer dependency resolution.",
        target: "https://yourdomain.com/api",
        speed: "16s"
      },
      phpbb: {
        title: "phpBB",
        badge: "COMMUNITY FORUM",
        badgeColor: "#10b981",
        category: "Discussion & Community",
        icon: "ri-discuss-line",
        iconColor: "#10b981",
        isIcon: true,
        desc: "Scalable discussion forum software with user permissions, private messaging, BBCode support, and anti-spam moderation tools.",
        target: "https://yourdomain.com/community",
        speed: "10s"
      },
      nextcloud: {
        title: "Nextcloud",
        badge: "PRIVATE CLOUD",
        badgeColor: "#0284c7",
        category: "Private Storage & Sync",
        icon: "ri-cloud-line",
        iconColor: "#0082c9",
        isIcon: true,
        desc: "Self-hosted file sync and collaboration suite. Control your own files, calendars, and contacts with end-to-end encryption on Hostamble NVMe storage.",
        target: "https://yourdomain.com/cloud",
        speed: "20s"
      }
    };

    let activeAppKey = "woocommerce";
    let isSimulating = false;

    // Elements
    const spotlightTitle = document.getElementById("spotlightTitle");
    const spotlightBadge = document.getElementById("spotlightBadge");
    const spotlightCat = document.getElementById("spotlightCat");
    const spotlightDesc = document.getElementById("spotlightDesc");
    const spotlightLogoWrap = document.getElementById("spotlightLogoWrap");
    const destUrl = document.getElementById("destUrl");

    const runBtn = document.getElementById("runSimulationBtn");
    const resetBtn = document.getElementById("resetSimulationBtn");
    const progressFill = document.getElementById("progressFill");
    const progressPercent = document.getElementById("progressPercent");
    const progressStepText = document.getElementById("progressStepText");
    const terminalLogs = document.getElementById("terminalLogs");
    const terminalStatusBadge = document.getElementById("terminalStatusBadge");

    function selectApp(appId) {
      const app = appsData[appId];
      if (!app) return;
      activeAppKey = appId;

      // Update Spotlight
      if (spotlightTitle) spotlightTitle.textContent = app.title;
      if (spotlightBadge) {
        spotlightBadge.textContent = app.badge;
        spotlightBadge.style.color = app.badgeColor || "#ff501a";
      }
      if (spotlightCat) spotlightCat.textContent = app.category;
      if (spotlightDesc) spotlightDesc.textContent = app.desc;
      if (destUrl) destUrl.textContent = app.target;

      if (spotlightLogoWrap) {
        if (app.isIcon) {
          spotlightLogoWrap.innerHTML = `<i class="${app.icon}" style="color: ${app.iconColor};"></i>`;
        } else {
          spotlightLogoWrap.innerHTML = `<img src="${app.logo}" alt="${app.title}" />`;
        }
      }

      // Update Card Visuals
      document.querySelectorAll(".app-card").forEach((card) => {
        if (card.getAttribute("data-app-id") === appId) {
          card.classList.add("is-selected");
        } else {
          card.classList.remove("is-selected");
        }
      });

      // Reset Simulation state for newly selected app
      resetSimulator();
    }

    // Bind Marquee Card Clicks
    document.querySelectorAll(".app-card").forEach((card) => {
      card.addEventListener("click", () => {
        const id = card.getAttribute("data-app-id");
        if (id) selectApp(id);
      });
    });

    // Category Filter Navigation
    const filterBtns = document.querySelectorAll(".app-filter-pill");
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const category = btn.getAttribute("data-category") || "all";

        document.querySelectorAll(".app-card").forEach((card) => {
          const cardCat = card.getAttribute("data-category") || "";
          if (category === "all" || cardCat.includes(category)) {
            card.classList.remove("is-dimmed");
          } else {
            card.classList.add("is-dimmed");
          }
        });

        // Automatically select the first visible matching app
        const firstMatching = document.querySelector(`.app-card:not(.is-dimmed)`);
        if (firstMatching) {
          const matchId = firstMatching.getAttribute("data-app-id");
          if (matchId) selectApp(matchId);
        }
      });
    });

    // Interactive 1-Click Simulation Runner
    function addLog(msg, type = "normal") {
      if (!terminalLogs) return;
      const now = new Date();
      const timeStr = now.toTimeString().split(" ")[0];
      const div = document.createElement("div");
      div.className = `log-line ${type === "success" ? "text-success font-weight-bold" : type === "info" ? "text-info" : type === "warning" ? "text-warning" : "text-light"}`;
      div.innerHTML = `<span class="log-ts">[${timeStr}]</span> ${msg}`;
      terminalLogs.appendChild(div);
      terminalLogs.scrollTop = terminalLogs.scrollHeight;
    }

    function resetSimulator() {
      isSimulating = false;
      if (progressFill) progressFill.style.width = "0%";
      if (progressPercent) progressPercent.textContent = "0%";
      if (progressStepText) progressStepText.textContent = `Click "Run 1-Click Install Demo" to test ${appsData[activeAppKey].title}`;
      if (terminalStatusBadge) {
        terminalStatusBadge.innerHTML = `<span class="status-live-dot" style="background: #34d399;"></span> READY`;
      }
      if (runBtn) {
        runBtn.disabled = false;
        runBtn.innerHTML = `<i class="ri-play-circle-fill"></i> <span>Run 1-Click Install Demo</span>`;
      }
      if (resetBtn) resetBtn.style.display = "none";
      if (terminalLogs) {
        terminalLogs.innerHTML = `
          <div class="log-line text-muted"><span class="log-ts">[00:00:00]</span> Softaculous Core v5.9 ready on CloudLinux</div>
          <div class="log-line text-info"><span class="log-ts">[00:00:00]</span> Selected package: <strong>${appsData[activeAppKey].title}</strong></div>
        `;
      }
    }

    async function runSimulation() {
      if (isSimulating) return;
      isSimulating = true;

      const app = appsData[activeAppKey];
      if (runBtn) {
        runBtn.disabled = true;
        runBtn.innerHTML = `<i class="ri-loader-4-line ri-spin"></i> <span>Installing ${app.title}...</span>`;
      }
      if (resetBtn) resetBtn.style.display = "inline-flex";
      if (terminalStatusBadge) {
        terminalStatusBadge.innerHTML = `<span class="status-live-dot" style="background: #f59e0b;"></span> PROVISIONING`;
      }

      const steps = [
        { pct: 20, text: `[1/4] Allocating NVMe storage at /home/user/public_html...`, log: `Isolated cPanel directory mounted (/home/user/public_html)`, delay: 500 },
        { pct: 50, text: `[2/4] Initializing MariaDB 10.6 database & secure schema...`, log: `Generated database 'cpanel_store' with utf8mb4 collation`, delay: 700 },
        { pct: 75, text: `[3/4] AutoSSL active: Applying Let's Encrypt 256-bit TLS...`, log: `SSL certificate verified & HTTPS rewrite enabled`, delay: 650 },
        { pct: 90, text: `[4/4] Activating LiteSpeed Cache & core app plugins...`, log: `LiteSpeed WebADC caching rules installed successfully`, delay: 600 },
        { pct: 100, text: `Installation Complete! ${app.title} is Live in 4.8s.`, log: `🎉 Deployment Verified! Live URL: ${app.target}`, delay: 500, success: true }
      ];

      for (const step of steps) {
        await new Promise((r) => setTimeout(r, step.delay));
        if (progressFill) progressFill.style.width = `${step.pct}%`;
        if (progressPercent) progressPercent.textContent = `${step.pct}%`;
        if (progressStepText) progressStepText.textContent = step.text;
        addLog(step.log, step.success ? "success" : "info");
      }

      if (terminalStatusBadge) {
        terminalStatusBadge.innerHTML = `<span class="status-live-dot" style="background: #10b981;"></span> LIVE`;
      }
      if (runBtn) {
        runBtn.disabled = false;
        runBtn.innerHTML = `<i class="ri-check-line"></i> <span>Re-run Demo</span>`;
      }
      isSimulating = false;
    }

    if (runBtn) runBtn.addEventListener("click", runSimulation);
    if (resetBtn) resetBtn.addEventListener("click", resetSimulator);

    // Initial Selection
    selectApp("woocommerce");
  }

  // Initialize
  initSoftaculousShowcase();
  document.addEventListener("astro:page-load", initSoftaculousShowcase);
</script>

