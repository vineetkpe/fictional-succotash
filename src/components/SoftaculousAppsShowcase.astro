      }
    };

    let activeAppKey = "woocommerce";
    let isSimulating = false;

    // Elements
    const spotlightTitle = document.getElementById("spotlightTitle");
    const spotlightBadge = document.getElementById("spotlightBadge");
    const spotlightCat = document.getElementById("spotlightCat");
    const spotlightDesc = document.getElementById("spotlightDesc");
    const spotlightLogoWrap = document.getElementById("spotlightLogoWrap");
    const destUrl = document.getElementById("destUrl");

    const runBtn = document.getElementById("runSimulationBtn") as HTMLButtonElement | null;
    const resetBtn = document.getElementById("resetSimulationBtn") as HTMLButtonElement | null;
    const progressFill = document.getElementById("progressFill");
    const progressPercent = document.getElementById("progressPercent");
    const progressStepText = document.getElementById("progressStepText");
    const terminalStatusBadge = document.getElementById("terminalStatusBadge");

    function selectApp(appId: string) {
      const app = appsData[appId];
      if (!app) return;
      activeAppKey = appId;

      // Update Spotlight
      if (spotlightTitle) spotlightTitle.textContent = app.title;
      if (spotlightBadge) {
        spotlightBadge.textContent = app.badge;
        spotlightBadge.style.color = app.badgeColor || "#ff501a";
      }
      if (spotlightCat) spotlightCat.textContent = app.category;
      if (spotlightDesc) spotlightDesc.textContent = app.desc;
      if (destUrl) destUrl.textContent = app.target;

      if (spotlightLogoWrap) {
        if (app.isIcon) {
          spotlightLogoWrap.innerHTML = `<i class="${app.icon}" style="color: ${app.iconColor};"></i>`;
        } else {
          spotlightLogoWrap.innerHTML = `<img src="${app.logo}" alt="${app.title}" />`;
        }
      }

      // Update Card Visuals
      document.querySelectorAll(".app-card").forEach((card) => {
        if (card.getAttribute("data-app-id") === appId) {
          card.classList.add("is-selected");
        } else {
          card.classList.remove("is-selected");
        }
      });

      // Reset Simulation state for newly selected app
      resetSimulator();
    }

    // Bind Marquee Card Clicks
    document.querySelectorAll(".app-card").forEach((card) => {
      card.addEventListener("click", () => {
        const id = card.getAttribute("data-app-id");
        if (id) selectApp(id);
      });
    });

    // Category Filter Navigation
    const filterBtns = document.querySelectorAll(".app-filter-pill");
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const category = btn.getAttribute("data-category") || "all";

        document.querySelectorAll(".app-card").forEach((card) => {
          const cardCat = card.getAttribute("data-category") || "";
          if (category === "all" || cardCat.includes(category)) {
            card.classList.remove("is-dimmed");
          } else {
            card.classList.add("is-dimmed");
          }
        });

        // Automatically select the first visible matching app
        const firstMatching = document.querySelector(`.app-card:not(.is-dimmed)`);
        if (firstMatching) {
          const matchId = firstMatching.getAttribute("data-app-id");
          if (matchId) selectApp(matchId);
        }
      });
    });

    // Interactive 1-Click Simulation Runner
    function resetSimulator() {
      isSimulating = false;
      if (progressFill) progressFill.style.width = "0%";
      if (progressPercent) progressPercent.textContent = "0%";
      if (progressStepText) progressStepText.textContent = `Ready • Click "Deploy in 1-Click" to test ${appsData[activeAppKey].title}`;
      if (terminalStatusBadge) {
        terminalStatusBadge.className = "deploy-status-pill status-ready";
        terminalStatusBadge.innerHTML = `<span class="status-live-dot"></span> <span class="status-live-text">READY</span>`;
      }
      if (runBtn) {
        runBtn.disabled = false;
        runBtn.innerHTML = `<i class="ri-flashlight-fill"></i> <span>Deploy in 1-Click (Demo)</span>`;
      }
      if (resetBtn) resetBtn.style.display = "none";
      const banner = document.getElementById("deploySuccessBanner");
      if (banner) banner.style.display = "none";

      for (let s = 1; s <= 4; s++) {
        const item = document.getElementById(`stepPipe${s}`);
        const status = document.getElementById(`stepPipeStatus${s}`);
        if (item) item.className = "step-pipe-item";
        if (status) status.innerHTML = `<i class="ri-time-line text-muted"></i>`;
      }
    }

    async function runSimulation() {
      if (isSimulating) return;
      isSimulating = true;

      const app = appsData[activeAppKey];
      if (runBtn) {
        runBtn.disabled = true;
        runBtn.innerHTML = `<i class="ri-loader-4-line ri-spin"></i> <span>Deploying ${app.title}...</span>`;
      }
      if (resetBtn) resetBtn.style.display = "inline-flex";
      if (terminalStatusBadge) {
        terminalStatusBadge.className = "deploy-status-pill status-provisioning";
        terminalStatusBadge.innerHTML = `<span class="status-live-dot"></span> <span class="status-live-text">PROVISIONING</span>`;
      }

      const steps = [
        {
          pct: 25,
          text: `[1/4] Allocating isolated CloudLinux NVMe directory...`,
          step: 1,
          delay: 450
        },
        {
          pct: 50,
          text: `[2/4] Generating MariaDB 10.6 database & credentials...`,
          step: 2,
          delay: 500
        },
        {
          pct: 75,
          text: `[3/4] AutoSSL active: Applying Let's Encrypt 256-bit TLS...`,
          step: 3,
          delay: 450
        },
        {
          pct: 100,
          text: `[4/4] Activating LiteSpeed Cache & core app modules...`,
          step: 4,
          delay: 450,
          success: true
        }
      ];

      for (let i = 0; i < steps.length; i++) {
        const step = steps[i];
        const item = document.getElementById(`stepPipe${step.step}`);
        const status = document.getElementById(`stepPipeStatus${step.step}`);
        if (item) item.className = "step-pipe-item is-running";
        if (status) status.innerHTML = `<i class="ri-loader-4-line ri-spin text-primary"></i>`;

        if (progressFill) progressFill.style.width = `${step.pct}%`;
        if (progressPercent) progressPercent.textContent = `${step.pct}%`;
        if (progressStepText) progressStepText.textContent = step.text;

        await new Promise((r) => setTimeout(r, step.delay));

        if (item) item.className = "step-pipe-item is-done";
        if (status) status.innerHTML = `<i class="ri-checkbox-circle-fill text-success"></i>`;
      }

      const banner = document.getElementById("deploySuccessBanner");
      if (banner) banner.style.display = "block";

      if (progressStepText) progressStepText.textContent = `Deployment Complete! ${app.title} is Live in 4.2s.`;

      if (terminalStatusBadge) {
        terminalStatusBadge.className = "deploy-status-pill status-live";
        terminalStatusBadge.innerHTML = `<span class="status-live-dot"></span> <span class="status-live-text">LIVE</span>`;
      }
      if (runBtn) {
        runBtn.disabled = false;
        runBtn.innerHTML = `<i class="ri-check-line"></i> <span>Re-run Deployment Demo</span>`;
      }
      isSimulating = false;
    }

        if (runBtn) runBtn.addEventListener("click", runSimulation);
    if (resetBtn) resetBtn.addEventListener("click", resetSimulator);

    // Initial Selection
    selectApp("woocommerce");
  }

  // Initialize
  initSoftaculousShowcase();
  document.addEventListener("astro:page-load", initSoftaculousShowcase);
</script>

