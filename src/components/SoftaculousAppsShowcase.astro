---
// Interactive Softaculous 1-Click App Showcase & Shopping Cart Installer Simulator
---

<section class="ace-just-one ace-section-gap bg-image position-relative overflow-hidden" id="apps-showcase">
  <!-- Decorative Background Glows -->
  <div class="apps-glow-blob glow-blob-1" aria-hidden="true"></div>
  <div class="apps-glow-blob glow-blob-2" aria-hidden="true"></div>

  <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
    <!-- Section Header -->
    <div class="row g-4 align-items-end mb-4">
      <div class="col-lg-7 col-md-12">
        <div class="section-title text-start" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="apps-eyebrow-pill mb-3">
            <span class="apps-pulse-beacon"></span>
            <span class="apps-eyebrow-text">INSTALL A SHOPPING CART &amp; 400+ APPS</span>
            <span class="apps-eyebrow-tag">1-CLICK CPANEL</span>
          </div>
          <h2 class="title mb-3">
            Photo Gallery, a Blog, or an eCommerce Store in Just 1 Click
          </h2>
          <p class="description mb-0">
            Powered by genuine <strong class="text-primary font-weight-bold">Softaculous Enterprise</strong> inside your cPanel. Launch WooCommerce, OpenCart, Magento, or WordPress in under 15 seconds with automated MariaDB configuration and free Let's Encrypt SSL.
          </p>
        </div>
      </div>

      <div class="col-lg-5 col-md-12 text-lg-end text-start">
        <div class="apps-stats-strip d-inline-flex flex-wrap gap-2 justify-content-lg-end" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="app-stat-badge">
            <i class="ri-shopping-cart-2-fill text-primary"></i>
            <span><strong>40+</strong> Shopping Carts</span>
          </div>
          <div class="app-stat-badge">
            <i class="ri-apps-2-fill text-success"></i>
            <span><strong>400+</strong> 1-Click Scripts</span>
          </div>
          <div class="app-stat-badge">
            <i class="ri-flashlight-fill text-warning"></i>
            <span><strong>&lt; 15s</strong> Deploy Time</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Category Filter Navigation -->
    <div class="apps-filter-nav mb-4" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="filter-label text-muted small font-weight-bold d-none d-md-inline-block">Filter Apps:</span>
        <button type="button" class="app-filter-pill active" data-category="all">
          <i class="ri-grid-fill"></i>
          <span>All 400+ Apps</span>
        </button>
        <button type="button" class="app-filter-pill featured-filter" data-category="ecommerce">
          <i class="ri-shopping-bag-3-fill"></i>
          <span>eCommerce &amp; Shopping Carts</span>
          <span class="filter-count-badge">5 Carts</span>
        </button>
        <button type="button" class="app-filter-pill" data-category="cms">
          <i class="ri-article-fill"></i>
          <span>Blogs &amp; CMS</span>
        </button>
        <button type="button" class="app-filter-pill" data-category="community">
          <i class="ri-community-fill"></i>
          <span>Forums &amp; Portals</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Dual Infinite Smooth-Scroll Continuous Marquee (Full Bleed End-to-End) -->
    <div class="apps-marquee-container mb-5" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
      <div class="marquee-fader fader-left" aria-hidden="true"></div>
      <div class="marquee-fader fader-right" aria-hidden="true"></div>

      <!-- Marquee Track 1 (Left Scrolling) -->
      <div class="marquee-track-wrapper mb-3">
