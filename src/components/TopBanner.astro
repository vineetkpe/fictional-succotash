---
interface Props {
  badge?: string;
  text?: string;
  linkText?: string;
  linkUrl?: string;
}

const {
  badge = "Diwali Sale",
  linkText = "See offers →",
  linkUrl = "#plans"
} = Astro.props;
---

<div class="top-sale-strip" id="topSaleStrip">
  <div class="marquee-track">
    <div class="marquee-group">
      <div class="top-sale-item">
        <span class="sale-badge">
          <span class="badge-icon">🪔</span>
          <span class="badge-text">{badge}</span>
        </span>
        <span class="sale-message">
          Get ready for Diwali Sale! Up to <strong class="sale-highlight">77% OFF</strong> on Hosting + Free Domain!
        </span>
        <a href={linkUrl} class="sale-link">
          {linkText}
        </a>
      </div>
      <span class="sale-divider">✦</span>
      <div class="top-sale-item">
        <span class="sale-badge">
          <span class="badge-icon">🪔</span>
          <span class="badge-text">{badge}</span>
        </span>
        <span class="sale-message">
          Special Festive Hosting Deals — Fast, Reliable & Secure!
        </span>
        <a href={linkUrl} class="sale-link">
          {linkText}
        </a>
      </div>
      <span class="sale-divider">✦</span>
      <div class="top-sale-item">
        <span class="sale-badge">
          <span class="badge-icon">🪔</span>
          <span class="badge-text">{badge}</span>
        </span>
        <span class="sale-message">
          Get ready for Diwali Sale! Up to <strong class="sale-highlight">77% OFF</strong> on Hosting + Free Domain!
        </span>
        <a href={linkUrl} class="sale-link">
          {linkText}
        </a>
      </div>
      <span class="sale-divider">✦</span>
    </div>

    <!-- Duplicate group for seamless infinite continuous scroll -->
    <div class="marquee-group" aria-hidden="true">
      <div class="top-sale-item">
        <span class="sale-badge">
          <span class="badge-icon">🪔</span>
          <span class="badge-text">{badge}</span>
        </span>
        <span class="sale-message">
          Get ready for Diwali Sale! Up to <strong class="sale-highlight">77% OFF</strong> on Hosting + Free Domain!
        </span>
        <a href={linkUrl} class="sale-link">
          {linkText}
        </a>
      </div>
      <span class="sale-divider">✦</span>
      <div class="top-sale-item">
        <span class="sale-badge">
          <span class="badge-icon">🪔</span>
          <span class="badge-text">{badge}</span>
        </span>
        <span class="sale-message">
          Special Festive Hosting Deals — Fast, Reliable & Secure!
        </span>
        <a href={linkUrl} class="sale-link">
          {linkText}
        </a>
      </div>
      <span class="sale-divider">✦</span>
      <div class="top-sale-item">
        <span class="sale-badge">
          <span class="badge-icon">🪔</span>
          <span class="badge-text">{badge}</span>
        </span>
        <span class="sale-message">
          Get ready for Diwali Sale! Up to <strong class="sale-highlight">77% OFF</strong> on Hosting + Free Domain!
        </span>
        <a href={linkUrl} class="sale-link">
          {linkText}
        </a>
      </div>
      <span class="sale-divider">✦</span>
    </div>
  </div>
</div>

<style>
  .top-sale-strip {
    background: #ff6027;
    color: #ffffff;
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    position: relative;
    z-index: 100;
    width: 100%;
    padding: 4px 0;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    height: 32px;
    display: flex;
    align-items: center;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    user-select: none;
  }

  .marquee-track:hover .marquee-group {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 28px;
    padding-right: 28px;
    animation: marqueeScroll 30s linear infinite;
  }

  @keyframes marqueeScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  .top-sale-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .sale-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #202133;
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    transform: rotate(-2deg);
    transition: transform 0.2s ease;
  }

  .sale-badge:hover {
    transform: rotate(0deg) scale(1.05);
  }

  .badge-icon {
    font-size: 11px;
    line-height: 1;
  }

  .sale-message {
    color: #ffffff;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .sale-highlight {
    color: #ffffff;
    font-weight: 800;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .sale-link {
    color: #ffffff;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: all 0.2s ease;
    white-space: nowrap;
    margin-left: 2px;
  }

  .sale-link:hover {
    color: #202133;
    text-decoration: none;
  }

  .sale-divider {
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
    display: inline-block;
  }

  @media (max-width: 767px) {
    .top-sale-strip {
      font-size: 12px;
      height: 30px;
      padding: 3px 0;
    }

    .marquee-group {
      gap: 20px;
      padding-right: 20px;
      animation-duration: 24s;
    }

    .sale-badge {
      font-size: 9.5px;
      padding: 1.5px 6px;
    }
  }
</style>
