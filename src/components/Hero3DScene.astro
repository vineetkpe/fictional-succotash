---
import { STATIONS } from '../scripts/hero3d';
---

<div class="hero-3d-wrapper" id="hero3dContainer">
  <!-- Top Quick-Select Station Pills -->
  <div class="hero-3d-pills" role="tablist" aria-label="Cloud Server Engine Components">
    {STATIONS.map((station, idx) => (
      <button 
        type="button" 
        class={`hero-3d-pill-btn ${idx === 1 ? 'active' : ''}`}
        data-station-select={station.id}
        role="tab"
        aria-selected={idx === 1 ? 'true' : 'false'}
      >
        <span class="pill-dot" style={`--dot-color: #${station.color.toString(16).padStart(6, '0')};`}></span>
        <span class="pill-name">{station.name}</span>
      </button>
    ))}
  </div>

  <!-- 3D WebGL Canvas Canvas Area -->
  <div class="hero-3d-canvas-wrap">
    <canvas id="hero3dCanvas" aria-label="Interactive 3D Hostamble Cloud Server Engine. Drag to rotate 360 degrees."></canvas>

    <!-- Interactive Live HUD Card -->
    <div class="hero-3d-hud" data-hero3d-hud>
      <div class="hud-header">
        <span class="hud-badge" data-station-badge>ACCELERATOR</span>
        <span class="hud-metric" data-station-metric>10x Faster</span>
      </div>
      <h4 class="hud-title" data-station-title>LiteSpeed Enterprise</h4>
      <p class="hud-desc" data-station-desc>Native server-level cache & HTTP/3 protocol for lightning WordPress load times.</p>
    </div>

    <!-- Interaction Hint -->
    <div class="hero-3d-hint" aria-hidden="true">
      <i class="ri-drag-move-2-line" aria-hidden="true"></i>
      <span>Drag to rotate 360° · Tap node to inspect</span>
    </div>
  </div>
</div>

<script>
  import { initHero3D } from '../scripts/hero3d';

  const container = document.getElementById('hero3dContainer');
  if (container) {
    initHero3D(container);
  }
</script>

<style>
  .hero-3d-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    user-select: none;
  }

  /* Quick-select pills */
  .hero-3d-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    width: 100%;
    z-index: 4;
  }

  .hero-3d-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(220, 224, 233, 0.9);
    color: #374151;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .hero-3d-pill-btn:hover {
    background: #ffffff;
    border-color: #ff501a;
    color: #ff501a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 80, 26, 0.15);
  }

  .hero-3d-pill-btn.active {
    background: #151824;
    color: #ffffff;
    border-color: #ff501a;
    box-shadow: 0 4px 14px rgba(255, 80, 26, 0.25);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dot-color, #ff501a);
    box-shadow: 0 0 6px var(--dot-color, #ff501a);
    flex-shrink: 0;
  }

  /* Canvas Container */
  .hero-3d-canvas-wrap {
    position: relative;
    width: 100%;
    height: 480px;
    min-height: 420px;
    border-radius: 20px;
    background: radial-gradient(circle at 50% 50%, rgba(255, 245, 238, 0.8) 0%, rgba(255, 255, 255, 0.2) 70%, transparent 100%);
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .hero-3d-canvas-wrap {
      height: 520px;
    }
  }

  @media (max-width: 575px) {
    .hero-3d-canvas-wrap {
      height: 390px;
      min-height: 360px;
    }
  }

  #hero3dCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  #hero3dCanvas:active {
    cursor: grabbing;
  }

  /* HUD Card */
  .hero-3d-hud {
    position: absolute;
    bottom: 40px;
    left: 20px;
    max-width: 320px;
    padding: 14px 18px;
    background: rgba(18, 20, 30, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 3px solid #ff501a;
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 5;
  }

  @media (max-width: 575px) {
    .hero-3d-hud {
      bottom: 34px;
      left: 12px;
      right: 12px;
      max-width: none;
      padding: 10px 14px;
    }
  }

  .hud-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  .hud-badge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ff501a;
    text-transform: uppercase;
  }

  .hud-metric {
    font-size: 13px;
    font-weight: 700;
    color: #10b981;
    font-variant-numeric: tabular-nums;
  }

  .hud-title {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px 0;
    line-height: 1.25;
  }

  .hud-desc {
    font-size: 12px;
    color: #a0aec0;
    margin: 0;
    line-height: 1.4;
  }

  /* Interaction hint */
  .hero-3d-hint {
    position: absolute;
    bottom: 12px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(220, 224, 233, 0.8);
    font-size: 11px;
    font-weight: 600;
    color: #6b7280;
    pointer-events: none;
    z-index: 4;
  }

  .hero-3d-hint i {
    font-size: 13px;
    color: #ff501a;
  }

  @media (max-width: 575px) {
    .hero-3d-hint {
      display: none;
    }
  }
</style>
