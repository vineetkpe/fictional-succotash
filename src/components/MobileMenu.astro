        <div class="header-top">
            <div class="logo"><a href="/"><img alt="Site Logo" src="/assets/images/logo.png" /> </a></div>
            <div class="close-menu"><button class="close-button" aria-label="Close menu"><i class="ri-close-line"></i></button></div>
        </div>

        <div class="mobile-currency-wrap px-4 pt-2">
            <CurrencySwitcher variant="mobile" />
        </div>

        <ul class="mainmenu">
            <li><a href="/">Home</a></li>
            <li class="has-droupdown"><a href="/domain-search">Domain</a>
                <ul class="submenu">
                    <li><a href="/domain-search">Domain Search</a></li>
                    <li><a href="/transfer-domain">Domain Transfer</a></li>
                    <li><a href="/tld-pricing">TLD Pricing List</a></li>
                    <li><a href="/ai-domain-generator">AI Domain Generator</a></li>
                </ul>
            </li>
            <li class="has-droupdown"><a href="/shared-hosting">Hosting</a>
                <ul class="submenu">
                    <li><a href="/shared-hosting">Shared Hosting</a></li>
                    <li><a href="/wordpress-hosting">Wordpress Hosting</a></li>
                </ul>
            </li>
            <li><a href="/knowledge-base">Knowledge Base</a></li>
            <li class="has-droupdown"><a href="/about-us">Company</a>
                <ul class="submenu">
                    <li><a href="/about-us">About Us</a></li>
                    <li><a href="/contacts">Contact Us</a></li>
