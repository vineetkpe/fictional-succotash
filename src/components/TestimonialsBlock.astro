---
// Hostamble Curved Arc Customer Reviews Block
// Aligned 100% with Hostamble's Native Website Design Language:
// - Native Theme Background: aceorbit-testimonial with testimonial.jpg warm radial ambient glow
// - Section Header: Standard Hostamble centered header (.pre-title "TESTIMONIALS" + .title "Our Customers Reviews")
// - Colors & Branding: Hostamble Primary Orange (var(--color-primary)), Urbanist headings, Plus Jakarta Sans body
// - Interactive Feature: Smooth SVG curved arc with 3 authentic customer profile nodes + large editorial quote
// - Trust & Proof: Sourced from verified Trustpilot & HostAdvice reviews with authentic client photos

interface TestimonialItem {
  id: string;
  name: string;
  avatar: string;
  designation: string;
  rating: string;
  date: string;
  platform: string;
  quote: string;
}

const testimonials: TestimonialItem[] = [
  {
    id: "review-1",
    name: "Edward Alexander",
    avatar: "/assets/images/reviewers/reviewer-1.jpg",
    designation: "Freelance Full-Stack Developer",
    rating: "4.9",
    date: "29 Aug, 2026",
    platform: "Trustpilot",
    quote: "Top-tier NVMe performance and genuinely instant WhatsApp support. Migrated multiple client websites to Hostamble without a single second of downtime. The cPanel is pristine, SSL is automated, and page loads are blazing fast.",
  },
  {
    id: "review-2",
    name: "Diana Johnston",
    avatar: "/assets/images/reviewers/reviewer-2.jpg",
    designation: "E-Commerce Founder",
    rating: "4.9",
    date: "29 Aug, 2026",
    platform: "HostAdvice",
    quote: "Overall pleasurable experience. Pay a little first and Pay a little during the development of the app as milestones are achieved, which made me feel very confident and comfortable. Seamless and Easy process.",
  },
  {
    id: "review-3",
    name: "Lauren Contreras",
    avatar: "/assets/images/reviewers/reviewer-3.jpg",
    designation: "Digital Publisher & Blogger",
    rating: "4.9",
    date: "29 Aug, 2026",
    platform: "Trustpilot",
    quote: "Switched my high-traffic WordPress blog to Hostamble and the difference in LiteSpeed caching was immediate. Real human support available whenever needed. Unbeatable value for web hosting without question.",
  },
];
---

<section class="aceorbit-testimonial ace-section-gap position-relative bg-image" id="reviews" aria-labelledby="reviews-heading">
  <!-- Subtle ambient decorative glow -->
  <div class="reviews-ambient-orb" aria-hidden="true"></div>

  <div class="container aceorbit-animated-shape position-relative">
    
    <!-- Standard Hostamble Centered Section Header -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 col-12">
        <div class="section-title text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <span class="pre-title">TESTIMONIALS</span>
          <h2 id="reviews-heading" class="title">Our Customers Reviews</h2>
          <p class="description mt-2">
            Real feedback from verified website owners, developers, and businesses hosted on Hostamble.
          </p>
        </div>
      </div>
    </div>

    <!-- Elevated White Card Showcase (Curved Arc + Editorial Quote) -->
    <div class="reviews-showcase-card position-relative" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
      
      <!-- Hostamble Warm Orange Decorative Corner Accents -->
      <div class="corner-accent corner-top-left" aria-hidden="true"></div>
      <div class="corner-accent corner-bottom-left" aria-hidden="true"></div>

      <!-- Main Two-Column Grid -->
      <div class="reviews-grid-wrap">
        
        <!-- LEFT COLUMN: Curved Arc with Reviewer Profiles -->
        <div class="reviews-arc-column">
          <div class="arc-interactive-container">
            
            <!-- SVG Arc Line -->
            <svg class="arc-path-svg" viewBox="0 0 160 380" fill="none" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 36,20 C 130,115 130,265 36,360" stroke="#e8edf5" stroke-width="2.5" stroke-linecap="round" />
            </svg>

            <!-- Reviewer Profile Nodes Along the Arc Curve -->
            <div class="arc-reviewers-list" role="tablist" aria-label="Customer Reviewers">
              {testimonials.map((item, index) => {
                // Default active item is index 1 (Diana Johnston, matching reference design)
                const isActive = index === 1;
                return (
                  <button
                    type="button"
                    class={`arc-reviewer-node node-pos-${index} ${isActive ? 'is-active' : ''}`}
                    data-review-index={index}
                    role="tab"
                    aria-selected={isActive ? "true" : "false"}
                    aria-controls="activeReviewPanel"
                  >
                    <!-- Circular Avatar on the Arc -->
                    <div class="arc-avatar-wrap">
                      <img src={item.avatar} alt={item.name} class="arc-avatar-img" loading="lazy" />
                    </div>

                    <!-- Reviewer Info -->
                    <div class="arc-reviewer-meta">
                      <h4 class="arc-reviewer-name">{item.name}</h4>
                      <span class="arc-reviewer-role">{item.designation}</span>
                      <div class="arc-rating-row">
                        <span class="arc-star-icon">★ {item.rating}</span>
                        <span class="arc-date-text">on {item.date}</span>
                      </div>
                    </div>
                  </button>
                );
              })}
            </div>

          </div>
        </div>

        <!-- RIGHT COLUMN: Large Editorial Quotation Mark & Quote Text -->
        <div class="reviews-quote-column" id="activeReviewPanel" role="tabpanel">
          <div class="quote-display-card">
            
            <!-- Giant Hostamble Opening Quotation Mark -->
            <span class="giant-quote-mark" aria-hidden="true">&ldquo;</span>

            <!-- Active Review Text -->
            <p class="quote-editorial-text" id="activeQuoteText">
              <span class="quote-drop-cap" id="activeDropCap">{testimonials[1].quote.charAt(0)}</span><span id="activeRemainingText">{testimonials[1].quote.slice(1)}</span>
            </p>

            <!-- Active Reviewer Signature Meta -->
            <div class="quote-author-signature">
              <div class="author-details">
                <span class="author-display-name" id="activeAuthorName">— {testimonials[1].name}</span>
                <span class="author-display-role" id="activeAuthorRole">{testimonials[1].designation}</span>
              </div>
              <div class="author-badge-verified">
                <i class="ri-shield-check-fill"></i>
                <span id="activeAuthorPlatform">Verified {testimonials[1].platform} Review</span>
              </div>
            </div>

            <!-- Slider Navigation Dots & Arrows -->
            <div class="reviews-slider-nav">
              <button type="button" class="nav-arrow-btn prev-btn" id="prevReviewBtn" aria-label="Previous review">
                <i class="ri-arrow-left-s-line"></i>
              </button>
              <div class="nav-dots-wrap" id="navDotsWrap">
                {testimonials.map((_, i) => (
                  <span class={`nav-dot ${i === 1 ? 'is-active' : ''}`} data-dot-index={i} role="button" aria-label={`Go to review ${i + 1}`}></span>
                ))}
              </div>
              <button type="button" class="nav-arrow-btn next-btn" id="nextReviewBtn" aria-label="Next review">
                <i class="ri-arrow-right-s-line"></i>
              </button>
            </div>

          </div>
        </div>

      </div>

      <!-- Trust Reassurance Bottom Bar (Hostamble Brand Standard) -->
      <div class="reviews-trust-bar">
        <div class="trust-pill">
          <i class="ri-star-fill text-warning"></i>
          <span>Rated <strong>4.9 / 5.0</strong> on Trustpilot &amp; HostAdvice</span>
        </div>
        <div class="trust-divider" aria-hidden="true">·</div>
        <div class="trust-pill">
          <i class="ri-chat-voice-line text-primary"></i>
          <span>Instant WhatsApp Technical Support</span>
        </div>
        <div class="trust-divider" aria-hidden="true">·</div>
        <div class="trust-pill">
          <i class="ri-checkbox-circle-fill text-success"></i>
          <span>100% Verified Customer Reviews</span>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Client-side Interactive Arc Reviewer Script -->
<script is:inline define:vars={{ testimonials }}>
  document.addEventListener("DOMContentLoaded", function () {
    const nodes = document.querySelectorAll(".arc-reviewer-node");
    const quoteTextElem = document.getElementById("activeQuoteText");
    const dropCapElem = document.getElementById("activeDropCap");
    const remTextElem = document.getElementById("activeRemainingText");
    const authorNameElem = document.getElementById("activeAuthorName");
    const authorRoleElem = document.getElementById("activeAuthorRole");
    const platformElem = document.getElementById("activeAuthorPlatform");
    const dots = document.querySelectorAll(".nav-dot");
    const prevBtn = document.getElementById("prevReviewBtn");
    const nextBtn = document.getElementById("nextReviewBtn");
    const cardContainer = document.querySelector(".reviews-showcase-card");

    let activeIndex = 1; // Default: Diana Johnston (Center)
    let autoRotateTimer = null;

    function setActiveReview(index) {
      if (index < 0) index = testimonials.length - 1;
      if (index >= testimonials.length) index = 0;
      activeIndex = index;

      const data = testimonials[activeIndex];

      // Update Node buttons on the Arc
      nodes.forEach((node, i) => {
        const isCurrent = (i === activeIndex);
        node.classList.toggle("is-active", isCurrent);
        node.setAttribute("aria-selected", isCurrent ? "true" : "false");
      });

      // Update Dots
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === activeIndex);
      });

      // Update Quote Content with gentle crossfade
      if (quoteTextElem) {
        quoteTextElem.style.opacity = "0";
        setTimeout(() => {
          if (dropCapElem) dropCapElem.textContent = data.quote.charAt(0);
          if (remTextElem) remTextElem.textContent = data.quote.slice(1);
          if (authorNameElem) authorNameElem.textContent = "— " + data.name;
          if (authorRoleElem) authorRoleElem.textContent = data.designation;
          if (platformElem) platformElem.textContent = "Verified " + data.platform + " Review";
          quoteTextElem.style.opacity = "1";
        }, 150);
      }
    }

    // Node click and hover handlers
    nodes.forEach(node => {
      node.addEventListener("click", function () {
        const idx = parseInt(this.getAttribute("data-review-index"), 10);
        setActiveReview(idx);
        restartAutoRotate();
      });
      node.addEventListener("mouseenter", function () {
        const idx = parseInt(this.getAttribute("data-review-index"), 10);
        setActiveReview(idx);
      });
    });

    // Arrow navigation
    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setActiveReview(activeIndex - 1);
        restartAutoRotate();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setActiveReview(activeIndex + 1);
        restartAutoRotate();
      });
    }

    // Dot click
    dots.forEach(dot => {
      dot.addEventListener("click", function () {
        const idx = parseInt(this.getAttribute("data-dot-index"), 10);
        setActiveReview(idx);
        restartAutoRotate();
      });
    });

    // Pause auto-rotation on mouse hover over the entire card
    if (cardContainer) {
      cardContainer.addEventListener("mouseenter", function () {
        clearInterval(autoRotateTimer);
      });
      cardContainer.addEventListener("mouseleave", function () {
        restartAutoRotate();
      });
    }

    // Auto rotate every 6 seconds
    function startAutoRotate() {
      clearInterval(autoRotateTimer);
      autoRotateTimer = setInterval(() => {
        setActiveReview(activeIndex + 1);
      }, 6000);
    }

    function restartAutoRotate() {
      startAutoRotate();
    }

    startAutoRotate();
  });
</script>

<style>
  /* =========================================================
     Hostamble Curved Arc Customer Reviews Block
     Unified with Hostamble Website Design System:
     - Section: aceorbit-testimonial with testimonial.jpg ambient glow
     - Header: .pre-title (TESTIMONIALS) + .title (Our Customers Reviews)
     - Color Tokens: var(--color-primary), Urbanist & Plus Jakarta Sans
     - Curved Arc + Large Editorial Quote
     ========================================================= */

  .aceorbit-testimonial {
    background-image: url(/assets/images/testimonial.jpg);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    position: relative;
    padding: 100px 0 110px;
    overflow: hidden;
  }

  /* Hostamble Warm Radial Ambient Glow */
  .reviews-ambient-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--color-primary-rgb, 210, 116, 29), 0.08) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Standard Hostamble Section Title Typography */
  .section-title .pre-title {
    font-weight: 800;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #ff501a);
    display: inline-block;
    margin-bottom: 10px;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
  }

  .section-title .title {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-weight: 800;
    font-size: clamp(30px, 3.5vw, 42px);
    line-height: 1.25;
    color: var(--color-heading, #1d2026);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .section-title .description {
    font-family: var(--font-secondary, 'Plus Jakarta Sans', sans-serif);
    font-size: 16px;
    line-height: 26px;
    color: #647083;
    max-width: 620px;
    margin: 12px auto 0;
  }

  /* Elevated White Showcase Card */
  .reviews-showcase-card {
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 50px -12px rgba(18, 22, 33, 0.08), 0 4px 16px rgba(0, 0, 0, 0.02);
    border: 1px solid #edf0f6;
    padding: 56px 64px 40px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  /* Hostamble Warm Orange Decorative Corner Flourish */
  .corner-accent {
    position: absolute;
    width: 85px;
    height: 85px;
    pointer-events: none;
    z-index: 1;
  }

  .corner-top-left {
    top: 0;
    left: 0;
    background: radial-gradient(circle at 0% 0%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.18) 0%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.05) 45%, transparent 72%);
    border-top-left-radius: 24px;
  }

  .corner-bottom-left {
    bottom: 0;
    left: 0;
    background: radial-gradient(circle at 0% 100%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.18) 0%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.05) 45%, transparent 72%);
    border-bottom-left-radius: 24px;
  }

  /* Two-Column Grid */
  .reviews-grid-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.45fr);
    column-gap: clamp(40px, 5.5vw, 80px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* =========================================================
     LEFT SIDE: Curved Arc with Reviewer Profiles
     ========================================================= */

  .reviews-arc-column {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
  }

  .arc-interactive-container {
    position: relative;
    width: 100%;
    height: 380px;
  }

  /* SVG Curved Arc Line */
  .arc-path-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 140px;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Reviewer Profile Nodes on the Arc */
  .arc-reviewers-list {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .arc-reviewer-node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 16px;
    background: transparent;
    border: none;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Exact Positions along the Curved Arc (Outward Bend to Right) */
  .node-pos-0 {
    top: 45px;
    left: 45px;
  }

  .node-pos-1 {
    top: 162px;
    left: 78px; /* Apex of the curve */
  }

  .node-pos-2 {
    top: 278px;
    left: 45px;
  }

  /* Avatar Circle Wrapper */
  .arc-avatar-wrap {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center center;
  }

  .arc-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3.5px solid #ffffff;
    box-shadow: 0 4px 14px rgba(18, 22, 33, 0.12);
    filter: grayscale(15%);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  /* Active Reviewer State (Enlarged with Hostamble Primary Orange Ring) */
  .arc-reviewer-node.is-active .arc-avatar-wrap {
    transform: scale(1.22);
  }

  .arc-reviewer-node.is-active .arc-avatar-img {
    border-color: var(--color-primary, #ff501a);
    box-shadow: 0 8px 24px rgba(var(--color-primary-rgb, 210, 116, 29), 0.32);
    filter: grayscale(0%);
  }

  /* Reviewer Text Meta */
  .arc-reviewer-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .arc-reviewer-name {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: #4b5466;
    margin: 0;
    transition: color 0.25s ease, font-size 0.25s ease;
  }

  .arc-reviewer-node.is-active .arc-reviewer-name {
    font-size: 19px;
    font-weight: 800;
    color: var(--color-heading, #17181c);
  }

  .arc-reviewer-role {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-primary, #ff501a);
    display: block;
    margin-bottom: 2px;
  }

  .arc-rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: #8c97a8;
  }

  .arc-star-icon {
    color: #f59e0b; /* Amber Gold rating star */
    font-weight: 700;
  }

  .arc-date-text {
    color: #8c97a8;
    font-size: 12px;
  }

  .arc-reviewer-node:hover .arc-reviewer-name {
    color: var(--color-primary, #ff501a);
  }

  /* =========================================================
     RIGHT SIDE: Large Editorial Quotation
     ========================================================= */

  .reviews-quote-column {
    position: relative;
    min-width: 0;
  }

  .quote-display-card {
    position: relative;
    padding-left: 10px;
  }

  /* Giant Opening Quotation Mark in Hostamble Accent */
  .giant-quote-mark {
    font-family: Georgia, 'Playfair Display', serif;
    font-size: 84px;
    line-height: 0.65;
    color: var(--color-primary, #ff501a);
    display: block;
    margin-bottom: 20px;
    opacity: 0.85;
    user-select: none;
  }

  /* Editorial Italic Quote Text (Playfair Display) */
  .quote-editorial-text {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(20px, 2.3vw, 27px);
    line-height: 1.62;
    color: #1e2229;
    margin: 0 0 26px;
    transition: opacity 0.2s ease-in-out;
  }

  .quote-drop-cap {
    font-size: 1.15em;
    font-weight: 700;
    color: var(--color-primary, #ff501a);
  }

  /* Author Signature Meta */
  .quote-author-signature {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid #edf0f5;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-display-name {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 17px;
    font-weight: 800;
    color: var(--color-heading, #17181c);
  }

  .author-display-role {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-primary, #ff501a);
  }

  /* Hostamble Platform Verified Badge */
  .author-badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.08);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.22);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary, #ff501a);
    font-family: var(--font-primary, 'Urbanist', sans-serif);
  }

  .author-badge-verified i {
    font-size: 15px;
    color: var(--color-primary, #ff501a);
  }

  /* Slider Navigation Dots & Arrows */
  .reviews-slider-nav {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }

  .nav-arrow-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #e2e7f0;
    background: #ffffff;
    color: #4b5466;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 20px;
    transition: all 0.2s ease;
  }

  .nav-arrow-btn:hover {
    border-color: var(--color-primary, #ff501a);
    color: var(--color-primary, #ff501a);
    background: #fff8f5;
    box-shadow: 0 4px 14px rgba(var(--color-primary-rgb, 210, 116, 29), 0.2);
  }

  .nav-dots-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d3dbe6;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .nav-dot.is-active {
    width: 24px;
    border-radius: 999px;
    background: var(--color-primary, #ff501a);
  }

  /* Trust Reassurance Bottom Bar */
  .reviews-trust-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 42px;
    padding-top: 24px;
    border-top: 1px dashed #e8edf5;
    color: #647083;
    font-size: 13.5px;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .trust-pill i {
    font-size: 16px;
  }

  .trust-divider {
    color: #cbd5e1;
    font-weight: bold;
  }

  /* Responsive Adjustments */
  @media only screen and (max-width: 991px) {
    .reviews-showcase-card {
      padding: 36px 28px 36px;
    }

    .reviews-grid-wrap {
      grid-template-columns: 1fr;
      row-gap: 36px;
    }

    .reviews-arc-column {
      min-height: auto;
    }

    .arc-interactive-container {
      height: auto;
    }

    .arc-path-svg {
      display: none; /* Hide SVG arc on mobile, display accessible row */
    }

    .arc-reviewers-list {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: flex-start;
    }

    .arc-reviewer-node {
      position: static;
      padding: 6px;
    }

    .quote-display-card {
      padding-left: 0;
    }

    .quote-editorial-text {
      font-size: 20px;
    }

    .reviews-trust-bar {
      flex-direction: column;
