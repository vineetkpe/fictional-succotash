---

<section class="aceorbit-testimonial ace-section-gap position-relative bg-image" id="reviews" aria-labelledby="reviews-heading">
  <!-- Subtle ambient decorative glow -->
  <div class="reviews-ambient-orb" aria-hidden="true"></div>

  <div class="container aceorbit-animated-shape position-relative">
    
    <!-- Standard Hostamble Centered Section Header -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 col-12">
        <div class="section-title text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <span class="pre-title">TESTIMONIALS</span>
          <h2 id="reviews-heading" class="title">Our Customers Reviews</h2>
          <p class="description mt-2">
            Real feedback from verified website owners, developers, and businesses hosted on Hostamble.
          </p>
        </div>
      </div>
    </div>

    <!-- Elevated White Card Showcase (Curved Arc + Editorial Quote) -->
    <div class="reviews-showcase-card position-relative" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
      
      <!-- Hostamble Warm Orange Decorative Corner Accents -->
      <div class="corner-accent corner-top-left" aria-hidden="true"></div>
      <div class="corner-accent corner-bottom-left" aria-hidden="true"></div>

      <!-- Main Two-Column Grid -->
      <div class="reviews-grid-wrap">
        
        <!-- LEFT COLUMN: Curved Arc with Dynamic Reviewer Profiles -->
        <div class="reviews-arc-column">
          <div class="arc-interactive-container">
            
            <!-- SVG Arc Line -->
            <svg class="arc-path-svg" viewBox="0 0 160 380" fill="none" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 36,20 C 130,115 130,265 36,360" stroke="#e8edf5" stroke-width="2.5" stroke-linecap="round" />
            </svg>

            <!-- Dynamic Arc Reviewer Slots (Top, Center/Active, Bottom) -->
            <div class="arc-reviewers-list" role="tablist" aria-label="Customer Reviewers">
              
              <!-- SLOT 0: Top Node (Previous) -->
              <button
                type="button"
                class="arc-reviewer-node node-pos-0"
                id="arcNodeTop"
                data-slot="top"
                role="tab"
                aria-selected="false"
                aria-controls="activeReviewPanel"
                title={`View ${testimonials[0].name}'s review`}
              >
                <div class="arc-avatar-wrap">
                  <img src={testimonials[0].avatar} alt={testimonials[0].name} class="arc-avatar-img" id="arcAvatarTop" loading="lazy" />
                </div>
                <div class="arc-reviewer-meta">
                  <h4 class="arc-reviewer-name" id="arcNameTop">{testimonials[0].name}</h4>
                  <span class="arc-reviewer-role" id="arcRoleTop">{testimonials[0].designation}</span>
                  <div class="arc-rating-row">
                    <span class="arc-star-icon" id="arcStarTop">★ {testimonials[0].rating}</span>
                    <span class="arc-date-text" id="arcDateTop">on {testimonials[0].date}</span>
                  </div>
                </div>
              </button>

              <!-- SLOT 1: Center Node (Active Apex) -->
              <button
                type="button"
                class="arc-reviewer-node node-pos-1 is-active"
                id="arcNodeCenter"
                data-slot="center"
                role="tab"
                aria-selected="true"
                aria-controls="activeReviewPanel"
                title={`Active: ${testimonials[1].name}'s review`}
              >
                <div class="arc-avatar-wrap">
                  <img src={testimonials[1].avatar} alt={testimonials[1].name} class="arc-avatar-img" id="arcAvatarCenter" loading="lazy" />
                </div>
                <div class="arc-reviewer-meta">
                  <h4 class="arc-reviewer-name" id="arcNameCenter">{testimonials[1].name}</h4>
                  <span class="arc-reviewer-role" id="arcRoleCenter">{testimonials[1].designation}</span>
                  <div class="arc-rating-row">
                    <span class="arc-star-icon" id="arcStarCenter">★ {testimonials[1].rating}</span>
                    <span class="arc-date-text" id="arcDateCenter">on {testimonials[1].date}</span>
                  </div>
                </div>
              </button>

              <!-- SLOT 2: Bottom Node (Next) -->
              <button
                type="button"
                class="arc-reviewer-node node-pos-2"
                id="arcNodeBottom"
                data-slot="bottom"
                role="tab"
                aria-selected="false"
                aria-controls="activeReviewPanel"
                title={`View ${testimonials[2].name}'s review`}
              >
                <div class="arc-avatar-wrap">
                  <img src={testimonials[2].avatar} alt={testimonials[2].name} class="arc-avatar-img" id="arcAvatarBottom" loading="lazy" />
                </div>
                <div class="arc-reviewer-meta">
                  <h4 class="arc-reviewer-name" id="arcNameBottom">{testimonials[2].name}</h4>
                  <span class="arc-reviewer-role" id="arcRoleBottom">{testimonials[2].designation}</span>
                  <div class="arc-rating-row">
                    <span class="arc-star-icon" id="arcStarBottom">★ {testimonials[2].rating}</span>
                    <span class="arc-date-text" id="arcDateBottom">on {testimonials[2].date}</span>
                  </div>
                </div>
              </button>

            </div>

          </div>

          <!-- Mobile Reviewer Pill Selector (Visible only on tablets & mobile) -->
          <div class="mobile-reviewers-strip" aria-label="Quick Reviewer Switcher">
            {testimonials.map((item, idx) => (
              <button
                type="button"
                class={`mobile-reviewer-chip ${idx === 1 ? 'is-active' : ''}`}
                data-chip-index={idx}
                title={`Read review by ${item.name}`}
              >
                <img src={item.avatar} alt={item.name} class="mobile-chip-avatar" loading="lazy" />
                <span class="mobile-chip-name">{item.name.split(" ")[0]}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- RIGHT COLUMN: Large Editorial Quotation Mark & Quote Text -->
        <div class="reviews-quote-column" id="activeReviewPanel" role="tabpanel">
          <div class="quote-display-card">
            
            <!-- Giant Hostamble Opening Quotation Mark -->
            <span class="giant-quote-mark" aria-hidden="true">&ldquo;</span>

            <!-- Active Review Text -->
            <p class="quote-editorial-text" id="activeQuoteText">
              <span class="quote-drop-cap" id="activeDropCap">{testimonials[1].quote.charAt(0)}</span><span id="activeRemainingText">{testimonials[1].quote.slice(1)}</span>
            </p>

            <!-- Active Reviewer Signature Meta -->
            <div class="quote-author-signature">
              <div class="author-details">
                <span class="author-display-name" id="activeAuthorName">— {testimonials[1].name}</span>
                <span class="author-display-role" id="activeAuthorRole">{testimonials[1].designation}</span>
              </div>
              <div class="author-badge-verified">
                <i class="ri-shield-check-fill"></i>
                <span id="activeAuthorPlatform">Verified {testimonials[1].platform} Review</span>
              </div>
            </div>

            <!-- Slider Navigation Dots & Arrows -->
            <div class="reviews-slider-nav">
              <button type="button" class="nav-arrow-btn prev-btn" id="prevReviewBtn" aria-label="Previous review">
                <i class="ri-arrow-left-s-line"></i>
              </button>
              <div class="nav-dots-wrap" id="navDotsWrap">
                {testimonials.map((_, i) => (
                  <span class={`nav-dot ${i === 1 ? 'is-active' : ''}`} data-dot-index={i} role="button" aria-label={`Go to review ${i + 1}`}></span>
                ))}
              </div>
              <button type="button" class="nav-arrow-btn next-btn" id="nextReviewBtn" aria-label="Next review">
                <i class="ri-arrow-right-s-line"></i>
              </button>
            </div>

          </div>
        </div>

      </div>

      <!-- Trust Reassurance Bottom Bar (Hostamble Brand Standard) -->
      <div class="reviews-trust-bar">
        <div class="trust-pill">
          <i class="ri-star-fill text-warning"></i>
          <span>Rated <strong>4.8 / 5.0</strong> on <a href="https://www.trustpilot.com/review/hostamble.com" target="_blank" rel="noopener noreferrer" class="trust-link">Trustpilot</a> &amp; <a href="https://hostadvice.com/hosting-company/hostamble-reviews/" target="_blank" rel="noopener noreferrer" class="trust-link">HostAdvice</a></span>
        </div>
        <div class="trust-divider" aria-hidden="true">·</div>
        <div class="trust-pill">
          <i class="ri-whatsapp-line text-success"></i>
          <span>Direct WhatsApp Customer Support</span>
        </div>
        <div class="trust-divider" aria-hidden="true">·</div>
        <div class="trust-pill">
          <i class="ri-checkbox-circle-fill text-success"></i>
          <span>100% Genuine User Reviews</span>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Client-side Interactive Arc Reviewer Script -->
<script is:inline define:vars={{ testimonials }}>
  document.addEventListener("DOMContentLoaded", function () {
    const totalReviews = testimonials.length;
    let activeIndex = 1; // Default: Diana Johnston
    let autoRotateTimer = null;

    // Elements
    const quoteTextElem = document.getElementById("activeQuoteText");
    const dropCapElem = document.getElementById("activeDropCap");
    const remTextElem = document.getElementById("activeRemainingText");
    const authorNameElem = document.getElementById("activeAuthorName");
    const authorRoleElem = document.getElementById("activeAuthorRole");
    const platformElem = document.getElementById("activeAuthorPlatform");
    const dots = document.querySelectorAll(".nav-dot");
    const mobileChips = document.querySelectorAll(".mobile-reviewer-chip");
    const prevBtn = document.getElementById("prevReviewBtn");
    const nextBtn = document.getElementById("nextReviewBtn");
    const cardContainer = document.querySelector(".reviews-showcase-card");

    // Arc Slot Elements
    const arcNodeTop = document.getElementById("arcNodeTop");
    const arcAvatarTop = document.getElementById("arcAvatarTop");
    const arcNameTop = document.getElementById("arcNameTop");
    const arcRoleTop = document.getElementById("arcRoleTop");
    const arcStarTop = document.getElementById("arcStarTop");
    const arcDateTop = document.getElementById("arcDateTop");

    const arcNodeCenter = document.getElementById("arcNodeCenter");
    const arcAvatarCenter = document.getElementById("arcAvatarCenter");
    const arcNameCenter = document.getElementById("arcNameCenter");
    const arcRoleCenter = document.getElementById("arcRoleCenter");
    const arcStarCenter = document.getElementById("arcStarCenter");
    const arcDateCenter = document.getElementById("arcDateCenter");

    const arcNodeBottom = document.getElementById("arcNodeBottom");
    const arcAvatarBottom = document.getElementById("arcAvatarBottom");
    const arcNameBottom = document.getElementById("arcNameBottom");
    const arcRoleBottom = document.getElementById("arcRoleBottom");
    const arcStarBottom = document.getElementById("arcStarBottom");
    const arcDateBottom = document.getElementById("arcDateBottom");

    function updateSlot(data, avatarEl, nameEl, roleEl, starEl, dateEl) {
      if (!data) return;
      if (avatarEl) {
        avatarEl.src = data.avatar;
        avatarEl.alt = data.name;
      }
      if (nameEl) nameEl.textContent = data.name;
      if (roleEl) roleEl.textContent = data.designation;
      if (starEl) starEl.textContent = "★ " + data.rating;
      if (dateEl) dateEl.textContent = "on " + data.date;
    }

    function setActiveReview(index) {
      if (index < 0) index = totalReviews - 1;
      if (index >= totalReviews) index = 0;
      activeIndex = index;

      const prevIndex = (activeIndex - 1 + totalReviews) % totalReviews;
      const nextIndex = (activeIndex + 1) % totalReviews;

      const activeData = testimonials[activeIndex];
      const prevData = testimonials[prevIndex];
      const nextData = testimonials[nextIndex];

      // Update Arc Slots with smooth content transition
      updateSlot(prevData, arcAvatarTop, arcNameTop, arcRoleTop, arcStarTop, arcDateTop);
      updateSlot(activeData, arcAvatarCenter, arcNameCenter, arcRoleCenter, arcStarCenter, arcDateCenter);
      updateSlot(nextData, arcAvatarBottom, arcNameBottom, arcRoleBottom, arcStarBottom, arcDateBottom);

      // Store target indexes on slot elements
      if (arcNodeTop) arcNodeTop.setAttribute("data-target-index", prevIndex);
      if (arcNodeCenter) arcNodeCenter.setAttribute("data-target-index", activeIndex);
      if (arcNodeBottom) arcNodeBottom.setAttribute("data-target-index", nextIndex);

      // Update Navigation Dots
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === activeIndex);
      });

      // Update Mobile Chips
      mobileChips.forEach((chip, i) => {
        chip.classList.toggle("is-active", i === activeIndex);
      });

      // Update Quote Content with gentle crossfade
      if (quoteTextElem) {
        quoteTextElem.style.opacity = "0";
        setTimeout(() => {
          if (dropCapElem) dropCapElem.textContent = activeData.quote.charAt(0);
          if (remTextElem) remTextElem.textContent = activeData.quote.slice(1);
          if (authorNameElem) authorNameElem.textContent = "— " + activeData.name;
          if (authorRoleElem) authorRoleElem.textContent = activeData.designation;
          if (platformElem) platformElem.textContent = "Verified " + activeData.platform + " Review";
          quoteTextElem.style.opacity = "1";
        }, 150);
      }
    }

    // Top Slot Click -> Go to Previous Review
    if (arcNodeTop) {
      arcNodeTop.addEventListener("click", function () {
        const target = parseInt(this.getAttribute("data-target-index"), 10);
        setActiveReview(isNaN(target) ? activeIndex - 1 : target);
        restartAutoRotate();
      });
    }

    // Bottom Slot Click -> Go to Next Review
    if (arcNodeBottom) {
      arcNodeBottom.addEventListener("click", function () {
        const target = parseInt(this.getAttribute("data-target-index"), 10);
        setActiveReview(isNaN(target) ? activeIndex + 1 : target);
        restartAutoRotate();
      });
    }

    // Arrow navigation
    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setActiveReview(activeIndex - 1);
        restartAutoRotate();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setActiveReview(activeIndex + 1);
        restartAutoRotate();
      });
    }

    // Dot click
    dots.forEach(dot => {
      dot.addEventListener("click", function () {
        const idx = parseInt(this.getAttribute("data-dot-index"), 10);
        setActiveReview(idx);
        restartAutoRotate();
      });
    });

    // Mobile Chip Click
    mobileChips.forEach(chip => {
      chip.addEventListener("click", function () {
        const idx = parseInt(this.getAttribute("data-chip-index"), 10);
        setActiveReview(idx);
        restartAutoRotate();
      });
    });

    // Pause auto-rotation on mouse hover over the entire card
    if (cardContainer) {
      cardContainer.addEventListener("mouseenter", function () {
        clearInterval(autoRotateTimer);
      });
      cardContainer.addEventListener("mouseleave", function () {
        restartAutoRotate();
      });
    }

    // Auto rotate every 3.5 seconds (reduced time for lively responsive navigation)
    function startAutoRotate() {
      clearInterval(autoRotateTimer);
      autoRotateTimer = setInterval(() => {
        setActiveReview(activeIndex + 1);
      }, 3500);
    }

    function restartAutoRotate() {
      startAutoRotate();
    }

    // Initialize with Diana Johnston active
    setActiveReview(1);
    startAutoRotate();
  });
</script>

<style>
  /* =========================================================
     Hostamble Curved Arc Customer Reviews Block
     - Unified with Hostamble Website Design System
     - Sourced from Trustpilot & HostAdvice Verified Reviews
     ========================================================= */

  .aceorbit-testimonial {
    background-image: url(/assets/images/testimonial.jpg);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    position: relative;
    padding: 100px 0 110px;
    overflow: hidden;
  }

  /* Hostamble Warm Radial Ambient Glow */
  .reviews-ambient-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--color-primary-rgb, 210, 116, 29), 0.08) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Standard Hostamble Section Title Typography */
  .section-title .pre-title {
    font-weight: 800;
    font-size: 15px;
    line-height: 24px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #ff501a);
    display: inline-block;
    margin-bottom: 10px;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
  }

  .section-title .title {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-weight: 800;
    font-size: clamp(30px, 3.5vw, 42px);
    line-height: 1.25;
    color: var(--color-heading, #1d2026);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .section-title .description {
    font-family: var(--font-secondary, 'Plus Jakarta Sans', sans-serif);
    font-size: 16px;
    line-height: 26px;
    color: #647083;
    max-width: 620px;
    margin: 12px auto 0;
  }

  /* Elevated White Showcase Card */
  .reviews-showcase-card {
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 50px -12px rgba(18, 22, 33, 0.08), 0 4px 16px rgba(0, 0, 0, 0.02);
    border: 1px solid #edf0f6;
    padding: 56px 64px 40px;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  /* Hostamble Warm Orange Decorative Corner Flourish */
  .corner-accent {
    position: absolute;
    width: 85px;
    height: 85px;
    pointer-events: none;
    z-index: 1;
  }

  .corner-top-left {
    top: 0;
    left: 0;
    background: radial-gradient(circle at 0% 0%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.18) 0%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.05) 45%, transparent 72%);
    border-top-left-radius: 24px;
  }

  .corner-bottom-left {
    bottom: 0;
    left: 0;
    background: radial-gradient(circle at 0% 100%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.18) 0%, rgba(var(--color-primary-rgb, 210, 116, 29), 0.05) 45%, transparent 72%);
    border-bottom-left-radius: 24px;
  }

  /* Two-Column Grid */
  .reviews-grid-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.45fr);
    column-gap: clamp(40px, 5.5vw, 80px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* =========================================================
     LEFT SIDE: Curved Arc with Reviewer Profiles
     ========================================================= */

  .reviews-arc-column {
    position: relative;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .arc-interactive-container {
    position: relative;
    width: 100%;
    height: 380px;
  }

  /* SVG Curved Arc Line */
  .arc-path-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 140px;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Reviewer Profile Nodes on the Arc */
  .arc-reviewers-list {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .arc-reviewer-node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 16px;
