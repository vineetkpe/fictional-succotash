---
// Hostamble Native Theme "Why Choose Hostamble / Our Best Features" Flow
// Zero heavy "blockness" - Open, airy, theme-matched layout with creative organic moving shape badges

interface FeatureNode {
  id: string;
  step: string;
  title: string;
  description: string;
  tag: string;
  icon: string;
  morphClass: string;
  accent: "primary" | "secondary";
}

const features: FeatureNode[] = [
  {
    id: "cpanel",
    step: "01",
    title: "Control Panel",
    description: "Intuitive cPanel & DirectAdmin interface for effortless website, email, and database management.",
    tag: "cPanel & DirectAdmin",
    icon: "ri-dashboard-3-line",
    morphClass: "organic-shape-1",
    accent: "primary"
  },
  {
    id: "ssl",
    step: "02",
    title: "Free SSL Certificate",
    description: "Automated Let's Encrypt SSL security with lifetime auto-renewal on all domains and subdomains.",
    tag: "Lifetime Free HTTPS",
    icon: "ri-shield-keyhole-line",
    morphClass: "organic-shape-2",
    accent: "secondary"
  },
  {
    id: "email",
    step: "03",
    title: "Business Email",
    description: "Professional @yourdomain mailboxes equipped with advanced spam protection and Webmail access.",
    tag: "Spam-Protected Mail",
    icon: "ri-mail-send-line",
    morphClass: "organic-shape-3",
    accent: "primary"
  },
  {
    id: "litespeed",
    step: "04",
    title: "LiteSpeed Server",
    description: "Next-gen HTTP/3 web server with built-in LSCache delivering up to 10x faster page loading speeds.",
    tag: "10x Faster Speeds",
    icon: "ri-flashlight-line",
    morphClass: "organic-shape-4",
    accent: "secondary"
  },
  {
    id: "backups",
    step: "05",
    title: "Last 3 Days Backups",
    description: "Continuous automated daily snapshots with instant 1-click restore points for complete peace of mind.",
    tag: "Instant 1-Click Restore",
    icon: "ri-history-line",
    morphClass: "organic-shape-5",
    accent: "primary"
  },
  {
    id: "ssd",
    step: "06",
    title: "Pure NVMe SSD",
    description: "Enterprise RAID-10 NVMe solid-state storage offering blazing read and write input/output speeds.",
    tag: "RAID-10 NVMe Storage",
    icon: "ri-hard-drive-2-line",
    morphClass: "organic-shape-6",
    accent: "secondary"
  },
  {
    id: "uptime",
    step: "07",
    title: "99.9% Uptime SLA",
    description: "High-availability Tier-4 datacenter network continuously monitored to keep your site reliably online.",
    tag: "Tier-4 Infrastructure",
    icon: "ri-server-line",
    morphClass: "organic-shape-7",
    accent: "primary"
  },
  {
    id: "installer",
    step: "08",
    title: "1-Click App Installer",
    description: "Deploy WordPress, WooCommerce, Joomla, and over 400+ web applications in just one single click.",
    tag: "400+ One-Click Apps",
    icon: "ri-apps-2-line",
    morphClass: "organic-shape-8",
    accent: "secondary"
  }
];

// Features list (all 8 features in a clean, unified grid)
---

<section id="features" class="features-theme-section" aria-label="Why Choose Hostamble - Our Best Features">
  <!-- Soft Ambient Theme Glow Orbs -->
  <div class="features-ambient-glow glow-left" aria-hidden="true"></div>
  <div class="features-ambient-glow glow-right" aria-hidden="true"></div>

  <div class="container position-relative" style="z-index: 2;">
    <!-- Section Title (Authentic Hostamble Theme Hierarchy) -->
    <div class="section-title text-center" data-sal="slide-up" data-sal-duration="800">
      <span class="pre-title">WHY CHOOSE HOSTAMBLE</span>
      <h2 class="title">Our Best Features</h2>
      <p class="description">
        Powerful hosting features designed to make your website fast, secure and reliable.
      </p>
    </div>

    <!-- Features Flow (Clean & Open - No Connecting Line, Zero Blockness) -->
    <div class="row g-4 g-lg-5 justify-content-center mt-2">
      {features.map((item, idx) => (
        <div 
          class="col-xl-3 col-lg-3 col-md-6 col-12"
          data-sal="slide-up"
          data-sal-delay={(idx % 4) * 100 + 100}
          data-sal-duration="750"
        >
          <div class="feature-item fitem" style={`--item-idx: ${idx};`}>
            <!-- Creative Organic Shape Badge (Non-Square, Morphing on Hover) -->
            <div class="feature-badge-wrap">
              <div class={`organic-shape-badge ${item.morphClass} accent-${item.accent}`}>
                <i class={item.icon} aria-hidden="true"></i>
              </div>
              <span class="badge-step-pill">#{item.step}</span>
            </div>

            <!-- Open Clean Content (No Box Walls) -->
            <h5 class="feature-title">{item.title}</h5>
            <p class="feature-desc">{item.description}</p>
            
            <div class="feature-tag-pill">
              <i class="ri-checkbox-circle-fill" aria-hidden="true"></i>
              <span>{item.tag}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-theme-section {
    position: relative;
    background: linear-gradient(180deg, var(--color-secondary-alt, #FFF6F4) 0%, #FFFFFF 100%);
    padding: 95px 0 90px 0;
    font-family: var(--font-primary, "Urbanist", sans-serif);
    color: var(--color-heading, #202133);
    overflow: hidden;
  }

  /* Soft Ambient Theme Glow Orbs */
  .features-ambient-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
  .glow-left {
    left: -120px;
    top: -80px;
    width: 300px;
    height: 300px;
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.08);
    filter: blur(85px);
  }
  .glow-right {
    right: -140px;
    bottom: -100px;
    width: 320px;
    height: 320px;
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.07);
    filter: blur(95px);
  }

  /* Section Title Hierarchy */
  .section-title .pre-title {
    font-weight: 800;
    font-size: 15px;
    line-height: 26px;
    color: var(--color-primary, #ff501a);
    margin-bottom: 6px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: block;
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .section-title .title {
    font-size: 40px;
    font-weight: 800;
    color: var(--color-heading, #202133);
    margin: 8px 0 14px 0;
    line-height: 1.25;
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .section-title .description {
    font-size: 16.5px;
    color: var(--color-body, #6F6B80);
    max-width: 680px;
    margin: 0 auto 40px auto;
    line-height: 1.65;
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }


  /* Open Feature Item (NO Card Box, NO Heavy Border) */
  .feature-item {
    text-align: center;
    padding: 10px 14px;
    position: relative;
    z-index: 2;
    cursor: pointer;
  }

  /* Badge Wrap with Floating Step Pill */
  .feature-badge-wrap {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto 20px auto;
  }

  /* Creative Organic Shape Badge (Non-Square, Morphing on Hover) */
  .organic-shape-badge {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                background 0.35s ease,
                color 0.35s ease,
                box-shadow 0.35s ease,
                border-radius 0.5s ease;
  }

  /* 8 Distinct Asymmetric Non-Square Organic Shapes */
  .organic-shape-1 {
    border-radius: 40px 22px 36px 20px / 22px 36px 20px 40px;
  }
  .organic-shape-2 {
    border-radius: 22px 40px 20px 36px / 38px 20px 38px 20px;
  }
  .organic-shape-3 {
    border-radius: 36px 20px 40px 24px / 24px 38px 22px 38px;
  }
  .organic-shape-4 {
    border-radius: 20px 38px 24px 40px / 40px 22px 38px 22px;
  }
  .organic-shape-5 {
    border-radius: 38px 22px 36px 22px / 22px 38px 22px 38px;
  }
  .organic-shape-6 {
    border-radius: 22px 38px 22px 38px / 38px 22px 38px 22px;
  }
  .organic-shape-7 {
    border-radius: 40px 20px 38px 24px / 22px 38px 20px 40px;
  }
  .organic-shape-8 {
    border-radius: 22px 38px 22px 40px / 38px 22px 40px 20px;
  }

  /* Primary Accent Badge */
  .accent-primary {
    background: #ffffff;
    border: 2px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.28);
    color: var(--color-primary, #ff501a);
    box-shadow: 0 4px 16px rgba(var(--color-primary-rgb, 210, 116, 29), 0.08);
  }

  /* Secondary Accent Badge */
  .accent-secondary {
    background: #ffffff;
    border: 2px solid rgba(var(--color-secondary-rgb, 32, 33, 51), 0.22);
    color: var(--color-secondary, #202133);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  /* Floating Step Badge Pill */
  .badge-step-pill {
    position: absolute;
    top: -4px;
    right: -6px;
    font-size: 11.5px;
    font-weight: 800;
    font-family: var(--font-primary, "Urbanist", sans-serif);
    color: var(--color-primary, #ff501a);
    background: var(--color-secondary-alt, #FFF6F4);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.25);
    border-radius: 10px;
    padding: 1px 7px;
    line-height: 1.4;
    transition: all 0.3s ease;
    z-index: 3;
  }

  /* Content Typography (Open & Clean) */
  .feature-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    margin: 0 0 8px 0;
    line-height: 1.35;
    font-family: var(--font-primary, "Urbanist", sans-serif);
    transition: color 0.25s ease;
  }

  .feature-desc {
    font-size: 13.8px;
    font-weight: 400;
    color: var(--color-body, #6F6B80);
    line-height: 1.55;
    margin: 0 auto 12px auto;
    max-width: 230px;
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .feature-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary, #ff501a);
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.08);
    padding: 3px 10px;
    border-radius: 12px;
    font-family: var(--font-primary, "Urbanist", sans-serif);
    transition: all 0.25s ease;
  }

  .feature-tag-pill i {
    font-size: 13.5px;
  }

  /* ========================================================
     HOVER REACTION: STRICTLY THE SELECTED HOVERED ITEM MOVES
     ======================================================== */

  .feature-item:hover .organic-shape-badge {
    transform: translateY(-10px) scale(1.12);
    box-shadow: 0 14px 30px rgba(var(--color-primary-rgb, 210, 116, 29), 0.32);
  }

  .feature-item:hover .accent-primary {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
    border-color: var(--color-primary, #ff501a);
  }

  .feature-item:hover .accent-secondary {
    background: var(--color-secondary, #202133);
    color: #ffffff;
    border-color: var(--color-secondary, #202133);
    box-shadow: 0 14px 30px rgba(var(--color-secondary-rgb, 32, 33, 51), 0.28);
  }

  /* Smooth shape morphing strictly on hovered badge */
  .feature-item:hover .organic-shape-1 {
    border-radius: 24px 38px 22px 38px / 38px 24px 38px 24px;
  }
  .feature-item:hover .organic-shape-2 {
    border-radius: 38px 22px 36px 22px / 22px 38px 22px 38px;
  }
  .feature-item:hover .organic-shape-3 {
    border-radius: 22px 38px 22px 40px / 40px 22px 38px 22px;
  }
  .feature-item:hover .organic-shape-4 {
    border-radius: 38px 22px 40px 22px / 22px 40px 22px 38px;
  }
  .feature-item:hover .organic-shape-5 {
    border-radius: 22px 40px 22px 38px / 38px 22px 40px 22px;
  }
  .feature-item:hover .organic-shape-6 {
    border-radius: 40px 22px 38px 22px / 22px 38px 22px 40px;
  }
  .feature-item:hover .organic-shape-7 {
    border-radius: 22px 38px 22px 40px / 38px 22px 40px 22px;
  }
  .feature-item:hover .organic-shape-8 {
    border-radius: 38px 22px 38px 22px / 22px 40px 22px 38px;
  }

  .feature-item:hover .badge-step-pill {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
    border-color: var(--color-primary, #ff501a);
    transform: translateY(-10px);
  }

  .feature-item:hover .feature-title {
    color: var(--color-primary, #ff501a);
  }

  .feature-item:hover .feature-tag-pill {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
  }
  .feature-item:hover .feature-tag-pill i {
    color: #ffffff;
  }

  /* Entrance Animation for .fitem via features.ts */
  .fitem {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.165, 0.84, 0.44, 1),
                transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .fitem.fitem-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive Adjustments */
  @media (max-width: 991px) {
    .section-title .title {
      font-size: 34px;
    }
    .features-theme-section {
      padding: 75px 0 70px 0;
    }
    .feature-desc {
      max-width: 280px;
    }
  }

  @media (max-width: 575px) {
    .section-title .title {
      font-size: 28px;
    }
    .features-theme-section {
      padding: 60px 0 55px 0;
    }
  }
</style>
