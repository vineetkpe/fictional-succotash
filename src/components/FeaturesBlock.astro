</style>

<script>
  // ONLY the selected/hovered block moves - all other blocks remain still
  const pods = document.querySelectorAll<HTMLElement>('.feature-organic-pod');

  pods.forEach((pod) => {
    let isHovering = false;

    pod.addEventListener('mouseenter', () => {
      isHovering = true;
      pod.style.transition = 'transform 0.12s ease-out, box-shadow 0.3s ease, border-color 0.3s ease, border-radius 0.4s ease';
    });

    pod.addEventListener('mousemove', (e) => {
      if (!isHovering) return;
      const rect = pod.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // Magnetic 3D tilt & smooth translation applied STRICTLY to this single hovered pod
      const rotateX = ((y - centerY) / centerY) * -8;
      const rotateY = ((x - centerX) / centerX) * 8;
      const moveX = ((x - centerX) / centerX) * 7;
      const moveY = ((y - centerY) / centerY) * 7 - 12; // lift up by 12px

      pod.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translate3d(${moveX}px, ${moveY}px, 0) scale(1.035)`;
    });

    pod.addEventListener('mouseleave', () => {
      isHovering = false;
      pod.style.transition = 'transform 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.35s ease, border-color 0.35s ease, border-radius 0.6s ease';
      pod.style.transform = '';
    });
  });
</script>
