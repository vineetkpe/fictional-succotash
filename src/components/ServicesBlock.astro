---
// Hostamble Native Theme Services Showcase Block
// Displays the 5 core services: Shared Hosting, WordPress Hosting, Domain Search, SSL Certificates, and Business Email
---

<section class="hostamble-services-section ace-section-gap position-relative" id="services">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div 
          class="section-title text-center mb-5"
          data-sal="slide-up"
          data-sal-delay="150"
          data-sal-duration="800"
        >
          <span class="pre-title">Our Services</span>
          <h3 class="title">Explore Our Web &amp; Hosting Solutions</h3>
          <p class="service-subtitle">
            Reliable, lightning-fast infrastructure and essential web tools engineered to help your business succeed online.
          </p>
        </div>
      </div>
    </div>

    <!-- 5 Core Services Grid -->
    <div class="services-grid">

      <!-- 1. Shared Hosting -->
      <div class="service-box" data-sal="slide-up" data-sal-delay="100" data-sal-duration="700">
        <div class="service-box-header">
          <div class="service-icon-box">
            <i class="ri-server-line" aria-hidden="true"></i>
          </div>
          <span class="service-badge badge-popular">Popular</span>
        </div>
        
        <h4 class="service-title">Shared Hosting</h4>
        <p class="service-desc">
          Supercharged cPanel hosting powered by LiteSpeed and pure NVMe SSDs for instant page loads.
        </p>

        <div class="service-divider" aria-hidden="true"></div>

        <ul class="service-features">
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>10x LiteSpeed Web Server</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Free cPanel &amp; Auto SSL</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>99.9% Uptime Guarantee</span>
          </li>
        </ul>

        <div class="service-price-tag">
          <span class="price-label">Starting at</span>
          <span class="price-value" data-inr="₹39/mo" data-usd="$0.47/mo">₹39/mo</span>
        </div>

        <a href="/shared-hosting" class="service-action-btn">
          <span>Explore Plans</span>
          <i class="ri-arrow-right-line" aria-hidden="true"></i>
        </a>
      </div>

      <!-- 2. WordPress Hosting -->
      <div class="service-box" data-sal="slide-up" data-sal-delay="150" data-sal-duration="700">
        <div class="service-box-header">
          <div class="service-icon-box">
            <i class="ri-wordpress-fill" aria-hidden="true"></i>
          </div>
          <span class="service-badge badge-turbo">Turbo Speed</span>
        </div>
        
        <h4 class="service-title">WordPress Hosting</h4>
        <p class="service-desc">
          Tuned specifically for WordPress with built-in LSCache, 1-click staging, and automated updates.
        </p>

        <div class="service-divider" aria-hidden="true"></div>

        <ul class="service-features">
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>1-Click WP Deployment</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>LiteSpeed Cache Engine</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Automated Daily Backups</span>
          </li>
        </ul>

        <div class="service-price-tag">
          <span class="price-label">Starting at</span>
          <span class="price-value" data-inr="₹99/mo" data-usd="$1.19/mo">₹99/mo</span>
        </div>

        <a href="/wordpress-hosting" class="service-action-btn">
          <span>Explore Plans</span>
          <i class="ri-arrow-right-line" aria-hidden="true"></i>
        </a>
      </div>

      <!-- 3. Domain Search -->
      <div class="service-box" data-sal="slide-up" data-sal-delay="200" data-sal-duration="700">
        <div class="service-box-header">
          <div class="service-icon-box">
            <i class="ri-global-line" aria-hidden="true"></i>
          </div>
          <span class="service-badge badge-instant">Instant Setup</span>
        </div>
        
        <h4 class="service-title">Domain Names</h4>
        <p class="service-desc">
          Claim your brand identity with 500+ extensions (.com, .in, .net) with free lifetime DNS tools.
        </p>

        <div class="service-divider" aria-hidden="true"></div>

        <ul class="service-features">
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Free DNS Management</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Domain Theft Protection</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Instant Setup &amp; Forwarding</span>
          </li>
        </ul>

        <div class="service-price-tag">
          <span class="price-label">Starting at</span>
          <span class="price-value" data-inr="₹199/yr" data-usd="$2.39/yr">₹199/yr</span>
        </div>

        <a href="/domain-search" class="service-action-btn">
          <span>Find Domain</span>
          <i class="ri-arrow-right-line" aria-hidden="true"></i>
        </a>
      </div>

      <!-- 4. SSL Certificates -->
      <div class="service-box" data-sal="slide-up" data-sal-delay="250" data-sal-duration="700">
        <div class="service-box-header">
          <div class="service-icon-box">
            <i class="ri-shield-check-line" aria-hidden="true"></i>
          </div>
          <span class="service-badge badge-security">Max Security</span>
        </div>
        
        <h4 class="service-title">SSL Certificates</h4>
        <p class="service-desc">
          Protect visitor transactions, encrypt customer data, and display the trusted browser padlock.
        </p>

        <div class="service-divider" aria-hidden="true"></div>

        <ul class="service-features">
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>256-Bit TLS Encryption</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Trusted Browser Padlock</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Site Seal &amp; SEO Boost</span>
          </li>
        </ul>

        <div class="service-price-tag">
          <span class="price-label">Starting at</span>
          <span class="price-value" data-inr="₹499/yr" data-usd="$5.99/yr">₹499/yr</span>
        </div>

        <a href="/ssl-certificates" class="service-action-btn">
          <span>Get Protected</span>
          <i class="ri-arrow-right-line" aria-hidden="true"></i>
        </a>
      </div>

      <!-- 5. Business Email -->
      <div class="service-box" data-sal="slide-up" data-sal-delay="300" data-sal-duration="700">
        <div class="service-box-header">
          <div class="service-icon-box">
            <i class="ri-mail-star-line" aria-hidden="true"></i>
          </div>
          <span class="service-badge badge-identity">Pro Identity</span>
        </div>
        
        <h4 class="service-title">Business Email</h4>
        <p class="service-desc">
          Build instant credibility with personalized email matching your domain name plus spam protection.
        </p>

        <div class="service-divider" aria-hidden="true"></div>

        <ul class="service-features">
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>You@YourCompany.com</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Anti-Spam &amp; Virus Shield</span>
          </li>
          <li>
            <i class="ri-check-line" aria-hidden="true"></i>
            <span>Webmail &amp; Mobile Sync</span>
          </li>
        </ul>

        <div class="service-price-tag">
          <span class="price-label">Starting at</span>
          <span class="price-value" data-inr="₹49/mo" data-usd="$0.59/mo">₹49/mo</span>
        </div>

        <a href="/business-email" class="service-action-btn">
          <span>Get Email</span>
          <i class="ri-arrow-right-line" aria-hidden="true"></i>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .hostamble-services-section {
    padding: 85px 0 90px;
    background: #ffffff;
    border-top: 1px solid var(--color-border, #eeeeee);
    position: relative;
    z-index: 2;
  }

  .service-subtitle {
    color: var(--color-body, #6F6B80);
    max-width: 680px;
    margin: 12px auto 0 auto;
    font-size: 16px;
    line-height: 1.6;
  }

  /* 5-Column Responsive Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px;
    margin-top: 10px;
  }

  /* Individual Service Card */
  .service-box {
    background: var(--color-white, #ffffff);
    border: 1px solid var(--color-border, #eeeeee);
    border-radius: 12px;
    padding: 26px 20px 22px;
    display: flex;
    flex-direction: column;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
  }

  .service-box:hover {
    transform: translateY(-7px);
    border-color: rgba(var(--color-primary-rgb, 210, 116, 29), 0.35);
    box-shadow: 0 16px 36px rgba(var(--color-primary-rgb, 210, 116, 29), 0.10), 0 4px 12px rgba(0, 0, 0, 0.04);
  }

  /* Card Header: Icon + Badge */
  .service-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .service-icon-box {
    width: 48px;
    height: 48px;
    background: var(--color-secondary-alt, #FFF6F4);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.15);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary, #ff501a);
    font-size: 23px;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .service-box:hover .service-icon-box {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
    border-color: var(--color-primary, #ff501a);
    transform: scale(1.05);
    box-shadow: 0 6px 18px rgba(var(--color-primary-rgb, 210, 116, 29), 0.28);
  }

  .service-badge {
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--color-secondary-alt, #FFF6F4);
    color: var(--color-primary, #ff501a);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.20);
  }

  .badge-popular {
    background: rgba(255, 80, 26, 0.10);
    color: #ff501a;
    border-color: rgba(255, 80, 26, 0.25);
  }

  .badge-turbo {
    background: rgba(113, 82, 233, 0.10);
    color: #7152e9;
    border-color: rgba(113, 82, 233, 0.25);
  }

  .badge-instant {
    background: rgba(27, 162, 219, 0.10);
    color: #1ba2db;
    border-color: rgba(27, 162, 219, 0.25);
  }

  .badge-security {
    background: rgba(62, 183, 94, 0.10);
    color: #2e9f4d;
    border-color: rgba(62, 183, 94, 0.25);
  }

  .badge-identity {
    background: rgba(255, 143, 60, 0.10);
    color: #e67319;
    border-color: rgba(255, 143, 60, 0.25);
  }

  /* Title & Description */
  .service-title {
    font-size: 18.5px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    margin: 0 0 8px 0;
    line-height: 1.3;
    font-family: "Plus Jakarta Sans", var(--font-primary), sans-serif;
  }

  .service-desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-body, #6F6B80);
    margin: 0 0 16px 0;
    min-height: 48px;
  }

  .service-divider {
    height: 1px;
    background: var(--color-border, #eeeeee);
    margin-bottom: 15px;
    width: 100%;
  }

  /* Features List */
  .service-features {
    list-style: none;
    padding: 0;
    margin: 0 0 18px 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .service-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #374151;
    font-weight: 500;
  }

  .service-features li i {
    color: var(--color-primary, #ff501a);
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Price Tag */
  .service-price-tag {
    background: #fbfbfd;
    border: 1px dashed var(--color-border, #eeeeee);
    border-radius: 8px;
    padding: 8px 12px;
    margin-top: auto;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .price-label {
    font-size: 11px;
    font-weight: 600;
    color: #8a8a9e;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .price-value {
    font-size: 15.5px;
    font-weight: 800;
    color: var(--color-primary, #ff501a);
    font-family: "Plus Jakarta Sans", var(--font-primary), sans-serif;
  }

  /* Action Button */
  .service-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 14px;
    background: var(--color-secondary-alt, #FFF6F4);
    color: var(--color-primary, #ff501a);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.22);
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .service-action-btn i {
    font-size: 14px;
    transition: transform 0.25s ease;
  }

  .service-action-btn:hover {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
    border-color: var(--color-primary, #ff501a);
    box-shadow: 0 6px 18px rgba(var(--color-primary-rgb, 210, 116, 29), 0.28);
  }

  .service-action-btn:hover i {
    transform: translateX(4px);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .service-desc {
      min-height: auto;
    }
  }

  @media (max-width: 580px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .hostamble-services-section {
      padding: 60px 0;
    }
  }
</style>
