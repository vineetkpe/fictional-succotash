---
// Hostamble Native Theme Services Showcase
// Exact replica of Hostamble's native `aceorbit-service` and `service-card-3` block architecture
---

<div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1" id="services">
  <div class="container aceorbit-animated-shape">
    
    <!-- Section Title -->
    <div class="row">
      <div class="col-lg-12">
        <div 
          class="section-title text-center"
          data-sal="slide-up"
          data-sal-delay="150"
          data-sal-duration="800"
        >
          <span class="pre-title">Our Services</span>
          <h3 class="title">Explore Our Web &amp; Hosting Solutions</h3>
          <p class="description" style="max-width: 680px; margin: 12px auto 0; color: var(--color-body); font-size: 16px; line-height: 1.6;">
            Reliable cloud infrastructure, managed WordPress environments, and high-security web solutions built for scale.
          </p>
        </div>
      </div>
    </div>

    <!-- 6 Core Services Grid (3x2 Native Replica) -->
    <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">

      <!-- 1. Shared Hosting -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
          <div class="inner">
            <div class="icon">
              <span><i class="ri-server-line" aria-hidden="true"></i></span>
            </div>
            <div class="content">
              <h6 class="title">Shared Hosting</h6>
              <p class="description">
                Cost-effective, high-speed cPanel hosting powered by LiteSpeed Enterprise and pure NVMe SSDs with 99.9% uptime guarantee.
              </p>
              <div class="service-bottom-meta">
                <span class="service-price" data-inr="From ₹39/mo" data-usd="From $0.47/mo">From ₹39/mo</span>
                <a href="/shared-hosting" class="service-link">
                  <span>Explore Plans</span>
                  <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. WordPress Hosting -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
          <div class="inner">
            <div class="icon">
              <span><i class="ri-wordpress-fill" aria-hidden="true"></i></span>
            </div>
            <div class="content">
              <h6 class="title">WordPress Hosting</h6>
              <p class="description">
                Specially tuned for WordPress with built-in LSCache caching layers, 1-click staging sandbox, and automated safe core updates.
              </p>
              <div class="service-bottom-meta">
                <span class="service-price" data-inr="From ₹79/mo" data-usd="From $0.95/mo">From ₹79/mo</span>
                <a href="/wordpress-hosting" class="service-link">
                  <span>Explore Plans</span>
                  <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Domain Names -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
          <div class="inner">
            <div class="icon">
              <span><i class="ri-global-line" aria-hidden="true"></i></span>
            </div>
            <div class="content">
              <h6 class="title">Domain Search &amp; Reg</h6>
              <p class="description">
                Claim your brand identity with 500+ extensions (.com, .in, .org), free lifetime DNS management, and domain theft protection.
              </p>
              <div class="service-bottom-meta">
                <span class="service-price" data-inr="From ₹199/yr" data-usd="From $2.39/yr">From ₹199/yr</span>
                <a href="/domain-search" class="service-link">
                  <span>Find Domain</span>
                  <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. VPS Cloud Hosting -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
          <div class="inner">
            <div class="icon">
              <span><i class="ri-hard-drive-2-line" aria-hidden="true"></i></span>
            </div>
            <div class="content">
              <h6 class="title">VPS Cloud Hosting</h6>
              <p class="description">
                Guaranteed KVM hardware resources with instant reboot controls, isolated hypervisor, full root SSH access, and 1 Gbps uplink.
              </p>
              <div class="service-bottom-meta">
                <span class="service-price" data-inr="From ₹499/mo" data-usd="From $5.99/mo">From ₹499/mo</span>
                <a href="/vps-hosting" class="service-link">
                  <span>Configure VPS</span>
                  <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Business Email -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="300" data-sal-duration="800">
        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
          <div class="inner">
            <div class="icon">
              <span><i class="ri-mail-star-line" aria-hidden="true"></i></span>
            </div>
            <div class="content">
              <h6 class="title">Business Email</h6>
              <p class="description">
                Professional branded corporate email with responsive webmail, intelligent anti-spam filters, and DKIM identity authentication.
              </p>
              <div class="service-bottom-meta">
                <span class="service-price" data-inr="From ₹29/mo" data-usd="From $0.35/mo">From ₹29/mo</span>
                <a href="/business-email" class="service-link">
                  <span>Get Email</span>
                  <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. SSL Certificates -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="350" data-sal-duration="800">
        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
          <div class="inner">
            <div class="icon">
              <span><i class="ri-shield-check-line" aria-hidden="true"></i></span>
            </div>
            <div class="content">
              <h6 class="title">SSL Certificates</h6>
              <p class="description">
                Industry-grade 256-bit TLS encryption with trusted browser green padlock, instant Let's Encrypt auto-renewal, and SEO boost.
              </p>
              <div class="service-bottom-meta">
                <span class="service-price" data-inr="From ₹499/yr" data-usd="From $5.99/yr">From ₹499/yr</span>
                <a href="/ssl-certificates" class="service-link">
                  <span>View Security</span>
                  <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Native Theme Decorative Floating Shapes -->
    <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
      <div class="shape-image shape-image-1">
        <img alt="Shape Thumb" src="/assets/images/shape29.png" />
      </div>
      <div class="shape-image shape-image-2">
        <img alt="Shape Thumb" src="/assets/images/shape0306.png" />
      </div>
      <div class="shape-image shape-image-3">
        <img alt="Shape Thumb" src="/assets/images/shape0206.png" />
      </div>
      <div class="shape-image shape-image-4">
        <img alt="Shape Thumb" src="/assets/images/shape19.png" />
      </div>
    </div>

  </div>
</div>

<style>
  .service-bottom-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 15px;
    margin-top: 15px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .service-price {
    font-size: 14px;
    font-weight: 800;
    color: var(--color-primary, #ff501a);
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .service-link {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.25s ease;
  }

  .service-link:hover {
    color: var(--color-primary, #ff501a);
  }

  .service-link i {
    font-size: 14px;
    transition: transform 0.25s ease;
  }

  .service-link:hover i {
    transform: translateX(4px);
  }
</style>
