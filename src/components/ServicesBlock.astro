---
// Hostamble Native Services Showcase
// Pinned Sticky Left Column (stays still) with Moving/Stacking Right Column
import {
  sharedHosting,
  wordpressHosting,
  vpsHosting,
  businessEmail,
  sslCertificates,
  domainPricing
} from "../data/pricing";

const services = [
  {
    num: "01",
    shapeClass: "shape-bg-1",
    icon: "ri-server-line",
    title: "Shared Hosting",
    desc: "Cost-effective, high-speed cPanel hosting powered by LiteSpeed Enterprise and pure NVMe SSDs with 99.9% uptime guarantee.",
    price: sharedHosting.heroStartPrice,
    link: "/shared-hosting",
    linkText: "Explore Plans"
  },
  {
    num: "02",
    shapeClass: "shape-bg-2",
    icon: "ri-wordpress-fill",
    title: "WordPress Hosting",
    desc: "Specially tuned for WordPress with built-in LSCache caching layers, 1-click staging sandbox, and automated safe core updates.",
    price: wordpressHosting.heroStartPrice,
    link: "/wordpress-hosting",
    linkText: "Explore Plans"
  },
  {
    num: "03",
    shapeClass: "shape-bg-1",
    icon: "ri-global-line",
    title: "Domain Search & Reg",
    desc: "Claim your brand identity with 500+ extensions (.com, .in, .org), free lifetime DNS management, and domain theft protection.",
    price: domainPricing.heroStartPrice,
    link: "/domain-search",
    linkText: "Find Domain"
  },
  {
    num: "04",
    shapeClass: "shape-bg-2",
    icon: "ri-hard-drive-2-line",
    title: "VPS Cloud Hosting",
    desc: "Guaranteed KVM hardware resources with instant reboot controls, isolated hypervisor, full root SSH access, and 1 Gbps uplink.",
    price: vpsHosting.heroStartPrice,
    link: "/vps-hosting",
    linkText: "Configure VPS"
  },
  {
    num: "05",
    shapeClass: "shape-bg-1",
    icon: "ri-mail-star-line",
    title: "Business Email",
    desc: "Professional branded corporate email with responsive webmail, intelligent anti-spam filters, and DKIM identity authentication.",
    price: businessEmail.heroStartPrice,
    link: "/business-email",
    linkText: "Get Email"
  },
  {
    num: "06",
    shapeClass: "shape-bg-2",
    icon: "ri-shield-check-line",
    title: "SSL Certificates",
    desc: "Industry-grade 256-bit TLS encryption with trusted browser green padlock, instant Let's Encrypt auto-renewal, and SEO boost.",
    price: sslCertificates.heroStartPrice,
    link: "/ssl-certificates",
    linkText: "View Security"
  }
];
---

<div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1" id="services">
  <div class="container aceorbit-animated-shape">
    
    <div class="services-two-col-layout">
      
      <!-- LEFT COLUMN: Locked Still while scrolling -->
      <div class="sticky-left-col">
        <div class="section-title text-start" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <span class="pre-title">Our Services</span>
          <h3 class="title">Explore Our Web &amp; Hosting Solutions</h3>
          <p class="description mt-3">
            Reliable cloud infrastructure, managed WordPress environments, and high-security web solutions built for scale.
          </p>
        </div>

        <!-- Native Theme Reassurance Box -->
        <div class="theme-reassurance-box mt-4 p-4 rounded bg-grey">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="reassurance-icon shape-1">
              <i class="ri-shield-check-line" aria-hidden="true"></i>
            </div>
            <div>
              <h6 class="mb-0 reassurance-title">99.9% Zero Downtime</h6>
              <span class="reassurance-sub">Tier-4 Certified Datacenter Fleet</span>
            </div>
          </div>

          <div class="d-flex align-items-center gap-3">
            <div class="reassurance-icon shape-2">
              <i class="ri-customer-service-2-line" aria-hidden="true"></i>
            </div>
            <div>
              <h6 class="mb-0 reassurance-title">WhatsApp Support</h6>
              <span class="reassurance-sub">Fast WhatsApp &amp; Ticket Assistance</span>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <a class="ace-btn" href="#plans">Explore All Plans</a>
        </div>
      </div>

      <!-- RIGHT COLUMN: Moves and Stacks smoothly on scroll -->
      <div class="moving-right-col">
        <div class="services-stack-list">
          {services.map((item, idx) => (
            <div 
              class={`service-card service-card-3 text-left ${item.shapeClass} bg-grey stack-card ${idx === 0 ? 'is-active' : ''}`}
              style={`--card-index: ${idx};`}
              data-stack-card
            >
              <div class="inner">
                
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <div class="icon">
                    <span><i class={item.icon} aria-hidden="true"></i></span>
                  </div>
                  <span class="service-idx-badge">{item.num}</span>
                </div>

                <div class="content">
                  <h6 class="title">{item.title}</h6>
                  <p class="description">{item.desc}</p>
                  
                  <div class="service-bottom-meta">
                    <span 
                      class="service-price" 
                      data-inr={item.price.inr} 
                      data-usd={item.price.usd}
                    >
                      {item.price.inr}
                    </span>
                    <a href={item.link} class="service-link">
                      <span>{item.linkText}</span>
                      <i class="ri-arrow-right-line" aria-hidden="true"></i>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Native Theme Decorative Floating Shapes -->
    <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
      <div class="shape-image shape-image-1">
        <img alt="Shape Thumb" src="/assets/images/shape29.png" />
      </div>
      <div class="shape-image shape-image-2">
        <img alt="Shape Thumb" src="/assets/images/shape0306.png" />
      </div>
      <div class="shape-image shape-image-3">
        <img alt="Shape Thumb" src="/assets/images/shape0206.png" />
      </div>
      <div class="shape-image shape-image-4">
        <img alt="Shape Thumb" src="/assets/images/shape19.png" />
      </div>
    </div>

  </div>
</div>

<style>
  /* --------------------------------------------------------------------------
     TWO COLUMN GRID LAYOUT (Desktop Grid ensures Left Column is 100% STILL)
     -------------------------------------------------------------------------- */
  .services-two-col-layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
    position: relative;
  }

  @media (min-width: 992px) {
    .services-two-col-layout {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 50px;
      align-items: start;
    }

    /* Left column is pinned STILL */
    .sticky-left-col {
      position: sticky;
      top: 105px;
      z-index: 5;
    }

    /* Right column moves freely */
    .moving-right-col {
      position: relative;
    }
  }

  /* Reassurance Box */
  .theme-reassurance-box {
    border: 1px solid var(--color-border, #eeeeee);
  }

  .reassurance-icon {
    width: 44px;
    height: 44px;
    border-radius: 22px 22px 3px 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .reassurance-icon.shape-1 {
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.1);
    color: var(--color-primary, #ff501a);
  }

  .reassurance-icon.shape-2 {
    background: rgba(var(--color-secondary-rgb, 32, 33, 51), 0.1);
    color: var(--color-secondary, #202133);
  }

  .reassurance-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .reassurance-sub {
    font-size: 13px;
    color: var(--color-body, #6F6B80);
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  /* --------------------------------------------------------------------------
     STACKING CARDS & TIMELINE ON RIGHT COLUMN
     -------------------------------------------------------------------------- */
  .services-stack-list {
    display: flex;
    flex-direction: column;
    gap: 25px;
    position: relative;
  }

  @media (min-width: 992px) {
    .services-stack-list {
      padding-left: 36px;
    }

    /* Continuous Timeline Line */
    .services-stack-list::before {
      content: "";
      position: absolute;
      top: 25px;
      bottom: 25px;
      left: 10px;
      width: 2px;
      background: var(--color-border, #eeeeee);
      border-radius: 2px;
    }

    /* Scroll Progress Gradient Line */
    .services-stack-list::after {
      content: "";
      position: absolute;
      top: 25px;
      left: 10px;
      width: 2px;
      height: var(--scroll-progress, 0%);
      max-height: calc(100% - 50px);
      background: var(--color-primary, #ff501a);
      border-radius: 2px;
      transition: height 0.15s ease-out;
    }

    /* Sticky Stacking Position for Moving Cards */
    .stack-card {
      position: sticky;
      top: calc(105px + var(--card-index, 0) * 18px);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.35s ease, filter 0.35s ease;
      transform-origin: top center;
    }

    /* Timeline Node Dot for each card */
    .stack-card::before {
      content: "";
      position: absolute;
      top: 40px;
      left: -32px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--color-white, #ffffff);
      border: 2px solid var(--color-border, #d5dae2);
      transition: all 0.35s ease;
      z-index: 3;
    }

    /* Active Node Dot */
    .stack-card.is-active::before {
      background: var(--color-primary, #ff501a);
      border-color: var(--color-primary, #ff501a);
      box-shadow: 0 0 0 5px rgba(var(--color-primary-rgb, 210, 116, 29), 0.2);
      transform: scale(1.2);
    }

    /* Active Card Surface */
    .stack-card.is-active {
      background: var(--color-white, #ffffff);
      box-shadow: 0px 14px 35px rgba(0, 0, 0, 0.08);
    }
  }

  /* Index Badge (01, 02, etc.) */
  .service-idx-badge {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-primary, #ff501a);
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.1);
    padding: 3px 10px;
    border-radius: 20px;
    font-family: var(--font-primary, "Urbanist", sans-serif);
    transition: all 0.3s ease;
  }

  .stack-card.is-active .service-idx-badge {
    background: var(--color-primary, #ff501a);
    color: var(--color-white, #ffffff);
  }

  /* Native Bottom Price & Link Meta */
  .service-bottom-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 15px;
    margin-top: 15px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .service-price {
    font-size: 15px;
    font-weight: 800;
    color: var(--color-primary, #ff501a);
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .service-link {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.25s ease;
    font-family: var(--font-primary, "Urbanist", sans-serif);
  }

  .service-link:hover {
    color: var(--color-primary, #ff501a);
  }

  .service-link i {
    font-size: 14px;
    transition: transform 0.25s ease;
  }

  .service-link:hover i {
    transform: translateX(4px);
  }
</style>

<script>
  function initStackingMovement() {
    const list = document.querySelector<HTMLElement>('.services-stack-list');
    if (!list) return;

    const cards = Array.from(list.querySelectorAll<HTMLElement>('.stack-card'));
    if (!cards.length) return;

    let isTicking = false;

    function onScroll() {
      if (window.innerWidth < 992) {
        cards.forEach(card => {
          card.style.transform = '';
          card.style.filter = '';
        });
        isTicking = false;
        return;
      }

      const listRect = list!.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Update vertical progress line
      const triggerStart = viewportHeight * 0.7;
      const totalTravel = listRect.height;
      const currentScroll = triggerStart - listRect.top;
      const progressPercent = Math.max(0, Math.min(100, (currentScroll / totalTravel) * 100));
      list!.style.setProperty('--scroll-progress', `${progressPercent}%`);

      // Find active card index based on scroll position
      const threshold = 170;
      let activeIndex = 0;

      cards.forEach((card, i) => {
        const rect = card.getBoundingClientRect();
        if (rect.top <= threshold) {
          activeIndex = i;
        }
      });

      // Apply stacking depth scaling to moving cards
      cards.forEach((card, i) => {
        const isActive = (i === activeIndex);
        card.classList.toggle('is-active', isActive);

        if (i < activeIndex) {
          const depth = activeIndex - i;
          const scale = Math.max(0.93, 1 - depth * 0.025);
          const brightness = Math.max(0.92, 1 - depth * 0.03);
          card.style.transform = `scale(${scale})`;
          card.style.filter = `brightness(${brightness})`;
        } else {
          card.style.transform = 'scale(1)';
          card.style.filter = 'brightness(1)';
        }
      });

      isTicking = false;
    }

    function requestScroll() {
      if (!isTicking) {
        window.requestAnimationFrame(onScroll);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', requestScroll, { passive: true });
    window.addEventListener('resize', requestScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStackingMovement);
  } else {
    initStackingMovement();
  }
  document.addEventListener('astro:page-load', initStackingMovement);
</script>
