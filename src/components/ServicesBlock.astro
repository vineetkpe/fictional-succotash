---
// Hostamble Central Services Showcase
// Synced dynamically with src/data/pricing.ts origin pricing configuration
import {
  sharedHosting,
  wordpressHosting,
  vpsHosting,
  businessEmail,
  sslCertificates,
  domainPricing
} from "../data/pricing";
---

<div class="aceorbit-service ace-service-area ace-section-gap position-relative border-bottom-1 hostamble-services-ecosystem" id="services">
  <div class="container aceorbit-animated-shape">
    
    <!-- Section Title (strictly adhering to site's global typography classes) -->
    <div class="row">
      <div class="col-lg-12">
        <div 
          class="section-title text-center"
          data-sal="slide-up"
          data-sal-delay="150"
          data-sal-duration="800"
        >
          <span class="pre-title">Our Services</span>
          <h3 class="title">Explore Our Web &amp; Hosting Solutions</h3>
          <p class="description" style="max-width: 680px; margin: 12px auto 0;">
            Reliable cloud hosting, managed WordPress environments, domain registration, and ironclad web security built for speed and scale.
          </p>
        </div>
      </div>
    </div>

    <!-- 6 Core Services Grid (Square Shaped Cards) -->
    <div class="row g-4 mt--20 justify-content-center">

      <!-- 1. Shared Hosting (Featured) -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
        <div class="service-square-card card-featured">
          <div class="card-top-accent"></div>
          
          <div class="card-top">
            <div class="card-head-bar">
              <div class="service-icon-box icon-primary">
                <i class="ri-server-line" aria-hidden="true"></i>
              </div>
              <span class="service-badge badge-primary">Most Popular</span>
            </div>

            <div class="card-heading-row">
              <h5 class="service-name">Shared Hosting</h5>
              <div class="service-pricing">
                <span class="price-prefix">From</span>
                <span 
                  class="price-tag" 
                  data-inr={sharedHosting.heroStartPrice.inr} 
                  data-usd={sharedHosting.heroStartPrice.usd}
                >
                  {sharedHosting.heroStartPrice.inr}
                </span>
              </div>
            </div>

            <p class="service-summary">
              Cost-effective cPanel hosting powered by LiteSpeed Enterprise and NVMe SSDs with 99.9% uptime SLA.
            </p>

            <ul class="service-highlights">
              <li>
                <i class="ri-checkbox-circle-fill" aria-hidden="true"></i>
                <span>LiteSpeed Turbo + LSCache</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill" aria-hidden="true"></i>
                <span>Pure Gen4 NVMe SSD Storage</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill" aria-hidden="true"></i>
                <span>Free cPanel &amp; Unlimited SSLs</span>
              </li>
            </ul>
          </div>

          <div class="card-bottom">
            <span class="service-sla">
              <i class="ri-flashlight-line" aria-hidden="true"></i> Instant Setup
            </span>
            <a href="/shared-hosting" class="service-square-btn btn-featured">
              <span>Explore</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>

      <!-- 2. WordPress Hosting -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
        <div class="service-square-card">
          <div class="card-top-accent"></div>
          
          <div class="card-top">
            <div class="card-head-bar">
              <div class="service-icon-box icon-purple">
                <i class="ri-wordpress-fill" aria-hidden="true"></i>
              </div>
              <span class="service-badge badge-purple">Turbo Speed</span>
            </div>

            <div class="card-heading-row">
              <h5 class="service-name">WordPress Hosting</h5>
              <div class="service-pricing">
                <span class="price-prefix">From</span>
                <span 
                  class="price-tag" 
                  data-inr={wordpressHosting.heroStartPrice.inr} 
                  data-usd={wordpressHosting.heroStartPrice.usd}
                >
                  {wordpressHosting.heroStartPrice.inr}
                </span>
              </div>
            </div>

            <p class="service-summary">
              Engineered specifically for WordPress with built-in LSCache caching, 1-click staging, and auto-updates.
            </p>

            <ul class="service-highlights">
              <li>
                <i class="ri-checkbox-circle-fill text-purple" aria-hidden="true"></i>
                <span>300% Faster PHP 8.x Execution</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-purple" aria-hidden="true"></i>
                <span>1-Click Safe Staging &amp; Clone</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-purple" aria-hidden="true"></i>
                <span>Smart WP-CLI &amp; Malware Shield</span>
              </li>
            </ul>
          </div>

          <div class="card-bottom">
            <span class="service-sla">
              <i class="ri-speed-up-line" aria-hidden="true"></i> Sub-Sec TTFB
            </span>
            <a href="/wordpress-hosting" class="service-square-btn">
              <span>Explore</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>

      <!-- 3. Domain Names -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
        <div class="service-square-card">
          <div class="card-top-accent"></div>
          
          <div class="card-top">
            <div class="card-head-bar">
              <div class="service-icon-box icon-amber">
                <i class="ri-global-line" aria-hidden="true"></i>
              </div>
              <span class="service-badge badge-amber">500+ Extensions</span>
            </div>

            <div class="card-heading-row">
              <h5 class="service-name">Domain Names</h5>
              <div class="service-pricing">
                <span class="price-prefix">From</span>
                <span 
                  class="price-tag" 
                  data-inr={domainPricing.heroStartPrice.inr} 
                  data-usd={domainPricing.heroStartPrice.usd}
                >
                  {domainPricing.heroStartPrice.inr}
                </span>
              </div>
            </div>

            <p class="service-summary">
              Secure your perfect digital brand identity with competitive renewal pricing and full DNS routing controls.
            </p>

            <ul class="service-highlights">
              <li>
                <i class="ri-checkbox-circle-fill text-amber" aria-hidden="true"></i>
                <span>Free DNS Records Management</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-amber" aria-hidden="true"></i>
                <span>WHOIS Privacy &amp; Theft Protection</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-amber" aria-hidden="true"></i>
                <span>Real-Time Anycast Propagation</span>
              </li>
            </ul>
          </div>

          <div class="card-bottom">
            <span class="service-sla">
              <i class="ri-search-eye-line" aria-hidden="true"></i> Live Search
            </span>
            <a href="/domain-search" class="service-square-btn">
              <span>Find Domain</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>

      <!-- 4. Cloud VPS Hosting -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
        <div class="service-square-card">
          <div class="card-top-accent"></div>
          
          <div class="card-top">
            <div class="card-head-bar">
              <div class="service-icon-box icon-blue">
                <i class="ri-hard-drive-2-line" aria-hidden="true"></i>
              </div>
              <span class="service-badge badge-blue">Dedicated KVM</span>
            </div>

            <div class="card-heading-row">
              <h5 class="service-name">Cloud VPS Hosting</h5>
              <div class="service-pricing">
                <span class="price-prefix">From</span>
                <span 
                  class="price-tag" 
                  data-inr={vpsHosting.heroStartPrice.inr} 
                  data-usd={vpsHosting.heroStartPrice.usd}
                >
                  {vpsHosting.heroStartPrice.inr}
                </span>
              </div>
            </div>

            <p class="service-summary">
              Guaranteed KVM virtualization with isolated CPU &amp; RAM, unmetered network bandwidth, and full SSH root access.
            </p>

            <ul class="service-highlights">
              <li>
                <i class="ri-checkbox-circle-fill text-blue" aria-hidden="true"></i>
                <span>100% Dedicated KVM Hypervisor</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-blue" aria-hidden="true"></i>
                <span>Full Root SSH &amp; Instant Reboots</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-blue" aria-hidden="true"></i>
                <span>1 Gbps Uplink &amp; Anti-DDoS Shield</span>
              </li>
            </ul>
          </div>

          <div class="card-bottom">
            <span class="service-sla">
              <i class="ri-shield-keyhole-line" aria-hidden="true"></i> Full Root KVM
            </span>
            <a href="/vps-hosting" class="service-square-btn">
              <span>Configure</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>

      <!-- 5. Business Email -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="300" data-sal-duration="800">
        <div class="service-square-card">
          <div class="card-top-accent"></div>
          
          <div class="card-top">
            <div class="card-head-bar">
              <div class="service-icon-box icon-cyan">
                <i class="ri-mail-star-line" aria-hidden="true"></i>
              </div>
              <span class="service-badge badge-cyan">Custom Mail</span>
            </div>

            <div class="card-heading-row">
              <h5 class="service-name">Business Email</h5>
              <div class="service-pricing">
                <span class="price-prefix">From</span>
                <span 
                  class="price-tag" 
                  data-inr={businessEmail.heroStartPrice.inr} 
                  data-usd={businessEmail.heroStartPrice.usd}
                >
                  {businessEmail.heroStartPrice.inr}
                </span>
              </div>
            </div>

            <p class="service-summary">
              Build client trust with branded email addresses (you@yourdomain.com), modern webmail, and anti-spam filters.
            </p>

            <ul class="service-highlights">
              <li>
                <i class="ri-checkbox-circle-fill text-cyan" aria-hidden="true"></i>
                <span>Custom Branded Domain Mailboxes</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-cyan" aria-hidden="true"></i>
                <span>SpamExperts™ Inbound/Outbound Filter</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-cyan" aria-hidden="true"></i>
                <span>DKIM, SPF &amp; DMARC Deliverability</span>
              </li>
            </ul>
          </div>

          <div class="card-bottom">
            <span class="service-sla">
              <i class="ri-mail-check-line" aria-hidden="true"></i> 99.9% Spam-Free
            </span>
            <a href="/business-email" class="service-square-btn">
              <span>Get Email</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>

      <!-- 6. SSL Certificates -->
      <div class="col-lg-4 col-md-6 col-12" data-sal="slide-up" data-sal-delay="350" data-sal-duration="800">
        <div class="service-square-card">
          <div class="card-top-accent"></div>
          
          <div class="card-top">
            <div class="card-head-bar">
              <div class="service-icon-box icon-green">
                <i class="ri-shield-check-line" aria-hidden="true"></i>
              </div>
              <span class="service-badge badge-green">256-Bit TLS</span>
            </div>

            <div class="card-heading-row">
              <h5 class="service-name">SSL Certificates</h5>
              <div class="service-pricing">
                <span class="price-prefix">From</span>
                <span 
                  class="price-tag" 
                  data-inr={sslCertificates.heroStartPrice.inr} 
                  data-usd={sslCertificates.heroStartPrice.usd}
                >
                  {sslCertificates.heroStartPrice.inr}
                </span>
              </div>
            </div>

            <p class="service-summary">
              Protect visitor transactions and passwords with 256-bit encryption, browser padlock trust, and SEO ranking boost.
            </p>

            <ul class="service-highlights">
              <li>
                <i class="ri-checkbox-circle-fill text-green" aria-hidden="true"></i>
                <span>Industry-Grade 256-Bit TLS Encryption</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-green" aria-hidden="true"></i>
                <span>Trusted Browser Padlock Indicator</span>
              </li>
              <li>
                <i class="ri-checkbox-circle-fill text-green" aria-hidden="true"></i>
                <span>Automated Let's Encrypt / DV Support</span>
              </li>
            </ul>
          </div>

          <div class="card-bottom">
            <span class="service-sla">
              <i class="ri-lock-2-line" aria-hidden="true"></i> 100% Secure
            </span>
            <a href="/ssl-certificates" class="service-square-btn">
              <span>View Plans</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- Native Theme Decorative Floating Shapes -->
    <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
      <div class="shape-image shape-image-1">
        <img alt="Shape Thumb" src="/assets/images/shape29.png" />
      </div>
      <div class="shape-image shape-image-2">
        <img alt="Shape Thumb" src="/assets/images/shape0306.png" />
      </div>
      <div class="shape-image shape-image-3">
        <img alt="Shape Thumb" src="/assets/images/shape0206.png" />
      </div>
      <div class="shape-image shape-image-4">
        <img alt="Shape Thumb" src="/assets/images/shape19.png" />
      </div>
    </div>

  </div>
</div>

<style>
  .hostamble-services-ecosystem {
    background: #FAFBFC;
    border-top: 1px solid var(--color-border, #EEEEEE);
    border-bottom: 1px solid var(--color-border, #EEEEEE);
  }

  /* Square Card Architecture */
  .service-square-card {
    background: var(--color-white, #ffffff);
    border: 1px solid var(--color-border, #eef0f4);
    border-radius: var(--radius, 10px);
    padding: 24px 22px 20px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    box-shadow: 0 4px 16px rgba(32, 33, 51, 0.03);
    height: 100%;
  }

  /* Desktop and Tablet: 1:1 Aspect Ratio for true square cards */
  @media (min-width: 768px) {
    .service-square-card {
      aspect-ratio: 1 / 1;
    }
  }

  .service-square-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(32, 33, 51, 0.08);
    border-color: rgba(var(--color-primary-rgb, 210, 116, 29), 0.4);
  }

  /* Top Accent Line */
  .card-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    transition: background 0.3s ease;
  }

  .service-square-card:hover .card-top-accent,
  .service-square-card.card-featured .card-top-accent {
    background: var(--color-primary, #ff501a);
  }

  .service-square-card.card-featured {
    border-color: rgba(var(--color-primary-rgb, 210, 116, 29), 0.3);
    box-shadow: 0 6px 20px rgba(var(--color-primary-rgb, 210, 116, 29), 0.06);
  }

  /* Header Bar */
  .card-head-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  /* Square Icon Box */
  .service-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-small, 6px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    transition: all 0.3s ease;
  }

  .service-square-card:hover .service-icon-box {
    transform: scale(1.05);
  }

  .icon-primary {
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.1);
    color: var(--color-primary, #ff501a);
  }
  .service-square-card:hover .icon-primary {
    background: var(--color-primary, #ff501a);
    color: var(--color-white, #ffffff);
  }

  .icon-purple {
    background: rgba(124, 58, 237, 0.1);
    color: #7c3aed;
  }
  .service-square-card:hover .icon-purple {
    background: #7c3aed;
    color: var(--color-white, #ffffff);
  }

  .icon-amber {
    background: rgba(217, 119, 6, 0.1);
    color: #d97706;
  }
  .service-square-card:hover .icon-amber {
    background: #d97706;
    color: var(--color-white, #ffffff);
  }

  .icon-blue {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
  }
  .service-square-card:hover .icon-blue {
    background: #2563eb;
    color: var(--color-white, #ffffff);
  }

  .icon-cyan {
    background: rgba(14, 165, 233, 0.1);
    color: #0284c7;
  }
  .service-square-card:hover .icon-cyan {
    background: #0284c7;
    color: var(--color-white, #ffffff);
  }

  .icon-green {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
  }
  .service-square-card:hover .icon-green {
    background: #059669;
    color: var(--color-white, #ffffff);
  }

  /* Badges */
  .service-badge {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--radius-small, 5px);
    font-family: var(--font-primary);
  }

  .badge-primary {
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.1);
    color: var(--color-primary, #ff501a);
  }
  .badge-purple {
    background: rgba(124, 58, 237, 0.1);
    color: #7c3aed;
  }
  .badge-amber {
    background: rgba(217, 119, 6, 0.1);
    color: #d97706;
  }
  .badge-blue {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
  }
  .badge-cyan {
    background: rgba(14, 165, 233, 0.1);
    color: #0284c7;
  }
  .badge-green {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
  }

  /* Title & Pricing */
  .card-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .service-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    margin: 0;
    font-family: var(--font-primary);
    line-height: 1.3;
  }

  .service-pricing {
    text-align: right;
    flex-shrink: 0;
  }

  .price-prefix {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--color-body, #6F6B80);
    font-weight: 600;
    display: block;
    line-height: 1;
    margin-bottom: 2px;
    font-family: var(--font-primary);
  }

  .price-tag {
    font-size: 16px;
    font-weight: 800;
    color: var(--color-primary, #ff501a);
    font-family: var(--font-primary);
    line-height: 1;
  }

  /* Description */
  .service-summary {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-body, #6F6B80);
    margin: 0 0 12px 0;
    font-family: var(--font-primary);
  }

  /* Highlights */
  .service-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .service-highlights li {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-heading, #202133);
    font-family: var(--font-primary);
  }

  .service-highlights li i {
    font-size: 14px;
    color: var(--color-primary, #ff501a);
    flex-shrink: 0;
  }

  .text-purple {
    color: #7c3aed !important;
  }
  .text-amber {
    color: #d97706 !important;
  }
  .text-blue {
    color: #2563eb !important;
  }
  .text-cyan {
    color: #0284c7 !important;
  }
  .text-green {
    color: #059669 !important;
  }

  /* Footer */
  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--color-border, #EEEEEE);
  }

  .service-sla {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-body, #6F6B80);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-primary);
  }

  .service-sla i {
    font-size: 13px;
    color: var(--color-primary, #ff501a);
  }

  /* Button */
  .service-square-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border-radius: var(--radius-small, 5px);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-primary, #ff501a);
    background: rgba(var(--color-primary-rgb, 210, 116, 29), 0.08);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.2);
    transition: all 0.25s ease;
    font-family: var(--font-primary);
  }

  .service-square-btn:hover {
    color: var(--color-white, #ffffff);
    background: var(--color-primary, #ff501a);
    border-color: var(--color-primary, #ff501a);
    box-shadow: 0 4px 12px rgba(var(--color-primary-rgb, 210, 116, 29), 0.25);
  }

  .service-square-btn i {
    font-size: 13px;
    transition: transform 0.25s ease;
  }

  .service-square-btn:hover i {
    transform: translateX(3px);
  }

  .service-square-btn.btn-featured {
    color: var(--color-white, #ffffff);
    background: var(--color-primary, #ff501a);
    border-color: var(--color-primary, #ff501a);
  }

  .service-square-btn.btn-featured:hover {
    background: #e04414;
    border-color: #e04414;
  }

  @media (max-width: 575px) {
    .service-square-card {
      padding: 20px 18px 16px;
    }
  }
</style>
