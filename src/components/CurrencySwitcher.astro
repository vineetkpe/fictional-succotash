---
interface Props {
  variant?: 'header' | 'mobile';
  class?: string;
}

const { variant = 'header', class: className = '' } = Astro.props;
---

<div class={`currency-dropdown-wrap currency-${variant} ${className}`} id={variant === 'header' ? 'currencySwitcherHeader' : 'currencySwitcherMobile'}>
  <button 
    type="button" 
    class="currency-dropdown-btn" 
    aria-expanded="false" 
    aria-haspopup="listbox"
    aria-label="Select Currency"
  >
    <span class="currency-current-label">₹ INR</span>
    <i class="ri-arrow-down-s-line currency-chevron" aria-hidden="true"></i>
  </button>

  <div class="currency-dropdown-card" role="listbox" aria-label="Currency options">
    <button 
      type="button" 
      class="currency-dropdown-item active" 
      data-currency="INR" 
      role="option" 
      aria-selected="true"
    >
      <span class="currency-item-symbol">₹</span>
      <span class="currency-item-code">INR</span>
      <i class="ri-check-line currency-item-check" aria-hidden="true"></i>
    </button>
    <button 
      type="button" 
      class="currency-dropdown-item" 
      data-currency="USD" 
      role="option" 
      aria-selected="false"
    >
      <span class="currency-item-symbol">$</span>
      <span class="currency-item-code">USD</span>
      <i class="ri-check-line currency-item-check" aria-hidden="true"></i>
    </button>
  </div>
</div>

<script>
  import { initCurrency } from '../scripts/currency';
  initCurrency();
</script>

<style>
  .currency-dropdown-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    user-select: none;
    font-family: inherit;
  }

  .currency-dropdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    padding: 6px 8px;
    font-size: 15px;
    font-weight: 700;
    color: #e53935;
    cursor: pointer;
    line-height: 1.2;
    transition: all 0.2s ease;
    border-radius: 4px;
  }

  .currency-dropdown-btn:hover {
    color: #c62828;
    background: rgba(229, 57, 53, 0.05);
  }

  .currency-current-label {
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .currency-chevron {
    font-size: 17px;
    line-height: 1;
    color: #e53935;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .currency-dropdown-wrap.open .currency-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Card */
  .currency-dropdown-card {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 130px;
    background: #ffffff;
    border: 1px solid #ebebeb;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    padding: 8px 0;
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.2s;
  }

  .currency-dropdown-wrap.open .currency-dropdown-card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Items */
  .currency-dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 9px 18px;
    border: none;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    color: #2b2f38;
    text-align: left;
    cursor: pointer;
    line-height: 1.4;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .currency-dropdown-item:hover {
    background: #f7f8fa;
    color: #e53935;
  }

  .currency-dropdown-item.active {
    background: rgba(229, 57, 53, 0.06);
    color: #e53935;
    font-weight: 700;
  }

  .currency-item-symbol {
    font-weight: 600;
    min-width: 14px;
  }

  .currency-item-code {
    letter-spacing: 0.02em;
  }

  .currency-item-check {
    margin-left: auto;
    font-size: 16px;
    color: #e53935;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .currency-dropdown-item.active .currency-item-check {
    opacity: 1;
  }

  /* Header Variant */
  .currency-header {
    margin-right: 14px;
  }

  /* Mobile Drawer Variant */
  .currency-mobile {
    width: 100%;
    margin: 10px 0 15px 0;
  }

  .currency-mobile .currency-dropdown-btn {
    width: 100%;
    justify-content: space-between;
    padding: 10px 14px;
    background: #f4f5f8;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 14px;
  }

  .currency-mobile .currency-dropdown-card {
    position: static;
    display: none;
    width: 100%;
    margin-top: 6px;
    box-shadow: none;
    border: 1px solid #e5e7eb;
    transform: none;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .currency-mobile.open .currency-dropdown-card {
    display: block;
  }

  @media (max-width: 991px) {
    .currency-header {
      margin-right: 8px;
    }

    .currency-header .currency-dropdown-btn {
      padding: 4px 6px;
      font-size: 13px;
    }

    .currency-header .currency-chevron {
      font-size: 15px;
    }
  }

  @media (max-width: 576px) {
    .currency-header {
      display: none !important;
    }
  }
</style>
