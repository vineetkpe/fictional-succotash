---
// Dual-row continuous infinite marquee ticker ribbon
const row1Items = [
  "WordPress Hosting",
  "NVMe Cloud VPS",
  "Free .COM Domain",
  "10x LiteSpeed Turbo",
  "Business Email Suite",
  "99.9% Uptime Guarantee",
  "Free SSL Certificates",
  "n8n Workflow Automation",
  "24/7 Dedicated Support",
];

const row2Items = [
  "1-Click WordPress Deploy",
  "100% Pure NVMe Storage",
  "cPanel & DirectAdmin",
  "Daily Cloud Backups",
  "Global Anycast DNS",
  "Free Website Migration",
  "Enterprise DDoS Shield",
  "Instant Server Activation",
];
---

<section class="product-marquee-banner" aria-label="Hostamble Product Showcase">
  <!-- Row 1: Solid bold typography scrolling left -->
  <div class="marquee-row marquee-row-solid">
    <div class="marquee-track scroll-left">
      <div class="marquee-group">
        {row1Items.map((item) => (
          <span class="marquee-item">
            <span class="item-text">{item}</span>
            <span class="item-sparkle" aria-hidden="true">✦</span>
          </span>
        ))}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {row1Items.map((item) => (
          <span class="marquee-item">
            <span class="item-text">{item}</span>
            <span class="item-sparkle" aria-hidden="true">✦</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Row 2: Outlined typography scrolling right -->
  <div class="marquee-row marquee-row-outline">
    <div class="marquee-track scroll-right">
      <div class="marquee-group">
        {row2Items.map((item) => (
          <span class="marquee-item">
            <span class="item-text outline-text">{item}</span>
            <span class="item-sparkle" aria-hidden="true">✦</span>
          </span>
        ))}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {row2Items.map((item) => (
          <span class="marquee-item">
            <span class="item-text outline-text">{item}</span>
            <span class="item-sparkle" aria-hidden="true">✦</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .product-marquee-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 26px 0 20px 0;
    background: transparent;
    user-select: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .marquee-row {
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    will-change: transform;
  }

  .scroll-left {
    animation: marqueeScrollLeft 38s linear infinite;
  }

  .scroll-right {
    animation: marqueeScrollRight 42s linear infinite;
  }

  .product-marquee-banner:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 0 16px;
    white-space: nowrap;
  }

  .item-text {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 800;
    color: #111827;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .outline-text {
    color: transparent;
    -webkit-text-stroke: 1.4px rgba(17, 24, 39, 0.42);
    letter-spacing: -0.015em;
    transition: color 0.3s ease, -webkit-text-stroke 0.3s ease;
  }

  .outline-text:hover {
    color: rgba(255, 80, 26, 0.1);
    -webkit-text-stroke: 1.4px #ff501a;
  }

  .item-sparkle {
    font-size: 14px;
    color: #ff501a;
    display: inline-block;
    filter: drop-shadow(0 0 6px rgba(255, 80, 26, 0.45));
    line-height: 1;
    transform: translateY(-1px);
  }

  @keyframes marqueeScrollLeft {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes marqueeScrollRight {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 768px) {
    .product-marquee-banner {
      padding: 20px 0 14px 0;
      gap: 8px;
    }
    .marquee-item {
      gap: 16px;
      padding: 0 10px;
    }
    .item-sparkle {
      font-size: 11px;
    }
  }
</style>
