---
// Hostamble Questions, Answered (FAQ) Block
// Elevated design with Sticky Left Support Concierge Rail, Live Question Search, 
// Category Filter Pills, and Distinctive Hostamble Question Cards.

interface FaqItem {
  id: string;
  category: 'hosting' | 'domains' | 'billing' | 'support';
  categoryLabel: string;
  question: string;
  answer: string;
  highlights?: string[];
  defaultOpen?: boolean;
}

const faqs: FaqItem[] = [
  {
    id: "faq-renewals",
    category: "billing",
    categoryLabel: "Billing & Plans",
    question: "What will I pay when my plan renews?",
    answer: "Your plan renews at the regular transparent price shown on our pricing table. We never engage in sneaky price hikes or hidden renewal fees. Any introductory promotional coupon applies to your initial billing cycle unless stated otherwise.",
    highlights: ["100% Price Transparency", "Zero Hidden Fees"],
    defaultOpen: true,
  },
  {
    id: "faq-refund",
    category: "billing",
    categoryLabel: "Billing & Plans",
    question: "Can I get a refund if I'm not satisfied?",
    answer: "Yes! All Hostamble shared and WordPress hosting packages come with a 7-Day Risk-Free Money-Back Guarantee. If our LiteSpeed speeds, NVMe performance, or support don't exceed your expectations, request a full refund within 7 days—no hassle.",
    highlights: ["7-Day Money-Back Guarantee", "100% Risk-Free"],
  },
  {
    id: "faq-gst",
    category: "billing",
    categoryLabel: "Billing & Plans",
    question: "Do you add GST or unexpected fees at checkout?",
    answer: "No checkout surprises! Every rupee and applicable tax is clearly calculated and displayed before you enter payment details. What you see is what you pay.",
    highlights: ["No Surprise Add-ons", "Clear Invoicing"],
  },
  {
    id: "faq-payments",
    category: "billing",
    categoryLabel: "Billing & Plans",
    question: "Which payment methods do you accept?",
    answer: "We support all preferred Indian and global payment options. Pay securely using UPI (Google Pay, PhonePe, Paytm, BHIM), Net Banking across all banks, Credit & Debit Cards, or PayPal for international orders. All transactions are protected by 256-bit bank-grade SSL encryption.",
    highlights: ["Instant UPI & Cards", "Bank-Grade Encryption"],
  },
  {
    id: "faq-migration",
    category: "hosting",
    categoryLabel: "Hosting & Speeds",
    question: "Can you move my existing website for free?",
    answer: "Yes, 100% free with zero downtime! Our in-house technical team handles complete migrations—including your WordPress installation, MySQL databases, cPanel settings, and email accounts—with no website interruption.",
    highlights: ["100% Free Migration", "Zero Downtime Guarantee"],
  },
  {
    id: "faq-ssl",
    category: "domains",
    categoryLabel: "Domains & Security",
    question: "Is an SSL Certificate included with hosting?",
    answer: "Yes! Lifetime automated Let's Encrypt SSL certificates come pre-integrated on all hosting plans. They generate and renew automatically for your main domain, subdomains, and addon domains with zero manual configuration.",
    highlights: ["Free Lifetime SSL", "Automated Auto-Renewal"],
  },
  {
    id: "faq-backups",
    category: "hosting",
    categoryLabel: "Hosting & Speeds",
    question: "How do backups work on Hostamble?",
    answer: "Automated daily backups powered by JetBackup safeguard your website files, databases, and mailboxes. You can restore a single file, database table, or your complete account with one click directly inside your cPanel dashboard.",
    highlights: ["Automated JetBackup", "1-Click Full Restore"],
  },
  {
    id: "faq-email",
    category: "domains",
    categoryLabel: "Domains & Security",
    question: "Can I create professional email accounts on my domain?",
    answer: "Yes! Every plan includes business domain emails (e.g. info@yourdomain.com), an intuitive webmail portal, SpamAssassin defense, and full IMAP/POP3/SMTP support to sync with iOS Mail, Android, Outlook, and Gmail.",
    highlights: ["Custom Domain Email", "Smartphone & Outlook Sync"],
  },
  {
    id: "faq-plan-choice",
    category: "hosting",
    categoryLabel: "Hosting & Speeds",
    question: "Which hosting plan is right for my project?",
    answer: "For single landing pages, personal blogs, or student portfolios, our Starter plan is ideal. For businesses, WooCommerce shops, or agencies hosting multiple clients, our Super or Turbo NVMe plans with LiteSpeed acceleration provide lightning-fast TTFB and top performance.",
    highlights: ["Starter for Personal Sites", "Turbo for High-Traffic E-commerce"],
  },
  {
    id: "faq-support",
    category: "support",
    categoryLabel: "24/7 Support",
    question: "How can I get help if something goes wrong?",
    answer: "Our certified hosting engineers are available 24/7/365 in both Hindi and English. Reach us instantly through Live Chat, WhatsApp (+91 62847 19083), or Support Ticket. Our average response time is under 3 minutes!",
    highlights: ["24/7 Hindi & English", "Average Reply < 3 Mins"],
  },
  {
    id: "faq-upgrade",
    category: "hosting",
    categoryLabel: "Hosting & Speeds",
    question: "Can I easily upgrade my plan as my website grows?",
    answer: "Yes, anytime! You can scale your disk quota, CPU cores, RAM, or seamlessly upgrade to a dedicated Cloud VPS with zero downtime directly through your Hostamble client portal.",
    highlights: ["Instant Scalability", "Zero-Downtime Upgrades"],
  },
];

// Schema.org FAQPage structured data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="hostamble-faq-section position-relative" id="faq" aria-labelledby="faq-main-title">
  <!-- Subtle ambient decorative accent -->
  <div class="faq-bg-ambient" aria-hidden="true"></div>

  <div class="container position-relative">
    <div class="faq-grid-layout">
      
      <!-- LEFT SIDE: Sticky Support Concierge Rail (STAYS STILL WHILE SCROLLING) -->
      <aside class="faq-side-rail" aria-label="Support & Section Overview">
        <div class="faq-sticky-container">
          
          <!-- Section Heading -->
          <div class="faq-intro-header">
            <div class="faq-eyebrow-pill mb-2">
              <span class="pulse-dot"></span>
              <span>Hostamble Helpdesk</span>
            </div>
            <h2 id="faq-main-title" class="faq-main-title">Questions, answered.</h2>
            <p class="faq-lead-text">Clear, honest answers to the questions webmasters ask before choosing Hostamble.</p>
          </div>

          <!-- Unique Hostamble Support Concierge Card -->
          <div class="faq-concierge-card" aria-labelledby="faq-concierge-title">
            <div class="concierge-header">
              <div class="concierge-avatar-wrap">
                <div class="concierge-avatar">
                  <i class="ri-customer-service-2-fill"></i>
                </div>
                <span class="concierge-online-badge" title="Support Engineers Online Now">
                  <span class="badge-ring"></span>
                  <span class="badge-dot"></span>
                </span>
              </div>
              
              <div class="concierge-meta">
                <span class="concierge-badge-tag">Hostamble Concierge</span>
                <h3 id="faq-concierge-title" class="concierge-heading">Still have a question?</h3>
                <p class="concierge-desc">Talk directly with a real server engineer.</p>
              </div>
            </div>

            <!-- Live Metrics Micro-Bar -->
            <div class="concierge-metrics-strip">
              <div class="metric-item">
                <i class="ri-flashlight-fill"></i>
                <span>Avg Reply: <strong>&lt; 3 Mins</strong></span>
              </div>
              <div class="metric-item">
                <i class="ri-translate-2"></i>
                <span><strong>Hindi &amp; English</strong></span>
              </div>
            </div>

            <!-- Action Channels -->
            <div class="concierge-actions">
              <button 
                type="button" 
                class="concierge-btn-chat" 
                onclick="window.Tawk_API && window.Tawk_API.toggle ? window.Tawk_API.toggle() : window.location.href='/contacts'"
                title="Start Instant Live Chat"
              >
                <i class="ri-chat-smile-2-fill" aria-hidden="true"></i>
                <span>Chat with an Expert</span>
              </button>

              <div class="concierge-sub-actions">
                <a 
                  href="https://wa.me/916284719083?text=Hi%20Hostamble,%20I%20have%20a%20question%20about%20hosting" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="concierge-link-btn wa-link"
                  title="WhatsApp Support"
                >
                  <i class="ri-whatsapp-fill"></i>
                  <span>WhatsApp</span>
                </a>

                <a 
                  href="/contacts" 
                  class="concierge-link-btn ticket-link"
                  title="Submit a Ticket"
                >
                  <i class="ri-ticket-2-line"></i>
                  <span>Open Ticket</span>
                </a>
              </div>
            </div>

            <div class="concierge-footer-guarantee">
              <i class="ri-shield-check-fill"></i>
              <span>100% In-house assistance · No chatbots</span>
            </div>
          </div>

        </div>
      </aside>

      <!-- RIGHT SIDE: Scrollable Interactive Questions Rail -->
      <div class="faq-questions-rail">
        
        <!-- Interactive Controls Bar: Live Search & Category Pills -->
        <div class="faq-controls-bar">
          
          <!-- Live Instant Search Input -->
          <div class="faq-search-wrapper">
            <i class="ri-search-line faq-search-icon" aria-hidden="true"></i>
            <input 
              type="text" 
              id="faqSearchInput" 
              class="faq-search-input" 
              placeholder="Search questions (e.g. refund, migration, SSL, cPanel)..."
              autocomplete="off"
            />
            <button type="button" id="faqClearSearch" class="faq-search-clear d-none" aria-label="Clear search">
              <i class="ri-close-line"></i>
            </button>
          </div>

          <!-- Category Filter Pills -->
          <div class="faq-category-pills" role="tablist" aria-label="FAQ Categories">
            <button type="button" class="category-pill active" data-category="all" role="tab" aria-selected="true">
              <span>All Questions</span>
              <span class="pill-count">11</span>
            </button>
            <button type="button" class="category-pill" data-category="hosting" role="tab" aria-selected="false">
              <span>Hosting &amp; Speeds</span>
            </button>
            <button type="button" class="category-pill" data-category="domains" role="tab" aria-selected="false">
              <span>Domains &amp; SSL</span>
            </button>
            <button type="button" class="category-pill" data-category="billing" role="tab" aria-selected="false">
              <span>Billing &amp; Refunds</span>
            </button>
            <button type="button" class="category-pill" data-category="support" role="tab" aria-selected="false">
              <span>24/7 Support</span>
            </button>
          </div>

        </div>

        <!-- Questions Accordion Cards List -->
        <div class="faq-cards-container" id="faqCardsList">
          {faqs.map((faq, index) => {
            const num = (index + 1).toString().padStart(2, '0');
            return (
              <div 
                class={`faq-card-item ${faq.defaultOpen ? 'is-active' : ''}`}
                data-faq-id={faq.id}
                data-category={faq.category}
              >
                <button 
                  type="button" 
                  class="faq-card-trigger" 
                  aria-expanded={faq.defaultOpen ? "true" : "false"}
                  aria-controls={`faq-answer-${faq.id}`}
                >
                  <div class="faq-trigger-left">
                    <span class="faq-num-pill">{num}</span>
                    <span class="faq-question-text">{faq.question}</span>
                  </div>
                  <div class="faq-trigger-icon-wrap" aria-hidden="true">
                    <i class="ri-arrow-down-s-line faq-chevron-icon"></i>
                  </div>
                </button>

                <div 
                  id={`faq-answer-${faq.id}`} 
                  class="faq-card-collapse"
                  style={faq.defaultOpen ? "display: block;" : "display: none;"}
                >
                  <div class="faq-card-body">
                    <p class="faq-answer-paragraph">{faq.answer}</p>
                    {faq.highlights && (
                      <div class="faq-highlights-row">
                        {faq.highlights.map(tag => (
                          <span class="faq-tag-pill">
                            <i class="ri-checkbox-circle-fill"></i>
                            <span>{tag}</span>
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}

          <!-- No results empty state (shown when search has 0 matches) -->
          <div id="faqNoResults" class="faq-no-results d-none">
            <div class="no-results-icon"><i class="ri-question-mark"></i></div>
            <h4>No matching questions found</h4>
            <p>Can't find what you're looking for? Talk to our server team directly on WhatsApp or Live Chat.</p>
            <button type="button" class="btn-reset-search" id="btnResetSearch">Show All Questions</button>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Schema.org JSON-LD Structured Data for Google Rich Results -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<!-- Client-side Interactive Search & Category Filter Script -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("faqSearchInput");
    const clearBtn = document.getElementById("faqClearSearch");
    const categoryBtns = document.querySelectorAll(".category-pill");
    const cards = document.querySelectorAll(".faq-card-item");
    const noResults = document.getElementById("faqNoResults");
    const resetSearchBtn = document.getElementById("btnResetSearch");

    let currentCategory = "all";
    let searchQuery = "";

    function filterFaqs() {
      let visibleCount = 0;
      const query = searchQuery.trim().toLowerCase();

      cards.forEach(card => {
        const category = card.getAttribute("data-category");
        const text = card.textContent.toLowerCase();

        const matchesCat = currentCategory === "all" || category === currentCategory;
        const matchesQuery = query === "" || text.includes(query);

        if (matchesCat && matchesQuery) {
          card.style.display = "block";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("d-none");
        } else {
          noResults.classList.add("d-none");
        }
      }

      if (clearBtn) {
        if (query.length > 0) {
          clearBtn.classList.remove("d-none");
        } else {
          clearBtn.classList.add("d-none");
        }
      }
    }

    // Category button click
    categoryBtns.forEach(btn => {
      btn.addEventListener("click", function () {
        categoryBtns.forEach(b => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        this.classList.add("active");
        this.setAttribute("aria-selected", "true");
        currentCategory = this.getAttribute("data-category") || "all";
        filterFaqs();
      });
    });

    // Live search input
    if (searchInput) {
      searchInput.addEventListener("input", function () {
        searchQuery = this.value;
        filterFaqs();
      });
    }

    // Clear search button
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (searchInput) {
          searchInput.value = "";
          searchQuery = "";
          searchInput.focus();
          filterFaqs();
        }
      });
    }

    if (resetSearchBtn) {
      resetSearchBtn.addEventListener("click", function () {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        currentCategory = "all";
        categoryBtns.forEach(b => {
          b.classList.toggle("active", b.getAttribute("data-category") === "all");
        });
        filterFaqs();
      });
    }

    // Accordion Toggle
    cards.forEach(card => {
      const trigger = card.querySelector(".faq-card-trigger");
      const collapse = card.querySelector(".faq-card-collapse");

      if (trigger && collapse) {
        trigger.addEventListener("click", function () {
          const isOpen = card.classList.contains("is-active");

          // Optional: close other cards for accordion behavior
          cards.forEach(other => {
            if (other !== card && other.classList.contains("is-active")) {
              other.classList.remove("is-active");
              const otherTrigger = other.querySelector(".faq-card-trigger");
              const otherCollapse = other.querySelector(".faq-card-collapse");
              if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
              if (otherCollapse) otherCollapse.style.display = "none";
            }
          });

          if (isOpen) {
            card.classList.remove("is-active");
            trigger.setAttribute("aria-expanded", "false");
            collapse.style.display = "none";
          } else {
            card.classList.add("is-active");
            trigger.setAttribute("aria-expanded", "true");
            collapse.style.display = "block";
          }
        });
      }
    });
  });
</script>

<style>
  /* =========================================================
     Hostamble Premium Questions Section
     - Left side stays STILL (sticky position: sticky)
     - Right side scrolls smoothly
     - Unique Hostamble Concierge Card, Instant Search, & Cards
     ========================================================= */

  .hostamble-faq-section {
    background-color: #fafbfc;
    padding: 95px 0 !important;
    overflow: visible !important;
  }

  .faq-bg-ambient {
    position: absolute;
    top: 5%;
    left: -8%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.05) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Two-Column Layout */
  .faq-grid-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.45fr);
    column-gap: clamp(36px, 5vw, 64px);
    align-items: stretch; /* Stretches left rail to match full scroll height */
    position: relative;
  }

  /* Left Side Rail: Remains STICKY and STILL while scrolling */
  .faq-side-rail {
    position: relative;
    height: 100%;
    min-width: 0;
  }

  .faq-sticky-container {
    position: -webkit-sticky;
    position: sticky;
    top: 100px; /* Stays fixed 100px below top navigation */
    display: flex;
    flex-direction: column;
    gap: 26px;
    z-index: 5;
  }

  /* Eyebrow Pill */
  .faq-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 80, 26, 0.08);
    border: 1px solid rgba(255, 80, 26, 0.2);
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-primary, #ff501a);
    width: fit-content;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary, #ff501a);
    box-shadow: 0 0 8px rgba(255, 80, 26, 0.8);
  }

  /* Main Section Title */
  .faq-main-title {
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(32px, 3.8vw, 44px);
    font-weight: 900;
    line-height: 1.15;
    color: #17181c;
    margin-bottom: 12px;
    letter-spacing: -0.025em;
  }

  .faq-lead-text {
    font-size: 16px;
    line-height: 1.6;
    color: #636c7e;
    margin: 0;
  }

  /* Concierge Support Card */
  .faq-concierge-card {
    background: linear-gradient(150deg, #ffffff 0%, #fff7f3 100%);
    border: 1px solid rgba(255, 80, 26, 0.18);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 16px 36px -16px rgba(255, 80, 26, 0.14), 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .faq-concierge-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 44px -16px rgba(255, 80, 26, 0.22);
  }

  .concierge-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .concierge-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .concierge-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff501a 0%, #ff7036 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 8px 16px -4px rgba(255, 80, 26, 0.4);
    border: 2px solid #ffffff;
  }

  .concierge-online-badge {
    position: absolute;
    right: -2px;
    bottom: 0px;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .badge-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #22c55e;
    border: 2px solid #ffffff;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.6);
  }

  .badge-ring {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: rgba(34, 197, 94, 0.35);
    animation: livePulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .concierge-meta {
    min-width: 0;
  }

  .concierge-badge-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-primary, #ff501a);
    margin-bottom: 2px;
  }

  .concierge-heading {
    margin: 0 0 3px;
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.25;
    color: #17181c;
  }

  .concierge-desc {
    margin: 0;
    font-size: 13.5px;
    color: #656d7e;
    line-height: 1.4;
  }

  /* Metrics Strip */
  .concierge-metrics-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid rgba(255, 80, 26, 0.12);
    border-radius: 10px;
    padding: 8px 12px;
    margin: 16px 0 14px;
    gap: 8px;
  }

  .metric-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #4b5260;
  }

  .metric-item i {
    color: var(--color-primary, #ff501a);
    font-size: 14px;
  }

  .metric-item strong {
    color: #17181c;
  }

  /* Actions */
  .concierge-actions {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .concierge-btn-chat {
    width: 100%;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    background: linear-gradient(135deg, #ff501a 0%, #ff6b30 100%);
    color: #ffffff;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 20px -6px rgba(255, 80, 26, 0.45);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .concierge-btn-chat:hover {
    background: linear-gradient(135deg, #e64512 0%, #ff501a 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -6px rgba(255, 80, 26, 0.55);
  }

  .concierge-sub-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .concierge-link-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    min-height: 42px;
    padding: 0 10px;
    border-radius: 9px;
    font-size: 13.5px;
    font-weight: 600;
    background-color: #ffffff;
    border: 1px solid #e5e8ee;
    color: #17181c;
    text-decoration: none;
    transition: all 0.2s ease;
  }

