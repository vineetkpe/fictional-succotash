---
// Hostamble Questions, Answered (FAQ) Block
// Modeled after modern high-converting support rails, styled 100% to Hostamble native design tokens.

interface FaqItem {
  question: string;
  answer: string;
  defaultOpen?: boolean;
}

const faqs: FaqItem[] = [
  {
    question: "What will I pay when my plan renews?",
    answer: "Your plan renews at the regular, transparent price displayed on our pricing table. We believe in honest pricing with zero hidden fees or surprise renewal spikes. Promotional discounts apply to your initial billing term unless explicitly stated.",
    defaultOpen: true,
  },
  {
    question: "Can I get a refund?",
    answer: "Yes! Every shared and WordPress hosting plan is backed by our 7-Day Risk-Free Money-Back Guarantee. If you are not completely satisfied with our performance or uptime, simply reach out to support within 7 days for a 100% refund.",
  },
  {
    question: "Do you add GST or hidden checkout fees to prices?",
    answer: "No surprise checkout costs! All prices and applicable taxes are transparently calculated and displayed before you make your payment. What you see is what you pay.",
  },
  {
    question: "Which payment methods can I use?",
    answer: "We support all major Indian and international payment methods. Pay easily via UPI (Google Pay, PhonePe, Paytm, BHIM), Net Banking from all Indian banks, Credit/Debit Cards, and PayPal for global customers. All payments are secured with 256-bit SSL encryption.",
  },
  {
    question: "Can you move my existing website for free?",
    answer: "Yes, 100% free with zero downtime! Our certified technical team will migrate your entire website—including WordPress files, MySQL databases, cPanel accounts, and emails—from your previous host completely free of charge.",
  },
  {
    question: "Is an SSL Certificate included?",
    answer: "Yes! Free automated Let's Encrypt SSL certificates are included with all hosting packages. They are pre-configured to install automatically and renew for lifetime across all your primary domains and subdomains.",
  },
  {
    question: "How do backups work?",
    answer: "We run automated regular backups powered by JetBackup to keep your data secure. You can easily generate, download, or restore files, databases, and full accounts with a single click directly inside your cPanel dashboard.",
  },
  {
    question: "Can I have email accounts on my own domain?",
    answer: "Yes! Every plan includes custom business email addresses (e.g., info@yourdomain.com), powerful webmail access, anti-spam filters, and IMAP/POP3 support to connect seamlessly with iOS Mail, Android, Outlook, and Gmail.",
  },
  {
    question: "Which hosting plan should I choose?",
    answer: "If you're launching a personal blog or small portfolio site, our Starter / Personal Shared Hosting plan is ideal. For businesses, WooCommerce stores, or growing WordPress sites, our Super or Turbo NVMe plans with LiteSpeed acceleration provide the fastest speeds and highest resource allocations.",
  },
  {
    question: "How can I get help?",
    answer: "Real hosting engineers are available 24/7 in both Hindi and English through Live Chat, WhatsApp (+91 62847 19083), and Support Tickets. Our average first-response time is under 5 minutes!",
  },
  {
    question: "Can I upgrade my hosting plan later?",
    answer: "Yes, anytime! As your traffic grows, you can seamlessly scale your storage, CPU, RAM, or upgrade to a dedicated VPS in one click with zero downtime through your Hostamble client portal.",
  },
];

// JSON-LD Structured Data for Google Rich Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="hostamble-faq-section ace-section-gap position-relative" id="faq" aria-labelledby="faq-main-title">
  <!-- Subtle decorative ambient backdrop elements -->
  <div class="faq-bg-ambient" aria-hidden="true"></div>

  <div class="container position-relative">
    <div class="faq-grid-layout">
      
      <!-- Sticky Side Rail: Heading + Support Card -->
      <div class="faq-side-rail">
        <div class="faq-sticky-container">
          
          <header class="faq-intro-header">
            <span class="faq-pretitle">Got Questions?</span>
            <h2 id="faq-main-title" class="faq-main-title">Questions, answered.</h2>
            <p class="faq-lead-text">The details worth knowing before you choose Hostamble.</p>
          </header>

          <!-- Support Contact Card -->
          <aside class="faq-support-card" aria-labelledby="faq-contact-card-title">
            <div class="faq-support-person">
              <div class="faq-agent-avatar" aria-hidden="true">
                <i class="ri-customer-service-2-fill"></i>
                <span class="faq-live-indicator" title="Online now"></span>
              </div>
              <div class="faq-agent-meta">
                <h3 id="faq-contact-card-title" class="faq-card-heading">Still have a question?</h3>
                <p class="faq-card-subheading">Talk to a real person in Hindi or English.</p>
              </div>
            </div>

            <div class="faq-actions-grid">
              <!-- Live Chat Action -->
              <button 
                type="button" 
                class="faq-btn-chat" 
                onclick="window.Tawk_API && window.Tawk_API.toggle ? window.Tawk_API.toggle() : window.location.href='/contacts'"
                title="Start a live chat"
              >
                <i class="ri-chat-smile-2-fill" aria-hidden="true"></i>
                <span>Chat with us</span>
              </button>

              <!-- WhatsApp Quick Action -->
              <a 
                href="https://wa.me/916284719083?text=Hi%20Hostamble,%20I%20have%20a%20question%20about%20hosting" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="faq-btn-link faq-btn-wa"
                title="Chat with us on WhatsApp"
              >
                <i class="ri-whatsapp-fill" aria-hidden="true"></i>
                <span>WhatsApp</span>
              </a>

              <!-- Support Ticket / Contact Action -->
              <a 
                href="/contacts" 
                class="faq-btn-link faq-btn-ticket"
                title="Submit a support ticket"
              >
                <i class="ri-ticket-2-line" aria-hidden="true"></i>
                <span>Open a ticket</span>
              </a>
            </div>
          </aside>

        </div>
      </div>

      <!-- Right Column: Accordion Questions List -->
      <div class="faq-questions-rail">
        <div class="faq-accordion-list" role="region" aria-label="Frequently Asked Questions">
          {faqs.map((faq) => (
            <details class="faq-accordion-item" open={faq.defaultOpen ? true : undefined}>
              <summary class="faq-accordion-question">
                <span class="faq-question-text">{faq.question}</span>
                <span class="faq-accordion-toggle" aria-hidden="true"></span>
              </summary>
              <div class="faq-accordion-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- FAQPage Schema for Search Engines -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  /* =========================================================
     Hostamble FAQ Section Styles
     Clean, modern sticky rail beside an uninterrupted list of answers.
     100% Hostamble typography, color tokens, and smooth physics.
     ========================================================= */

  .hostamble-faq-section {
    background-color: #ffffff;
    overflow: visible;
  }

  .faq-bg-ambient {
    position: absolute;
    top: 5%;
    left: -5%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.04) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Two-column layout matching modern reference */
  .faq-grid-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.45fr);
    column-gap: clamp(36px, 5vw, 76px);
    align-items: start;
    position: relative;
  }

  /* Sticky Side Rail */
  .faq-side-rail {
    position: relative;
    min-width: 0;
  }

  .faq-sticky-container {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 32px;
    min-width: 0;
  }

  /* Section Intro Header */
  .faq-intro-header {
    min-width: 0;
  }

  .faq-pretitle {
    display: inline-block;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-primary, #ff501a);
    margin-bottom: 10px;
  }

  .faq-main-title {
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(32px, 3.8vw, 44px);
    font-weight: 800;
    line-height: 1.18;
    color: #17181c;
    margin-bottom: 14px;
    letter-spacing: -0.02em;
  }

  .faq-lead-text {
    font-size: 16.5px;
    line-height: 1.6;
    color: #5d6676;
    margin: 0;
  }

  /* Support Card */
  .faq-support-card {
    min-width: 0;
    padding: 24px;
    border: 1px solid rgba(255, 80, 26, 0.16);
    border-radius: 18px;
    background: linear-gradient(150deg, #ffffff 0%, #fff7f3 100%);
    box-shadow: 0 20px 40px -20px rgba(255, 80, 26, 0.14), 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .faq-support-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 48px -18px rgba(255, 80, 26, 0.2), 0 6px 18px rgba(0, 0, 0, 0.04);
  }

  .faq-support-person {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .faq-agent-avatar {
    position: relative;
    flex: none;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff501a 0%, #ff723b 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 8px 18px -4px rgba(255, 80, 26, 0.38);
    border: 2px solid #ffffff;
  }

  .faq-live-indicator {
    position: absolute;
    right: -1px;
    bottom: 0px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #22c55e;
    border: 2.5px solid #ffffff;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.6);
  }

  .faq-agent-meta {
    min-width: 0;
  }

  .faq-card-heading {
    margin: 0 0 3px;
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
    color: #17181c;
  }

  .faq-card-subheading {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: #636b7b;
  }

  /* Support Actions Grid */
  .faq-actions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 20px;
  }

  .faq-btn-chat {
    grid-column: 1 / -1;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    background-color: var(--color-primary, #ff501a);
    color: #ffffff;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 20px -6px rgba(255, 80, 26, 0.4);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-btn-chat i {
    font-size: 18px;
  }

  .faq-btn-chat:hover {
    background-color: #e64512;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -6px rgba(255, 80, 26, 0.5);
  }

  .faq-btn-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    white-space: nowrap;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid #e7eaef;
    background-color: #ffffff;
    color: #17181c;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .faq-btn-link i {
    font-size: 17px;
  }

  .faq-btn-wa i {
    color: #25d366;
  }

  .faq-btn-ticket i {
    color: var(--color-primary, #ff501a);
  }

  .faq-btn-wa:hover {
    border-color: #25d366;
    color: #128c7e;
    background-color: #f6fdf8;
    transform: translateY(-1px);
  }

  .faq-btn-ticket:hover {
    border-color: var(--color-primary, #ff501a);
    color: var(--color-primary, #ff501a);
    background-color: #fff9f6;
    transform: translateY(-1px);
  }

  /* Right Column: Accordion List */
  .faq-questions-rail {
    min-width: 0;
  }

  .faq-accordion-list {
    border-top: 1px solid #e8ecf2;
  }

  .faq-accordion-item {
    border-bottom: 1px solid #e8ecf2;
    transition: background-color 0.2s ease;
  }

  .faq-accordion-item[open] {
    background-color: #fbfbfc;
  }

  .faq-accordion-question {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 74px;
    padding: 20px 40px 20px 0;
    list-style: none;
    cursor: pointer;
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 17.5px;
    font-weight: 700;
    line-height: 1.45;
    color: #17181c;
    user-select: none;
    transition: color 0.2s ease, padding 0.2s ease;
  }

  .faq-accordion-item[open] .faq-accordion-question {
    padding-left: 12px;
    color: var(--color-primary, #ff501a);
  }

  .faq-accordion-question::-webkit-details-marker {
    display: none;
  }

  .faq-accordion-question::marker {
    content: "";
  }

  .faq-accordion-question:hover {
    color: var(--color-primary, #ff501a);
  }

  .faq-question-text {
    padding-right: 16px;
  }

  /* Animated Plus/Minus Toggle */
  .faq-accordion-toggle {
    position: absolute;
    right: 6px;
    top: calc(50% - 9px);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .faq-accordion-toggle::before,
  .faq-accordion-toggle::after {
    content: "";
    position: absolute;
    top: 8px;
    left: 1px;
    width: 16px;
    height: 2px;
    background-color: var(--color-primary, #ff501a);
    border-radius: 2px;
    transition: transform 0.22s ease;
  }

  .faq-accordion-toggle::after {
    transform: rotate(90deg);
  }

  .faq-accordion-item[open] .faq-accordion-toggle::after {
    transform: rotate(0deg);
  }

  /* Answer Body */
  .faq-accordion-answer {
    padding: 0 40px 24px 0;
  }

  .faq-accordion-item[open] .faq-accordion-answer {
    padding-left: 12px;
  }

  .faq-accordion-answer p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.75;
    color: #555e6d;
    overflow-wrap: anywhere;
  }

  /* Responsive Adjustments */
  @media only screen and (max-width: 991px) {
    .faq-grid-layout {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }

    .faq-sticky-container {
      position: static;
      gap: 24px;
    }

    .faq-support-card {
      max-width: 520px;
    }

    .faq-accordion-question {
      min-height: 64px;
      padding: 18px 36px 18px 0;
      font-size: 16.5px;
    }

    .faq-accordion-answer {
      padding: 0 36px 20px 0;
    }
  }

  @media only screen and (max-width: 575px) {
    .faq-actions-grid {
      grid-template-columns: 1fr;
    }

    .faq-main-title {
      font-size: 28px;
    }

    .faq-accordion-question {
      font-size: 15.5px;
    }

    .faq-accordion-answer p {
      font-size: 14.5px;
    }
  }
</style>
