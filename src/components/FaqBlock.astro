---
// Hostamble Knowledge Base & FAQ Block
// Custom Modern Cloud Architecture:
// - Left: Sticky Topic Navigator & Live Engineering Desk (STAYS STILL WHILE SCROLLING)
// - Right: Live Search & Modern Elevated Question Cards with Feature Icons & Highlights

interface FaqItem {
  id: string;
  category: 'hosting' | 'domains' | 'billing' | 'support';
  categoryLabel: string;
  icon: string;
  question: string;
  answer: string;
  highlights?: string[];
  defaultOpen?: boolean;
}

const faqs: FaqItem[] = [
  {
    id: "faq-renewals",
    category: "billing",
    categoryLabel: "Pricing & Guarantee",
    icon: "ri-price-tag-3-line",
    question: "What will I pay when my plan renews?",
    answer: "Your plan renews at the regular transparent price shown on our pricing table. We never engage in sneaky price hikes or hidden renewal penalties. Any introductory promotional coupon applies to your initial billing term unless explicitly stated.",
    highlights: ["100% Price Transparency", "Zero Hidden Renewal Spikes"],
    defaultOpen: true,
  },
  {
    id: "faq-refund",
    category: "billing",
    categoryLabel: "Pricing & Guarantee",
    icon: "ri-shield-check-line",
    question: "Can I get a refund if I'm not satisfied?",
    answer: "Yes! All Hostamble shared and WordPress hosting packages come with a 7-Day Risk-Free Money-Back Guarantee. If our LiteSpeed speeds, pure NVMe storage, or 24/7 assistance don't meet your expectations, request a full refund within 7 days with zero questions asked.",
    highlights: ["7-Day Money-Back Guarantee", "100% Risk-Free"],
  },
  {
    id: "faq-gst",
    category: "billing",
    categoryLabel: "Pricing & Guarantee",
    icon: "ri-file-list-3-line",
    question: "Do you add GST or unexpected fees at checkout?",
    answer: "No checkout surprises! Every rupee and applicable tax is clearly calculated and displayed before you enter payment details. What you see is what you pay.",
    highlights: ["No Hidden Surcharges", "Clear GST Invoicing"],
  },
  {
    id: "faq-payments",
    category: "billing",
    categoryLabel: "Pricing & Guarantee",
    icon: "ri-bank-card-line",
    question: "Which payment methods do you accept?",
    answer: "We support all preferred Indian and global payment options. Pay securely using UPI (Google Pay, PhonePe, Paytm, BHIM), Net Banking across all banks, Credit & Debit Cards, or PayPal for international orders. All transactions are protected by 256-bit bank-grade SSL encryption.",
    highlights: ["Instant UPI & Cards", "Bank-Grade Encryption"],
  },
  {
    id: "faq-migration",
    category: "hosting",
    categoryLabel: "Performance & Speeds",
    icon: "ri-rocket-2-line",
    question: "Can you move my existing website for free?",
    answer: "Yes, 100% free with zero downtime! Our in-house technical team handles complete migrations—including your WordPress installation, MySQL databases, cPanel settings, and email accounts—with no website interruption.",
    highlights: ["100% Free Migration", "Zero Downtime Guarantee"],
  },
  {
    id: "faq-ssl",
    category: "domains",
    categoryLabel: "Domains & Security",
    icon: "ri-lock-2-line",
    question: "Is an SSL Certificate included with hosting?",
    answer: "Yes! Lifetime automated Let's Encrypt SSL certificates come pre-integrated on all hosting plans. They generate and renew automatically for your main domain, subdomains, and addon domains with zero manual configuration.",
    highlights: ["Free Lifetime SSL", "Automated HTTPS Renewal"],
  },
  {
    id: "faq-backups",
    category: "hosting",
    categoryLabel: "Performance & Speeds",
    icon: "ri-database-2-line",
    question: "How do backups work on Hostamble?",
    answer: "Automated daily backups powered by JetBackup safeguard your website files, databases, and mailboxes. You can restore a single file, database table, or your complete account with one click directly inside your cPanel dashboard.",
    highlights: ["Automated JetBackup", "1-Click Full Restore"],
  },
  {
    id: "faq-email",
    category: "domains",
    categoryLabel: "Domains & Security",
    icon: "ri-mail-line",
    question: "Can I create professional email accounts on my domain?",
    answer: "Yes! Every plan includes business domain emails (e.g. info@yourdomain.com), an intuitive webmail portal, SpamAssassin defense, and full IMAP/POP3/SMTP support to sync with iOS Mail, Android, Outlook, and Gmail.",
    highlights: ["Custom Domain Email", "Smartphone & Outlook Sync"],
  },
  {
    id: "faq-plan-choice",
    category: "hosting",
    categoryLabel: "Performance & Speeds",
    icon: "ri-dashboard-3-line",
    question: "Which hosting plan is right for my project?",
    answer: "For single landing pages, personal blogs, or student portfolios, our Starter plan is ideal. For businesses, WooCommerce shops, or agencies hosting multiple clients, our Super or Turbo NVMe plans with LiteSpeed acceleration provide lightning-fast TTFB and top performance.",
    highlights: ["Starter for Personal Sites", "Turbo for High-Traffic E-commerce"],
  },
  {
    id: "faq-support",
    category: "support",
    categoryLabel: "Technical Support",
    icon: "ri-customer-service-2-line",
    question: "How can I get help if something goes wrong?",
    answer: "Our certified hosting engineers are available 24/7/365 in both Hindi and English. Reach us instantly through Live Chat, WhatsApp (+91 62847 19083), or Support Ticket. Our average response time is under 3 minutes!",
    highlights: ["24/7 Hindi & English", "Average Reply < 3 Mins"],
  },
  {
    id: "faq-upgrade",
    category: "hosting",
    categoryLabel: "Performance & Speeds",
    icon: "ri-line-chart-line",
    question: "Can I easily upgrade my plan as my website grows?",
    answer: "Yes, anytime! You can scale your disk quota, CPU cores, RAM, or seamlessly upgrade to a dedicated Cloud VPS with zero downtime directly through your Hostamble client portal.",
    highlights: ["Instant Scalability", "Zero-Downtime Upgrades"],
  },
];

// Schema.org FAQPage structured data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="hostamble-knowledge-section" id="faq" aria-labelledby="knowledge-main-heading">
  <!-- Subtle decorative ambient accents -->
  <div class="kb-glow-circle glow-top-left" aria-hidden="true"></div>
  <div class="kb-glow-circle glow-bottom-right" aria-hidden="true"></div>

  <div class="container position-relative">
    <div class="kb-layout-grid">
      
      <!-- =========================================================
           LEFT COLUMN: Sticky Navigation & Support Concierge Desk
           (Pinned & Still on Screen While Right Questions Scroll)
           ========================================================= -->
      <aside class="kb-side-rail" aria-label="Knowledgebase Categories & Support">
        <div class="kb-sticky-holder">
          
          <!-- Header Area -->
          <div class="kb-intro-block">
            <div class="kb-tag-pill">
              <span class="pill-radar-dot"></span>
              <span>Hostamble Knowledge Base</span>
            </div>
            <h2 id="knowledge-main-heading" class="kb-headline">Everything You Need To Know.</h2>
            <p class="kb-subhead">Clear answers to technical details, guarantees, and hosting policies so you can deploy with confidence.</p>
          </div>

          <!-- Interactive Topic Selector -->
          <nav class="kb-topic-nav" aria-label="Filter FAQ Topics">
            <span class="topic-nav-label">Browse by topic</span>
            <div class="topic-buttons-list">
              <button type="button" class="topic-btn active" data-category="all">
                <i class="ri-apps-2-line"></i>
                <span class="topic-name">All Questions</span>
                <span class="topic-count">11</span>
              </button>
              <button type="button" class="topic-btn" data-category="hosting">
                <i class="ri-rocket-2-line"></i>
                <span class="topic-name">Performance &amp; Speeds</span>
                <span class="topic-count">4</span>
              </button>
              <button type="button" class="topic-btn" data-category="domains">
                <i class="ri-lock-2-line"></i>
                <span class="topic-name">Domains &amp; SSL</span>
                <span class="topic-count">2</span>
              </button>
              <button type="button" class="topic-btn" data-category="billing">
                <i class="ri-shield-check-line"></i>
                <span class="topic-name">Pricing &amp; 7-Day Refund</span>
                <span class="topic-count">4</span>
              </button>
              <button type="button" class="topic-btn" data-category="support">
                <i class="ri-customer-service-2-line"></i>
                <span class="topic-name">24/7 Technical Support</span>
                <span class="topic-count">1</span>
              </button>
            </div>
          </nav>

          <!-- Live Engineering Help Desk Widget -->
          <div class="kb-live-desk-card">
            <div class="desk-status-bar">
              <span class="desk-pulse-indicator">
                <span class="desk-dot-ring"></span>
                <span class="desk-dot-core"></span>
              </span>
              <span class="desk-status-text">Server Engineers Online</span>
            </div>

            <h4 class="desk-card-title">Need personalized assistance?</h4>
            <p class="desk-card-desc">Speak directly with our technical team in Hindi or English.</p>

            <div class="desk-actions-stack">
              <button 
                type="button" 
                class="desk-primary-btn" 
                onclick="window.Tawk_API && window.Tawk_API.toggle ? window.Tawk_API.toggle() : window.location.href='/contacts'"
              >
                <i class="ri-chat-voice-line"></i>
                <span>Start Live Chat</span>
              </button>

              <div class="desk-secondary-row">
                <a 
                  href="https://wa.me/916284719083?text=Hi%20Hostamble,%20I%20have%20a%20question%20about%20hosting" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="desk-sub-btn wa-sub-btn"
                >
                  <i class="ri-whatsapp-fill"></i>
                  <span>WhatsApp</span>
                </a>

                <a href="/contacts" class="desk-sub-btn ticket-sub-btn">
                  <i class="ri-mail-send-line"></i>
                  <span>Contact Us</span>
                </a>
              </div>
            </div>

            <div class="desk-guarantee-note">
              <i class="ri-time-line"></i>
              <span>Average response time: <strong>&lt; 3 mins</strong></span>
            </div>
          </div>

        </div>
      </aside>

      <!-- =========================================================
           RIGHT COLUMN: Scrollable Questions Rail & Live Search
           ========================================================= -->
      <main class="kb-questions-rail" aria-label="Frequently Asked Questions List">
        
        <!-- Search Input Bar -->
        <div class="kb-search-bar">
          <i class="ri-search-2-line kb-search-icon" aria-hidden="true"></i>
          <input 
            type="text" 
            id="kbSearchInput" 
            class="kb-search-field" 
            placeholder="Type keywords to filter (e.g. refund, migration, SSL, cPanel, UPI)..."
            autocomplete="off"
          />
          <button type="button" id="kbClearSearch" class="kb-clear-btn d-none" aria-label="Clear Search">
            <i class="ri-close-line"></i>
          </button>
        </div>

        <!-- Questions Cards Container -->
        <div class="kb-cards-stack" id="kbCardsStack">
          {faqs.map((faq, index) => {
            const num = (index + 1).toString().padStart(2, '0');
            return (
              <article 
                class={`kb-question-card ${faq.defaultOpen ? 'card-open' : ''}`}
                data-category={faq.category}
                data-faq-id={faq.id}
              >
                <button 
                  type="button" 
                  class="kb-card-header-btn" 
                  aria-expanded={faq.defaultOpen ? "true" : "false"}
                  aria-controls={`kb-body-${faq.id}`}
                >
                  <!-- Left: Icon Pod -->
                  <div class="kb-card-icon-pod" aria-hidden="true">
                    <i class={faq.icon}></i>
                  </div>

                  <!-- Center: Category Tag & Question -->
                  <div class="kb-card-text-block">
                    <span class="kb-card-category">{faq.categoryLabel}</span>
                    <h3 class="kb-card-question-title">{faq.question}</h3>
                  </div>

                  <!-- Right: Number Badge & Chevron Toggle -->
                  <div class="kb-card-action-block">
                    <span class="kb-card-num-badge">#{num}</span>
                    <div class="kb-card-toggle-pod" aria-hidden="true">
                      <i class="ri-arrow-down-s-line kb-toggle-chevron"></i>
                    </div>
                  </div>
                </button>

                <!-- Expandable Answer Panel -->
                <div 
                  id={`kb-body-${faq.id}`} 
                  class="kb-card-expandable"
                  style={faq.defaultOpen ? "display: block;" : "display: none;"}
                >
                  <div class="kb-card-content">
                    <p class="kb-answer-text">{faq.answer}</p>
                    
                    {faq.highlights && (
                      <div class="kb-highlights-wrap">
                        {faq.highlights.map(tag => (
                          <span class="kb-micro-pill">
                            <i class="ri-checkbox-circle-fill"></i>
                            <span>{tag}</span>
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })}

          <!-- Zero Results State -->
          <div id="kbNoResults" class="kb-empty-state d-none">
            <div class="empty-icon-wrap"><i class="ri-search-eye-line"></i></div>
            <h4 class="empty-heading">No matching questions found</h4>
            <p class="empty-desc">Have a specific question not listed here? Our server engineers are online right now to help you.</p>
            <button type="button" class="empty-reset-btn" id="kbResetBtn">View All Questions</button>
          </div>
        </div>

      </main>

    </div>
  </div>

  <!-- FAQPage Schema for Search Engines -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<!-- Interactive Script for Live Search, Topic Filtering & Card Toggles -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("kbSearchInput");
    const clearBtn = document.getElementById("kbClearSearch");
    const topicBtns = document.querySelectorAll(".topic-btn");
    const cards = document.querySelectorAll(".kb-question-card");
    const noResults = document.getElementById("kbNoResults");
    const resetBtn = document.getElementById("kbResetBtn");

    let currentCat = "all";
    let currentQuery = "";

    function applyFilter() {
      let count = 0;
      const query = currentQuery.trim().toLowerCase();

      cards.forEach(card => {
        const cat = card.getAttribute("data-category");
        const cardText = card.textContent.toLowerCase();

        const catMatches = (currentCat === "all") || (cat === currentCat);
        const queryMatches = (query === "") || cardText.includes(query);

        if (catMatches && queryMatches) {
          card.style.display = "block";
          count++;
        } else {
          card.style.display = "none";
        }
      });

      if (noResults) {
        if (count === 0) {
          noResults.classList.remove("d-none");
        } else {
          noResults.classList.add("d-none");
        }
      }

      if (clearBtn) {
        if (query.length > 0) {
          clearBtn.classList.remove("d-none");
        } else {
          clearBtn.classList.add("d-none");
        }
      }
    }

    // Topic filter click
    topicBtns.forEach(btn => {
      btn.addEventListener("click", function () {
        topicBtns.forEach(b => b.classList.remove("active"));
        this.classList.add("active");
        currentCat = this.getAttribute("data-category") || "all";
        applyFilter();
      });
    });

    // Search input
    if (searchInput) {
      searchInput.addEventListener("input", function () {
        currentQuery = this.value;
        applyFilter();
      });
    }

    // Clear search
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (searchInput) {
          searchInput.value = "";
          currentQuery = "";
          searchInput.focus();
          applyFilter();
        }
      });
    }

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener("click", function () {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        currentCat = "all";
        topicBtns.forEach(b => {
          b.classList.toggle("active", b.getAttribute("data-category") === "all");
        });
        applyFilter();
      });
    }

    // Card Accordion Click
    cards.forEach(card => {
      const headerBtn = card.querySelector(".kb-card-header-btn");
      const expandPanel = card.querySelector(".kb-card-expandable");

      if (headerBtn && expandPanel) {
        headerBtn.addEventListener("click", function () {
          const isOpen = card.classList.contains("card-open");

          // Optional: close other open cards for clean reading
          cards.forEach(other => {
            if (other !== card && other.classList.contains("card-open")) {
              other.classList.remove("card-open");
              const otherBtn = other.querySelector(".kb-card-header-btn");
              const otherPanel = other.querySelector(".kb-card-expandable");
              if (otherBtn) otherBtn.setAttribute("aria-expanded", "false");
              if (otherPanel) otherPanel.style.display = "none";
            }
          });

          if (isOpen) {
            card.classList.remove("card-open");
            headerBtn.setAttribute("aria-expanded", "false");
            expandPanel.style.display = "none";
          } else {
            card.classList.add("card-open");
            headerBtn.setAttribute("aria-expanded", "true");
            expandPanel.style.display = "block";
          }
        });
      }
    });
  });
</script>

<style>
  /* =========================================================
     Hostamble Modern Cloud Knowledge Section
     - Left Side: Stationary / Sticky Rail (100% Still on Scroll)
     - Right Side: Interactive Search & Modern Elevated Question Pods
     - Tech Icon Pods, Topic Selector, & In-House Support Hub
     ========================================================= */

  .hostamble-knowledge-section {
    position: relative;
    background-color: #f8fafc;
    padding: 100px 0 !important;
    overflow: visible !important;
  }

  .kb-glow-circle {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .glow-top-left {
    top: 0;
    left: -15%;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.05) 0%, rgba(248, 250, 252, 0) 70%);
  }

  .glow-bottom-right {
    bottom: 0;
    right: -15%;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.04) 0%, rgba(248, 250, 252, 0) 70%);
  }

  /* Two Column Responsive Grid */
  .kb-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.45fr);
    column-gap: clamp(36px, 5vw, 68px);
    align-items: stretch; /* Stretches left column so sticky has full scroll travel */
    position: relative;
  }

  /* =========================================================
     LEFT SIDE: Sticky Holder (STAYS STILL)
     ========================================================= */

  .kb-side-rail {
    position: relative;
    height: 100%;
    min-width: 0;
  }

  .kb-sticky-holder {
    position: -webkit-sticky;
    position: sticky;
    top: 95px; /* Pinned in view below the header */
    display: flex;
    flex-direction: column;
    gap: 24px;
    z-index: 5;
  }

  /* Intro Block */
  .kb-intro-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kb-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid rgba(255, 80, 26, 0.22);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-primary, #ff501a);
    box-shadow: 0 4px 12px rgba(255, 80, 26, 0.06);
    width: fit-content;
  }

  .pill-radar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary, #ff501a);
    box-shadow: 0 0 8px rgba(255, 80, 26, 0.8);
  }

  .kb-headline {
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 900;
    line-height: 1.16;
    color: #11141d;
    margin: 0;
    letter-spacing: -0.025em;
  }

  .kb-subhead {
    font-size: 15.5px;
    line-height: 1.6;
    color: #616c7f;
    margin: 0;
  }

  /* Topic Navigator on Left Rail */
  .kb-topic-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #e7ebf2;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
  }

  .topic-nav-label {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #8c97a8;
    padding-left: 8px;
    margin-bottom: 4px;
  }

  .topic-buttons-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .topic-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: none;
    color: #434c5e;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .topic-btn i {
    font-size: 16px;
    color: #8892a2;
    transition: color 0.2s ease;
  }

  .topic-name {
    flex-grow: 1;
  }

  .topic-count {
    background: #f1f4f9;
    color: #6a7689;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
  }

  .topic-btn:hover {
    background: #fdf6f3;
    color: var(--color-primary, #ff501a);
  }

  .topic-btn:hover i {
    color: var(--color-primary, #ff501a);
  }

  .topic-btn.active {
    background: #fff4f0;
    border-color: rgba(255, 80, 26, 0.25);
    color: var(--color-primary, #ff501a);
    font-weight: 700;
  }

  .topic-btn.active i {
    color: var(--color-primary, #ff501a);
  }

  .topic-btn.active .topic-count {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
  }

  /* Live Help Desk Widget */
  .kb-live-desk-card {
    background: #ffffff;
    border: 1px solid rgba(255, 80, 26, 0.18);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 12px 32px -12px rgba(255, 80, 26, 0.12), 0 4px 12px rgba(0, 0, 0, 0.02);
  }

  .desk-status-bar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .desk-pulse-indicator {
    position: relative;
    width: 8px;
    height: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .desk-dot-core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
  }

  .desk-dot-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(22, 163, 74, 0.35);
    animation: livePulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .desk-status-text {
    font-size: 11.5px;
    font-weight: 700;
    color: #15803d;
  }

  .desk-card-title {
    margin: 0 0 4px;
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 17px;
    font-weight: 800;
    color: #11141d;
  }

  .desk-card-desc {
    margin: 0 0 16px;
    font-size: 13px;
    color: #647083;
    line-height: 1.45;
  }

  .desk-actions-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .desk-primary-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
