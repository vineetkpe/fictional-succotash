const defaultCategories: CategoryItem[] = [
  { id: "general", label: "General" },
  { id: "hosting", label: "Hosting & WordPress" },
  { id: "billing", label: "Pricing & Renewals" },
  { id: "support", label: "Migration & Support" },
  { id: "domains", label: "Domains & SSL" },
];

const {
  preTitle = "COMMON QUESTIONS",
  title = "Got Questions? We’ve Got Answers.",
  description = "Clear, honest facts about renewals, free migrations, LiteSpeed speeds, and our direct WhatsApp support.",
  items,
  categories,
  searchPlaceholder = "Search common questions (e.g., migration, refund, UPI, cPanel)...",
  whatsAppText = "Hi Hostamble, I have a question about your hosting plans",
  conciergeTitle = "Still have questions or need custom setup?",
  conciergeDesc = "Talk directly with our in-house hosting team. We speak your language and usually reply in under 3 minutes."
} = Astro.props;

const displayFaqs = items || faqs;

function slugify(str: string): string {
  return (str || "").toLowerCase().trim().replace(/[^a-z0-9]+/g, "-");
}

let displayCategories: CategoryItem[] = categories || [];
if (!displayCategories || displayCategories.length === 0) {
  if (items && items.length > 0) {
    const rawCats = Array.from(new Set(items.map(f => f.categoryLabel || f.category || "General")));
    displayCategories = [
      { id: "all", label: "All Questions" },
      ...rawCats.map(c => ({ id: slugify(c), label: c }))
    ];
  } else {
    displayCategories = defaultCategories;
  }
}

const defaultActiveCat = displayCategories[0]?.id || "all";

// Schema.org FAQPage structured data for Google SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": displayFaqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="hostamble-faq-section" id="faq" aria-labelledby="faq-main-heading">
  <!-- Subtle ambient decorative glow -->
  <div class="faq-ambient-glow" aria-hidden="true"></div>

  <div class="container position-relative">
    
    <!-- Standard Hostamble Centered Section Header -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-8 col-12 text-center">
        <div class="section-title text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <span class="pre-title">{preTitle}</span>
          <h2 id="faq-main-heading" class="title">{title}</h2>
          <p class="description mt-2">
            {description}
          </p>
        </div>
      </div>
    </div>

    <!-- Interactive Filter Toolbar: Category Pills + Search -->
    <div class="faq-toolbar-wrap" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
      
      <!-- Category Filter Pills -->
      <nav class="faq-categories-nav" aria-label="Filter FAQ Topics">
        {displayCategories.map((cat, idx) => (
          <button 
            type="button" 
            class={`faq-cat-pill ${idx === 0 ? 'active' : ''}`} 
            data-category={cat.id}
          >
            <span>{cat.label}</span>
          </button>
        ))}
      </nav>

      <!-- Instant Search Input -->
      <div class="faq-search-box">
        <i class="ri-search-2-line faq-search-icon" aria-hidden="true"></i>
        <input 
          type="text" 
          id="faqSearchInput" 
          class="faq-search-input" 
          placeholder={searchPlaceholder}
          autocomplete="off"
        />
        <button type="button" id="faqClearSearch" class="faq-clear-btn d-none" aria-label="Clear Search">
          <i class="ri-close-line"></i>
        </button>
      </div>

    </div>

    <!-- Centered Accordion Stack (Max-Width 920px for optimal reading) -->
    <div class="faq-accordion-container" id="faqCardsStack" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
      {displayFaqs.map((faq, idx) => {
        const faqCatSlug = slugify(faq.category || "general");
        const faqCatLabel = faq.categoryLabel || faq.category || "General";
        const faqId = faq.id || `faq-${idx}`;
        const isDefaultVisible = (defaultActiveCat === 'all') || (faqCatSlug === defaultActiveCat) || (slugify(faq.categoryLabel || "") === defaultActiveCat) || (faq.category === defaultActiveCat);
        return (
          <article 
            class={`faq-item-card ${faq.defaultOpen ? 'is-open' : ''}`}
            data-category={faqCatSlug}
            data-faq-id={faqId}
            style={isDefaultVisible ? "display: block;" : "display: none;"}
          >
            <button 
              type="button" 
              class="faq-header-trigger" 
              aria-expanded={faq.defaultOpen ? "true" : "false"}
              aria-controls={`faq-answer-${faqId}`}
            >
              <div class="faq-question-meta">
                <span class="faq-cat-label">{faqCatLabel}</span>
                <h3 class="faq-question-text">{faq.question}</h3>
              </div>
              <div class="faq-toggle-icon" aria-hidden="true">
                <i class="ri-add-line icon-plus"></i>
                <i class="ri-subtract-line icon-minus"></i>
              </div>
            </button>

            <div 
              id={`faq-answer-${faqId}`} 
              class="faq-answer-collapse"
              style={faq.defaultOpen ? "display: block;" : "display: none;"}
            >
              <div class="faq-answer-body">
                <p class="faq-answer-text">{faq.answer}</p>
              </div>
            </div>
          </article>
        );
      })}

      <!-- Zero Results Fallback -->
      <div id="faqNoResults" class="faq-empty-state d-none">
        <div class="faq-empty-icon"><i class="ri-search-eye-line"></i></div>
        <h4 class="faq-empty-title">No matching questions found</h4>
        <p class="faq-empty-text">Have a specific question not listed here? Our support team is online right now to help you.</p>
        <button type="button" class="faq-empty-reset" id="faqResetBtn">View All Questions</button>
      </div>
    </div>

    <!-- Bottom Human Support Reassurance Card -->
    <div class="faq-bottom-concierge" data-sal="slide-up" data-sal-delay="300" data-sal-duration="800">
      <div class="concierge-content">
        <div class="concierge-icon-wrap" aria-hidden="true">
          <i class="ri-customer-service-2-fill"></i>
        </div>
        <div class="concierge-text">
          <h4 class="concierge-title">{conciergeTitle}</h4>
          <p class="concierge-desc">
            {conciergeDesc}
          </p>
        </div>
      </div>
      <div class="concierge-actions">
        <a 
          href={`https://wa.me/916284719083?text=${encodeURIComponent(whatsAppText)}`} 
          class="concierge-btn btn-whatsapp"
          target="_blank" 
          rel="noopener noreferrer"
        >
          <i class="ri-whatsapp-fill"></i>
          <span>WhatsApp Chat</span>
        </a>
        <a 
          href="https://hostamble.com/dash/submitticket.php?step=2&deptid=1" 
          class="concierge-btn btn-ticket"
          target="_blank" 
          rel="noopener noreferrer"
        >
          <i class="ri-ticket-2-line"></i>
          <span>Submit a Ticket</span>
        </a>
      </div>
    </div>

  </div>

  <!-- Schema.org FAQPage Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<!-- Client-side Interactive Filter & Accordion Script -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("faqSearchInput");
    const clearBtn = document.getElementById("faqClearSearch");
    const catPills = document.querySelectorAll(".faq-cat-pill");
    const cards = document.querySelectorAll(".faq-item-card");
    const noResults = document.getElementById("faqNoResults");
    const resetBtn = document.getElementById("faqResetBtn");

    const activePill = document.querySelector(".faq-cat-pill.active");
    let activeCat = activePill ? (activePill.getAttribute("data-category") || "all") : "all";
    let activeQuery = "";

    function filterFaqs() {
      let visibleCount = 0;
      const query = activeQuery.trim().toLowerCase();

      cards.forEach(card => {
        const cat = card.getAttribute("data-category");
        const text = card.textContent.toLowerCase();

        // When user types a search query, search across all questions; otherwise filter by activeCat
        const catMatches = (query.length > 0) ? true : (activeCat === "all" || cat === activeCat);
        const queryMatches = (query === "") || text.includes(query);

        if (catMatches && queryMatches) {
          card.style.display = "block";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("d-none");
        } else {
          noResults.classList.add("d-none");
        }
      }

      if (clearBtn) {
        if (query.length > 0) {
          clearBtn.classList.remove("d-none");
        } else {
          clearBtn.classList.add("d-none");
        }
      }
    }

    // Category Pill Click
    catPills.forEach(pill => {
      pill.addEventListener("click", function () {
        catPills.forEach(p => p.classList.remove("active"));
        this.classList.add("active");
        activeCat = this.getAttribute("data-category") || "all";
        filterFaqs();
      });
    });

    // Search Input Typing
    if (searchInput) {
      searchInput.addEventListener("input", function () {
        activeQuery = this.value;
        filterFaqs();
      });
    }

    // Clear Search Button
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (searchInput) {
          searchInput.value = "";
          activeQuery = "";
          searchInput.focus();
          filterFaqs();
        }
      });
    }

    // Reset Filter Button
    if (resetBtn) {
      resetBtn.addEventListener("click", function () {
        if (searchInput) searchInput.value = "";
        activeQuery = "";
        if (catPills.length > 0) {
          catPills.forEach((p, idx) => {
            p.classList.toggle("active", idx === 0);
          });
          activeCat = catPills[0].getAttribute("data-category") || "all";
        }
        filterFaqs();
      });
    }

    // Run filter on initial load
    filterFaqs();

    // Accordion Toggle Behavior
    cards.forEach(card => {
      const trigger = card.querySelector(".faq-header-trigger");
      const answer = card.querySelector(".faq-answer-collapse");

      if (trigger && answer) {
        trigger.addEventListener("click", function () {
          const isOpen = card.classList.contains("is-open");

          // Close other cards for clean, focused reading
          cards.forEach(other => {
            if (other !== card && other.classList.contains("is-open")) {
              other.classList.remove("is-open");
              const otherTrigger = other.querySelector(".faq-header-trigger");
              const otherAnswer = other.querySelector(".faq-answer-collapse");
              if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
              if (otherAnswer) otherAnswer.style.display = "none";
            }
          });

          if (isOpen) {
            card.classList.remove("is-open");
            trigger.setAttribute("aria-expanded", "false");
            answer.style.display = "none";
          } else {
            card.classList.add("is-open");
            trigger.setAttribute("aria-expanded", "true");
            answer.style.display = "block";
          }
        });
      }
    });
  });
</script>

<style>
  /* =========================================================
     Hostamble Modern FAQ Block
     - Clean, focused, human-first design
     - Centered layout matching Testimonials & Blog
