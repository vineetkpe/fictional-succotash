---
// Hostamble Frequently Asked Questions Block
// - Clean, modern, human-first FAQ design unified with Hostamble's design system
// - Centered header matching TestimonialsBlock & BlogBlock
// - Horizontal topic filter pills + instant keyword search
// - Clean elevated accordion cards without artificial AI clutter or badges
// - Direct WhatsApp & In-House Support concierge card at the bottom
// - Schema.org FAQPage structured data for Google SEO rich snippets

interface FaqItem {
  id: string;
  category: string;
  categoryLabel: string;
  question: string;
  answer: string;
  defaultOpen?: boolean;
}

interface CategoryItem {
  id: string;
  label: string;
}

interface Props {
  preTitle?: string;
  title?: string;
  description?: string;
  items?: FaqItem[];
  categories?: CategoryItem[];
  searchPlaceholder?: string;
  whatsAppText?: string;
  conciergeTitle?: string;
  conciergeDesc?: string;
}

