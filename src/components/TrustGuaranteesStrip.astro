---
// Hostamble Native Theme Trust & Guarantees Strip
---

<div class="trust-theme-section" aria-label="Hostamble Guarantees">
  <div class="container">
    <div class="trust-theme-bar">
      
      <!-- 1: 99.9% Uptime -->
      <a href="#plans" class="trust-feature-col">
        <div class="trust-icon-box">
          <i class="ri-pulse-line" aria-hidden="true"></i>
        </div>
        <div class="trust-feature-info">
          <h5 class="feature-title">99.9% Uptime</h5>
          <span class="feature-subtitle">Zero-Downtime Guarantee</span>
        </div>
      </a>

      <div class="trust-col-divider d-none d-lg-block" aria-hidden="true"></div>

      <!-- 2: WhatsApp Support -->
      <a 
        href="https://wa.me/916284719083?text=Hi%20Hostamble,%20I%20have%20a%20question%20about%20hosting" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="trust-feature-col"
      >
        <div class="trust-icon-box icon-whatsapp">
          <i class="ri-whatsapp-line" aria-hidden="true"></i>
        </div>
        <div class="trust-feature-info">
          <h5 class="feature-title">WhatsApp Support</h5>
          <span class="feature-subtitle">Instant Live Assistance</span>
        </div>
      </a>

      <div class="trust-col-divider d-none d-lg-block" aria-hidden="true"></div>

      <!-- 3: 7-Day Refund Policy -->
      <a href="/refund-and-cancellation-policy" class="trust-feature-col">
        <div class="trust-icon-box">
          <i class="ri-refund-2-line" aria-hidden="true"></i>
        </div>
        <div class="trust-feature-info">
          <h5 class="feature-title">7-Day Refund Policy</h5>
          <span class="feature-subtitle">100% Risk-Free Guarantee</span>
        </div>
      </a>

      <div class="trust-col-divider d-none d-lg-block" aria-hidden="true"></div>

      <!-- 4: Trusted by 10,000+ Webmasters -->
      <div class="trust-feature-col">
        <div class="trust-icon-box">
          <i class="ri-user-star-line" aria-hidden="true"></i>
        </div>
        <div class="trust-feature-info">
          <h5 class="feature-title">10,000+ Webmasters</h5>
          <span class="feature-subtitle">Trusted Across India &amp; Global</span>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .trust-theme-section {
    position: relative;
    z-index: 5;
    margin-top: -10px;
    margin-bottom: 25px;
  }

  .trust-theme-bar {
    background: var(--color-white, #ffffff);
    border: 1px solid var(--color-border, #eeeeee);
    border-radius: var(--radius-small, 5px);
    box-shadow: 0px 8px 30px rgba(0, 0, 0, 0.03);
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: 0.35s ease;
  }

  .trust-theme-bar:hover {
    box-shadow: 0px 12px 35px rgba(0, 0, 0, 0.06);
  }

  .trust-feature-col {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    text-decoration: none;
    color: inherit;
    transition: 0.3s ease;
  }

  .trust-icon-box {
    width: 48px;
    height: 48px;
    background: var(--color-secondary-alt, #FFF6F4);
    border: 1px solid rgba(var(--color-primary-rgb, 210, 116, 29), 0.15);
    border-radius: var(--radius-small, 5px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary, #ff501a);
    font-size: 23px;
    flex-shrink: 0;
    transition: 0.3s ease;
  }

  .trust-feature-col:hover .trust-icon-box {
    background: var(--color-primary, #ff501a);
    color: #ffffff;
    border-color: var(--color-primary, #ff501a);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(var(--color-primary-rgb, 210, 116, 29), 0.25);
  }

  .trust-feature-col:hover .trust-icon-box.icon-whatsapp {
    background: #25d366;
    border-color: #25d366;
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.28);
  }

  .trust-feature-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .feature-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--color-heading, #202133);
    margin: 0 0 2px 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.25s ease;
    white-space: nowrap;
  }

  .trust-feature-col:hover .feature-title {
    color: var(--color-primary, #ff501a);
  }

  .feature-subtitle {
    font-size: 12.5px;
    font-weight: 400;
    color: var(--color-body, #6F6B80);
    line-height: 1.25;
    margin: 0;
    white-space: nowrap;
  }

  .trust-col-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border, #eeeeee);
    flex-shrink: 0;
  }

  @media (max-width: 991px) {
    .trust-theme-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      padding: 22px 20px;
    }
    .trust-theme-section {
      margin-top: 15px;
      margin-bottom: 25px;
    }
  }

  @media (max-width: 576px) {
    .trust-theme-bar {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 18px;
    }
  }
</style>
