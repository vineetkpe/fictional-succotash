---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Hostamble — 24/7 Technical Support & Sales Inquiries"
  description="Contact Hostamble's dedicated support team 24/7/365 via WhatsApp, email, live chat, or support ticket. We're here to help you resolve any hosting inquiries."
  keywords="contact hostamble, hosting customer support, hostamble whatsapp, web hosting help desk india"
>
<!--first block -->
         

         <div class="slider-area banner banner-style-two bg-image d-flex align-items-center  height-800">
            <div class="container">
               <div class="row g-5 align-items-center">
                  <div class="col-lg-6 col-md-12">
                     <div class="inner">
                        <div class="content">
                           
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                               Contact Now
                           </h1>
                           <p class="description mb-4" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              Easily accessible customer service is crucial in today's , online business environment Hostamble's experienced team Members. 
                           </p>
                          
                           <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                              <a class="ace-btn" href="#plans">Get Started Today <i class="icon-arrow-right-line-right"></i></a>
                           </div>
                        </div>
                     </div>
                  </div>
                  <div class="col-lg-6">
                     <div class="banner-thumbnail">
                        <img class="img-thumb" src="/assets/images/banner04.png" alt="Banner Images" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
                     </div>
                  
                  </div>
               </div>
               <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                  <div class="shape-image shape-image-1">
                     <img src="/assets/images/shape1108.png" alt="Shape Thumb">
                  </div>
                  <div class="shape-image shape-image-2">
                     <img src="/assets/images/shape03.png" alt="Shape Thumb">
                  </div>
                  <div class="shape-image shape-image-3">
                     <img src="/assets/images/shape2302.png" alt="Shape Thumb">
                  </div>
               </div>
            </div>
         </div>


          <div class="ace-contact-us-area aceorbit-contact-us ace-section-gap bg-color-white" id="plans">
            <div class="container aceorbit-animated-shape">
                <div class="row g-5">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Need Help?</span>
                            <h3 class="title">Get In Touch With us</h3>
                        </div>
                    </div>
                </div>
                <div class="row g-5 mt--20">
                    <div class="col-lg-6">
                        <div class="contact-info pr--70 pr_lg--0 pr_md--0 pr_sm--0">
                            <div class="row g-5">
                                <div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                    <div class="contact-address-card-1 website">
                                        <div class="inner">
                                            <div class="icon">
                                                <i class="ri-global-line"></i>
                                            </div>
                                            <div class="content">
                                                <h6 class="title">Sales</h6>
                                                <p><a href="tel:1234567890" target="_blank">Phone: 91 628 471 9083</a></p>
                                                <p><a href="mailto:support@hostamble.com" target="_blank">Mail: support@hostamble.com</a></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                              
                                <div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                                    <div class="contact-address-card-1 phone">
                                        <div class="inner">
                                            <div class="icon">
                                                <i class="icon-mail-open-line"></i>
                                            </div>
                                            <div class="content">
                                                <h6 class="title">Billing</h6>
                                                <p><a href="mailto:billing@hostamble.in" target="_blank">Mail: billing@hostamble.in</a></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                                    <div class="contact-address-card-1 email">
                                        <div class="inner">
                                            <div class="icon">
                                             <i class="icon-Headphone"></i>
                                                
                                            </div>
                                            <div class="content">
                                                <h6 class="title">Technical</h6>
                                                <p><a href="tel:1234567890" target="_blank">Phone: 91 628 471 9083</a></p>
                                                <p><a href="mailto:support@hostamble.com" target="_blank">Mail: support@hostamble.com</a></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                                    <div class="contact-address-card-1 location">
                                        <div class="inner">
                                            <div class="icon">
                                                <i class="icon-map-pin-line"></i>
                                            </div>
                                            <div class="content">
                                                <h6 class="title">Our Location</h6>
                                                <p>Asia , India</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                

                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <form class="rnt-contact-form rwt-dynamic-form row" id="contact-form" method="POST">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <input name="contact-name" id="contact-name" type="text" class="form-control form-control-lg" placeholder="Name*">
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="form-group">
                                    <input type="email" class="form-control form-control-lg" id="contact-email" name="contact-email" placeholder="Email*">
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-lg" name="contact-phone" id="contact-phone" placeholder="Phone">
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="form-group">
                                    <input type="text" class="form-control form-control-lg" id="subject" name="subject" placeholder="Subject">
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <textarea class="form-control" name="contact-message" id="contact-message" placeholder="Your Message"></textarea>
                                </div>
                            </div>
                            <div class="col-lg-12">
                              <a href="https://hostamble.com/dash/contact.php" style="text-decoration:none;">
                                 <button class="ace-btn w-100 mt-3" type="button">
                                    Contact Now <i class="icon-arrow-right-line-right"></i>
                                 </button>
                               </a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image scene shape-image-1">
                        <span data-depth="-2.2">
                            <img src="/assets/images/shape0401.png" alt="Shape Thumb">
                        </span>
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0208.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape15.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>
</Layout>
