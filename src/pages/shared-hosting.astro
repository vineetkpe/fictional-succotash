    box-shadow: 0 10px 22px rgba(255, 80, 26, 0.28);
  }
</style>

<script is:inline>
  (function () {
    function initCardSpotlight() {
      const cards = document.querySelectorAll(".flow-enhanced-card");
      cards.forEach(function (card) {
        card.addEventListener("mousemove", function (e) {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty("--mouse-x", x + "px");
          card.style.setProperty("--mouse-y", y + "px");
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCardSpotlight);
    } else {
      initCardSpotlight();
    }
    document.addEventListener("astro:page-load", initCardSpotlight);
  })();
</script>
