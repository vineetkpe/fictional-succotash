                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.starter.pricing.biennial?.totalInr}</span>
                                        <span class="renewal-note">{plans.starter.pricing.biennial?.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="monthly-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.starter.pricing.monthly.inr}
                                        data-usd={plans.starter.pricing.monthly.usd}
                                        >{plans.starter.pricing.monthly.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.starter.pricing.monthly.totalInr}</span>
                                        <span class="renewal-note">{plans.starter.pricing.monthly.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="semiannual-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.starter.pricing.semiannual?.inr}
                                        data-usd={plans.starter.pricing.semiannual?.usd}
                                        >{plans.starter.pricing.semiannual?.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.starter.pricing.semiannual?.totalInr}</span>
                                        <span class="renewal-note">{plans.starter.pricing.semiannual?.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="annual-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.starter.pricing.annual.inr}
                                        data-usd={plans.starter.pricing.annual.usd}
                                        >{plans.starter.pricing.annual.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.starter.pricing.annual.totalInr}</span>
                                        <span class="renewal-note">{plans.starter.pricing.annual.renewalInr}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pricing-body">
                            <ul class="list-item">
                                <li style="color: #000; font-weight: bold;">
                                    5 websites
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    15 GB SSD storage
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    150 GB monthly bandwidth
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    5 email accounts — 1 GB each
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    Free SSL for all hosted websites
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    WordPress + Softaculous installer
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    LiteSpeed Server
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    Imunify360 security protection
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    Daily backups — 3-day retention
                                </li>
                                <li style="color: #16a34a; font-weight: bold;">
                                    1 domain free for 1 year — two-year plan only
                                </li>
                            </ul>
                        </div>

                        <div class="pricing-btn">
                            <a
                                class="ace-btn"
                                data-base-url="https://hostamble.com/dash/store/sharedhosting/starter"
                                href="https://hostamble.com/dash/store/sharedhosting/starter?billingcycle=biennially"
                                >Buy This Plan</a
                            >
                        </div>
                    </div>
                </div>

                <!-- Elite Plan -->
                <div
                    class="col-xl-4 col-lg-6 col-md-6 col-12"
                    data-sal="slide-up"
                    data-sal-delay="250"
                    data-sal-duration="800"
                >
                    <div class="pricing-table">
                        <div class="pricing-header">
                            <h3 class="title">Elite</h3>

                            <div class="price-wrap">
                                <div
                                    class="biennial-pricing"
                                    style="display: block;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.elite.pricing.biennial?.inr}
