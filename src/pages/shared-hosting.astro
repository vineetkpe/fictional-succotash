                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.elite.pricing.biennial?.totalInr}</span>
                                        <span class="renewal-note">{plans.elite.pricing.biennial?.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="monthly-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.elite.pricing.monthly.inr}
                                        data-usd={plans.elite.pricing.monthly.usd}
                                        >{plans.elite.pricing.monthly.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.elite.pricing.monthly.totalInr}</span>
                                        <span class="renewal-note">{plans.elite.pricing.monthly.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="semiannual-pricing"
                                    style="display: none;"
