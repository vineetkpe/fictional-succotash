---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import InteractiveHeroIllustration from '../components/InteractiveHeroIllustration.astro';
import SoftaculousAppsShowcase from '../components/SoftaculousAppsShowcase.astro';
import { sharedHosting, sharedPlanSpecs } from '../data/pricing';
import PlanSpecsTable from '../components/PlanSpecsTable.astro';

const plans = sharedHosting.plans;

import FaqBlock from '../components/FaqBlock.astro';

// Shared Hosting Help Pillars
const sharedHostingHelpPillars = [
  {
    icon: "ri-rocket-2-line",
    title: "100% Free Site Migration",
    desc: "Moving from GoDaddy, Hostinger, or Namecheap? Our team moves all your files, databases, and emails with zero downtime."
  },
  {
    icon: "ri-flashlight-line",
    title: "LiteSpeed & PHP Tuning",
    desc: "Free assistance configuring LiteSpeed Cache (LSCache) for WordPress, WooCommerce, or custom PHP web apps."
  },
  {
    icon: "ri-mail-check-line",
    title: "Professional Business Webmail",
    desc: "Step-by-step guidance setting up custom domain mailboxes with SPF, DKIM, DMARC, and mobile sync."
  },
  {
    icon: "ri-shield-check-line",
    title: "Imunify360 Security & AutoSSL",
    desc: "Continuous AI server security, automated malware cleanup, and free Let's Encrypt SSL certificates."
  }
];

// High-Intent SEO FAQs for Shared Web Hosting
const sharedHostingFaqs = [
  {
    id: "faq-what-is-shared-hosting",
    category: "general",
    categoryLabel: "General & cPanel",
    question: "What is Shared Web Hosting and who is it best for?",
    answer: "Shared Web Hosting is a cost-effective, high-performance hosting solution where multiple websites reside on a single physical enterprise server, with resources isolated using CloudLinux OS. Each account is partitioned with its own dedicated CPU, RAM, and I/O limits so that other users cannot impact your site's speed. It is ideal for small to medium businesses, blogs, eCommerce stores, and personal websites seeking enterprise LiteSpeed speed at an affordable price.",
    defaultOpen: true
  },
  {
    id: "faq-free-site-migration",
    category: "migration",
    categoryLabel: "Migration & Support",
    question: "Do you offer free website migration from my current hosting provider?",
    answer: "Yes, 100% free migration! If your website is currently hosted with GoDaddy, Hostinger, Bluehost, Namecheap, BigRock, or any cPanel host, our senior migration engineers will transfer your website files, MariaDB/MySQL databases, and email inboxes seamlessly with zero downtime.",
    defaultOpen: false
  },
  {
    id: "faq-cpanel-included",
    category: "general",
    categoryLabel: "General & cPanel",
    question: "Is genuine cPanel control panel included with every plan?",
    answer: "Yes. Every Hostamble shared hosting account comes with the genuine, official cPanel control dashboard. You get full access to File Manager, MySQL/MariaDB database wizard, phpMyAdmin, email accounts, DNS zone editor, cron jobs, and the Softaculous 1-click app installer.",
    defaultOpen: false
  },
  {
    id: "faq-litespeed-vs-apache",
    category: "speed",
    categoryLabel: "Speed & Tech",
    question: "How does LiteSpeed Enterprise make my website faster than Apache hosting?",
    answer: "Hostamble servers run commercial LiteSpeed Enterprise Web Server with native LSCache support, rather than traditional Apache. LiteSpeed handles concurrent visitors up to 10x faster, consumes less server memory, accelerates dynamic PHP requests, and supports modern HTTP/3 and QUIC protocols for instantaneous page delivery.",
    defaultOpen: false
  },
  {
    id: "faq-security-imunify360",
    category: "security",
    categoryLabel: "Security & Backups",
    question: "What security protection is included? Do you use Imunify360?",
    answer: "Yes. All our shared hosting nodes are protected by the enterprise Imunify360 AI security suite. Imunify360 provides 24/7 proactive real-time malware scanning, automatic infected file disinfection, advanced Web Application Firewall (WAF), brute-force defense, and DoS mitigation. Additionally, free Let's Encrypt Wildcard SSL is automatically installed and renewed on all domains.",
    defaultOpen: false
  },
  {
    id: "faq-daily-backups-jetbackup",
    category: "security",
    categoryLabel: "Security & Backups",
    question: "Are automated daily backups included, and how do I restore them?",
    answer: "Yes. Automated daily snapshots are captured using JetBackup 5 and stored in a secure offsite disaster-recovery location. From inside your cPanel dashboard, you can perform 1-click self-service restores for full accounts, individual files, databases, or email mailboxes at any time without opening a support ticket.",
    defaultOpen: false
  },
  {
    id: "faq-host-multiple-websites",
    category: "general",
    categoryLabel: "General & cPanel",
    question: "Can I host multiple domains and websites on one plan?",
    answer: "Our Basic plan is tailored for 1 website, while our Standard and Advanced plans allow you to host multiple websites under one hosting package by adding secondary addon domains inside your cPanel. Each website maintains its own isolated root directory and SSL certificate.",
    defaultOpen: false
  },
  {
    id: "faq-business-email",
    category: "general",
    categoryLabel: "General & cPanel",
    question: "Can I create custom business email accounts (like you@yourdomain.com)?",
    answer: "Yes. You can create custom domain-branded email addresses directly in cPanel. Features include webmail access (Roundcube), IMAP/POP3 mobile synchronization (Outlook, Apple Mail, Gmail), autoresponders, email forwarding, and SpamAssassin anti-spam filtering.",
    defaultOpen: false
  },
  {
    id: "faq-php-versions-databases",
    category: "speed",
    categoryLabel: "Speed & Tech",
    question: "Which PHP versions, databases, and developer tools are supported?",
    answer: "We provide an interactive Multi-PHP Selector supporting PHP 8.1, 8.2, 8.3, and 8.4 with OPcache acceleration. For databases, we run MariaDB 10.6+ and MySQL 8 with phpMyAdmin access. Developer runtimes like Node.js, Python, Ruby, and Git version control are also supported.",
    defaultOpen: false
  },
  {
    id: "faq-money-back-guarantee",
    category: "migration",
    categoryLabel: "Migration & Support",
    question: "Is there a money-back guarantee?",
    answer: "Yes! Hostamble provides an unconditional 30-day money-back guarantee on annual shared hosting plans. If you are not completely satisfied with our server performance or support within your first 30 days, we will issue a full refund with zero questions asked.",
    defaultOpen: false
  },
  {
    id: "faq-upgrade-plan",
    category: "general",
    categoryLabel: "General & cPanel",
    question: "Can I upgrade to a higher shared hosting or VPS plan as my traffic grows?",
    answer: "Absolutely. You can seamlessly scale your hosting plan at any time through the client dashboard. Upgrades are instantaneous, preserve all files and databases, and involve zero downtime. When your business outgrows shared hosting, our team can migrate you to a dedicated Cloud VPS with 1 click.",
    defaultOpen: false
  },
  {
    id: "faq-customer-support",
    category: "migration",
    categoryLabel: "Migration & Support",
    question: "How do I get technical support when I need assistance?",
    answer: "Our expert technical team is available 24/7/365. You can reach out directly via WhatsApp for rapid personal assistance, start a Live Chat on our website, or open a support ticket in your client dashboard. Average response time on WhatsApp is under 5 minutes.",
    defaultOpen: false
  }
];

const sharedHostingFaqCategories = [
  { id: "all", label: "All Questions" },
  { id: "general", label: "General & cPanel" },
  { id: "speed", label: "Speed & Technology" },
  { id: "security", label: "Security & Backups" },
  { id: "migration", label: "Migration & Support" }
];
---

<Layout 
  title="Affordable Shared Web Hosting Plans with cPanel & Free SSL | Hostamble"
  description="Host your website on fast, secure cPanel shared hosting starting at affordable rates. Includes free SSL, unmetered bandwidth, NVMe SSD storage, and dedicated WhatsApp support."
  keywords="shared hosting, cpanel hosting, affordable web hosting india, cheap shared hosting, fast website hosting"
>
<!--mobile menu end here-->


  <!--first block -->
         
         <div class="slider-area banner img2 bg-image d-flex align-items-center">
            <div class="container">
               <div class="row g-5 align-items-center">
                  <div class="col-lg-6 col-md-12">
                     <div class="inner">
                        <div class="content">
                           <div class="hero-eyebrow-pill mb-3" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
                              <span class="eyebrow-dot"></span>
                              <span class="eyebrow-label">SHARED HOSTING</span>
                              <span class="eyebrow-sep">•</span>
                              <span class="eyebrow-tag">FROM <span data-inr={sharedHosting.heroStartPrice.inr} data-usd={sharedHosting.heroStartPrice.usd}>{sharedHosting.heroStartPrice.inr}</span></span>
                           </div>
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                              Fast, Reliable Shared Hosting Built for High Performance
                           </h1>
                           <p class="description mb-4" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              Perfect for personal blogs, business portfolios, and fast-growing sites. Powered by LiteSpeed Enterprise, pure NVMe SSDs, and genuine cPanel.
                           </p>

                           <div class="hero-features-list mb-4 d-flex flex-wrap gap-2" data-sal="slide-up" data-sal-delay="280" data-sal-duration="800">
                              <div class="hero-pill-badge">
                                 <i class="ri-flashlight-fill text-primary-accent"></i>
                                 <span>LiteSpeed Turbo</span>
                              </div>
                              <div class="hero-pill-badge">
                                 <i class="ri-shield-check-fill text-success-accent"></i>
                                 <span>Free SSL &amp; JetBackup</span>
                              </div>
                              <div class="hero-pill-badge">
                                 <i class="ri-dashboard-3-line text-warning"></i>
                                 <span>cPanel Control</span>
                              </div>
                           </div>

                           <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                              <a class="ace-btn" href="#plans">Get Started Today <i class="icon-arrow-right-line-right"></i></a>
                           </div>
                           <div class="arrow-sign d-lg-block d-none">
                              <img src="/assets/images/arrow.png" alt="Banner Images" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
                           </div>
                        </div>
                     </div>
                  </div>
                  <div class="col-lg-6">
                     <InteractiveHeroIllustration 
                       image="/assets/images/banner05.png"
                       alt="Hostamble cPanel NVMe Shared Web Hosting Platform"
                       badge1Label="99.9% Uptime"
                       badge1Value="Zero-Downtime NVMe"
                       badge1Icon="ri-pulse-line"
                       badge2Label="LiteSpeed Turbo"
                       badge2Value="10x Faster PHP"
                       badge2Tag="NVMe TURBO"
                       badge2Icon="ri-rocket-2-fill"
                       badge3Label="cPanel Included"
                       badge3Value="Official Dashboard"
                       badge3Icon="ri-dashboard-3-line"
                       badge4Label="Free SSL & Backups"
                       badge4Value="Automated JetBackup"
                       badge4Icon="ri-shield-check-fill"
                     />
                  </div>
               </div>
               <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                  <div class="shape-image shape-image-1">
                     <img src="/assets/images/shape19.png" alt="Shape Thumb">
                  </div>
                  <div class="shape-image shape-image-2">
                     <img src="/assets/images/shape0501.png" alt="Shape Thumb">
                  </div>
                  <div class="shape-image shape-image-3">
                     <img src="/assets/images/shape1901.png" alt="Shape Thumb">
                  </div>
               </div>
            </div>
         </div>

 
             <!--pricing start here-->
    <div
        class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image"
        id="plans"
    >
        <div class="container aceorbit-animated-shape">
            <div class="row g-4 align-items-center mb-3">
                <div class="col-lg-5 col-md-12">
                    <div
                        class="section-title text-start"
                        data-sal="slide-up"
                        data-sal-delay="150"
                        data-sal-duration="800"
                    >
                        <span class="pre-title">Pricing Plan</span>

                        <h3 class="title mb-0">Choose Your Pricing Plan</h3>
                    </div>
                </div>

                <div class="col-lg-7 col-md-12 text-lg-end text-center mt-3 mt-lg-0">
                    <div class="pricing-billing-duration">
                        <ul>
                            <li class="nav-item">
                                <button
                                    class="nav-link"
                                    id="monthly-plan-btn"
                                    data-cycle="monthly"
                                    onclick="updatePricing('monthly');"
                                    type="button"
                                    aria-pressed="false">Monthly</button
                                >
                            </li>

                            <li class="nav-item">
                                <button
                                    class="nav-link"
                                    id="semiannual-plan-btn"
                                    data-cycle="semiannual"
                                    onclick="updatePricing('semiannual');"
                                    type="button"
                                    aria-pressed="false">Semi-Annual</button
                                >
                            </li>

                            <li class="nav-item">
                                <button
                                    class="nav-link"
                                    id="annual-plan-btn"
                                    data-cycle="annual"
                                    onclick="updatePricing('annual');"
                                    type="button"
                                    aria-pressed="false">Annual</button
                                >
                            </li>

                            <li class="nav-item">
                                <button
                                    class="nav-link active"
                                    id="biennial-plan-btn"
                                    data-cycle="biennial"
                                    onclick="updatePricing('biennial');"
                                    type="button"
                                    aria-pressed="true">2 Years <span class="badge-best-value ms-1">Best value</span></button
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row g-5 mt--20">
                <!-- Basic Plan -->
                <div
                    class="col-xl-4 col-lg-6 col-md-6 col-12"
                    data-sal="slide-up"
                    data-sal-delay="150"
                    data-sal-duration="800"
                >
                    <div class="pricing-table">
                        <div class="pricing-header">
                            <h3 class="title">Basic</h3>

                            <div class="price-wrap">
                                <div
                                    class="biennial-pricing"
                                    style="display: block;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.basic.pricing.biennial?.inr}
                                        data-usd={plans.basic.pricing.biennial?.usd}
                                        >{plans.basic.pricing.biennial?.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.basic.pricing.biennial?.totalInr}</span>
                                        <span class="renewal-note">{plans.basic.pricing.biennial?.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="monthly-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.basic.pricing.monthly.inr}
                                        data-usd={plans.basic.pricing.monthly.usd}
                                        >{plans.basic.pricing.monthly.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.basic.pricing.monthly.totalInr}</span>
                                        <span class="renewal-note">{plans.basic.pricing.monthly.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="semiannual-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.basic.pricing.semiannual?.inr}
                                        data-usd={plans.basic.pricing.semiannual?.usd}
                                        >{plans.basic.pricing.semiannual?.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.basic.pricing.semiannual?.totalInr}</span>
                                        <span class="renewal-note">{plans.basic.pricing.semiannual?.renewalInr}</span>
                                    </div>
                                </div>

                                <div
                                    class="annual-pricing"
                                    style="display: none;"
                                >
                                    <span
                                        class="amount"
                                        data-inr={plans.basic.pricing.annual.inr}
                                        data-usd={plans.basic.pricing.annual.usd}
                                        >{plans.basic.pricing.annual.inr}</span
                                    >
                                    <span class="duration">/month</span>
                                    <div class="pricing-billing-terms">
                                        <span class="billed-total">{plans.basic.pricing.annual.totalInr}</span>
                                        <span class="renewal-note">{plans.basic.pricing.annual.renewalInr}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pricing-body">
                            <ul class="list-item">
                                <li style="color: #000; font-weight: bold;">
