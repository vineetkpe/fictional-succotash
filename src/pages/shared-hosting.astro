    bottom: 5%;
    right: -100px;
    animation-delay: -7s;
  }

  @keyframes orbFloatingFlow {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
    100% { transform: translate(-30px, 25px) scale(0.95); }
