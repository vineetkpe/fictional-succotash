  /* Icon Spring Transition */
  .flow-enhanced-card .inner .icon span {
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), 
                box-shadow 0.4s ease !important;
  }

  .flow-enhanced-card:hover .inner .icon span {
