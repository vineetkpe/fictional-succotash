                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    5 GB SSD storage
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    50 GB monthly bandwidth
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    1 email account — 500 MB
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    Free SSL certificate
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    WordPress + Softaculous installer
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    2 databases + 5 subdomains
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    Daily backups — 3-day retention
                                </li>
                                <li style="color: #000; font-weight: bold;">
                                    1 standard website migration
                                </li>
                                <li style="color: #16a34a; font-weight: bold;">
                                    1 domain free for 1 year — two-year plan only
                                </li>
                            </ul>
                        </div>

                        <div class="pricing-btn">
                            <a
                                class="ace-btn btn-dark"
                                data-base-url="https://hostamble.com/dash/store/sharedhosting/basic"
                                href="https://hostamble.com/dash/store/sharedhosting/basic?billingcycle=biennially"
                                >Buy This Plan</a
                            >
                        </div>
                    </div>
                </div>

                <!-- Starter Plan -->
                <div
                    class="col-xl-4 col-lg-6 col-md-6 col-12"
                    data-sal="slide-up"
                    data-sal-delay="200"
                    data-sal-duration="800"
                >
                    <div class="pricing-table active">
                        <div class="pricing-header">
                            <div class="ace-badge">
                                <span>Recommended</span>
                            </div>

                            <h3 class="title">Starter</h3>

                            <div class="price-wrap">
                                <div
                                    class="biennial-pricing"
                                    style="display: block;"
                                >
                                    <span
