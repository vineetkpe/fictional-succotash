---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import InteractiveHeroIllustration from '../components/InteractiveHeroIllustration.astro';
import SoftaculousAppsShowcase from '../components/SoftaculousAppsShowcase.astro';
import { sharedHosting } from '../data/pricing';

const plans = sharedHosting.plans;
---

<Layout 
  title="Affordable Shared Web Hosting Plans with cPanel & Free SSL | Hostamble"
  description="Host your website on fast, secure cPanel shared hosting starting at affordable rates. Includes free SSL, unmetered bandwidth, NVMe SSD storage, and dedicated WhatsApp support."
  keywords="shared hosting, cpanel hosting, affordable web hosting india, cheap shared hosting, fast website hosting"
>
<!--mobile menu end here-->


  <!--first block -->
         
         <div class="slider-area banner img2 bg-image d-flex align-items-center">
            <div class="container">
               <div class="row g-5 align-items-center">
                  <div class="col-lg-6 col-md-12">
                     <div class="inner">
                        <div class="content">
                           <div class="hero-eyebrow-pill mb-3" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
                              <span class="eyebrow-dot"></span>
                              <span class="eyebrow-label">SHARED HOSTING</span>
                              <span class="eyebrow-sep">•</span>
                              <span class="eyebrow-tag">FROM <span data-inr={sharedHosting.heroStartPrice.inr} data-usd={sharedHosting.heroStartPrice.usd}>{sharedHosting.heroStartPrice.inr}</span></span>
                           </div>
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                              Shared Hosting - At it's Simplest Best
                           </h1>
                           <p class="description mb-4" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              Perfect for personal blogs, business portfolios, and fast-growing sites. Powered by LiteSpeed Enterprise, pure NVMe SSDs, and genuine cPanel.
                           </p>

                           <div class="hero-features-list mb-4 d-flex flex-wrap gap-2" data-sal="slide-up" data-sal-delay="280" data-sal-duration="800">
                              <div class="hero-pill-badge">
                                 <i class="ri-flashlight-fill text-primary-accent"></i>
                                 <span>LiteSpeed Turbo</span>
                              </div>
                              <div class="hero-pill-badge">
                                 <i class="ri-shield-check-fill text-success-accent"></i>
                                 <span>Free SSL &amp; JetBackup</span>
                              </div>
                              <div class="hero-pill-badge">
                                 <i class="ri-dashboard-3-line text-warning"></i>
                                 <span>cPanel Control</span>
                              </div>
                           </div>

                           <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                              <a class="ace-btn" href="#plans">Get Started Today <i class="icon-arrow-right-line-right"></i></a>
                           </div>
                           <div class="arrow-sign d-lg-block d-none">
                              <img src="/assets/images/arrow.png" alt="Banner Images" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
                           </div>
                        </div>
                     </div>
                  </div>
                  <div class="col-lg-6">
                     <InteractiveHeroIllustration 
                       image="/assets/images/banner05.png"
                       alt="Hostamble cPanel NVMe Shared Web Hosting Platform"
                       badge1Label="99.9% Uptime"
                       badge1Value="Zero-Downtime NVMe"
                       badge1Icon="ri-pulse-line"
                       badge2Label="LiteSpeed Turbo"
                       badge2Value="10x Faster PHP"
                       badge2Tag="NVMe TURBO"
                       badge2Icon="ri-rocket-2-fill"
                       badge3Label="cPanel Included"
                       badge3Value="Official Dashboard"
                       badge3Icon="ri-dashboard-3-line"
                       badge4Label="Free SSL & Backups"
                       badge4Value="Automated JetBackup"
                       badge4Icon="ri-shield-check-fill"
                     />
                  </div>
               </div>
               <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                  <div class="shape-image shape-image-1">
                     <img src="/assets/images/shape19.png" alt="Shape Thumb">
                  </div>
                  <div class="shape-image shape-image-2">
                     <img src="/assets/images/shape0501.png" alt="Shape Thumb">
                  </div>
                  <div class="shape-image shape-image-3">
                     <img src="/assets/images/shape1901.png" alt="Shape Thumb">
                  </div>
               </div>
            </div>
         </div>

 
         <div class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image" id="plans">
          <div class="container aceorbit-animated-shape">
          <div class="row g-5">
          <div class="col-lg-6 col-md-6">
          <div class="section-title text-start" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800"><span class="pre-title">Pricing Plan</span>
          
          <h3 class="title">Choose Your Pricing Plan</h3>
          </div>
          </div>
          
          <div class="col-lg-6 col-md-6">
          <div class="pricing-billing-duration">
          <ul>
            <li class="nav-item"><button class="nav-link active" id="monthly-plan-btn" onclick="updatePricing('monthly')" type="button">Monthly</button></li>
            <li class="nav-item"><button class="nav-link" id="quarterly-plan-btn" onclick="updatePricing('quarterly')" type="button">Quarterly</button></li>
            <li class="nav-item"><button class="nav-link" id="semiannual-plan-btn" onclick="updatePricing('semiannual')" type="button">Semi-Annual</button></li>
            <li class="nav-item"><button class="nav-link" id="annual-plan-btn" onclick="updatePricing('annual')" type="button">Annual</button></li>
          </ul>
          </div>
          </div>
          </div>
          
          <div class="row g-5 mt--20"><!-- Basic Plan -->
          <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <div class="pricing-table">
          <div class="pricing-header">
          <h3 class="title">Basic</h3>
          
          <div class="price-wrap">
          <div class="monthly-pricing" style="display: block;"><span class="amount" data-inr={plans.basic.pricing.monthly.inr} data-usd={plans.basic.pricing.monthly.usd}>{plans.basic.pricing.monthly.inr}</span> <span class="duration">/monthly</span></div>
          
          <div class="quarterly-pricing" style="display: none;"><span class="amount" data-inr={plans.basic.pricing.quarterly.inr} data-usd={plans.basic.pricing.quarterly.usd}>{plans.basic.pricing.quarterly.inr}</span> <span class="duration">/quarterly</span></div>
          
          <div class="semiannual-pricing" style="display: none;"><span class="amount" data-inr={plans.basic.pricing.semiannual.inr} data-usd={plans.basic.pricing.semiannual.usd}>{plans.basic.pricing.semiannual.inr}</span> <span class="duration">/semiannual</span></div>
          
          <div class="annual-pricing" style="display: none;"><span class="amount" data-inr={plans.basic.pricing.annual.inr} data-usd={plans.basic.pricing.annual.usd}>{plans.basic.pricing.annual.inr}</span> <span class="duration">/annual</span></div>
          </div>
          </div>
          
          <div class="pricing-body">
          <ul class="list-item">
            <li class="free-domain" style="display: none; color: #000; font-weight: bold;">Free Domain</li>
            <li style="color: #000; font-weight: bold;">1 Website</li>
            <li style="color: #000; font-weight: bold;">4 GB SSD</li>
            <li style="color: #000; font-weight: bold;">40 GB Bandwidth</li>
            <li style="color: #000; font-weight: bold;">2 MySql Database</li>
            <li style="color: #000; font-weight: bold;">1 Subdomain</li>
            <li style="color: #000; font-weight: bold;">Bitninja Security</li>
            <li style="color: #000; font-weight: bold;">Free JetBackup</li>
            <li style="color: #000; font-weight: bold;">SSL Included</li>
          </ul>
          </div>
          
          <div class="pricing-btn"><a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/sharedhosting/basic">Buy This Plan</a></div>
          </div>
          </div>
          <!-- Starter Plan -->
          
          <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          <div class="pricing-table active">
          <div class="pricing-header">
          <div class="ace-badge"><span>Recommended</span></div>
          
          <h3 class="title">Starter</h3>
          
          <div class="price-wrap">
          <div class="monthly-pricing" style="display: block;"><span class="amount" data-inr={plans.starter.pricing.monthly.inr} data-usd={plans.starter.pricing.monthly.usd}>{plans.starter.pricing.monthly.inr}</span> <span class="duration">/monthly</span></div>
          
          <div class="quarterly-pricing" style="display: none;"><span class="amount" data-inr={plans.starter.pricing.quarterly.inr} data-usd={plans.starter.pricing.quarterly.usd}>{plans.starter.pricing.quarterly.inr}</span> <span class="duration">/quarterly</span></div>
          
          <div class="semiannual-pricing" style="display: none;"><span class="amount" data-inr={plans.starter.pricing.semiannual.inr} data-usd={plans.starter.pricing.semiannual.usd}>{plans.starter.pricing.semiannual.inr}</span> <span class="duration">/semiannual</span></div>
          
          <div class="annual-pricing" style="display: none;"><span class="amount" data-inr={plans.starter.pricing.annual.inr} data-usd={plans.starter.pricing.annual.usd}>{plans.starter.pricing.annual.inr}</span> <span class="duration">/annual</span> <span class="free-domain">+ Free Domain</span></div>
          </div>
          </div>
          
          <div class="pricing-body">
          <ul class="list-item">
            <li class="free-domain" style="display: none; color: #000; font-weight: bold;">Free Domain</li>
            <li style="color: #000; font-weight: bold;">3 Websites</li>
            <li style="color: #000; font-weight: bold;">10 GB SSD</li>
            <li style="color: #000; font-weight: bold;">100 GB Bandwidth</li>
            <li style="color: #000; font-weight: bold;">6 MySql Database</li>
            <li style="color: #000; font-weight: bold;">3 Subdomains</li>
            <li style="color: #000; font-weight: bold;">Bitninja Security</li>
            <li style="color: #000; font-weight: bold;">Free JetBackup</li>
            <li style="color: #000; font-weight: bold;">SSL Included</li>
          </ul>
          </div>
          
          <div class="pricing-btn"><a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/sharedhosting/starter">Buy This Plan</a></div>
          </div>
          </div>
          <!-- Elite Plan -->
          
          <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
          <div class="pricing-table">
          <div class="pricing-header">
          <h3 class="title">Elite</h3>
          
          <div class="price-wrap">
          <div class="monthly-pricing" style="display: block;"><span class="amount" data-inr={plans.elite.pricing.monthly.inr} data-usd={plans.elite.pricing.monthly.usd}>{plans.elite.pricing.monthly.inr}</span> <span class="duration">/monthly</span></div>
          
          <div class="quarterly-pricing" style="display: none;"><span class="amount" data-inr={plans.elite.pricing.quarterly.inr} data-usd={plans.elite.pricing.quarterly.usd}>{plans.elite.pricing.quarterly.inr}</span> <span class="duration">/quarterly</span></div>
          
          <div class="semiannual-pricing" style="display: none;"><span class="amount" data-inr={plans.elite.pricing.semiannual.inr} data-usd={plans.elite.pricing.semiannual.usd}>{plans.elite.pricing.semiannual.inr}</span> <span class="duration">/semiannual</span></div>
          
          <div class="annual-pricing" style="display: none;"><span class="amount" data-inr={plans.elite.pricing.annual.inr} data-usd={plans.elite.pricing.annual.usd}>{plans.elite.pricing.annual.inr}</span> <span class="duration">/annual</span> <span class="free-domain">+ Free Domain</span></div>
          </div>
          </div>
          
          <div class="pricing-body">
          <ul class="list-item">
            <li class="free-domain" style="display: none; color: #000; font-weight: bold;">Free Domain</li>
            <li style="color: #000; font-weight: bold;">10 Websites</li>
            <li style="color: #000; font-weight: bold;">25 GB SSD</li>
            <li style="color: #000; font-weight: bold;">250 GB Bandwidth</li>
            <li style="color: #000; font-weight: bold;">20 MySql Database</li>
            <li style="color: #000; font-weight: bold;">10 Subdomains</li>
            <li style="color: #000; font-weight: bold;">Bitninja Security</li>
            <li style="color: #000; font-weight: bold;">Free JetBackup</li>
            <li style="color: #000; font-weight: bold;">SSL Included</li>
          </ul>
          </div>
          
          <div class="pricing-btn"><a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/sharedhosting/elite">Buy This Plan</a></div>
          </div>
          </div>
          </div>
          
          <div class="section-title text-start" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800"><span class="pre-title">&quot;Only Annual Plans are eligible for free domain names. &quot;</span></div>
          </div>
          </div>
          <script>
            import '../scripts/pricing';
          </script>


         <!-- =========================================================
              FEATURES: Basic Web Presence (Connected Flow Design)
              ========================================================= -->
         <div class="ace-services-area bg-image ace-section-gap position-relative overflow-hidden" id="hosting-features-flow">
            <!-- Flowing Ambient Gradient Mesh Overlay -->
            <div class="features-ambient-flow" aria-hidden="true">
                <div class="flow-glow-orb orb-1"></div>
                <div class="flow-glow-orb orb-2"></div>
            </div>

            <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
                <div class="row g-5">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Features</span>
                            <h3 class="title">Just what you need for a Basic Web Presence</h3>
                            <p class="description max-w-750 mx-auto mt-2 text-muted">
                                Everything required to launch, secure, and accelerate your personal website or business online with zero technical friction.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Cards Row with Connected Flow Stream -->
                <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center position-relative features-flow-row">

                    <!-- Flowing Streamline Connector (Desktop) -->
                    <div class="features-flow-stream d-none d-lg-block" aria-hidden="true">
                        <svg class="flow-stream-svg" viewBox="0 0 1000 40" fill="none" preserveAspectRatio="none">
                            <path class="flow-track-path" d="M 120 20 L 880 20" stroke="url(#flowLineGrad)" stroke-width="2" stroke-dasharray="6 6" />
                            <circle class="flow-pulse-particle" r="4" fill="#ff501a">
                                <animateMotion path="M 120 20 L 880 20" dur="4.5s" repeatCount="indefinite" />
                            </circle>
                            <defs>
                                <linearGradient id="flowLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#ff501a" stop-opacity="0.25" />
                                    <stop offset="50%" stop-color="#0284c7" stop-opacity="0.45" />
                                    <stop offset="100%" stop-color="#ff501a" stop-opacity="0.25" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    
                    <!-- Card 1: LiteSpeed Turbo NVMe Hosting -->
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 flow-enhanced-card">
                            <span class="card-flow-num" aria-hidden="true">01</span>
                            <div class="card-shimmer-sheen" aria-hidden="true"></div>
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-flashlight-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">LiteSpeed Turbo Hosting</h6>
                                    <p class="description">Enterprise LiteSpeed Web Server with built-in LSCache and pure NVMe SSDs delivers 10x faster dynamic PHP loading and instant page delivery.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Card 2: Professional Business Email -->
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 flow-enhanced-card">
                            <span class="card-flow-num" aria-hidden="true">02</span>
                            <div class="card-shimmer-sheen" aria-hidden="true"></div>
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-mail-open-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Professional Email Included</h6>
                                    <p class="description">Create custom @yourdomain.com inboxes with responsive Webmail, IMAP/POP3 mobile sync, forwarders, autoresponders, and automated anti-spam.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <!-- Card 3: Genuine cPanel & 1-Click Apps -->
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 flow-enhanced-card">
                            <span class="card-flow-num" aria-hidden="true">03</span>
                            <div class="card-shimmer-sheen" aria-hidden="true"></div>
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-dashboard-3-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Official cPanel &amp; Softaculous</h6>
                                    <p class="description">Manage your entire hosting environment effortlessly with industry-standard cPanel, MariaDB databases, File Manager, and 400+ 1-click app installs.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape32.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0308.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape2701.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
         </div>

        


        <!-- =========================================================
             INTERACTIVE SHOPPING CARTS & 400+ APPS (SOFTACULOUS)
             ========================================================= -->
        <SoftaculousAppsShowcase />

        <!-- =========================================================
             FEATURED ARCHITECTURE: Next-Gen Shared Cloud (Custom 3D AI Visual)
             ========================================================= -->
        <div class="ace-section-gap bg-image position-relative border-top-1 border-bottom-1">
           <div class="container aceorbit-animated-shape">
              <div class="row align-items-center g-5">
                 <!-- Left: Feature Breakdown -->
                 <div class="col-lg-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <div class="section-title text-start mb-4">
                       <span class="pre-title">CLOUD CLUSTER ARCHITECTURE</span>
                       <h3 class="title">Next-Gen NVMe Storage with Isolated CloudLinux Speed</h3>
                       <p class="description mt-2">
                          Unlike legacy budget web hosts that crowd hundreds of sites onto spinning disks, Hostamble partitions dedicated CPU cores, LVE memory, and lightning-fast pure NVMe SSDs for every client.
                       </p>
                    </div>

                    <div class="row g-4 mt-2">
                       <div class="col-sm-6">
                          <div class="p-3 rounded-3 border" style="background: rgba(255, 80, 26, 0.04); border-color: rgba(255, 80, 26, 0.15) !important;">
                             <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="ri-flashlight-line text-danger" style="font-size: 20px;"></i>
                                <h6 class="mb-0 font-weight-bold">LiteSpeed Turbo</h6>
                             </div>
                             <p class="small text-muted mb-0">10x faster page load and dynamic PHP execution with built-in LSCache integration.</p>
                          </div>
                       </div>

                       <div class="col-sm-6">
                          <div class="p-3 rounded-3 border" style="background: rgba(22, 163, 74, 0.04); border-color: rgba(22, 163, 74, 0.15) !important;">
                             <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="ri-shield-check-line text-success" style="font-size: 20px;"></i>
                                <h6 class="mb-0 font-weight-bold">BitNinja Shield</h6>
                             </div>
                             <p class="small text-muted mb-0">24/7 proactive web application firewall (WAF), anti-malware, and DDoS mitigation.</p>
                          </div>
                       </div>

                       <div class="col-sm-6">
                          <div class="p-3 rounded-3 border" style="background: rgba(59, 130, 246, 0.04); border-color: rgba(59, 130, 246, 0.15) !important;">
                             <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="ri-hard-drive-2-line text-primary" style="font-size: 20px;"></i>
                                <h6 class="mb-0 font-weight-bold">Pure NVMe Storage</h6>
                             </div>
                             <p class="small text-muted mb-0">Raid-10 enterprise NVMe solid state drives delivering up to 3,500 MB/s read/write speeds.</p>
                          </div>
                       </div>

                       <div class="col-sm-6">
                          <div class="p-3 rounded-3 border" style="background: rgba(245, 158, 11, 0.04); border-color: rgba(245, 158, 11, 0.15) !important;">
                             <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="ri-history-line text-warning" style="font-size: 20px;"></i>
                                <h6 class="mb-0 font-weight-bold">JetBackup 5 Restores</h6>
                             </div>
                             <p class="small text-muted mb-0">Automated daily snapshots and 1-click self-service rollbacks right from your cPanel.</p>
                          </div>
                       </div>
                    </div>

                    <div class="mt-4 pt-2 d-flex align-items-center gap-3">
                       <a href="#plans" class="ace-btn"><span>Choose Your Plan</span> <i class="icon-arrow-right-line-right"></i></a>
                       <span class="text-muted small"><i class="ri-checkbox-circle-fill text-success me-1"></i> Free Site Migration Included</span>
                    </div>
                 </div>

                 <!-- Right: Custom 3D AI Generated Visual -->
                 <div class="col-lg-6 text-center" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                    <div class="position-relative">
                       <img 
                          src="/assets/images/shared-hosting-cloud.jpg" 
                          alt="Hostamble Shared Hosting High Performance Cloud Architecture" 
                          class="img-fluid rounded-4 shadow-lg border" 
                          style="max-height: 440px; object-fit: cover; width: 100%; border-color: rgba(255, 80, 26, 0.2) !important;" 
                       />
                       <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 bg-dark rounded-pill border border-danger text-white small" style="white-space: nowrap; box-shadow: 0 4px 20px rgba(0,0,0,0.4);">
                          <i class="ri-radar-line text-danger me-1"></i> Live Infrastructure: LiteSpeed Enterprise &bull; Pure NVMe
                       </div>
                    </div>
                 </div>
              </div>
           </div>
        </div>

         <div class="aceorbit-underhood bg-image ace-section-gap">
            <div class="container aceorbit-animated-shape">
               <div class="row">
                    <div class="col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="section-title text-center">
                            <span class="pre-title">hostig features</span>
                            <h3 class="title">Under the hood</h3>
