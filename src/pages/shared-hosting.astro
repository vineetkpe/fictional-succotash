  }

  /* Interactive Cursor Spotlight Glow */
  .flow-enhanced-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 240px at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(255, 80, 26, 0.07), transparent 70%);
