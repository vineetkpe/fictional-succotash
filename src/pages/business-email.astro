---
import Layout from '../layouts/Layout.astro';
import { businessEmail } from '../data/pricing';
const { heroStartPrice, plans } = businessEmail;
---

<Layout 
  title="Professional Business Email Hosting for Your Custom Domain | Hostamble"
  description="Build instant credibility with custom domain email addresses (you@yourdomain.com). Includes 100% ad-free inbox, AI anti-spam protection, and mobile sync."
  keywords="business email, custom domain email, professional email hosting, email hosting india, company email address"
>

  <!-- Block 1: Hero Area -->
  <div class="slider-area banner img2 bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-12">
          <div class="inner">
            <div class="content">
              <span class="pre-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Custom Domain Email • High Inbox Delivery • Starts at <span data-inr={heroStartPrice.inr} data-usd={heroStartPrice.usd}>{heroStartPrice.inr}</span>
              </span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                Professional Business Email for Your Brand
              </h1>
              <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Build instant trust with custom branded email addresses (you@yourcompany.com). 100% ad-free, 99.9% uptime, advanced AI anti-spam filtering, and seamless sync across Outlook, iPhone, and Android.
              </p>
              <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a class="ace-btn" href="#email-plans">Choose Email Plan <i class="icon-arrow-right-line-right"></i></a>
              </div>
              <div class="arrow-sign d-lg-block d-none">
                <img src="/assets/images/arrow.png" alt="Arrow Indicator" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="banner-thumbnail text-center">
            <img class="img-thumb" src="/assets/images/banner04.png" alt="Business Email Suite" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
          </div>
        </div>
      </div>
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape19.png" alt="Shape"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0501.png" alt="Shape"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1901.png" alt="Shape"></div>
      </div>
    </div>
  </div>

  <!-- Block 2: Business Email Pricing Plans -->
  <div class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image" id="email-plans">
    <div class="container aceorbit-animated-shape">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-6">
          <div class="section-title text-start" data-sal-slide-up data-sal-delay="150" data-sal-duration="800">
            <span class="pre-title">Reliable Communication</span>
            <h3 class="title">Choose Your Business Email Plan</h3>
          </div>
        </div>
        <div class="col-lg-6 col-md-6">
          <div class="pricing-billing-duration">
            <ul>
              <li class="nav-item">
                <button class="nav-link active" id="email-monthly-btn" type="button" onclick="switchEmailBilling('monthly')">Monthly</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" id="email-annual-btn" type="button" onclick="switchEmailBilling('annual')">Annual (Save 20%)</button>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="row g-5 mt--20">
        <!-- Email Plan 1: Starter -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">{plans.starter.name}</h3>
              <p class="text-muted small">{plans.starter.subtitle}</p>
              <div class="price-wrap">
                <div class="email-pricing-opt email-monthly" style="display: block;">
                  <span class="amount" data-inr={plans.starter.pricing.monthly.inr} data-usd={plans.starter.pricing.monthly.usd}>{plans.starter.pricing.monthly.inr}</span>
                  <span class="duration">/monthly /account</span>
                </div>
                <div class="email-pricing-opt email-annual" style="display: none;">
                  <span class="amount" data-inr={plans.starter.pricing.annual.inr} data-usd={plans.starter.pricing.annual.usd}>{plans.starter.pricing.annual.inr}</span>
                  <span class="duration">/annual /account</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">5 GB NVMe Cloud Mailbox</li>
                <li style="color: #000; font-weight: bold;">Custom Domain you@yourbrand.com</li>
                <li style="color: #000; font-weight: bold;">Modern Webmail + Mobile IMAP/SMTP</li>
                <li>25 MB File Attachments</li>
                <li>Standard Spam &amp; Virus Filtering</li>
                <li>Email Forwarding &amp; Autoresponders</li>
                <li>2-Factor Authentication (2FA)</li>
                <li>99.9% Uptime Guarantee</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/business-email">Get Starter</a>
            </div>
          </div>
        </div>

        <!-- Email Plan 2: Pro (Recommended) -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <div class="pricing-table featured-plan h-100" style="border: 2px solid #ff501a; position: relative;">
            <div class="plan-badge" style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #ff501a; color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 14px; border-radius: 20px; letter-spacing: 0.05em;">Most Popular</div>
            <div class="pricing-header">
              <h3 class="title">{plans.pro.name}</h3>
              <p class="text-muted small">{plans.pro.subtitle}</p>
              <div class="price-wrap">
                <div class="email-pricing-opt email-monthly" style="display: block;">
                  <span class="amount" data-inr={plans.pro.pricing.monthly.inr} data-usd={plans.pro.pricing.monthly.usd}>{plans.pro.pricing.monthly.inr}</span>
                  <span class="duration">/monthly /account</span>
                </div>
                <div class="email-pricing-opt email-annual" style="display: none;">
                  <span class="amount" data-inr={plans.pro.pricing.annual.inr} data-usd={plans.pro.pricing.annual.usd}>{plans.pro.pricing.annual.inr}</span>
                  <span class="duration">/annual /account</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">25 GB NVMe Cloud Mailbox</li>
                <li style="color: #000; font-weight: bold;">Custom Domain you@yourbrand.com</li>
                <li style="color: #000; font-weight: bold;">BitNinja AI Anti-Spam Engine</li>
                <li>Shared Team Calendars &amp; Contacts</li>
                <li>50 MB Large File Attachments</li>
                <li>Full Outlook, Apple Mail &amp; Android Sync</li>
                <li>Unlimited Email Aliases</li>
                <li>Priority WhatsApp &amp; Ticket Support</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn" href="https://hostamble.com/dash/index.php/store/business-email">Get Email Pro</a>
            </div>
          </div>
        </div>

        <!-- Email Plan 3: Enterprise -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">{plans.enterprise.name}</h3>
              <p class="text-muted small">{plans.enterprise.subtitle}</p>
              <div class="price-wrap">
                <div class="email-pricing-opt email-monthly" style="display: block;">
                  <span class="amount" data-inr={plans.enterprise.pricing.monthly.inr} data-usd={plans.enterprise.pricing.monthly.usd}>{plans.enterprise.pricing.monthly.inr}</span>
                  <span class="duration">/monthly /account</span>
                </div>
                <div class="email-pricing-opt email-annual" style="display: none;">
                  <span class="amount" data-inr={plans.enterprise.pricing.annual.inr} data-usd={plans.enterprise.pricing.annual.usd}>{plans.enterprise.pricing.annual.inr}</span>
                  <span class="duration">/annual /account</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">50 GB NVMe Cloud Mailbox</li>
                <li style="color: #000; font-weight: bold;">Dedicated Outgoing Delivery Pool</li>
                <li style="color: #000; font-weight: bold;">DKIM, SPF, and DMARC Hardening</li>
                <li>100 MB Mega Attachments</li>
                <li>Email Archiving &amp; Audit Logs</li>
                <li>Custom Webmail Branding &amp; Logo</li>
                <li>Shared Inboxes &amp; Group Lists</li>
                <li>Dedicated Migration Specialist</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/business-email">Get Enterprise</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 3: Device & Client Compatibility Showcase -->
  <div class="ace-service-area ace-section-gap bg-image">
    <div class="container aceorbit-animated-shape">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Universal Sync</span>
            <h3 class="title">Access Your Email Anywhere, on Any Device</h3>
            <p class="description max-w-700 mx-auto mt-2">
              Sync your emails, contacts, and calendar effortlessly across your desktop, laptop, tablet, and smartphone.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center text-center">
        <div class="col-lg-2 col-md-4 col-6">
          <div class="p-4 bg-white border rounded shadow-sm h-100">
            <i class="ri-windows-fill text-primary" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-1 font-weight-bold">MS Outlook</h6>
            <small class="text-muted">Desktop &amp; Web</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
          <div class="p-4 bg-white border rounded shadow-sm h-100">
            <i class="ri-apple-fill text-dark" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-1 font-weight-bold">Apple Mail</h6>
            <small class="text-muted">macOS &amp; iOS</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
          <div class="p-4 bg-white border rounded shadow-sm h-100">
            <i class="ri-android-fill text-success" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-1 font-weight-bold">Android</h6>
            <small class="text-muted">Gmail &amp; Native App</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
          <div class="p-4 bg-white border rounded shadow-sm h-100">
            <i class="ri-global-fill text-info" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-1 font-weight-bold">Rich Webmail</h6>
            <small class="text-muted">Modern Browser UI</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
          <div class="p-4 bg-white border rounded shadow-sm h-100">
            <i class="ri-mail-settings-fill text-warning" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-1 font-weight-bold">Thunderbird</h6>
            <small class="text-muted">Open Standards</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 4: Enterprise Productivity & Security Grid (6 Cards) -->
  <div class="ace-feature-area ace-section-gap bg-image bg-color-light">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Zero Spam Guarantee</span>
            <h3 class="title">Enterprise Email Infrastructure Engineered for Reliability</h3>
          </div>
        </div>
      </div>

      <div class="row g-5">
        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-shield-flash-line"></i></span></div>
              <div class="content">
                <h5 class="title">BitNinja AI Anti-Spam</h5>
                <p class="description">Multi-tier scanning filters out 99.8% of spam, phishing emails, and malware attachments before they reach your inbox.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-inbox-archive-line"></i></span></div>
              <div class="content">
                <h5 class="title">High-Reputation Clean IPs</h5>
                <p class="description">We rigorously monitor email sending IP reputations to ensure your important client quotes land straight in the primary inbox, not the junk folder.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-calendar-event-line"></i></span></div>
              <div class="content">
                <h5 class="title">Calendar &amp; Contact Sync</h5>
                <p class="description">Industry-standard CalDAV and CardDAV protocols keep your appointments and business address books synced seamlessly across your team.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-attachment-line"></i></span></div>
              <div class="content">
                <h5 class="title">50 MB Large Attachments</h5>
                <p class="description">Send and receive high-resolution presentations, CAD drawings, and large contract PDFs without bounce-backs or cloud link requirements.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-key-line"></i></span></div>
              <div class="content">
                <h5 class="title">2-Factor Authentication</h5>
                <p class="description">Lock down mailbox access with Google Authenticator or hardware security tokens to protect confidential financial communications.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-fingerprint-line"></i></span></div>
              <div class="content">
                <h5 class="title">SPF, DKIM &amp; DMARC Verified</h5>
                <p class="description">Automated cryptographic email signing protects your brand against spoofing, identity theft, and unauthorized impersonation.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 1: Zero-Downtime Automated Email Migration Assistant -->
  <div class="ace-section-gap bg-image" style="background: #0d0d12; color: #fff;">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start mb-4">
            <span class="pre-title" style="color: #ff501a;">Seamless Transition</span>
            <h3 class="title text-white">Switch to Hostamble Mail with Zero Lost Messages</h3>
            <p class="description text-muted">
              Worried about losing your historic client emails or inbox folders? Our automated IMAP migration tool copies every email, attachment, subfolder, and contact into your new Hostamble mailbox in the background.
            </p>
          </div>

          <div class="row g-3">
            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <span class="badge bg-danger text-white mb-2">Step 1</span>
                <h6 class="text-white mb-1">Enter Current Credentials</h6>
                <p class="small text-muted mb-0">Provide your existing email host's IMAP server details and password.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <span class="badge bg-danger text-white mb-2">Step 2</span>
                <h6 class="text-white mb-1">Background Sync</h6>
                <p class="small text-muted mb-0">Our sync engine replicates all folders while your old mail continues working.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <span class="badge bg-danger text-white mb-2">Step 3</span>
                <h6 class="text-white mb-1">Update MX Records</h6>
                <p class="small text-muted mb-0">Switch your domain MX records with assisted 1-click DNS guidance.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <span class="badge bg-success text-white mb-2">Step 4</span>
                <h6 class="text-white mb-1">100% Complete</h6>
                <p class="small text-muted mb-0">Enjoy clean spam-free mail delivery with 0 minutes of communication downtime.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6 text-center" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="position-relative">
            <img src="/assets/images/business-email-inbox.jpg" alt="Hostamble Business Email Inbox Mockup" class="img-fluid rounded-4 shadow-lg border border-secondary" style="max-height: 440px; object-fit: cover; width: 100%;" />
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 bg-dark rounded-pill border border-danger text-white small" style="white-space: nowrap;">
              <i class="ri-mail-check-fill text-success me-1"></i> Multi-Account Webmail &amp; IMAP/SMTP Sync
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 2: Email Deliverability & Anti-Blacklist Infrastructure Deep Dive -->
  <div class="ace-section-gap bg-image">
    <div class="container">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Primary Inbox Placement</span>
            <h3 class="title">Guaranteed Deliverability. Never Land in the Spam Folder</h3>
            <p class="description max-w-700 mx-auto mt-2">
              Sending a business proposal means nothing if it gets buried in a junk folder. Hostamble manages warm, pristine sending IP pools paired with automated authentication protocols.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-3 col-md-6" data-sal-delay="100" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-shield-check-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Warmed Clean IPs</h5>
            <p class="small text-muted mb-0">We never allow bulk spammers on our mail relays. Only genuine transactional and business mail shares our IP reputation.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-fingerprint-line"></i></div>
            <h5 class="mb-2 font-weight-bold">SPF &amp; DKIM Signing</h5>
            <p class="small text-muted mb-0">Every outgoing message is cryptographically signed with your unique 2048-bit DKIM key to prove sender authenticity.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-file-shield-2-line"></i></div>
            <h5 class="mb-2 font-weight-bold">DMARC Policy Enforcement</h5>
            <p class="small text-muted mb-0">Protects your brand against phishing attempts. Prevents attackers from sending fake invoices claiming to be from your domain.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-speed-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Real-Time Queue Dispatch</h5>
            <p class="small text-muted mb-0">Zero outbound throttling. Messages are delivered to Google, Microsoft, Yahoo, and corporate mail servers in under 2 seconds.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 3: Modern Webmail & Team Productivity Interface Tour -->
  <div class="ace-section-gap bg-image" style="background: #f8f9fa;">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-5" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start">
            <span class="pre-title">Modern Webmail Experience</span>
            <h3 class="title">Work Smarter with a Clean, Ultra-Responsive Webmail UI</h3>
            <p class="description">
              Access your business inbox from any browser, laptop, or smartphone without installing extra apps. Featuring keyboard shortcuts, team calendars, and drag-and-drop file attachments.
            </p>
            <div class="mt-4">
              <a href="#email-plans" class="ace-btn">Get Started Today</a>
            </div>
          </div>
        </div>

        <div class="col-lg-7" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="row g-3">
            <div class="col-sm-6">
              <div class="p-4 bg-white rounded-3 shadow-sm border h-100">
                <i class="ri-search-eye-line text-danger fs-2 mb-2 d-block"></i>
                <h6 class="font-weight-bold mb-1">Instant Full-Text Search</h6>
                <p class="small text-muted mb-0">Search through 100,000+ emails, subject lines, and attachment names in milliseconds.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-4 bg-white rounded-3 shadow-sm border h-100">
                <i class="ri-edit-2-line text-danger fs-2 mb-2 d-block"></i>
                <h6 class="font-weight-bold mb-1">Rich HTML Signatures</h6>
