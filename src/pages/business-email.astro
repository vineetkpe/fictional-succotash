<script is:inline>
  function switchEmailBilling(duration) {
    document.querySelectorAll('.pricing-billing-duration .nav-link').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`email-${duration}-btn`);
    if (activeBtn) activeBtn.classList.add('active');

    document.querySelectorAll('.email-pricing-opt').forEach(el => el.style.display = 'none');
    document.querySelectorAll(`.email-${duration}`).forEach(el => el.style.display = 'block');
  }
</script>
