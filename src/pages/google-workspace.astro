---
import Layout from '../layouts/Layout.astro';
import { googleWorkspace } from '../data/pricing';
const { heroStartPrice, plans } = googleWorkspace;
---

<Layout title="Google Workspace (Formerly G Suite) for Business | Hostamble">

  <!-- Block 1: Hero Area -->
  <div class="slider-area banner img2 bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-12">
          <div class="inner">
            <div class="content">
              <span class="pre-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Official Google Cloud Partner • Starts at <span data-inr={heroStartPrice.inr} data-usd={heroStartPrice.usd}>{heroStartPrice.inr}</span>
              </span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                Google Workspace for Modern Teams
              </h1>
              <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Get custom domain Gmail, Google Drive cloud storage, Google Meet video conferences, and smart collaboration docs. Fully configured with local GST invoicing and 24/7 dedicated onboarding.
              </p>
              <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a class="ace-btn" href="#workspace-plans">View Workspace Plans <i class="icon-arrow-right-line-right"></i></a>
              </div>
              <div class="arrow-sign d-lg-block d-none">
                <img src="/assets/images/arrow.png" alt="Arrow Indicator" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="banner-thumbnail text-center">
            <img class="img-thumb" src="/assets/images/banner08.png" alt="Google Workspace Apps" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
          </div>
        </div>
      </div>
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape19.png" alt="Shape"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0501.png" alt="Shape"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1901.png" alt="Shape"></div>
      </div>
    </div>
  </div>

  <!-- Block 2: Google Workspace Pricing Plans -->
  <div class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image" id="workspace-plans">
    <div class="container aceorbit-animated-shape">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-6">
          <div class="section-title text-start" data-sal-slide-up data-sal-delay="150" data-sal-duration="800">
            <span class="pre-title">Official Google Cloud Partner</span>
            <h3 class="title">Choose Your Workspace Edition</h3>
          </div>
        </div>
        <div class="col-lg-6 col-md-6">
          <div class="pricing-billing-duration">
            <ul>
              <li class="nav-item">
                <button class="nav-link active" id="gw-monthly-btn" type="button" onclick="switchGwBilling('monthly')">Monthly</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" id="gw-annual-btn" type="button" onclick="switchGwBilling('annual')">Annual</button>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="row g-5 mt--20">
        <!-- GW Plan 1: Business Starter -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">{plans.starter.name}</h3>
              <p class="text-muted small">For Startups &amp; Small Businesses</p>
              <div class="price-wrap">
                <div class="gw-pricing-opt gw-monthly" style="display: block;">
                  <span class="amount" data-inr={plans.starter.pricing.monthly.inr} data-usd={plans.starter.pricing.monthly.usd}>{plans.starter.pricing.monthly.inr}</span>
                  <span class="duration">/user /monthly</span>
                </div>
                <div class="gw-pricing-opt gw-annual" style="display: none;">
                  <span class="amount" data-inr={plans.starter.pricing.annual.inr} data-usd={plans.starter.pricing.annual.usd}>{plans.starter.pricing.annual.inr}</span>
                  <span class="duration">/user /annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">Custom Business Email (Gmail)</li>
                <li style="color: #000; font-weight: bold;">30 GB Cloud Storage per User</li>
                <li style="color: #000; font-weight: bold;">100-Participant Video Meetings</li>
                <li>Full Google Docs, Sheets &amp; Slides Suite</li>
                <li>Google Calendar &amp; Team Chat</li>
                <li>Standard Security &amp; Admin Controls</li>
                <li>Free Assisted DNS Setup by Hostamble</li>
                <li>24/7 Technical Onboarding Support</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/google-workspace">Order Starter</a>
            </div>
          </div>
        </div>

        <!-- GW Plan 2: Business Standard (Recommended) -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <div class="pricing-table featured-plan h-100" style="border: 2px solid #ff501a; position: relative;">
            <div class="plan-badge" style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #ff501a; color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 14px; border-radius: 20px; letter-spacing: 0.05em;">Best For Growing Teams</div>
            <div class="pricing-header">
              <h3 class="title">{plans.standard.name}</h3>
              <p class="text-muted small">Most Popular for Growing Companies</p>
              <div class="price-wrap">
                <div class="gw-pricing-opt gw-monthly" style="display: block;">
                  <span class="amount" data-inr={plans.standard.pricing.monthly.inr} data-usd={plans.standard.pricing.monthly.usd}>{plans.standard.pricing.monthly.inr}</span>
                  <span class="duration">/user /monthly</span>
                </div>
                <div class="gw-pricing-opt gw-annual" style="display: none;">
                  <span class="amount" data-inr={plans.standard.pricing.annual.inr} data-usd={plans.standard.pricing.annual.usd}>{plans.standard.pricing.annual.inr}</span>
                  <span class="duration">/user /annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">Custom Business Email (Gmail)</li>
                <li style="color: #000; font-weight: bold;">2 TB Pooled Cloud Storage per User</li>
                <li style="color: #000; font-weight: bold;">150-Participant Video Meetings + Recording</li>
                <li>Shared Team Drives &amp; Permissions</li>
                <li>Appointment Booking Pages</li>
                <li>Enhanced Security &amp; Admin Controls</li>
                <li>Free Data Migration from Old Host</li>
                <li>Dedicated Priority Support Line</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn" href="https://hostamble.com/dash/index.php/store/google-workspace">Order Standard</a>
            </div>
          </div>
        </div>

        <!-- GW Plan 3: Business Plus -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">{plans.plus.name}</h3>
              <p class="text-muted small">Advanced Security &amp; Compliance</p>
              <div class="price-wrap">
                <div class="gw-pricing-opt gw-monthly" style="display: block;">
                  <span class="amount" data-inr={plans.plus.pricing.monthly.inr} data-usd={plans.plus.pricing.monthly.usd}>{plans.plus.pricing.monthly.inr}</span>
                  <span class="duration">/user /monthly</span>
                </div>
                <div class="gw-pricing-opt gw-annual" style="display: none;">
                  <span class="amount" data-inr={plans.plus.pricing.annual.inr} data-usd={plans.plus.pricing.annual.usd}>{plans.plus.pricing.annual.inr}</span>
                  <span class="duration">/user /annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">Custom Business Email + eDiscovery</li>
                <li style="color: #000; font-weight: bold;">5 TB Pooled Cloud Storage per User</li>
                <li style="color: #000; font-weight: bold;">500-Participant Video Meetings + Attendance</li>
                <li>Google Vault for Retention &amp; Compliance</li>
                <li>Advanced Mobile Device Management</li>
                <li>Data Loss Prevention (DLP) Policies</li>
                <li>Security Center Analytics &amp; Auditing</li>
                <li>Dedicated Enterprise Account Manager</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/google-workspace">Order Business Plus</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 3: Included Google Collaboration Suite Apps -->
  <div class="ace-service-area ace-section-gap bg-image">
    <div class="container aceorbit-animated-shape">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Complete Cloud Suite</span>
            <h3 class="title">Every Google App Your Team Loves Included</h3>
            <p class="description max-w-700 mx-auto mt-2">
              Transform team productivity with seamlessly integrated apps across web and mobile.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center text-center">
        <div class="col-lg-2 col-md-3 col-4">
          <div class="p-3 bg-white border rounded shadow-sm h-100">
            <i class="ri-mail-line text-danger" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-0 font-weight-bold">Gmail</h6>
            <small class="text-muted">Branded Email</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-3 col-4">
          <div class="p-3 bg-white border rounded shadow-sm h-100">
            <i class="ri-video-chat-line text-success" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-0 font-weight-bold">Google Meet</h6>
            <small class="text-muted">HD Calls</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-3 col-4">
          <div class="p-3 bg-white border rounded shadow-sm h-100">
            <i class="ri-google-play-line text-primary" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-0 font-weight-bold">Google Drive</h6>
            <small class="text-muted">Cloud Storage</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-3 col-4">
          <div class="p-3 bg-white border rounded shadow-sm h-100">
            <i class="ri-file-text-line text-primary" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-0 font-weight-bold">Google Docs</h6>
            <small class="text-muted">Real-time Collab</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-3 col-4">
          <div class="p-3 bg-white border rounded shadow-sm h-100">
            <i class="ri-file-excel-line text-success" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-0 font-weight-bold">Google Sheets</h6>
            <small class="text-muted">Smart Analytics</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-3 col-4">
          <div class="p-3 bg-white border rounded shadow-sm h-100">
            <i class="ri-calendar-2-line text-warning" style="font-size: 36px;"></i>
            <h6 class="mt-2 mb-0 font-weight-bold">Calendar</h6>
            <small class="text-muted">Team Schedules</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 4: Why Buy Through Hostamble Grid (6 Cards) -->
  <div class="ace-feature-area ace-section-gap bg-image bg-color-light">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">The Hostamble Advantage</span>
            <h3 class="title">Why Purchase Google Workspace via Hostamble</h3>
          </div>
        </div>
      </div>

      <div class="row g-5">
        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-bill-line"></i></span></div>
              <div class="content">
                <h5 class="title">Local Currency &amp; GST Invoicing</h5>
                <p class="description">Pay conveniently in INR via UPI, Netbanking, or international cards with an official 18% GST tax invoice for your business accounting.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-settings-4-line"></i></span></div>
              <div class="content">
                <h5 class="title">Zero-Hassle DNS Configuration</h5>
                <p class="description">No confusing technical record entries. Our cloud engineers automatically configure your domain's MX, SPF, DKIM, and DMARC records.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-customer-service-2-line"></i></span></div>
              <div class="content">
                <h5 class="title">Dedicated 24/7 Human Support</h5>
                <p class="description">Skip automated Google support ticket queues. Speak directly to our certified cloud specialists by phone, WhatsApp, or live chat.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-exchange-box-line"></i></span></div>
              <div class="content">
                <h5 class="title">Free Full Mail Migration</h5>
                <p class="description">Switching from cPanel webmail, Microsoft 365, or Zoho? We will migrate all your mailboxes, contacts, and calendar entries for free.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-shield-check-line"></i></span></div>
              <div class="content">
                <h5 class="title">99.9% Uptime Google SLA</h5>
                <p class="description">Backed by Google's industry-leading global datacenter infrastructure with multi-redundant power and automated failovers.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-user-add-line"></i></span></div>
              <div class="content">
                <h5 class="title">Flexible User Scaling</h5>
                <p class="description">Add or remove user licenses as your team expands. Pay only for the exact number of active employees on your roster.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 1: Google Meet & Enterprise Collaboration Showcase -->
  <div class="ace-section-gap bg-image" style="background: #0d0d12; color: #fff;">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start mb-4">
            <span class="pre-title" style="color: #ff501a;">Seamless Video Collaboration</span>
            <h3 class="title text-white">Google Meet: Enterprise Video Meetings Anywhere</h3>
            <p class="description text-muted">
              Connect your distributed workforce with crystal-clear HD video conferencing. No downloads required—join with a single click from any browser, calendar invite, or smartphone.
            </p>
          </div>

          <div class="row g-3">
            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <i class="ri-team-line text-danger fs-2 mb-2 d-block"></i>
                <h6 class="text-white mb-1">Up to 500 Participants</h6>
                <p class="small text-muted mb-0">Host massive all-hands company townhalls and client webinars with zero lag.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <i class="ri-record-circle-line text-danger fs-2 mb-2 d-block"></i>
                <h6 class="text-white mb-1">Direct Drive Cloud Recording</h6>
                <p class="small text-muted mb-0">Record critical client calls and team training straight to Google Drive.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <i class="ri-volume-mute-line text-danger fs-2 mb-2 d-block"></i>
                <h6 class="text-white mb-1">AI Noise Cancellation</h6>
                <p class="small text-muted mb-0">Google's AI intelligently filters out background coffee shop sounds and typing.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.03);">
                <i class="ri-calendar-check-line text-danger fs-2 mb-2 d-block"></i>
                <h6 class="text-white mb-1">Appointment Schedules</h6>
                <p class="small text-muted mb-0">Share a booking page so customers can select open meeting slots automatically.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6 text-center" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="position-relative">
            <img src="/assets/images/google-workspace-suite.jpg" alt="Hostamble Google Workspace Collaboration Suite" class="img-fluid rounded-4 shadow-lg border border-secondary" style="max-height: 440px; object-fit: cover; width: 100%;" />
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 bg-dark rounded-pill border border-danger text-white small" style="white-space: nowrap;">
              <i class="ri-shield-star-fill text-warning me-1"></i> Official Google Cloud Authorized Reseller
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 2: Gemini AI for Google Workspace Integration -->
  <div class="ace-section-gap bg-image">
    <div class="container">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Next-Gen Intelligence</span>
            <h3 class="title">Supercharge Daily Productivity with Gemini AI</h3>
            <p class="description max-w-700 mx-auto mt-2">
              Gemini is natively embedded into the Google apps you use every day. Write compelling proposals, analyze complex data, and summarize meetings in seconds.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6" data-sal-delay="100" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-mail-ai-line"></i></div>
            <h5 class="mb-2 font-weight-bold">"Help Me Write" in Gmail</h5>
            <p class="small text-muted mb-0">Draft professional responses, adjust tone from casual to formal, and polish client sales pitches instantly.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-file-text-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Content Drafting in Docs</h5>
            <p class="small text-muted mb-0">Generate project proposals, marketing blogs, and contracts with intelligent outline auto-completion.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-table-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Smart Fill in Google Sheets</h5>
            <p class="small text-muted mb-0">Classify customer feedback, generate complex formulas, and organize project trackers automatically.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white rounded-3 shadow-sm border text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-slideshow-3-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Visual Generation in Slides</h5>
            <p class="small text-muted mb-0">Turn raw bullet points into compelling investor pitch decks with original custom illustrations on demand.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 3: Enterprise Admin Controls, Security & Vault Compliance -->
  <div class="ace-section-gap bg-image" style="background: #f8f9fc;">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-5" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start">
            <span class="pre-title">Complete Centralized Control</span>
            <h3 class="title">Enterprise Governance, Endpoint Security &amp; Vault</h3>
            <p class="description">
              Maintain absolute administrative visibility over corporate communications. Enforce zero-trust multi-factor authentication and protect sensitive intellectual property from unauthorized leaks.
            </p>
            <div class="mt-4">
              <a href="#gw-plans" class="ace-btn">Explore Workspace Plans</a>
            </div>
          </div>
        </div>

        <div class="col-lg-7" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border">
            <div class="d-flex align-items-start mb-4">
              <div class="me-3 p-2 bg-light rounded text-danger fs-3"><i class="ri-shield-keyhole-line"></i></div>
              <div>
                <h6 class="font-weight-bold mb-1">Enforced 2-Step Verification (2SV)</h6>
                <p class="small text-muted mb-0">Mandate hardware security keys or authenticator apps across all company user accounts to prevent phishing compromises.</p>
              </div>
            </div>

            <div class="d-flex align-items-start mb-4">
              <div class="me-3 p-2 bg-light rounded text-danger fs-3"><i class="ri-smartphone-line"></i></div>
              <div>
