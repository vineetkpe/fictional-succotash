<script is:inline>
  function switchGwBilling(duration) {
    document.querySelectorAll('.pricing-billing-duration .nav-link').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`gw-${duration}-btn`);
    if (activeBtn) activeBtn.classList.add('active');

    document.querySelectorAll('.gw-pricing-opt').forEach(el => el.style.display = 'none');
    document.querySelectorAll(`.gw-${duration}`).forEach(el => el.style.display = 'block');
  }
</script>
