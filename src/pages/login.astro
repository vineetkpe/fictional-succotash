---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Hostamble | Client Login">
  <div class="loginnow">
     <div class="container inner">
        <div class="row align-items-center">
           <div class="col-lg-6 d-none d-md-block">
              <img src="/assets/images/banner07.png" alt="Login images">
           </div>
           <div class="col-lg-6">
             <div class="login-contents">
                 <a href="/" class="logo">
                 <img src="/assets/images/logo.png" alt="logo">
              </a>
              <h4 class="title"></h4>
              
              <form>
                 <a class="ace-btn w-100 mt-3 d-inline-block text-center" href="https://hostamble.com/dash/login.php">
                    Login to Client Area <i class="icon-arrow-right-line-right"></i>
                 </a>
                 <a href="/register" class="mt--10 color-body text-center d-block">Don't Have an Account? Register Now</a>
                 <a href="https://hostamble.com/dash/index.php?rp=/password/reset" class="mt--10 color-body text-center d-block">Don't Have Password ? Forgot Password</a>
              </form>
             </div>
           </div>
        </div>
     </div>
  </div>
</AuthLayout>
