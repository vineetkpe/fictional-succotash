<script is:inline>
  function switchVpsBilling(duration) {
    document.querySelectorAll('.pricing-billing-duration .nav-link').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`vps-${duration}-btn`);
    if (activeBtn) activeBtn.classList.add('active');

    document.querySelectorAll('.vps-pricing-opt').forEach(el => el.style.display = 'none');
    document.querySelectorAll(`.vps-${duration}`).forEach(el => el.style.display = 'block');
  }

  const dcData = {
    mumbai: { name: 'Mumbai Datacenter (CtrlS Tier-4)', facility: 'Equinix / CtrlS Campus • NIXI Direct Peering', ping: '⚡ < 4 ms Ping', ip: '103.168.172.10', uplink: '10 Gbps Redundant' },
    singapore: { name: 'Singapore Datacenter (Equinix SG1)', facility: 'Equinix OneNorth • SingTel & StarHub Peering', ping: '⚡ < 28 ms Ping', ip: '139.180.208.5', uplink: '10 Gbps Redundant' },
    frankfurt: { name: 'Frankfurt Datacenter (Interxion FRA)', facility: 'DE-CIX Peering Hub • ISO 27001 Certified', ping: '⚡ < 95 ms Ping', ip: '194.26.29.14', uplink: '10 Gbps Redundant' },
    london: { name: 'London Datacenter (Telehouse North)', facility: 'LINX Peering Hub • 100% Green Powered', ping: '⚡ < 110 ms Ping', ip: '185.198.57.8', uplink: '10 Gbps Redundant' },
    newyork: { name: 'New York Datacenter (NY4 Core)', facility: 'Secaucus Data Center • Tier-1 Transatlantic Fibers', ping: '⚡ < 135 ms Ping', ip: '199.195.250.2', uplink: '10 Gbps Redundant' }
  };

  function selectDatacenter(city, btn) {
    document.querySelectorAll('.dc-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const data = dcData[city];
    if (data) {
      document.getElementById('dc-name').innerText = data.name;
      document.getElementById('dc-facility').innerText = data.facility;
      document.getElementById('dc-ping').innerText = data.ping;
      document.getElementById('dc-ip').innerText = data.ip;
      document.getElementById('dc-uplink').innerText = data.uplink;
    }
  }

  function updateCustomVpsPrice() {
    const cpu = parseInt(document.getElementById('vps-slider-cpu').value);
    const ram = parseInt(document.getElementById('vps-slider-ram').value);
    const disk = parseInt(document.getElementById('vps-slider-disk').value);

    document.getElementById('slider-cpu-val').innerText = `${cpu} Core${cpu > 1 ? 's' : ''} (AMD EPYC)`;
    document.getElementById('slider-ram-val').innerText = `${ram} GB RAM`;
    document.getElementById('slider-disk-val').innerText = `${disk} GB NVMe`;

    // Calculation: ₹200 base + CPU * 180 + RAM * 70 + Disk * 2.5
    const inrVal = Math.round(200 + (cpu * 180) + (ram * 70) + (disk * 2.5));
    const usdVal = (inrVal / 83.3).toFixed(2);

    const priceEl = document.getElementById('calc-vps-price');
    if (priceEl) {
      priceEl.setAttribute('data-inr', `₹${inrVal}`);
      priceEl.setAttribute('data-usd', `$${usdVal}`);
      const isUsd = document.querySelector('.currency-current-label')?.textContent?.includes('USD') || localStorage.getItem('hostamble_currency') === 'USD';
      priceEl.innerText = isUsd ? `$${usdVal}` : `₹${inrVal}`;
    }
  }
</script>
