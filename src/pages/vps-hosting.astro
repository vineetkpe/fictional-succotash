---
import Layout from '../layouts/Layout.astro';
---

<Layout title="High-Performance Cloud VPS Servers | Hostamble">

  <!-- Block 1: Hero Area -->
  <div class="slider-area banner img2 bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-12">
          <div class="inner">
            <div class="content">
              <span class="pre-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Pure NVMe KVM Cloud • Starts at <span data-inr="₹499 /mo" data-usd="$5.99 /mo">₹499 /mo</span>
              </span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                High-Performance Cloud VPS Servers
              </h1>
              <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Dedicated vCPU, lightning-fast NVMe storage, and full root access. Scale your web applications, APIs, and databases on enterprise Tier-4 infrastructure with 99.99% uptime guarantee.
              </p>
              <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a class="ace-btn" href="#vps-plans">Deploy Server Now <i class="icon-arrow-right-line-right"></i></a>
              </div>
              <div class="arrow-sign d-lg-block d-none">
                <img src="/assets/images/arrow.png" alt="Arrow Indicator" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="banner-thumbnail text-center">
            <img class="img-thumb" src="/assets/images/banner07.png" alt="Cloud VPS Server" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
          </div>
        </div>
      </div>
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape19.png" alt="Shape"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0501.png" alt="Shape"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1901.png" alt="Shape"></div>
      </div>
    </div>
  </div>

  <!-- Block 2: VPS Pricing Plans Area -->
  <div class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image" id="vps-plans">
    <div class="container aceorbit-animated-shape">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-6">
          <div class="section-title text-start" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
            <span class="pre-title">Scalable Cloud Resources</span>
            <h3 class="title">Choose Your VPS Plan</h3>
          </div>
        </div>
        <div class="col-lg-6 col-md-6">
          <div class="pricing-billing-duration">
            <ul>
              <li class="nav-item">
                <button class="nav-link active" id="vps-monthly-btn" type="button" onclick="switchVpsBilling('monthly')">Monthly</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" id="vps-quarterly-btn" type="button" onclick="switchVpsBilling('quarterly')">Quarterly</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" id="vps-semiannual-btn" type="button" onclick="switchVpsBilling('semiannual')">Semi-Annual</button>
              </li>
              <li class="nav-item">
                <button class="nav-link" id="vps-annual-btn" type="button" onclick="switchVpsBilling('annual')">Annual</button>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="row g-5 mt--20">
        <!-- VPS 1: Starter -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">VPS Starter</h3>
              <div class="price-wrap">
                <div class="vps-pricing-opt vps-monthly" style="display: block;">
                  <span class="amount" data-inr="₹499" data-usd="$5.99">₹499</span>
                  <span class="duration">/monthly</span>
                </div>
                <div class="vps-pricing-opt vps-quarterly" style="display: none;">
                  <span class="amount" data-inr="₹1425" data-usd="$17.10">₹1425</span>
                  <span class="duration">/quarterly</span>
                </div>
                <div class="vps-pricing-opt vps-semiannual" style="display: none;">
                  <span class="amount" data-inr="₹2695" data-usd="$32.35">₹2695</span>
                  <span class="duration">/semiannual</span>
                </div>
                <div class="vps-pricing-opt vps-annual" style="display: none;">
                  <span class="amount" data-inr="₹4990" data-usd="$59.90">₹4990</span>
                  <span class="duration">/annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">1 Core vCPU (EPYC)</li>
                <li style="color: #000; font-weight: bold;">2 GB DDR4 RAM</li>
                <li style="color: #000; font-weight: bold;">40 GB NVMe Gen4 SSD</li>
                <li>1 TB Bandwidth (1 Gbps)</li>
                <li>1 Dedicated IPv4 + /64 IPv6</li>
                <li>Full Root &amp; SSH Access</li>
                <li>Instant OS Provisioning</li>
                <li>Automated Weekly Backup</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/vps-hosting">Deploy Starter</a>
            </div>
          </div>
        </div>

        <!-- VPS 2: Growth (Recommended) -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <div class="pricing-table featured-plan h-100" style="border: 2px solid #ff501a; position: relative;">
            <div class="plan-badge" style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #ff501a; color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 14px; border-radius: 20px; letter-spacing: 0.05em;">Most Popular</div>
            <div class="pricing-header">
              <h3 class="title">VPS Growth</h3>
              <div class="price-wrap">
                <div class="vps-pricing-opt vps-monthly" style="display: block;">
                  <span class="amount" data-inr="₹899" data-usd="$10.79">₹899</span>
                  <span class="duration">/monthly</span>
                </div>
                <div class="vps-pricing-opt vps-quarterly" style="display: none;">
                  <span class="amount" data-inr="₹2560" data-usd="$30.70">₹2560</span>
                  <span class="duration">/quarterly</span>
                </div>
                <div class="vps-pricing-opt vps-semiannual" style="display: none;">
                  <span class="amount" data-inr="₹4850" data-usd="$58.20">₹4850</span>
                  <span class="duration">/semiannual</span>
                </div>
                <div class="vps-pricing-opt vps-annual" style="display: none;">
                  <span class="amount" data-inr="₹8990" data-usd="$107.90">₹8990</span>
                  <span class="duration">/annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">2 Cores vCPU (EPYC)</li>
                <li style="color: #000; font-weight: bold;">4 GB DDR4 RAM</li>
                <li style="color: #000; font-weight: bold;">80 GB NVMe Gen4 SSD</li>
                <li>2 TB Bandwidth (1 Gbps)</li>
                <li>1 Dedicated IPv4 + /64 IPv6</li>
                <li>Full Root &amp; SSH Access</li>
                <li>Free Snapshot Backup</li>
                <li>DDoS Mitigation Protected</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn" href="https://hostamble.com/dash/index.php/store/vps-hosting">Deploy Growth</a>
            </div>
          </div>
        </div>

        <!-- VPS 3: Pro -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">VPS Pro</h3>
              <div class="price-wrap">
                <div class="vps-pricing-opt vps-monthly" style="display: block;">
                  <span class="amount" data-inr="₹1699" data-usd="$20.39">₹1699</span>
                  <span class="duration">/monthly</span>
                </div>
                <div class="vps-pricing-opt vps-quarterly" style="display: none;">
                  <span class="amount" data-inr="₹4840" data-usd="$58.10">₹4840</span>
                  <span class="duration">/quarterly</span>
                </div>
                <div class="vps-pricing-opt vps-semiannual" style="display: none;">
                  <span class="amount" data-inr="₹9170" data-usd="$110.10">₹9170</span>
                  <span class="duration">/semiannual</span>
                </div>
                <div class="vps-pricing-opt vps-annual" style="display: none;">
                  <span class="amount" data-inr="₹16990" data-usd="$203.90">₹16990</span>
                  <span class="duration">/annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">4 Cores vCPU (EPYC)</li>
                <li style="color: #000; font-weight: bold;">8 GB DDR4 RAM</li>
                <li style="color: #000; font-weight: bold;">160 GB NVMe Gen4 SSD</li>
                <li>4 TB Bandwidth (1 Gbps)</li>
                <li>1 Dedicated IPv4 + /64 IPv6</li>
                <li>Full Root &amp; VNC Console</li>
                <li>2 Free Snapshot Backups</li>
                <li>Priority 24/7 Support</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/vps-hosting">Deploy Pro</a>
            </div>
          </div>
        </div>

        <!-- VPS 4: Enterprise -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">VPS Enterprise</h3>
              <div class="price-wrap">
                <div class="vps-pricing-opt vps-monthly" style="display: block;">
                  <span class="amount" data-inr="₹3199" data-usd="$38.39">₹3199</span>
                  <span class="duration">/monthly</span>
                </div>
                <div class="vps-pricing-opt vps-quarterly" style="display: none;">
                  <span class="amount" data-inr="₹9115" data-usd="$109.40">₹9115</span>
                  <span class="duration">/quarterly</span>
                </div>
                <div class="vps-pricing-opt vps-semiannual" style="display: none;">
                  <span class="amount" data-inr="₹17275" data-usd="$207.30">₹17275</span>
                  <span class="duration">/semiannual</span>
                </div>
                <div class="vps-pricing-opt vps-annual" style="display: none;">
                  <span class="amount" data-inr="₹31990" data-usd="$383.90">₹31990</span>
                  <span class="duration">/annual</span>
                </div>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">8 Cores vCPU (EPYC)</li>
                <li style="color: #000; font-weight: bold;">16 GB DDR4 RAM</li>
                <li style="color: #000; font-weight: bold;">320 GB NVMe Gen4 SSD</li>
                <li>8 TB Bandwidth (1 Gbps)</li>
                <li>2 Dedicated IPv4 + /64 IPv6</li>
                <li>Full Root &amp; VNC Console</li>
                <li>Custom Reverse DNS (rDNS)</li>
                <li>Enterprise SLA Guarantee</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/vps-hosting">Deploy Enterprise</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 3: Interactive Operating System & Template Chooser -->
  <div class="ace-service-area ace-section-gap bg-image">
    <div class="container aceorbit-animated-shape">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">1-Click OS Installs</span>
            <h3 class="title">Choose Your Preferred OS &amp; Control Panel</h3>
            <p class="description max-w-700 mx-auto mt-3">
              Deploy your favorite Linux distribution or Windows Server in seconds. Reinstall, format, or switch operating systems anytime directly from your dashboard.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-2 col-md-4 col-6 text-center" data-sal-delay="100" data-sal="slide-up" data-sal-duration="800">
          <div class="os-card p-4 rounded-3 border bg-white shadow-sm h-100 transition-all">
            <div class="os-icon mb-3" style="font-size: 38px; color: #E95420;"><i class="ri-ubuntu-fill"></i></div>
            <h6 class="mb-1 font-weight-bold">Ubuntu</h6>
            <small class="text-muted">24.04 / 22.04 LTS</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="os-card p-4 rounded-3 border bg-white shadow-sm h-100 transition-all">
            <div class="os-icon mb-3" style="font-size: 38px; color: #D70A53;"><i class="ri-terminal-box-line"></i></div>
            <h6 class="mb-1 font-weight-bold">Debian</h6>
            <small class="text-muted">12 Bookworm / 11</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 text-center" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="os-card p-4 rounded-3 border bg-white shadow-sm h-100 transition-all">
            <div class="os-icon mb-3" style="font-size: 38px; color: #102C57;"><i class="ri-centos-line"></i></div>
            <h6 class="mb-1 font-weight-bold">AlmaLinux</h6>
            <small class="text-muted">9.4 / 8.9 Enterprise</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 text-center" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="os-card p-4 rounded-3 border bg-white shadow-sm h-100 transition-all">
            <div class="os-icon mb-3" style="font-size: 38px; color: #0078D7;"><i class="ri-windows-fill"></i></div>
            <h6 class="mb-1 font-weight-bold">Windows</h6>
            <small class="text-muted">Server 2022 / 2019</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 text-center" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="os-card p-4 rounded-3 border bg-white shadow-sm h-100 transition-all">
            <div class="os-icon mb-3" style="font-size: 38px; color: #FF6C2C;"><i class="ri-dashboard-line"></i></div>
            <h6 class="mb-1 font-weight-bold">cPanel / WHM</h6>
            <small class="text-muted">Pre-Installed Addon</small>
          </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 text-center" data-sal-delay="350" data-sal="slide-up" data-sal-duration="800">
          <div class="os-card p-4 rounded-3 border bg-white shadow-sm h-100 transition-all">
            <div class="os-icon mb-3" style="font-size: 38px; color: #2B7A0B;"><i class="ri-code-box-line"></i></div>
            <h6 class="mb-1 font-weight-bold">Docker / CyberPanel</h6>
            <small class="text-muted">1-Click Stacks</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 4: Core VPS Features Grid (6 Cards) -->
  <div class="ace-feature-area ace-section-gap bg-image bg-color-light">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Engineered For Performance</span>
            <h3 class="title">Enterprise Infrastructure Included with Every VPS</h3>
          </div>
        </div>
      </div>

      <div class="row g-5">
        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="100" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-cpu-line"></i></span></div>
              <div class="content">
                <h5 class="title">KVM Hardware Virtualization</h5>
                <p class="description">Guaranteed dedicated CPU and RAM resources with zero overselling. Complete OS isolation with your own dedicated kernel.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-flashlight-line"></i></span></div>
              <div class="content">
                <h5 class="title">Gen4 NVMe SSD in RAID-10</h5>
                <p class="description">Enterprise NVMe solid-state storage delivering up to 7,000 MB/s read speeds and over 100,000 IOPS for intensive database queries.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-terminal-window-line"></i></span></div>
              <div class="content">
                <h5 class="title">Root SSH &amp; Emergency VNC</h5>
                <p class="description">Full superuser root access over SSH plus out-of-band HTML5 VNC console in case you misconfigure firewall or network rules.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-shield-check-line"></i></span></div>
              <div class="content">
                <h5 class="title">Always-On 3.2 Tbps DDoS Defense</h5>
                <p class="description">Multi-layered automated traffic scrubbing ensures malicious DDoS attacks are blocked upstream before hitting your server.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 shape-bg-1 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-camera-lens-line"></i></span></div>
              <div class="content">
                <h5 class="title">1-Click Snapshots &amp; Backups</h5>
                <p class="description">Create point-in-time snapshot images before deploying updates. Restore your entire server state in under two minutes.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="350" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 shape-bg-2 h-100">
            <div class="inner p-4">
              <div class="icon mb-3"><span><i class="ri-speed-up-line"></i></span></div>
              <div class="content">
                <h5 class="title">1 Gbps Unmetered Uplink</h5>
                <p class="description">Ultra-low latency connectivity powered by Tier-1 network carriers with redundant fiber backbones for instant response times.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 5: Technical Comparison & Specifications Table -->
  <div class="ace-section-gap bg-image">
    <div class="container">
      <div class="row align-items-center mb-5">
        <div class="col-lg-8">
          <div class="section-title text-start">
            <span class="pre-title">Hardware Transparency</span>
            <h3 class="title">Hostamble Cloud VPS vs Traditional VPS</h3>
          </div>
        </div>
        <div class="col-lg-4 text-lg-end">
          <span class="badge bg-success px-3 py-2 text-white font-weight-bold" style="font-size: 13px;">99.99% Tier-4 SLA</span>
        </div>
      </div>

      <div class="table-responsive bg-white rounded-3 shadow-sm border p-3">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 35%;">Feature / Specification</th>
              <th scope="col" style="width: 35%; color: #ff501a; font-weight: bold;">Hostamble Cloud VPS</th>
              <th scope="col" style="width: 30%; color: #888;">Standard Traditional VPS</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Virtualization Technology</strong></td>
              <td><span class="text-success"><i class="ri-check-line font-weight-bold"></i> Pure KVM (Dedicated Kernel)</span></td>
              <td>OpenVZ / Shared Kernel</td>
            </tr>
            <tr>
              <td><strong>Disk Storage Architecture</strong></td>
              <td><span class="text-success"><i class="ri-check-line font-weight-bold"></i> Gen4 NVMe SSD (RAID-10 Array)</span></td>
              <td>SATA SSD or mechanical HDD</td>
            </tr>
            <tr>
              <td><strong>Network Interface Speed</strong></td>
              <td><span class="text-success"><i class="ri-check-line font-weight-bold"></i> 1 Gbps High-Throughput Port</span></td>
              <td>100 Mbps Shared Port</td>
            </tr>
            <tr>
              <td><strong>Server Deployment Time</strong></td>
              <td><span class="text-success"><i class="ri-check-line font-weight-bold"></i> Under 60 Seconds Instant</span></td>
              <td>Several Hours / Manual</td>
            </tr>
            <tr>
              <td><strong>DDoS Protection</strong></td>
              <td><span class="text-success"><i class="ri-check-line font-weight-bold"></i> Included Free (Up to 3.2 Tbps)</span></td>
              <td>Extra Paid Add-on</td>
            </tr>
            <tr>
              <td><strong>IP Addresses</strong></td>
              <td><span class="text-success"><i class="ri-check-line font-weight-bold"></i> Dedicated Clean IPv4 + /64 IPv6</span></td>
              <td>Shared or Extra Charge</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Block 6: Help & Migration Assistance CTA Banner -->
  <div class="ace-help-area bg-image domain-style-3 ace-section-gap bg-color-primary">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7">
          <div class="inner">
