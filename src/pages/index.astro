---
import Layout from "../layouts/Layout.astro";
import InteractiveHeroIllustration from "../components/InteractiveHeroIllustration.astro";
import TrustGuaranteesStrip from "../components/TrustGuaranteesStrip.astro";
import ServicesBlock from "../components/ServicesBlock.astro";
import { sharedHosting, domainPricing } from "../data/pricing";

const plans = sharedHosting.plans;
---

<Layout
    title="Hostamble >> #1 India's Best And Cheap Web Hosting Provider"
    description="Affordable NVMe cloud hosting with LiteSpeed Turbo, free domain, automated SSL, and 24/7 dedicated support. Deploy your WordPress or custom website in seconds."
    keywords="cheap web hosting india, fast cloud hosting, wordpress hosting, buy domain name, litespeed hosting, nvme vps, hostamble"
>
    <!--mobile menu end here-->

    <!--Start of Tawk.to Script-->
    <script>
        window.Tawk_API = window.Tawk_API || {};
        window.Tawk_LoadStart = new Date();
        const s1 = document.createElement("script");
        const s0 = document.getElementsByTagName("script")[0];
        s1.async = true;
        s1.src = "https://embed.tawk.to/6293998f7b967b117991d451/1g488vnei";
        s1.setAttribute("crossorigin", "*");
        s0?.parentNode?.insertBefore(s1, s0);
    </script>

    <!--End of Tawk.to Script--><!--First Block -->

    <!-- 🎄 End Popup -->

    <!--First Block -->

    <!--First Block -->
    <div class="slider-area banner bg-image d-flex align-items-center">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 col-md-12">
                    <div class="inner">
                        <div class="content">
                            <div
                                class="hero-eyebrow-pill mb-3"
                                data-sal="slide-up"
                                data-sal-delay="100"
                                data-sal-duration="800"
                            >
                                <span class="eyebrow-dot"></span>
                                <span class="eyebrow-label"
                                    >BEST SHARED HOSTING</span
                                >
                                <span class="eyebrow-sep">•</span>
                                <span class="eyebrow-tag">SAVE 77%</span>
                            </div>

                            <h1
                                class="hero-headline mb-3"
                                data-sal="slide-up"
                                data-sal-delay="150"
                                data-sal-duration="800"
                            >
                                <span class="headline-row-top">
                                    <span class="font-still-black"
                                        >Launch Your Dream Website In Just Click</span
                                    >
                                </span>
                                <span class="headline-row-bottom">
                                    <span class="font-still-black"
                                        >With&nbsp;</span
                                    ><span class="typewriter-slot"
                                        ><span
                                            id="offerWord"
                                            class="font-moving-orange"
                                            >77% Discount</span
                                        ></span
                                    >
                                </span>
                            </h1>

                            <script>
                                import { initTypewriter } from "../scripts/typewriter";
                                initTypewriter();
                            </script>

                            <p
                                class="hero-lead-text mb-4"
                                data-sal="slide-up"
                                data-sal-delay="200"
                                data-sal-duration="800"
                            >
                                Ultra-fast NVMe cloud hosting with LiteSpeed
                                &amp; 24/7 dedicated support.
                            </p>

                            <div
                                class="hero-features-list mb-4"
                                data-sal="slide-up"
                                data-sal-delay="250"
                                data-sal-duration="800"
                            >
                                <div class="hero-pill-badge">
                                    <i
                                        class="ri-flashlight-fill text-primary-accent"
                                    ></i>
                                    <span>LiteSpeed</span>
                                </div>

                                <div class="hero-pill-badge">
                                    <i
                                        class="ri-shield-check-fill text-success-accent"
                                    ></i>
                                    <span>Free Domain &amp; SSL</span>
                                </div>

                                <div class="hero-pill-badge">
                                    <i
                                        class="ri-customer-service-2-fill text-info-accent"
                                    ></i>
                                    <span>Expert Support</span>
                                </div>
                            </div>

                            <div
                                class="hero-action-bar mb-4"
                                data-sal="slide-up"
                                data-sal-delay="300"
                                data-sal-duration="800"
                            >
                                <!-- Offer CTA Pill -->
                                <a href="#plans" class="hero-offer-cta">
                                    <span class="offer-tag">SPECIAL DEAL</span>
                                    <span class="offer-label">
                                        <span>Get 77% Off Today</span>
                                        <i
                                            class="ri-arrow-right-line offer-arrow"
                                        ></i>
                                    </span>
                                </a>

                                <!-- Plan Scroll Anchor Button -->
                                <a
                                    href="#plans"
                                    class="hero-scroll-btn"
                                    title="Explore Hosting Plans"
                                    aria-label="Explore Hosting Plans"
                                >
                                    <i class="ri-arrow-down-line"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <InteractiveHeroIllustration />
                </div>
            </div>

            <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                <div class="shape-image shape-image-1">
                    <img alt="Shape Thumb" src="/assets/images/shape19.png" />
                </div>
                <div class="shape-image shape-image-2">
                    <img alt="Shape Thumb" src="/assets/images/shape0501.png" />
                </div>
                <div class="shape-image shape-image-3">
                    <img alt="Shape Thumb" src="/assets/images/shape1901.png" />
                </div>
            </div>
        </div>
    </div>

    <style is:inline>
        /* Hero Eyebrow Pill */
        .hero-eyebrow-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(255, 80, 26, 0.08);
            border: 1px solid rgba(255, 80, 26, 0.22);
            border-radius: 9999px;
            font-size: 11.5px;
            font-weight: 700;
            color: #ff501a;
            letter-spacing: 0.04em;
            user-select: none;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ff501a;
            box-shadow: 0 0 8px #ff501a;
            animation: liveBlink 1.4s infinite;
        }

        .eyebrow-label {
            letter-spacing: 0.06em;
        }

        .eyebrow-sep {
            color: rgba(255, 80, 26, 0.4);
        }

        .eyebrow-tag {
            background: #ff501a;
            color: #ffffff;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 800;
        }

        /* Headline Styling */
        .hero-headline {
            font-size: clamp(34px, 4.4vw, 56px);
            line-height: 1.2;
            margin-bottom: 18px;
            letter-spacing: -0.035em;
        }

        .headline-row-top {
            display: block;
        }

        .headline-row-bottom {
            display: inline-flex;
            align-items: baseline;
            min-height: 1.25em;
            line-height: 1.2;
        }

        /* Black text: All still text in bold solid black */
        .font-still-black {
            font-family:
                "Plus Jakarta Sans",
                var(--font-primary),
                -apple-system,
                sans-serif;
            font-weight: 900;
            color: #111827;
            letter-spacing: -0.035em;
        }

        /* Fitted slot: Perfectly fitted so text change never shifts or moves the block */
        .typewriter-slot {
            display: inline-block;
            vertical-align: baseline;
            min-width: 380px;
            min-height: 1.25em;
            line-height: 1.2;
            text-align: left;
            white-space: nowrap;
        }

        /* Orange moving text: Different font ('Playfair Display' italic) in brand orange */
        .font-moving-orange {
            font-family: "Playfair Display", Georgia, serif;
            font-style: italic;
            font-weight: 900;
            color: #ff501a;
            padding-left: 2px;
            display: inline-block;
            line-height: 1.2;
            letter-spacing: -0.015em;
            text-shadow: 0 4px 18px rgba(255, 80, 26, 0.22);
        }

        @media (max-width: 991px) {
            .typewriter-slot {
                min-width: 320px;
            }
        }

        @media (max-width: 768px) {
            .typewriter-slot {
                min-width: 270px;
            }
        }

        @media (max-width: 576px) {
            .headline-row-bottom {
                flex-wrap: wrap;
            }
            .typewriter-slot {
                min-width: 220px;
                white-space: normal;
            }
        }

        /* Lead text */
        .hero-lead-text {
            font-size: clamp(16px, 1.2vw, 18px);
            line-height: 1.55;
            color: #374151;
            font-weight: 500;
            max-width: 520px;
        }

        /* Features List */
        .hero-features-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 14px;
            align-items: center;
        }

        .hero-pill-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(220, 226, 235, 0.95);
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1f2937;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        }

        .text-primary-accent {
            color: #ff501a;
            font-size: 16px;
        }
        .text-success-accent {
            color: #10b981;
            font-size: 16px;
        }
        .text-info-accent {
            color: #06b6d4;
            font-size: 16px;
        }

        /* Hero Action Bar & Offer CTA */
        .hero-action-bar {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .hero-offer-cta {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 11px 22px 11px 14px;
            background: linear-gradient(135deg, #ff501a 0%, #ff7a00 100%);
            border-radius: 9999px;
            color: #ffffff !important;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(255, 80, 26, 0.35);
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
            animation: pulseGlow 2.4s infinite;
        }

        .hero-offer-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(255, 80, 26, 0.45);
            color: #ffffff !important;
        }

        .offer-tag {
            background: rgba(0, 0, 0, 0.22);
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 9999px;
            letter-spacing: 0.05em;
            border: 1px solid rgba(255, 255, 255, 0.25);
            white-space: nowrap;
        }

        .offer-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
            font-weight: 800;
            font-family: "Plus Jakarta Sans", var(--font-primary), sans-serif;
            letter-spacing: -0.01em;
            white-space: nowrap;
        }

        .offer-arrow {
            font-size: 18px;
            transition: transform 0.2s ease;
        }

        .hero-offer-cta:hover .offer-arrow {
            transform: translateX(4px);
        }

        .hero-scroll-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            border: 1px solid rgba(220, 226, 235, 0.8);
            color: #ff501a;
            font-size: 24px;
            animation: bounce 1.8s infinite;
            text-decoration: none;
            flex-shrink: 0;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .hero-scroll-btn:hover {
            color: #e53935;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(255, 80, 26, 0.25);
        }

        @keyframes pulseGlow {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 80, 26, 0.6);
            }
            70% {
                box-shadow: 0 0 0 18px rgba(255, 80, 26, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(255, 80, 26, 0);
            }
        }

        @keyframes bounce {
            0%,
            100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(7px);
            }
        }
    </style>

    <!--First block end here-->

    <!-- Trust Guarantees Strip -->
    <TrustGuaranteesStrip />

    <!--offer first block-->

    <!--offer first block end here-->

    <!--blndnd-->

    <!-- Promo Banner & Domain Search Hub -->
    <div class="slider-area banner homepage-banner d-flex align-items-center">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-12">
                    <div class="inner">
                        <div class="content">

                            <!-- 1. Top Bundle Deal Card -->
                            <div class="promo-bundle-box" data-sal="slide-up" data-sal-delay="150" data-sal-duration="700">
                                <div class="bundle-head-row">
                                    <div class="bundle-badge">
                                        <span class="pulse-indicator"></span>
                                        <span>SPECIAL BUNDLE PROMO</span>
                                    </div>
                                    <h4 class="bundle-title">
                                        Get Free (.US.CC) Domain on Every <span class="text-gradient-orange">Semi-Annual &amp; Annual Plan</span>
                                    </h4>
                                </div>

                                <div class="bundle-pipeline-bar">
                                    <div class="bundle-service-label">
                                        <span class="plan-tag">INCLUDED IN</span>
                                        <h5 class="plan-name">Shared Hosting</h5>
                                    </div>

                                    <div class="bundle-features-track">
                                        <!-- Node 1: Domain -->
                                        <div class="bundle-node">
                                            <div class="node-icon-wrap">
                                                <i class="ri-global-line"></i>
                                            </div>
                                            <div class="node-info">
                                                <span class="node-main">Free Domain</span>
                                                <span class="node-sub">.US.CC Included</span>
                                            </div>
                                        </div>

                                        <div class="bundle-connector">
                                            <i class="ri-add-line"></i>
                                        </div>

                                        <!-- Node 2: Hosting -->
                                        <div class="bundle-node">
                                            <div class="node-icon-wrap">
                                                <i class="ri-server-line"></i>
                                            </div>
                                            <div class="node-info">
                                                <span class="node-main">NVMe Hosting</span>
                                                <span class="node-sub">LiteSpeed Powered</span>
                                            </div>
                                        </div>

                                        <div class="bundle-connector">
                                            <i class="ri-add-line"></i>
                                        </div>

                                        <!-- Node 3: SSL -->
                                        <div class="bundle-node">
                                            <div class="node-icon-wrap">
                                                <i class="ri-shield-check-line"></i>
                                            </div>
                                            <div class="node-info">
                                                <span class="node-main">SSL Certificate</span>
                                                <span class="node-sub">Lifetime Auto-Renew</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bundle-action">
                                        <a href="/shared-hosting" class="bundle-buy-btn">
                                            <span>Claim Offer</span>
                                            <i class="ri-arrow-right-line"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Domain Search (Left) & Trending Showcase (Right) -->
                            <div class="row g-4 mt-2">
                                
                                <!-- Left Column: Domain Search -->
                                <div class="col-lg-8" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
                                    <div class="domain-hub-card">
                                        <div class="domain-hub-header">
                                            <div class="hub-eyebrow">
                                                <i class="ri-search-eye-line text-orange"></i>
                                                <span>INSTANT DOMAIN SEARCH</span>
                                            </div>
                                            <h4 class="hub-title">Claim Your Perfect Web Address</h4>
                                            <p class="hub-subtitle">
                                                Search 500+ extensions with free DNS management, privacy theft lock &amp; instant 60-second setup.
                                            </p>
                                        </div>

                                        <!-- Search Form -->
                                        <form
                                            action="https://hostamble.com/dash/domainchecker.php?"
                                            class="creative-domain-form"
                                            method="post"
                                        >
                                            <div class="search-input-wrapper">
                                                <i class="ri-search-2-line search-icon-lead"></i>
                                                <input
                                                    class="creative-input"
                                                    name="domain"
                                                    placeholder="Type your domain name (e.g. mystore)..."
                                                    type="search"
                                                    required
                                                />
                                            </div>
                                            <button type="submit" class="creative-search-btn">
                                                <span>Search Now</span>
                                                <i class="ri-arrow-right-line"></i>
                                            </button>
                                        </form>

                                        <!-- TLD Pricing Cards Grid -->
                                        <div class="tld-showcase-wrap">
                                            <div class="tld-chips-grid">
                                                {
                                                    domainPricing.homepageTlds.map((tld) => (
                                                        <div class="tld-chip-card">
                                                            <div class="tld-top">
                                                                <span class="tld-name">{tld.name}</span>
                                                            </div>
                                                            <div class="tld-prices">
                                                                <span 
                                                                    class="tld-orig"
                                                                    data-inr={tld.original.inr}
                                                                    data-usd={tld.original.usd}
                                                                >
                                                                    {tld.original.inr}
                                                                </span>
                                                                <span 
                                                                    class="tld-deal"
                                                                    data-inr={tld.discount.inr}
                                                                    data-usd={tld.discount.usd}
                                                                >
                                                                    {tld.discount.inr}
                                                                </span>
                                                            </div>
                                                        </div>
                                                    ))
                                                }
                                                <a href="/tld-pricing" class="tld-chip-card tld-view-all">
                                                    <span class="view-all-text">View All 500+</span>
                                                    <i class="ri-arrow-right-line"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Trending Spotlight -->
                                <div class="col-lg-4" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
                                    <div class="trending-spotlight-card">
                                        <div class="spotlight-badge-row">
                                            <span class="badge-spotlight-live">
                                                <span class="badge-dot"></span>
                                                <span>WHAT'S NEW</span>
                                            </span>
                                            <span class="badge-spotlight-cms">HOT PICK</span>
                                        </div>

                                        <div class="spotlight-icon-box">
                                            <i class="ri-wordpress-fill"></i>
                                        </div>

                                        <h5 class="spotlight-title">WordPress Turbo Hosting</h5>
                                        <p class="spotlight-desc">
                                            Specialized hosting fine-tuned for high traffic, automated daily snapshots &amp; built-in LiteSpeed cache.
                                        </p>

                                        <div class="spotlight-perks">
                                            <div class="perk-item">
                                                <i class="ri-check-line text-purple"></i>
                                                <span>300% Faster PHP 8.3 Engine</span>
                                            </div>
                                            <div class="perk-item">
                                                <i class="ri-check-line text-purple"></i>
                                                <span>1-Click Staging &amp; Auto SSL</span>
                                            </div>
                                        </div>

                                        <div class="spotlight-footer">
                                            <div class="spotlight-pricing">
                                                <span class="spotlight-from">Starting at</span>
                                                <span class="spotlight-price" data-inr="₹79/mo" data-usd="$0.95/mo">₹79<small>/mo</small></span>
                                            </div>
                                            <a href="/wordpress-hosting" class="spotlight-cta">
                                                <span>Deploy WP</span>
                                                <i class="ri-arrow-right-line"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                <div class="shape-image shape-image-1">
                    <img alt="Shape Thumb" src="/assets/images/shape19.png" />
                </div>
                <div class="shape-image shape-image-2">
                    <img alt="Shape Thumb" src="/assets/images/shape0501.png" />
                </div>
            </div>
        </div>
    </div>

    <style is:inline>
        /* Promo Bundle Box */
        .promo-bundle-box {
            background: #ffffff;
            border: 1px solid #ffdcd0;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(255, 80, 26, 0.05);
            padding: 26px 32px 28px;
            margin-bottom: 24px;
            transition: all 0.3s ease;
            font-family: "Urbanist", var(--font-primary), -apple-system, sans-serif;
        }
        .promo-bundle-box:hover {
            box-shadow: 0 14px 38px rgba(255, 80, 26, 0.09);
            border-color: #ffb89e;
        }

        .bundle-head-row {
            margin-bottom: 18px;
        }
        .bundle-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(255, 80, 26, 0.08);
            border: 1px solid rgba(255, 80, 26, 0.22);
            color: #ff501a;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.05em;
            padding: 3px 10px;
            border-radius: 999px;
            margin-bottom: 8px;
        }
        .pulse-indicator {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #ff501a;
            box-shadow: 0 0 6px #ff501a;
            animation: livePulse 1.4s infinite;
        }
        @keyframes livePulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }

        .bundle-title {
            font-size: 24px;
            font-weight: 800;
            color: #111827;
            margin: 0;
            letter-spacing: -0.02em;
            font-family: "Urbanist", var(--font-primary), sans-serif;
        }
        .text-gradient-orange {
            color: #ff501a;
        }

        .bundle-pipeline-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            background: linear-gradient(135deg, #ffffff 0%, #fff8f5 100%);
            border: 1px solid #ffede5;
            border-radius: 12px;
            padding: 16px 24px;
        }

        .bundle-service-label {
            display: flex;
            flex-direction: column;
            min-width: 140px;
        }
        .plan-tag {
            font-size: 10px;
            font-weight: 800;
            color: #9ca3af;
            letter-spacing: 0.05em;
        }
        .plan-name {
            font-size: 18px;
            font-weight: 800;
            color: #ff501a;
            margin: 2px 0 0;
            white-space: nowrap;
        }

        .bundle-features-track {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            justify-content: center;
            flex: 1;
        }

        .bundle-node {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #ffffff;
            border: 1px solid #f0f0f5;
            border-radius: 10px;
            padding: 8px 14px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
            transition: transform 0.25s ease;
        }
        .bundle-node:hover {
            transform: translateY(-2px);
            border-color: #ffdcd0;
        }
        .node-icon-wrap {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(255, 80, 26, 0.10);
            color: #ff501a;
            display: flex;
            align-items: center;
