        <script is:inline>
            function updatePricing(plan) {
                // Hide all pricing and discounts
                document.querySelectorAll('.monthly-pricing').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.quarterly-pricing').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.semiannual-pricing').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.annual-pricing').forEach(el => el.style.display = 'none');

                // Hide all "Free Domain" features
                document.querySelectorAll('.free-domain').forEach(el => el.style.display = 'none');

                // Reset all discounts
                document.querySelectorAll('.discount').forEach(el => el.style.display = 'none');

                // Show relevant pricing and discount
                document.querySelectorAll('.' + plan + '-pricing').forEach(el => el.style.display = 'block');
                document.querySelectorAll('.' + plan + '-pricing .discount').forEach(el => el.style.display = 'block');

                // Show "Free Domain" for semiannual and annual plans
                if (plan === 'semiannual' || plan === 'annual') {
                    document.querySelectorAll('.' + plan + '-pricing .free-domain').forEach(el => el.style.display = 'block');
                }
            }
        </script>
