                                        77% OFF
                                    </span>

                                    <script is:inline>
                                        (function () {

                                            const words = [
                                                "77% OFF",
                                                "Free Domain",
                                                "Fast Support",
                                                "Fast Setup",
                                                "Free SSL",
                                                "WordPress"
                                            ];

                                            const el = document.getElementById("offerWord");

                                            let wordIndex = 0;
                                            let charIndex = 0;
                                            let deleting = false;

                                            function typeEffect() {

                                                const current = words[wordIndex];

                                                if (!deleting) {

                                                    charIndex++;
                                                    el.textContent = current.substring(0, charIndex);

                                                    // finished typing
                                                    if (charIndex === current.length) {
                                                        deleting = true;
                                                        setTimeout(typeEffect, 1200);   // pause after full word
                                                        return;
                                                    }

                                                    setTimeout(typeEffect, 70);         // slower typing

                                                } else {

                                                    charIndex--;
                                                    el.textContent = current.substring(0, charIndex);

                                                    if (charIndex === 0) {
                                                        deleting = false;
                                                        wordIndex = (wordIndex + 1) % words.length;
                                                    }

                                                    setTimeout(typeEffect, 40);         // faster deleting
                                                }
                                            }

                                            typeEffect();

                                        })();
                                    </script>

