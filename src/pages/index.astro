    <style is:inline>
        /* Hero Eyebrow Pill */
        .hero-eyebrow-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(255, 80, 26, 0.08);
            border: 1px solid rgba(255, 80, 26, 0.22);
            border-radius: 9999px;
            font-size: 11.5px;
            font-weight: 700;
            color: #ff501a;
            letter-spacing: 0.04em;
            user-select: none;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ff501a;
            box-shadow: 0 0 8px #ff501a;
            animation: liveBlink 1.4s infinite;
        }

        .eyebrow-label {
            letter-spacing: 0.06em;
        }

        .eyebrow-sep {
            color: rgba(255, 80, 26, 0.4);
        }

        .eyebrow-tag {
            background: #ff501a;
            color: #ffffff;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 800;
        }

        /* Headline Styling */
        .hero-headline {
            font-size: clamp(34px, 4.4vw, 56px);
            line-height: 1.2;
            margin-bottom: 18px;
            letter-spacing: -0.035em;
        }

        .headline-row-top {
            display: block;
        }

        .headline-row-bottom {
            display: inline-flex;
            align-items: baseline;
            min-height: 1.25em;
            line-height: 1.2;
        }

        /* Black text: All still text in bold solid black */
        .font-still-black {
            font-family:
                "Plus Jakarta Sans",
                var(--font-primary),
                -apple-system,
                sans-serif;
            font-weight: 900;
            color: #111827;
            letter-spacing: -0.035em;
        }

        /* Fitted slot: Perfectly fitted so text change never shifts or moves the block */
        .typewriter-slot {
            display: inline-block;
            vertical-align: baseline;
            min-width: 380px;
            min-height: 1.25em;
            line-height: 1.2;
            text-align: left;
            white-space: nowrap;
        }

        /* Orange moving text: Different font ('Playfair Display' italic) in brand orange */
        .font-moving-orange {
            font-family: "Playfair Display", Georgia, serif;
            font-style: italic;
            font-weight: 900;
            color: #ff501a;
            padding-left: 2px;
            display: inline-block;
            line-height: 1.2;
            letter-spacing: -0.015em;
            text-shadow: 0 4px 18px rgba(255, 80, 26, 0.22);
        }

        @media (max-width: 991px) {
            .typewriter-slot {
                min-width: 320px;
            }
        }

        @media (max-width: 768px) {
            .typewriter-slot {
                min-width: 270px;
            }
        }

        @media (max-width: 576px) {
            .headline-row-bottom {
                flex-wrap: wrap;
            }
            .typewriter-slot {
                min-width: 220px;
                white-space: normal;
            }
        }

        /* Lead text */
        .hero-lead-text {
            font-size: clamp(16px, 1.2vw, 18px);
            line-height: 1.55;
            color: #374151;
            font-weight: 500;
            max-width: 520px;
        }

        /* Features List */
        .hero-features-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 14px;
            align-items: center;
        }

        .hero-pill-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(220, 226, 235, 0.95);
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1f2937;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        }

        .text-primary-accent {
            color: #ff501a;
            font-size: 16px;
        }
        .text-success-accent {
            color: #10b981;
            font-size: 16px;
        }
        .text-info-accent {
            color: #06b6d4;
            font-size: 16px;
        }

        /* Hero Action Bar & Offer CTA */
        .hero-action-bar {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .hero-offer-cta {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 11px 22px 11px 14px;
            background: linear-gradient(135deg, #ff501a 0%, #ff7a00 100%);
            border-radius: 9999px;
            color: #ffffff !important;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(255, 80, 26, 0.35);
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
            animation: pulseGlow 2.4s infinite;
        }

        .hero-offer-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(255, 80, 26, 0.45);
            color: #ffffff !important;
        }

        .offer-tag {
            background: rgba(0, 0, 0, 0.22);
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 9999px;
            letter-spacing: 0.05em;
            border: 1px solid rgba(255, 255, 255, 0.25);
            white-space: nowrap;
        }

        .offer-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
            font-weight: 800;
            font-family: "Plus Jakarta Sans", var(--font-primary), sans-serif;
            letter-spacing: -0.01em;
            white-space: nowrap;
        }

        .offer-arrow {
            font-size: 18px;
            transition: transform 0.2s ease;
        }

        .hero-offer-cta:hover .offer-arrow {
            transform: translateX(4px);
        }

        .hero-scroll-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            border: 1px solid rgba(220, 226, 235, 0.8);
            color: #ff501a;
            font-size: 24px;
            animation: bounce 1.8s infinite;
            text-decoration: none;
            flex-shrink: 0;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .hero-scroll-btn:hover {
            color: #e53935;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(255, 80, 26, 0.25);
        }

        @keyframes pulseGlow {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 80, 26, 0.6);
            }
            70% {
                box-shadow: 0 0 0 18px rgba(255, 80, 26, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(255, 80, 26, 0);
            }
        }

        @keyframes bounce {
            0%,
            100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(7px);
            }
        }
    </style>

