---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { knowledgeItems, kbCategories } from '../data/knowledgeBase';

// Schema.org FAQPage structured data for Google Rich Snippets & AI Chatbots (ChatGPT, Perplexity, Claude, Gemini)
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": knowledgeItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title="Knowledge Base & Hosting FAQ | 150+ Technical Guides — Hostamble"
  description="Explore Hostamble's comprehensive hosting knowledge base. High-intent technical guides on cPanel, WordPress speed optimization, LiteSpeed Cache, WooCommerce, DNS, Free SSL, NVMe SSD, and website migration."
  keywords="web hosting knowledge base, cpanel guide, litespeed cache faq, wordpress speed optimization, woocommerce hosting, dns records tutorial, hostamble help center, cheap hosting india"
>
  <!-- SEO & AI Chatbot Structured Data (FAQPage Schema) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

  <!-- =========================================================
       HERO SECTION: Knowledge Base & Live Search
       ========================================================= -->
  <div class="slider-area banner bg-image d-flex align-items-center kb-hero-section">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-lg-10 col-xl-8">
          <div class="inner">
            <div class="content">
              <!-- Eyebrow Pill -->
              <div class="hero-eyebrow-pill mb-3" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
                <span class="eyebrow-dot"></span>
                <span class="eyebrow-label">HELP CENTER &amp; KNOWLEDGE BASE</span>
                <span class="eyebrow-sep">•</span>
                <span class="eyebrow-tag">150+ GUIDES</span>
              </div>

              <!-- Main Title -->
              <h1 class="hero-kb-title mb-3" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
                How Can We Help You <span class="kb-accent-text">Succeed Online?</span>
              </h1>

              <p class="hero-lead-text mx-auto mb-4" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
                Instant answers to the most-searched web hosting, cPanel, WordPress performance, WooCommerce scalability, DNS records, and server security questions.
              </p>

              <!-- Interactive Search Bar -->
              <div class="kb-search-box-wrapper mx-auto mb-4" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
                <div class="kb-search-input-group">
                  <i class="ri-search-line search-icon"></i>
                  <input
                    type="text"
                    id="kbSearchInput"
                    placeholder="Search keywords (e.g., LiteSpeed, DNS, Nameservers, cPanel, Staging, SSL)..."
                    aria-label="Search Knowledge Base"
                    autocomplete="off"
                  />
                  <button type="button" id="kbSearchClear" class="kb-search-clear-btn" aria-label="Clear Search" style="display: none;">
                    <i class="ri-close-line"></i>
                  </button>
                </div>
                <div class="kb-search-meta mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <span id="kbResultCount" class="kb-result-badge">{knowledgeItems.length} Guides Available</span>
                  <span class="kb-quick-tags d-none d-md-inline-block">
                    Popular: 
                    <a href="javascript:void(0)" class="quick-filter-tag" data-tag="litespeed">LiteSpeed</a>,
                    <a href="javascript:void(0)" class="quick-filter-tag" data-tag="dns">DNS</a>,
                    <a href="javascript:void(0)" class="quick-filter-tag" data-tag="cpanel">cPanel</a>,
                    <a href="javascript:void(0)" class="quick-filter-tag" data-tag="migration">Migration</a>,
                    <a href="javascript:void(0)" class="quick-filter-tag" data-tag="ssl">SSL</a>,
                    <a href="javascript:void(0)" class="quick-filter-tag" data-tag="woocommerce">WooCommerce</a>
                  </span>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       MAIN KNOWLEDGE BASE SECTION: Categories + Accordions
       ========================================================= -->
  <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white" id="articles">
    <div class="container aceorbit-animated-shape">
      
      <!-- Category Filter Pills -->
      <div class="row justify-content-center mb-5">
        <div class="col-12">
          <div class="kb-category-pills-wrapper d-flex flex-wrap justify-content-center gap-2">
            {kbCategories.map((cat, idx) => (
              <button
                type="button"
                class={`kb-cat-btn ${idx === 0 ? 'active' : ''}`}
                data-category={cat.id}
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Accordion Questions List -->
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          
          <div class="accordion accordion-flush" id="kbAccordion">
            {knowledgeItems.map((item, index) => (
              <div 
                class="accordion-item kb-item"
                data-category={item.category}
                data-keywords={`${item.question} ${item.answer} ${item.tags.join(' ')}`.toLowerCase()}
                id={`item-${item.id}`}
              >
                <h2 class="accordion-header" id={`heading-${item.id}`}>
                  <button
                    class={`accordion-button ${index !== 0 ? 'collapsed' : ''}`}
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target={`#collapse-${item.id}`}
                    aria-expanded={index === 0 ? "true" : "false"}
                    aria-controls={`collapse-${item.id}`}
                  >
                    <span class="kb-q-category-tag">{item.categoryLabel}</span>
                    <span class="kb-q-text">{item.question}</span>
                  </button>
                </h2>
                <div
                  id={`collapse-${item.id}`}
                  class={`accordion-collapse collapse ${index === 0 ? 'show' : ''}`}
                  aria-labelledby={`heading-${item.id}`}
                  data-bs-parent="#kbAccordion"
                >
                  <div class="accordion-body">
                    <p class="mb-3">{item.answer}</p>
                    <div class="kb-item-tags d-flex flex-wrap gap-1 align-items-center">
                      <span class="text-muted small me-2 font-weight-bold"><i class="ri-price-tag-3-line me-1"></i>Related Topics:</span>
                      {item.tags.map(tag => (
                        <span class="badge bg-light text-secondary rounded-pill px-2 py-1 small">{tag}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- No Results State -->
          <div id="kbNoResults" class="text-center py-5" style="display: none;">
            <div class="mb-3">
              <i class="ri-questionnaire-line text-muted" style="font-size: 54px;"></i>
            </div>
            <h4 class="font-weight-bold text-dark">No matching guides found</h4>
            <p class="text-muted mx-auto" style="max-width: 480px;">
              We couldn't find any questions matching your query. Try searching with different keywords, or connect directly with our 24/7 technical team.
            </p>
            <div class="d-flex justify-content-center gap-3 mt-4">
              <button type="button" class="ace-btn btn-border" id="kbResetSearchBtn">Reset Search</button>
              <a href="https://wa.me/916284719083?text=Hi%20Hostamble%20Support%2C%20I%20have%20a%20technical%20question" target="_blank" rel="noopener noreferrer" class="concierge-btn btn-whatsapp">
                <i class="ri-whatsapp-fill"></i>
                <span>Ask on WhatsApp</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Quick Concierge Help Card -->
      <div class="row justify-content-center mt-5 pt-3">
        <div class="col-12 col-lg-10">
          <div class="kb-concierge-card p-4 p-md-5 rounded-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
            <div class="concierge-content text-center text-md-start">
              <span class="badge bg-primary text-white px-3 py-1 rounded-pill small font-weight-bold mb-2">24/7 IN-HOUSE ASSISTANCE</span>
              <h4 class="font-weight-bold text-white mb-2">Can't Find What You're Looking For?</h4>
              <p class="text-white-50 mb-0" style="max-width: 520px;">
                Our certified Linux server administrators and WordPress experts are available around the clock to assist you with migrations, configurations, and inquiries.
              </p>
            </div>
            <div class="concierge-actions d-flex flex-column flex-sm-row gap-3">
              <a href="https://wa.me/916284719083?text=Hi%20Hostamble%20Support%2C%20I%20need%20assistance" target="_blank" rel="noopener noreferrer" class="concierge-btn btn-whatsapp">
                <i class="ri-whatsapp-fill"></i>
                <span>WhatsApp Support</span>
              </a>
              <a href="/contacts" class="concierge-btn btn-ticket">
                <i class="ri-mail-send-line"></i>
                <span>Open Ticket</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Animated Shape Accents -->
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1">
          <img src="/assets/images/shape29.png" alt="Shape Thumb">
        </div>
        <div class="shape-image shape-image-2">
          <img src="/assets/images/shape0306.png" alt="Shape Thumb">
        </div>
        <div class="shape-image shape-image-3">
          <img src="/assets/images/shape0206.png" alt="Shape Thumb">
        </div>
        <div class="shape-image shape-image-4">
          <img src="/assets/images/shape19.png" alt="Shape Thumb">
        </div>
      </div>

    </div>
  </div>

  <HelpCtaBlock />
</Layout>

<script is:inline>
  (function () {
    function initKbSearch() {
      const searchInput = document.getElementById('kbSearchInput');
      const clearBtn = document.getElementById('kbSearchClear');
      const resultBadge = document.getElementById('kbResultCount');
      const categoryBtns = document.querySelectorAll('.kb-cat-btn');
      const items = document.querySelectorAll('.kb-item');
      const noResults = document.getElementById('kbNoResults');
      const resetBtn = document.getElementById('kbResetSearchBtn');
      const quickTags = document.querySelectorAll('.quick-filter-tag');

      if (!searchInput || !items.length) return;

      let currentCategory = 'all';
      let currentQuery = '';

      function filterKnowledgeBase() {
        let visibleCount = 0;
        const query = currentQuery.trim().toLowerCase();

        items.forEach(item => {
          const itemCat = item.getAttribute('data-category') || '';
          const itemKeywords = item.getAttribute('data-keywords') || '';

          const matchesCat = (currentCategory === 'all' || itemCat === currentCategory);
          const matchesQuery = (!query || itemKeywords.includes(query));

          if (matchesCat && matchesQuery) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        // Update counter and no-results UI
        if (resultBadge) {
          resultBadge.textContent = `${visibleCount} Guide${visibleCount === 1 ? '' : 's'} Found`;
        }
        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
        if (clearBtn) {
          clearBtn.style.display = query ? 'block' : 'none';
        }
      }

      // Search input handler
      searchInput.addEventListener('input', function (e) {
        currentQuery = e.target.value;
        filterKnowledgeBase();
      });

      // Clear button handler
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          searchInput.value = '';
          currentQuery = '';
          filterKnowledgeBase();
          searchInput.focus();
        });
      }

      // Category tab click handler
      categoryBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          categoryBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          currentCategory = this.getAttribute('data-category') || 'all';
          filterKnowledgeBase();
        });
      });

      // Quick tags click handler
      quickTags.forEach(tag => {
        tag.addEventListener('click', function () {
          const tagValue = this.getAttribute('data-tag') || '';
          searchInput.value = tagValue;
          currentQuery = tagValue;
          filterKnowledgeBase();
        });
      });

      // Reset search button handler
      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          searchInput.value = '';
          currentQuery = '';
          currentCategory = 'all';
          categoryBtns.forEach(b => b.classList.remove('active'));
          const allBtn = document.querySelector('.kb-cat-btn[data-category="all"]');
          if (allBtn) allBtn.classList.add('active');
          filterKnowledgeBase();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKbSearch);
    } else {
      initKbSearch();
    }
    document.addEventListener('astro:page-load', initKbSearch);
  })();
</script>

<style>
  /* ════════════════════════════════════════════════════════════════
     HERO & SEARCH BOX STYLING
     ════════════════════════════════════════════════════════════════ */
  .kb-hero-section {
    padding: 130px 0 70px !important;
    background: linear-gradient(180deg, #fbfcfe 0%, #ffffff 100%);
  }

  .hero-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 80, 26, 0.08);
    border: 1px solid rgba(255, 80, 26, 0.22);
    border-radius: 9999px;
    font-size: 11.5px;
    font-weight: 700;
    color: #ff501a;
    letter-spacing: 0.04em;
    user-select: none;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff501a;
    box-shadow: 0 0 8px #ff501a;
  }

  .eyebrow-label {
    letter-spacing: 0.06em;
  }

  .eyebrow-sep {
    color: rgba(255, 80, 26, 0.4);
  }

  .eyebrow-tag {
    background: #ff501a;
    color: #ffffff;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 800;
  }

  .hero-kb-title {
    font-family: var(--font-primary, 'Urbanist', -apple-system, sans-serif);
    font-size: clamp(30px, 3.8vw, 48px);
    font-weight: 800;
    line-height: 1.25;
    color: #111827;
    letter-spacing: -0.025em;
  }

  .kb-accent-text {
    color: #ff501a;
  }

  .hero-lead-text {
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.6;
    color: #4b5563;
    max-width: 640px;
  }

  .kb-search-box-wrapper {
    max-width: 680px;
    width: 100%;
  }

  .kb-search-input-group {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 50px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    padding: 6px 18px;
    transition: all 0.25s ease;
  }

  .kb-search-input-group:focus-within {
    border-color: #ff501a;
    box-shadow: 0 12px 35px rgba(255, 80, 26, 0.15);
  }

  .kb-search-input-group .search-icon {
    font-size: 20px;
    color: #94a3b8;
    margin-right: 12px;
  }

  .kb-search-input-group input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 15.5px;
    font-weight: 600;
    color: #0f172a;
    padding: 10px 0;
    background: transparent;
  }

  .kb-search-clear-btn {
    background: #f1f5f9;
    border: none;
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .kb-search-clear-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .kb-search-meta {
    font-size: 13px;
    color: #64748b;
    padding: 0 10px;
  }

  .kb-result-badge {
    font-weight: 700;
    color: #ff501a;
  }

  .quick-filter-tag {
    color: #0284c7;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  .quick-filter-tag:hover {
    color: #ff501a;
  }

  /* ════════════════════════════════════════════════════════════════
     CATEGORY FILTER PILLS
     ════════════════════════════════════════════════════════════════ */
  .kb-category-pills-wrapper {
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .kb-cat-btn {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 8px 20px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .kb-cat-btn:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
    color: #0f172a;
  }

  .kb-cat-btn.active {
    background: #ff501a;
    border-color: #ff501a;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(255, 80, 26, 0.3);
  }

  /* ════════════════════════════════════════════════════════════════
     ACCORDION CARD STYLING
     ════════════════════════════════════════════════════════════════ */
  .kb-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px !important;
    margin-bottom: 14px;
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .kb-item:hover {
    border-color: rgba(255, 80, 26, 0.35);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
  }

  .kb-item .accordion-button {
    font-size: 16.5px;
    font-weight: 700;
    color: #0f172a;
    padding: 20px 24px;
    background: #ffffff;
    box-shadow: none !important;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .kb-item .accordion-button:not(.collapsed) {
    color: #ff501a;
    background: rgba(255, 80, 26, 0.04);
  }

  .kb-q-category-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #f1f5f9;
    color: #64748b;
    padding: 3px 10px;
    border-radius: 6px;
  }

  .kb-item .accordion-button:not(.collapsed) .kb-q-category-tag {
    background: rgba(255, 80, 26, 0.12);
    color: #ff501a;
  }

  .kb-q-text {
    flex: 1 1 70%;
  }

  .kb-item .accordion-body {
    padding: 16px 24px 24px;
    font-size: 15px;
    line-height: 1.7;
    color: #475569;
    border-top: 1px solid #f1f5f9;
  }

  /* ════════════════════════════════════════════════════════════════
     CONCIERGE CARD & FIXED BUTTONS
     ════════════════════════════════════════════════════════════════ */
  .kb-concierge-card {
    background: linear-gradient(135deg, #1b1c2b 0%, #292a40 100%);
    box-shadow: 0 16px 40px rgba(27, 28, 43, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .concierge-actions {
    flex-shrink: 0;
  }

  .concierge-btn {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    height: 48px !important;
    min-height: 48px !important;
    line-height: 48px !important;
    padding: 0 24px !important;
    border-radius: 9999px !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    border: none !important;
    outline: none !important;
    transition: all 0.25s ease !important;
    box-sizing: border-box !important;
    cursor: pointer !important;
  }

  .concierge-btn i {
    font-size: 20px !important;
    line-height: 1 !important;
    position: static !important;
    padding: 0 !important;
    margin: 0 !important;
    top: auto !important;
    left: auto !important;
    display: inline-block !important;
  }

  .concierge-btn span {
    white-space: nowrap !important;
    line-height: 1 !important;
    display: inline-block !important;
  }

  .concierge-btn.btn-whatsapp {
    background: #25D366 !important;
    color: #ffffff !important;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4) !important;
  }

  .concierge-btn.btn-whatsapp:hover {
    background: #1eb855 !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.5) !important;
  }

  .concierge-btn.btn-ticket {
    background: #ffffff !important;
    color: #111827 !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15) !important;
  }

  .concierge-btn.btn-ticket:hover {
    background: #f8fafc !important;
    color: #ff501a !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
  }
</style>
