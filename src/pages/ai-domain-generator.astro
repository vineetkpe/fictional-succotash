                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 5: Help & WhatsApp Concierge (Theme Component)
     ========================================================= -->
<HelpCtaBlock 
    title="Need help choosing or registering your domain?" 
    description="Have questions about domain registration, Anycast DNS setup, free site migration, or finding the right name? Our in-house technical team in India is ready to assist you on WhatsApp and Live Chat."
/>

<!-- =========================================================
     BLOCK 6: Free Essential Tools (Theme Block)
     ========================================================= -->
<div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
    <div class="container aceorbit-animated-shape">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">Free Services</span>
                    <h3 class="title">Everything Included With Your Domain</h3>
                </div>
            </div>
        </div>
        <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">
            <div class="col-lg-3 col-md-6 col-12">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="ri-shield-user-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Free WHOIS Privacy</h6>
                            <p class="description">Keep your personal contact details masked from public ICANN databases with zero renewal surcharges.</p>
                        </div>
                    </div>
