---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';

// ===== FAQ Structured Data for Google SEO Rich Snippets =====
const aiDomainFaqs = [
  {
    question: "How does Hostamble's AI Domain Name Generator work?",
    answer: "Hostamble's AI Domain Name Generator is powered by proprietary Mini AI to analyze your keywords, brand concept, and industry niche. It generates catchy, pronounceable, high-converting domain name variations paired with top commercial domain extensions (.com, .in, .ai, .store) ready for instant registration."
  },
  {
    question: "Is this AI Domain Name Generator free to use?",
    answer: "Yes, 100% free with unlimited searches. You can generate as many domain names as you want with zero sign-ups or hidden charges. When you find a domain you like, you can register it directly through Hostamble at wholesale rates."
  },
  {
    question: "How do I check if an AI-suggested domain name is available?",
    answer: "Every suggested domain card has a direct 'Check' button. Clicking it instantly queries the global WHOIS database through Hostamble's secure domain checker, telling you immediately if the domain is available to register."
  },
  {
    question: "Should I register a .com or a .in domain for my business?",
    answer: "If your target audience is in India, registering a .in or .co.in domain provides a significant local SEO advantage on Google India (google.co.in). If you are building a global brand or international SaaS product, .com or .ai is ideal. We recommend securing both to protect your brand from competitors."
  },
  {
    question: "Do I get free WHOIS domain privacy protection with my registration?",
    answer: "Yes. Hostamble provides free lifetime WHOIS Privacy Protection on all supported domain extensions. Your personal name, residential address, phone number, and email are completely hidden from public databases."
  },
  {
    question: "Can I connect my domain to Shopify, WordPress, or external hosting?",
    answer: "Yes. Every domain registered at Hostamble includes full Anycast DNS management. You can easily create and update A, CNAME, MX, TXT, and SPF records to point your domain to Shopify, WordPress, Wix, or any VPS anytime."
  }
];

const aiDomainFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": aiDomainFaqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout 
  title="Free AI Domain Name Generator | Smart Brand Ideas & Instant Availability"
  description="Generate smart, brandable, high-converting domain names in seconds with Hostamble's AI Domain Generator. Powered by Mini AI with instant WHOIS availability."
  keywords="ai domain generator, domain name generator, smart domain suggestions, business name generator, buy domain name india, check domain availability"
>

<!-- =========================================================
     BLOCK 1: Hero Block & AI Domain Generator Console
     ========================================================= -->
<div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800 position-relative overflow-hidden" id="plans">
    <!-- Interactive Ambient 3D Letters Canvas -->
    <canvas id="domainLettersCanvas" class="domain-hero-canvas" aria-hidden="true"></canvas>

    <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
        <div class="row">
            <div class="col-lg-12">
                <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <div class="content">
                        <!-- AI Badge with Crisp Curves -->
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3" style="background: rgba(255, 80, 26, 0.12); border: 1px solid rgba(255, 80, 26, 0.28); color: #ff501a; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; border-radius: 6px;">
                            <i class="ri-magic-line"></i> POWERED BY HOSTAMBLE MINI AI
                        </div>

                        <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                            AI Domain Name Generator
                        </h1>
                        <p class="description max-w-750 mx-auto" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                            Turn your startup idea or keywords into catchy, high-converting domain names in seconds. Real-time Mini AI brand synthesis with instant WHOIS availability.
                        </p>
                    </div>

                    <!-- AI Search Form -->
                    <div class="domain-form domain-form-style-1 mt--50 mt_md--30 mt_sm--30 position-relative">
                        <form id="aiDomainForm" class="input-box text-start" onsubmit="return false;">
                            <input id="aiDomainInput" class="large-input-box" type="search" placeholder="Enter keywords or brand idea (e.g. cloud, pay, flow, craft, nova)..." value="novaflow" name="domain" autocomplete="off" required>
                            <div class="mail-icon">
                                <i class="ri-magic-line"></i>
                            </div>
                            <button type="submit" id="aiGenerateBtn" class="ace-btn">
                                <span id="btnText">Generate Ideas</span><i class="icon-arrow-right-line-right"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Trending Seed Prompt Pills -->
                    <div class="hero-prompt-chips mt-3 d-flex flex-wrap justify-content-center gap-2">
                        <span class="prompt-chip-label text-muted small me-1">Try ideas:</span>
                        <button type="button" class="prompt-chip-btn" data-word="cloudstack">Cloud Stack</button>
                        <button type="button" class="prompt-chip-btn" data-word="payflow">Pay Flow</button>
                        <button type="button" class="prompt-chip-btn" data-word="craftly">Craftly Store</button>
                        <button type="button" class="prompt-chip-btn" data-word="nexusaudio">Nexus Audio</button>
                        <button type="button" class="prompt-chip-btn" data-word="vitalfit">Vital Fit</button>
                    </div>

                    <!-- TLD Pricing Row -->
                    <ul class="select-tlds mt-4">
                       {domainPricing.searchTlds.map((tld) => (
                           <li>
                               <span class="name">{tld.name}</span>
                               <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                               <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                           </li>
                       ))}
                       <li class="bg-none border-0 p-0 box-shadow-none">
                           <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                       </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
            <div class="shape-image shape-image-1"><img src="/assets/images/www.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-2"><img src="/assets/images/www2.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-3"><img src="/assets/images/www3.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-4"><img src="/assets/images/www4.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-5"><img src="/assets/images/www5.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-6"><img src="/assets/images/www6.png" alt="Shape Thumb"></div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 2: AI Generated Domain Results Dashboard (THE CORE BLOCK)
     ========================================================= -->
<div class="ai-results-wrapper position-relative" id="resultsSection">
    <div class="container position-relative" style="z-index: 2;">
        
        <!-- Results Section Header -->
        <div class="row justify-content-center text-center ai-results-header-box">
            <div class="col-lg-8 col-12">
                <span class="pre-title" id="resultsCountTag">AI BRAND SUGGESTIONS</span>
                <h3 class="title" id="resultsTitle">Available Domain Ideas for "novaflow"</h3>
                <p class="description max-w-750 mx-auto">
                    Select any domain to check instant live WHOIS availability or copy the name to your clipboard.
                </p>
            </div>
        </div>

        <!-- Filter Navigation Pills -->
        <div class="ai-filter-bar">
            <button type="button" class="ai-filter-btn active" data-filter="all">All (18)</button>
            <button type="button" class="ai-filter-btn" data-filter="com">🔥 .com</button>
            <button type="button" class="ai-filter-btn" data-filter="in">🇮🇳 .in</button>
            <button type="button" class="ai-filter-btn" data-filter="ai">🤖 .ai</button>
            <button type="button" class="ai-filter-btn" data-filter="store">🛍️ .store</button>
            <button type="button" class="ai-filter-btn" data-filter="short">⚡ Short (&lt;8 chars)</button>
        </div>

        <!-- Loading State Indicator (Hidden by Default) -->
        <div id="aiLoadingIndicator" class="text-center py-5 d-none">
            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Generating...</span>
            </div>
            <h5 class="text-dark font-weight-bold">Mini AI is synthesizing domain names...</h5>
            <p class="text-muted small">Checking semantic flow, brandability, and TLD suitability</p>
        </div>

        <!-- Results Cards Grid -->
        <div class="row g-4 justify-content-center" id="aiResultsGrid">
            <!-- Dynamically populated via client script -->
        </div>

    </div>
</div>

<!-- =========================================================
     BLOCK 3: Trending Startup Domains by Category (Native Theme Styling)
     ========================================================= -->
<div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
