<!-- =========================================================
     CLIENT SCRIPT: Hostamble Mini AI Connection + Smart Algorithmic Synthesizer
     ========================================================= -->
<script id="hostamble-tld-rates" type="application/json" set:html={JSON.stringify(tldRatesMap)}></script>
<script is:inline>
  (function () {
    /* ════════════════════════════════════════════════════════════════
       3D Floating TLD Canvas Background
       ════════════════════════════════════════════════════════════════ */
    function initDomainHeroScene() {
      const canvas = document.getElementById("domainLettersCanvas");
      const hero = document.getElementById("plans");
      if (!canvas || !hero) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = (canvas.width = hero.offsetWidth);
      let height = (canvas.height = hero.offsetHeight);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      function resize() {
        width = hero.offsetWidth;
        height = hero.offsetHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.scale(dpr, dpr);
      }
      resize();
      window.addEventListener("resize", resize, { passive: true });

      const mouse = { x: -9999, y: -9999, active: false, tiltX: 0, tiltY: 0, targetTiltX: 0, targetTiltY: 0 };
      function updateMouse(e) {
        const rect = hero.getBoundingClientRect();
        const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches && e.touches.length > 0 ? e.touches[0].clientY : e.clientY;
        mouse.x = clientX - rect.left;
        mouse.y = clientY - rect.top;
        mouse.active = true;
        mouse.targetTiltX = (mouse.x / width - 0.5) * 12;
        mouse.targetTiltY = (mouse.y / height - 0.5) * 8;
      }

      hero.addEventListener("mousemove", updateMouse, { passive: true });
      hero.addEventListener("mouseleave", function () {
        mouse.active = false;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      const tldSpecs = [
        { text: ".com", color: "#ff501a", size: 16, isBold: true },
        { text: ".in", color: "#ff501a", size: 15, isBold: true },
        { text: ".ai", color: "#ff6e3a", size: 15, isBold: true },
        { text: ".org", color: "#16a34a", size: 14, isBold: false },
        { text: ".store", color: "#16a34a", size: 13, isBold: false },
        { text: ".xyz", color: "#0284c7", size: 13, isBold: false },
        { text: ".io", color: "#8b5cf6", size: 14, isBold: true },
        { text: ".tech", color: "#ff501a", size: 13, isBold: false },
      ];

      const isMobile = window.innerWidth < 768;
      const count = isMobile ? 6 : tldSpecs.length;
      const sprites = [];
      for (let i = 0; i < count; i++) {
        const spec = tldSpecs[i % tldSpecs.length];
        const isRight = i % 2 === 1;
        const bandMinX = isRight ? 0.74 * width : 0.04 * width;
        const bandMaxX = isRight ? 0.95 * width : 0.26 * width;
        const x = bandMinX + Math.random() * (bandMaxX - bandMinX);
        const y = 0.12 * height + Math.random() * (0.76 * height);
        const z = -2.5 + Math.random() * 5.0;
        const angle = Math.random() * Math.PI * 2;
        const speed = 0.05 + Math.random() * 0.06;

        sprites.push({
          text: spec.text,
          color: spec.color,
          baseSize: spec.size,
          isBold: spec.isBold,
          x: x, y: y, z: z,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseVx: Math.cos(angle) * speed,
          baseVy: Math.sin(angle) * speed,
          isRight: isRight,
          wobbleSpeed: 0.006 + Math.random() * 0.008,
          wobbleAmp: 0.06 + Math.random() * 0.08,
          wobbleOffset: Math.random() * 100,
        });
      }

      let tick = 0;
      let isRunning = true;
      function render() {
        if (!isRunning) return;
        tick++;
        ctx.clearRect(0, 0, width, height);
        mouse.tiltX += (mouse.targetTiltX - mouse.tiltX) * 0.04;
        mouse.tiltY += (mouse.targetTiltY - mouse.tiltY) * 0.04;

        for (let i = 0; i < sprites.length; i++) {
          const sp = sprites[i];
          if (mouse.active) {
            const dx = sp.x - mouse.x;
            const dy = sp.y - mouse.y;
            const dist = Math.hypot(dx, dy);
            if (dist < 90 && dist > 1) {
              const force = Math.pow(1 - dist / 90, 1.4) * 1.5;
              sp.vx += (dx / dist) * force;
              sp.vy += (dy / dist) * force;
            }
          }

          sp.vx += (sp.baseVx - sp.vx) * 0.025;
          sp.vy += (sp.baseVy - sp.vy) * 0.025;
          sp.x += sp.vx;
          sp.y += sp.vy + Math.sin(tick * sp.wobbleSpeed + sp.wobbleOffset) * sp.wobbleAmp;

          const bandMinX = sp.isRight ? 0.70 * width : 0.02 * width;
          const bandMaxX = sp.isRight ? 0.98 * width : 0.30 * width;
          if (sp.x < bandMinX) { sp.x = bandMinX; sp.vx = Math.abs(sp.vx) * 0.75; }
          else if (sp.x > bandMaxX) { sp.x = bandMaxX; sp.vx = -Math.abs(sp.vx) * 0.75; }

          if (sp.y < 0.08 * height) { sp.y = 0.08 * height; sp.vy = Math.abs(sp.vy) * 0.75; }
          else if (sp.y > 0.88 * height) { sp.y = 0.88 * height; sp.vy = -Math.abs(sp.vy) * 0.75; }

          const depthFactor = 0.9 + (sp.z + 2.5) * 0.08;
          const opacity = Math.min(0.42, Math.max(0.18, 0.20 + (sp.z + 2.5) * 0.04));
          const fontSize = Math.round(sp.baseSize * depthFactor);
          const renderX = sp.x + mouse.tiltX * (0.4 + (sp.z + 2.5) * 0.1);
          const renderY = sp.y + mouse.tiltY * (0.4 + (sp.z + 2.5) * 0.1);

          ctx.save();
          ctx.font = `${sp.isBold ? "700" : "600"} ${fontSize}px "Space Mono", monospace`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.globalAlpha = opacity;
          ctx.shadowColor = sp.color;
          ctx.shadowBlur = 8;
          ctx.fillStyle = sp.color;
          ctx.fillText(sp.text, renderX, renderY);
          ctx.restore();
        }
        requestAnimationFrame(render);
      }
      requestAnimationFrame(render);

      document.addEventListener("visibilitychange", function () {
        isRunning = !document.hidden;
        if (isRunning) requestAnimationFrame(render);
      });
    }

    /* ════════════════════════════════════════════════════════════════
       AI Domain Generator Logic
       ════════════════════════════════════════════════════════════════ */
    let tldRates = {};
    try {
      const ratesEl = document.getElementById("hostamble-tld-rates");
      if (ratesEl && ratesEl.textContent) {
        tldRates = JSON.parse(ratesEl.textContent);
      }
    } catch (e) {
      console.warn("Could not load dynamic TLD rates:", e);
    }
    const defaultTldRate = tldRates[".com"] || { inr: "₹499 /yr", usd: "$5.95 /yr" };

    const form = document.getElementById("aiDomainForm");
    const input = document.getElementById("aiDomainInput");
    const btn = document.getElementById("aiGenerateBtn");
    const btnText = document.getElementById("btnText");
    const grid = document.getElementById("aiResultsGrid");
    const countTag = document.getElementById("resultsCountTag");
    const resultsTitle = document.getElementById("resultsTitle");
    const filterTabs = document.querySelectorAll(".ai-filter-btn");
    const loadingEl = document.getElementById("aiLoadingIndicator");

    let currentList = [];
    let currentFilter = "all";

    function cleanWord(str) {
      return (str || "").toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 20);
    }

    // Real-Time DNS Availability Verifier (Multi-Source: Google, Cloudflare & RDAP)
    async function checkLiveAvailability(domain) {
      // 1. Google DNS-over-HTTPS (RFC 8484) - Check NS records
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2000);
        const res = await fetch(`https://dns.google/resolve?name=${encodeURIComponent(domain)}&type=NS`, { signal: controller.signal });
        clearTimeout(timer);
        if (res.ok) {
          const data = await res.json();
          // Status 3 = NXDOMAIN: Domain not registered in registry -> AVAILABLE
          if (data.Status === 3) return "AVAILABLE";
          // Status 0 (NOERROR) or Status 2 (SERVFAIL): Domain exists in registry -> TAKEN
          if (data.Status === 0 || data.Status === 2) return "TAKEN";
        }
      } catch (e) {}

      // 1b. Google DNS-over-HTTPS - Check A records
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2000);
        const res = await fetch(`https://dns.google/resolve?name=${encodeURIComponent(domain)}&type=A`, { signal: controller.signal });
        clearTimeout(timer);
        if (res.ok) {
          const data = await res.json();
          if (data.Status === 3) return "AVAILABLE";
          if (data.Status === 0 || data.Status === 2) return "TAKEN";
        }
      } catch (e) {}

      // 2. Cloudflare DNS-over-HTTPS fallback
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2000);
        const res = await fetch(`https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(domain)}&type=NS`, {
          headers: { "accept": "application/dns-json" },
          signal: controller.signal
        });
        clearTimeout(timer);
        if (res.ok) {
          const data = await res.json();
          if (data.Status === 3) return "AVAILABLE";
          if (data.Status === 0 || data.Status === 2) return "TAKEN";
        }
      } catch (e) {}

      // 3. RDAP fallback (Official Registry Data: 200 = Registered, 404 = Available)
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 2500);
        const res = await fetch(`https://rdap.org/domain/${encodeURIComponent(domain)}`, { signal: controller.signal });
        clearTimeout(timer);
        if (res.status === 200) return "TAKEN";
        if (res.status === 404) return "AVAILABLE";
      } catch (e) {}

      return "UNKNOWN";
    }

    // High-Quality Algorithmic Backup Synthesizer
    function generateSmartFallbackList(raw) {
      const cleanRaw = (raw || "").toLowerCase().replace(/[^a-z0-9\s]/g, " ").trim();
      const tokens = cleanRaw.split(/\s+/).filter(Boolean);
      const root = cleanWord(tokens.join("")) || "novaflow";
      const primary = cleanWord(tokens[0]) || root;
      const secondary = cleanWord(tokens[1]) || "";

      const results = [];
      const seen = new Set();

      function addDomain(name, tld, tag) {
        const cleanName = cleanWord(name);
        if (!cleanName) return;
        const full = `${cleanName}${tld}`;
        if (!seen.has(full)) {
          seen.add(full);
          results.push({
            name: cleanName,
            tld: tld,
            full: full,
            tag: tag,
            price: tldRates[tld] || defaultTldRate
          });
        }
      }

      // 1. Exact Match Core Roots (checked live so user gets real data)
      addDomain(root, ".com", "Exact Match");
      addDomain(root, ".in", "Exact Match");
      addDomain(root, ".ai", "AI / Tech");
      addDomain(root, ".co.in", "Regional");
      addDomain(root, ".io", "Developer");

      // 2. Action SaaS & Startup Prefixes (High availability)
      addDomain(`get${primary}`, ".com", "Action SaaS");
      addDomain(`try${primary}`, ".in", "Action SaaS");
      addDomain(`go${primary}`, ".ai", "Action SaaS");
      addDomain(`use${primary}`, ".io", "Action SaaS");
      addDomain(`join${primary}`, ".com", "Action SaaS");

      // 3. Modern Brandable Affixes
      addDomain(`${primary}ly`, ".com", "Brandable");
      addDomain(`${primary}ify`, ".in", "Brandable");
      addDomain(`${primary}hq`, ".com", "Brandable");
      addDomain(`${primary}lab`, ".ai", "Brandable");
      addDomain(`${primary}app`, ".io", "Brandable");

      // 4. Compound Startup Modifiers
      addDomain(`${primary}flow`, ".com", "Compound");
      addDomain(`${primary}stack`, ".in", "Compound");
      addDomain(`${primary}pulse`, ".ai", "Compound");
      addDomain(`${primary}craft`, ".com", "Compound");
      addDomain(`${primary}base`, ".tech", "Compound");
      addDomain(`${primary}nexus`, ".io", "Compound");
      addDomain(`${primary}hub`, ".store", "eCommerce");

      // 5. If secondary word exists, synthesize combined patterns
      if (secondary) {
        addDomain(`${primary}${secondary}`, ".com", "Exact Match");
        addDomain(`${primary}${secondary}`, ".in", "Exact Match");
        addDomain(`get${primary}${secondary}`, ".com", "Action SaaS");
        addDomain(`${primary}${secondary}hq`, ".ai", "Brandable");
      }

      // 6. Premium Adjectives
      addDomain(`nova${primary}`, ".com", "Premium");
      addDomain(`smart${primary}`, ".ai", "Premium");
      addDomain(`prime${primary}`, ".in", "Premium");
      addDomain(`apex${primary}`, ".tech", "Premium");

      return results.slice(0, 18);
    }

    // Main Domain Generator function
    async function fetchAiDomains(keyword) {
      const cleanKw = (keyword || "").trim();
      if (!cleanKw) return;

      // Reveal results section if hidden and scroll to it
      const resultsSec = document.getElementById("resultsSection");
      if (resultsSec) {
        resultsSec.style.display = "block";
        resultsSec.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      if (btnText) btnText.textContent = "Synthesizing...";
      if (btn) btn.disabled = true;
      if (loadingEl) loadingEl.classList.remove("d-none");
      if (grid) grid.innerHTML = "";
      if (resultsTitle) resultsTitle.textContent = `Generating Real-Time Ideas for "${cleanKw}"...`;

      let domains = null;

      // 1. Try secure server-side PHP endpoint first (where API key is hidden on server) with quick timeout
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 1500);

        const response = await fetch("/api/generate-domains.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ keyword: cleanKw }),
          signal: controller.signal
        });
        clearTimeout(timer);

        if (response.ok) {
          const data = await response.json();
          if (data && data.success && Array.isArray(data.domains) && data.domains.length > 0) {
            domains = data.domains;
          }
        }
      } catch (err) {
        // Local preview or endpoint unavailable
      }

      // 2. If server PHP not reachable, call Gemini endpoint directly with quick timeout
      if (!domains) {
        try {
          const controller = new AbortController();
          const timer = setTimeout(() => controller.abort(), 1800);

          const _k = atob("QVEuQWI4Uk42THl2eGZ5WS1lWlI1OHkzalc2TWpkRElkZ3JuNVFIeUhqaXJWQjlOdzVtc3c=");
          const aiEndpointUrl = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=" + _k;
          const prompt = `You are an expert domain name generator for Hostamble Mini AI. Generate exactly 18 highly brandable, modern, catchy domain names for the keyword "${cleanKw}". Use a mix of .com, .in, .ai, .store, .co.in, .tech, .io, .org. No hyphens or numbers. Return ONLY a valid JSON array of objects with the exact schema: [{"name": "rootname", "tld": ".com", "tag": "Brandable"}]`;
          
          const gRes = await fetch(aiEndpointUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }),
            signal: controller.signal
          });
          clearTimeout(timer);

          if (gRes.ok) {
            const gData = await gRes.json();
            const text = gData?.candidates?.[0]?.content?.parts?.[0]?.text || "";
            const cleanText = text.replace(/^```json/i, "").replace(/^```/, "").replace(/```$/, "").trim();
            const parsed = JSON.parse(cleanText);
            if (Array.isArray(parsed) && parsed.length > 0) {
              domains = parsed;
            }
          }
        } catch (err2) {
          // Direct AI call failed or timed out, will fall back instantly below
        }
      }

      // 3. Guaranteed Rock-Solid Algorithmic Backup Synthesizer (Instant & 100% Reliable)
      if (!domains || domains.length === 0) {
        domains = generateSmartFallbackList(cleanKw);
      }

      currentList = domains.map((d, idx) => {
        const rawTld = (d.tld || ".com").startsWith(".") ? d.tld : `.${d.tld}`;
        const cleanName = (d.name || "").toLowerCase().replace(/[^a-z0-9]/g, "");
        const full = `${cleanName}${rawTld}`;
        return {
          id: `dom_${idx}_${cleanName}`,
          name: cleanName,
          tld: rawTld,
          full: full,
          tag: d.tag || "Brandable",
          price: tldRates[rawTld] || defaultTldRate,
          status: "CHECKING"
        };
      });

      if (btnText) btnText.textContent = "Generate Ideas";
      if (btn) btn.disabled = false;
      if (loadingEl) loadingEl.classList.add("d-none");
      if (resultsTitle) resultsTitle.textContent = `Live Domain Ideas for "${cleanKw}"`;

      renderResults();
      verifyAllDomains();
    }

    // Asynchronous Real-Time Verification Runner
    async function verifyAllDomains() {
      const activeCurrency = (typeof localStorage !== "undefined" && localStorage.getItem("hostamble_currency")) || "INR";

      // Verify in concurrency batches of 4
      for (let i = 0; i < currentList.length; i += 4) {
        const batch = currentList.slice(i, i + 4);
        await Promise.all(batch.map(async (item) => {
          const status = await checkLiveAvailability(item.full);
          item.status = status;

          const badgeEl = document.getElementById(`badge-${item.id}`);
          const footerEl = document.getElementById(`footer-${item.id}`);
          const colEl = document.getElementById(`col-${item.id}`);

          if (badgeEl) {
            if (status === "AVAILABLE") {
              badgeEl.className = "ai-live-badge status-available";
              badgeEl.innerHTML = `<span class="ai-live-dot dot-available"></span><span class="badge-text">Available</span>`;
            } else if (status === "TAKEN") {
              badgeEl.className = "ai-live-badge status-taken";
              badgeEl.innerHTML = `<span class="ai-live-dot dot-taken"></span><span class="badge-text">Taken</span>`;
            } else {
              badgeEl.className = "ai-live-badge status-checking";
              badgeEl.innerHTML = `<span class="ai-live-dot dot-checking"></span><span class="badge-text">Check Live</span>`;
            }
          }

          if (footerEl) {
            const orderUrl = `https://hostamble.com/dash/domainchecker.php?search=${encodeURIComponent(item.full)}`;
            const displayPrice = activeCurrency === "USD" ? item.price.usd : item.price.inr;
            if (status === "TAKEN") {
              footerEl.innerHTML = `
                <div class="ai-card-pricing">
                  <span class="ai-card-price text-muted" style="text-decoration: line-through; opacity: 0.65;">${displayPrice}</span>
                  <span class="ai-card-price-label d-block text-danger font-weight-bold">Already Registered</span>
                </div>
                <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="ace-btn btn-small btn-taken" title="Check WHOIS details for ${item.full}">
                  <span>WHOIS</span> <i class="ri-external-link-line"></i>
                </a>
              `;
              if (colEl) {
                const card = colEl.querySelector(".ai-domain-result-card");
                if (card) card.classList.add("is-taken");
                if (currentFilter === "available") {
                  colEl.style.display = "none";
                }
              }
            } else if (status === "AVAILABLE") {
              footerEl.innerHTML = `
                <div class="ai-card-pricing">
                  <span class="ai-card-price prices" data-inr="${item.price.inr}" data-usd="${item.price.usd}">${displayPrice}</span>
                  <span class="ai-card-price-label d-block text-muted">1st Year Reg</span>
                </div>
                <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="ace-btn btn-small" title="Register ${item.full}">
                  <span>Register</span> <i class="icon-arrow-right-line-right"></i>
                </a>
              `;
              if (colEl && currentFilter === "available") {
                colEl.style.display = "block";
              }
            } else {
              footerEl.innerHTML = `
                <div class="ai-card-pricing">
                  <span class="ai-card-price prices" data-inr="${item.price.inr}" data-usd="${item.price.usd}">${displayPrice}</span>
                  <span class="ai-card-price-label d-block text-muted">1st Year Reg</span>
                </div>
                <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="ace-btn btn-small" title="Check Live WHOIS for ${item.full}">
                  <span>Check Live</span> <i class="ri-external-link-line"></i>
                </a>
              `;
            }
          }

          // Update available count pill in real-time
          const availCountEl = document.getElementById("availCount");
          if (availCountEl) {
            const count = currentList.filter(x => x.status === "AVAILABLE").length;
            availCountEl.textContent = count;
          }
        }));
      }
    }

    function renderResults() {
      if (!grid) return;

      const filtered = currentList.filter(item => {
        if (currentFilter === "all") return true;
        if (currentFilter === "available") return item.status === "AVAILABLE";
        if (currentFilter === "com") return item.tld === ".com";
        if (currentFilter === "in") return item.tld === ".in" || item.tld === ".co.in";
        if (currentFilter === "ai") return item.tld === ".ai" || item.tld === ".io" || item.tld === ".tech";
        if (currentFilter === "store") return item.tld === ".store";
        if (currentFilter === "short") return item.name.length <= 8;
        return true;
      });

      if (countTag) {
        countTag.textContent = `${currentList.length} Suggestions Generated`;
      }
      const pillCount = document.getElementById("pillCount");
      if (pillCount) {
        pillCount.textContent = currentList.length;
      }
      const availCountEl = document.getElementById("availCount");
      if (availCountEl) {
        const availCount = currentList.filter(i => i.status === "AVAILABLE").length;
        availCountEl.textContent = currentList.some(i => i.status === "CHECKING") ? "..." : availCount;
      }

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-12 text-center py-5">
            <h5 class="text-muted">No domains match the selected filter.</h5>
            <p class="text-muted small">Switch back to 'All' or type new keywords above.</p>
          </div>
        `;
        return;
      }

      const activeCurrency = (typeof localStorage !== "undefined" && localStorage.getItem("hostamble_currency")) || "INR";

      grid.innerHTML = filtered.map((item, idx) => {
        const orderUrl = `https://hostamble.com/dash/domainchecker.php?search=${encodeURIComponent(item.full)}`;
        const shapeClass = idx % 2 === 0 ? 'shape-bg-1' : 'shape-bg-2';
        const displayPrice = activeCurrency === "USD" ? item.price.usd : item.price.inr;
        const isTaken = item.status === "TAKEN";

        let badgeStatusClass = "status-checking";
        let dotStatusClass = "dot-checking";
        let badgeLabel = "Verifying...";
        if (item.status === "AVAILABLE") {
          badgeStatusClass = "status-available";
          dotStatusClass = "dot-available";
          badgeLabel = "Available";
        } else if (item.status === "TAKEN") {
          badgeStatusClass = "status-taken";
          dotStatusClass = "dot-taken";
          badgeLabel = "Taken";
        } else if (item.status === "UNKNOWN") {
          badgeStatusClass = "status-checking";
          dotStatusClass = "dot-checking";
          badgeLabel = "Check Live";
        }

        return `
          <div class="col-lg-4 col-md-6 col-12 dom-item-col" id="col-${item.id}">
            <div class="service-card service-card-3 text-left ${shapeClass} bg-grey h-100 ai-domain-result-card ${isTaken ? 'is-taken' : ''}">
              <div class="inner d-flex flex-column h-100 justify-content-between">
                
                <!-- Card Header: Tag Badge + Live Status + Copy Button -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <div class="d-flex align-items-center gap-2">
                    <span class="ai-domain-badge">${item.tag}</span>
                    <span class="ai-live-badge ${badgeStatusClass}" id="badge-${item.id}">
                      <span class="ai-live-dot ${dotStatusClass}"></span>
                      <span class="badge-text">${badgeLabel}</span>
                    </span>
                  </div>
                  <button type="button" class="ai-copy-btn" data-domain="${item.full}" title="Copy domain name">
                    <i class="ri-file-copy-line"></i>
                  </button>
                </div>

                <!-- Domain Name & Subtitle -->
                <div class="content mb-3">
                  <h5 class="title ai-card-domain-name mb-1">
                    ${item.name}<strong class="text-primary">${item.tld}</strong>
                  </h5>
                  <p class="description mb-0 text-muted" style="font-size: 13px;">
                    Free WHOIS Privacy &amp; Anycast DNS
                  </p>
                </div>

                <!-- Footer: Pricing & Action Button -->
                <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto" id="footer-${item.id}">
                  <div class="ai-card-pricing">
                    <span class="ai-card-price prices ${isTaken ? 'text-muted text-decoration-line-through' : ''}" data-inr="${item.price.inr}" data-usd="${item.price.usd}">${displayPrice}</span>
                    <span class="ai-card-price-label d-block ${isTaken ? 'text-danger font-weight-bold' : 'text-muted'}">${isTaken ? 'Already Registered' : '1st Year Reg'}</span>
                  </div>
                  <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="ace-btn btn-small ${isTaken ? 'btn-taken' : ''}" title="${isTaken ? 'View WHOIS details for ' + item.full : 'Register ' + item.full}">
                    <span>${isTaken ? 'WHOIS' : 'Register'}</span> <i class="${isTaken ? 'ri-external-link-line' : 'icon-arrow-right-line-right'}"></i>
                  </a>
                </div>

              </div>
            </div>
          </div>
        `;
      }).join("");

      // Bind copy buttons
      grid.querySelectorAll(".ai-copy-btn").forEach(btn => {
        btn.addEventListener("click", function () {
          const dom = this.getAttribute("data-domain");
          if (dom) {
            navigator.clipboard.writeText(dom).then(() => {
              const icon = this.querySelector("i");
              if (icon) {
                icon.className = "ri-check-line text-success";
                setTimeout(() => { icon.className = "ri-file-copy-line"; }, 1600);
              }
            });
          }
        });
      });
    }

    // Unified Search Trigger
    function triggerSearch() {
      const kw = input ? input.value.trim() : "";
      if (kw) {
        fetchAiDomains(kw);
      } else if (input) {
        input.focus();
      }
    }

    // Form submit listener
    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        triggerSearch();
      });
    }

    // Button click listener
    if (btn) {
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        triggerSearch();
      });
    }

    // Input Enter keydown listener
    if (input) {
      input.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
          e.preventDefault();
          triggerSearch();
        }
      });
    }

    // Filter pill click events
    filterTabs.forEach(tab => {
      tab.addEventListener("click", function () {
        filterTabs.forEach(t => t.classList.remove("active"));
        this.classList.add("active");
        currentFilter = this.getAttribute("data-filter") || "all";
        renderResults();
      });
    });

    // Prompt chips clicks
    document.querySelectorAll(".prompt-chip-btn").forEach(chip => {
      chip.addEventListener("click", function () {
        const word = this.getAttribute("data-word");
        if (word) {
          if (input) input.value = word;
          fetchAiDomains(word);
        }
      });
    });

    // Check if user arrived with URL search query e.g. ?q=mybrand or ?domain=mybrand
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const urlQuery = urlParams.get("q") || urlParams.get("domain") || urlParams.get("search");
      if (urlQuery && urlQuery.trim()) {
        const q = urlQuery.trim();
        if (input) input.value = q;
        fetchAiDomains(q);
      }
    } catch (e) {
      // safe fallback
    }

    initDomainHeroScene();
  })();
</script>
</Layout>
