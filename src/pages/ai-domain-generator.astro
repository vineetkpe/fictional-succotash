<!-- =========================================================
     BLOCK 4: How the AI Domain Generator Works
     ========================================================= -->
<div class="ace-section-gap bg-color-light position-relative">
    <div class="container aceorbit-animated-shape">
        <div class="row g-5">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">HOW IT WORKS</span>
                    <h3 class="title">How AI Discovers Your Brand Name</h3>
                </div>
            </div>
        </div>

        <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">
            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-brain-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">1. Semantic Synthesis</h6>
                            <p class="description">Hostamble Mini AI analyzes your core keywords, decomposing them into linguistic synonyms, brand anchors, and modern tech affixes.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
