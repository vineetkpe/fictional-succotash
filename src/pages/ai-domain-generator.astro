<!-- =========================================================
     SMART AI DOMAIN NAME GENERATION ENGINE (Client-Side)
     ========================================================= -->
<script is:inline>
  (function () {
    // Top TLD Pricing reference
    const tldRates = {
      ".com": { inr: "₹999 /yr", usd: "$11.99 /yr" },
      ".in": { inr: "₹499 /yr", usd: "$5.95 /yr" },
      ".co.in": { inr: "₹399 /yr", usd: "$4.75 /yr" },
      ".ai": { inr: "₹6499 /yr", usd: "$77.99 /yr" },
      ".store": { inr: "₹299 /yr", usd: "$3.59 /yr" },
      ".org": { inr: "₹1199 /yr", usd: "$14.30 /yr" },
      ".tech": { inr: "₹399 /yr", usd: "$4.79 /yr" },
      ".io": { inr: "₹3499 /yr", usd: "$41.99 /yr" }
    };

    // Semantic dictionaries
    const generalTechAffixes = ["flow", "stack", "pulse", "craft", "base", "hub", "nexus", "core", "grid", "wave", "sync", "scale", "mind", "loop", "byte", "pilot"];
    const actionPrefixes = ["get", "go", "try", "use", "my", "the", "run", "hey"];
    const powerAdjectives = ["nova", "swift", "prime", "apex", "vital", "bold", "pure", "omni", "smart", "hyper"];
    const modernSuffixes = ["ly", "ify", "io", "ix", "ex", "hq", "lab", "box", "zone"];

    const nicheKeywords = {
      tech: ["code", "cloud", "data", "bot", "auto", "metric", "ops", "algo", "cyber", "ai"],
      ecommerce: ["cart", "shop", "mart", "bazaar", "drop", "box", "deal", "store", "buy"],
      finance: ["pay", "vault", "ledger", "coin", "mint", "fund", "fin", "capital", "wallet"],
      agency: ["studio", "pixel", "brand", "spark", "media", "canvas", "press", "digital"],
      health: ["fit", "vital", "well", "glow", "cure", "zen", "care", "nourish", "pulse"]
    };

    // DOM Elements
    const form = document.getElementById("aiDomainForm");
    const input = document.getElementById("aiKeywordsInput");
    const nicheSelect = document.getElementById("nicheSelect");
    const styleSelect = document.getElementById("styleSelect");
    const extensionSelect = document.getElementById("extensionSelect");
    const grid = document.getElementById("domainsOutputGrid");
    const countBadge = document.getElementById("resultsCountBadge");
    const filterTabs = document.querySelectorAll(".result-tab");
    const clearBtn = document.getElementById("clearKeywordBtn");

    let currentGeneratedList = [];
    let currentFilter = "all";

    // Clean user input
    function sanitizeKeyword(raw) {
      return (raw || "")
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "")
        .slice(0, 20);
    }

    // Generator Engine
    function generateSmartDomainList() {
      const rawInput = input.value.trim();
      const root = sanitizeKeyword(rawInput) || "novaflow";
      const niche = nicheSelect ? nicheSelect.value : "all";
      const style = styleSelect ? styleSelect.value : "brandable";
      const extPref = extensionSelect ? extensionSelect.value : "all";

      const suggestions = new Set();
      const results = [];

      function addDomain(name, tld, tag) {
        const full = `${name}${tld}`;
        if (!suggestions.has(full)) {
          suggestions.add(full);
          const rate = tldRates[tld] || { inr: "₹499 /yr", usd: "$5.95 /yr" };
          const isShort = name.length <= 8;
          results.push({
            name: name,
            tld: tld,
            full: full,
            tag: tag,
            price: rate,
            isShort: isShort
          });
        }
      }

      // 1. Target TLD Pool
      let tldPool = [".com", ".in", ".ai", ".store", ".co.in", ".org", ".tech", ".io"];
      if (extPref === "com") tldPool = [".com"];
      else if (extPref === "in") tldPool = [".in", ".co.in"];
      else if (extPref === "tech") tldPool = [".ai", ".io", ".tech", ".com"];

      function getTld(index) {
        return tldPool[index % tldPool.length];
      }

      // 2. Synthesize names based on style & niche
      // Pattern A: Modern Suffixes (-ly, -ify, -io, -hq, -lab)
      modernSuffixes.forEach((suf, idx) => {
        addDomain(`${root}${suf}`, getTld(idx), "Brandable");
      });

      // Pattern B: Action Verbs (get-, try-, go-)
      actionPrefixes.forEach((pre, idx) => {
        addDomain(`${pre}${root}`, getTld(idx + 2), "Action SaaS");
      });

      // Pattern C: Tech / Power Compound Pairs
      generalTechAffixes.forEach((aff, idx) => {
        addDomain(`${root}${aff}`, getTld(idx + 1), "Tech Compound");
        addDomain(`${aff}${root}`, getTld(idx + 3), "Power Brand");
      });

      // Pattern D: Quality Adjectives
      powerAdjectives.forEach((adj, idx) => {
        addDomain(`${adj}${root}`, getTld(idx + 4), "Premium");
      });

      // Pattern E: Niche-specific
      const nicheWords = nicheKeywords[niche] || [];
      nicheWords.forEach((nw, idx) => {
        addDomain(`${root}${nw}`, getTld(idx), "Niche Focus");
      });

      // Pattern F: Shortened Root (if long)
      if (root.length > 5) {
        const truncated = root.slice(0, 4);
        addDomain(`${truncated}ly`, getTld(0), "Short Brand");
        addDomain(`${truncated}io`, getTld(2), "Short Tech");
        addDomain(`${truncated}ix`, getTld(1), "Short Modern");
      }

      // Limit to 24 diverse, highest-quality names
      currentGeneratedList = results.slice(0, 24);
      renderResults();
    }

    // Render Results Grid
    function renderResults() {
      if (!grid) return;

      const filtered = currentGeneratedList.filter(item => {
        if (currentFilter === "all") return true;
        if (currentFilter === "com") return item.tld === ".com";
        if (currentFilter === "in") return item.tld === ".in" || item.tld === ".co.in";
        if (currentFilter === "tech") return item.tld === ".ai" || item.tld === ".io" || item.tld === ".tech";
        if (currentFilter === "short") return item.isShort;
        return true;
      });

      if (countBadge) {
        countBadge.textContent = `${filtered.length} Suggestions`;
      }

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-12 text-center py-5">
            <p class="text-white-70 mb-0">No domains match the selected filter. Try switching back to 'All' or change extension preferences above.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const orderUrl = `https://hostamble.com/dash/domainchecker.php?search=${encodeURIComponent(item.full)}`;
        return `
          <div class="col-lg-4 col-md-6 col-12">
            <div class="ai-domain-card">
              <div class="d-flex flex-column" style="min-width: 0;">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="domain-name-text text-truncate">${item.name}<span class="domain-tld-highlight">${item.tld}</span></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="domain-tag-badge">${item.tag}</span>
                  <span class="domain-price-tag prices" data-inr="${item.price.inr}" data-usd="${item.price.usd}">${item.price.inr}</span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <button type="button" class="btn-copy-domain" data-domain="${item.full}" title="Copy domain name">
                  <i class="ri-file-copy-line"></i>
                </button>
                <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="btn-check-domain" title="Check live availability">
                  <span>Check</span> <i class="ri-arrow-right-s-line"></i>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join("");

      // Bind copy buttons
      grid.querySelectorAll(".btn-copy-domain").forEach(btn => {
        btn.addEventListener("click", function () {
          const dom = this.getAttribute("data-domain");
          if (dom) {
            navigator.clipboard.writeText(dom).then(() => {
              const icon = this.querySelector("i");
              if (icon) {
                icon.className = "ri-check-line text-success";
                setTimeout(() => {
                  icon.className = "ri-file-copy-line";
                }, 1800);
              }
            });
          }
        });
      });
    }

    // Filter Tab Clicks
    filterTabs.forEach(tab => {
      tab.addEventListener("click", function () {
        filterTabs.forEach(t => t.classList.remove("active"));
        this.classList.add("active");
        currentFilter = this.getAttribute("data-filter") || "all";
        renderResults();
      });
    });

    // Form Submit / Input changes
    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        generateSmartDomainList();
      });
    }

    if (input) {
      input.addEventListener("input", function () {
        if (clearBtn) {
          if (this.value.length > 0) clearBtn.classList.remove("d-none");
          else clearBtn.classList.add("d-none");
        }
      });
    }

    if (clearBtn && input) {
      clearBtn.addEventListener("click", function () {
        input.value = "";
        clearBtn.classList.add("d-none");
        input.focus();
      });
    }

    if (nicheSelect) nicheSelect.addEventListener("change", generateSmartDomainList);
    if (styleSelect) styleSelect.addEventListener("change", generateSmartDomainList);
    if (extensionSelect) extensionSelect.addEventListener("change", generateSmartDomainList);

    // Initial run
    generateSmartDomainList();

    // ==========================================
    // Accordion Logic for Block 6
    // ==========================================
    const faqStack = document.getElementById("aiFaqAccordion");
    if (faqStack) {
      const cards = faqStack.querySelectorAll(".faq-card-item");
      cards.forEach(card => {
        const trigger = card.querySelector(".faq-card-trigger");
        const collapse = card.querySelector(".faq-card-collapse");
        if (!trigger || !collapse) return;

        trigger.addEventListener("click", function () {
          const isOpen = card.classList.contains("is-open");

          cards.forEach(c => {
            c.classList.remove("is-open");
            const btn = c.querySelector(".faq-card-trigger");
            const col = c.querySelector(".faq-card-collapse");
            if (btn) btn.setAttribute("aria-expanded", "false");
            if (col) {
              col.style.maxHeight = "0px";
              col.style.opacity = "0";
            }
          });

          if (!isOpen) {
            card.classList.add("is-open");
            trigger.setAttribute("aria-expanded", "true");
            collapse.style.maxHeight = collapse.scrollHeight + 30 + "px";
            collapse.style.opacity = "1";
          }
        });
      });
    }
  })();
</script>
