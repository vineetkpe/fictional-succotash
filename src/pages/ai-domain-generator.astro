</div>

<!-- =========================================================
     BLOCK 4: How the AI Domain Generator Works
     ========================================================= -->
<div class="ace-section-gap bg-color-light position-relative">
    <div class="container aceorbit-animated-shape">
        <div class="row g-5">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">HOW IT WORKS</span>
                    <h3 class="title">How AI Discovers Your Brand Name</h3>
                </div>
            </div>
        </div>

        <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">
            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-brain-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">1. Semantic Synthesis</h6>
                            <p class="description">Hostamble Mini AI analyzes your core keywords, decomposing them into linguistic synonyms, brand anchors, and modern tech affixes.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-2 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-sound-module-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">2. Phonetic Flow &amp; Rhythm</h6>
                            <p class="description">Each name is generated without awkward hyphens or confusing numbers, ensuring it is easy to spell, pronounce, and remember.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-shield-check-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">3. Instant WHOIS &amp; Lock-in</h6>
                            <p class="description">1-click direct check connects to Hostamble's real-time WHOIS registry with free lifetime privacy and automated Anycast DNS.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 5: Help & WhatsApp Concierge (Theme Component)
     ========================================================= -->
<HelpCtaBlock 
    title="Need help choosing or registering your domain?" 
    description="Have questions about domain registration, Anycast DNS setup, free site migration, or finding the right name? Our in-house technical team in India is ready to assist you on WhatsApp and Live Chat."
/>

<!-- =========================================================
     BLOCK 6: Free Essential Tools (Theme Block)
     ========================================================= -->
<div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
    <div class="container aceorbit-animated-shape">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">Free Services</span>
                    <h3 class="title">Everything Included With Your Domain</h3>
                </div>
            </div>
        </div>
        <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">
            <div class="col-lg-3 col-md-6 col-12">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="ri-shield-user-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Free WHOIS Privacy</h6>
                            <p class="description">Keep your personal contact details masked from public ICANN databases with zero renewal surcharges.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12">
                <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="ri-flashlight-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Anycast DNS Control</h6>
                            <p class="description">Free automated DNS management to connect your domain easily to Shopify, WordPress, or external VPS.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="ri-lock-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Domain Theft Lock</h6>
                            <p class="description">Protect your Domain from being transferred out accidentally or without your permission with 1-click lock.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12">
                <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="ri-mail-send-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Free Email Forwarding</h6>
                            <p class="description">Create email forwarders like hello@yourdomain.com and route automatically to your existing inbox.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 7: FAQ Block (Theme Accordion + Schema.org)
     ========================================================= -->
<div class="ace-section-gap bg-color-white position-relative border-top-1" id="ai-domain-faqs">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 col-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">COMMON QUESTIONS</span>
                    <h3 class="title">AI Domain Generator FAQs</h3>
                    <p class="description max-w-750 mx-auto mt-2 text-muted">
                        Clear, honest answers about our AI domain generator, availability, and registration.
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-9 col-12">
                <div class="ai-faq-accordion-stack" id="aiFaqStack">
                    {aiDomainFaqs.map((faq, idx) => (
                        <div class={`ai-faq-card ${idx === 0 ? 'is-open' : ''}`}>
                            <button 
                                type="button" 
                                class="ai-faq-trigger" 
                                aria-expanded={idx === 0 ? 'true' : 'false'}
                            >
                                <span class="ai-faq-num">0{idx + 1}</span>
                                <span class="ai-faq-q">{faq.question}</span>
