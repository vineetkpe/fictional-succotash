                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-bank-card-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">Fintech &amp; Payments</h6>
                            <p class="description">Authoritative, trust-centered names for digital finance.</p>
                            <div class="theme-domain-list">
                                <a href="https://hostamble.com/dash/domainchecker.php?search=payforge.in" target="_blank" rel="noopener noreferrer" class="theme-domain-item">
                                    <span class="td-name">payforge<strong class="td-tld">.in</strong></span>
                                    <span class="td-arrow"><i class="icon-arrow-right-line-right"></i></span>
                                </a>
                                <a href="https://hostamble.com/dash/domainchecker.php?search=vaultstack.com" target="_blank" rel="noopener noreferrer" class="theme-domain-item">
                                    <span class="td-name">vaultstack<strong class="td-tld">.com</strong></span>
                                    <span class="td-arrow"><i class="icon-arrow-right-line-right"></i></span>
                                </a>
                                <a href="https://hostamble.com/dash/domainchecker.php?search=ledgerly.co.in" target="_blank" rel="noopener noreferrer" class="theme-domain-item">
                                    <span class="td-name">ledgerly<strong class="td-tld">.co.in</strong></span>
                                    <span class="td-arrow"><i class="icon-arrow-right-line-right"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3: D2C & E-Commerce -->
            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-shopping-bag-3-line"></i></span>
                        </div>
                        <div class="content">
