                                    <span class="td-arrow"><i class="icon-arrow-right-line-right"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 4: Micro-SaaS & Tools -->
            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-rocket-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">Micro-SaaS &amp; Tools</h6>
                            <p class="description">Action-oriented names built for high software conversion.</p>
                            <div class="theme-domain-list">
                                <a href="https://hostamble.com/dash/domainchecker.php?search=taskpilot.com" target="_blank" rel="noopener noreferrer" class="theme-domain-item">
                                    <span class="td-name">taskpilot<strong class="td-tld">.com</strong></span>
                                    <span class="td-arrow"><i class="icon-arrow-right-line-right"></i></span>
                                </a>
                                <a href="https://hostamble.com/dash/domainchecker.php?search=metricpulse.io" target="_blank" rel="noopener noreferrer" class="theme-domain-item">
                                    <span class="td-name">metricpulse<strong class="td-tld">.io</strong></span>
