      if (resultsTitle) resultsTitle.textContent = `Available Domain Ideas for "${cleanKw}"`;

      renderResults();
    }

    function renderResults() {
      if (!grid) return;

      const filtered = currentList.filter(item => {
        if (currentFilter === "all") return true;
        if (currentFilter === "com") return item.tld === ".com";
        if (currentFilter === "in") return item.tld === ".in" || item.tld === ".co.in";
        if (currentFilter === "ai") return item.tld === ".ai" || item.tld === ".io" || item.tld === ".tech";
        if (currentFilter === "store") return item.tld === ".store";
        if (currentFilter === "short") return item.name.length <= 8;
        return true;
      });

      if (countTag) {
        countTag.textContent = `${filtered.length} AI SUGGESTIONS AVAILABLE`;
      }

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-12 text-center py-5">
            <h5 class="text-muted">No domains match the selected filter.</h5>
            <p class="text-muted small">Switch back to 'All' or type new keywords above.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const orderUrl = `https://hostamble.com/dash/domainchecker.php?search=${encodeURIComponent(item.full)}`;
        return `
          <div class="col-lg-4 col-md-6 col-12">
            <div class="ai-domain-card">
              <!-- Top Row: Name + Copy Button -->
              <div class="ai-domain-top">
                <span class="ai-domain-name">${item.name}<span class="ai-domain-tld">${item.tld}</span></span>
                <button type="button" class="ai-copy-btn" data-domain="${item.full}" title="Copy domain name">
                  <i class="ri-file-copy-line"></i>
                </button>
              </div>

              <!-- Meta: Badge + Status Dot -->
              <div class="ai-domain-meta">
                <span class="ai-tag-pill">${item.tag}</span>
                <span class="ai-status-pill"><span class="ai-status-dot"></span> Available to Register</span>
              </div>

              <!-- Bottom Row: Price + Check Action -->
              <div class="ai-domain-bottom">
                <div>
                  <span class="ai-price-text prices" data-inr="${item.price.inr}" data-usd="${item.price.usd}">${item.price.inr}</span>
                  <span class="ai-price-sub">1st Year Reg</span>
                </div>
                <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="ai-check-btn" title="Check live WHOIS availability">
                  <span>Check</span> <i class="ri-arrow-right-line"></i>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join("");

      // Bind copy buttons
      grid.querySelectorAll(".ai-copy-btn").forEach(btn => {
        btn.addEventListener("click", function () {
          const dom = this.getAttribute("data-domain");
          if (dom) {
            navigator.clipboard.writeText(dom).then(() => {
              const icon = this.querySelector("i");
              if (icon) {
                icon.className = "ri-check-line text-success";
                setTimeout(() => { icon.className = "ri-file-copy-line"; }, 1600);
              }
            });
          }
        });
      });
    }

    // Filter pill click events
    filterTabs.forEach(tab => {
      tab.addEventListener("click", function () {
        filterTabs.forEach(t => t.classList.remove("active"));
        this.classList.add("active");
        currentFilter = this.getAttribute("data-filter") || "all";
        renderResults();
      });
    });

    // Form submit
    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const kw = input ? input.value.trim() : "novaflow";
        fetchAiDomains(kw);
      });
    }

    // Prompt chips clicks
    document.querySelectorAll(".prompt-chip-btn").forEach(chip => {
      chip.addEventListener("click", function () {
        const word = this.getAttribute("data-word");
        if (input && word) {
          input.value = word;
          fetchAiDomains(word);
        }
      });
    });

    // Initial load
    fetchAiDomains("novaflow");

    // ==========================================
    // Accordion Logic for FAQ Block
    // ==========================================
    const faqStack = document.getElementById("aiFaqStack");
    if (faqStack) {
      const cards = faqStack.querySelectorAll(".ai-faq-card");
      cards.forEach(card => {
        const trigger = card.querySelector(".ai-faq-trigger");
        const collapse = card.querySelector(".ai-faq-collapse");
        if (!trigger || !collapse) return;

        trigger.addEventListener("click", function () {
          const isOpen = card.classList.contains("is-open");

          cards.forEach(c => {
            c.classList.remove("is-open");
            const btn = c.querySelector(".ai-faq-trigger");
            const col = c.querySelector(".ai-faq-collapse");
            if (btn) btn.setAttribute("aria-expanded", "false");
            if (col) {
              col.style.maxHeight = "0px";
              col.style.opacity = "0";
            }
          });

          if (!isOpen) {
            card.classList.add("is-open");
            trigger.setAttribute("aria-expanded", "true");
            collapse.style.maxHeight = collapse.scrollHeight + 30 + "px";
            collapse.style.opacity = "1";
          }
        });
      });
    }

    initDomainHeroScene();
  })();
</script>
</Layout>
