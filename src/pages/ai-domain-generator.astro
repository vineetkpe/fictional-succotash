                                </a>
                                <a href="https://hostamble.com/dash/domainchecker.php?search=getcloudly.com" target="_blank" rel="noopener noreferrer" class="theme-domain-item">
                                    <span class="td-name">getcloudly<strong class="td-tld">.com</strong></span>
                                    <span class="td-arrow"><i class="icon-arrow-right-line-right"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Decorative Theme Background Shapes -->
        <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
            <div class="shape-image shape-image-1">
                <img src="/assets/images/shape32.png" alt="Shape Thumb">
            </div>
            <div class="shape-image shape-image-2">
                <img src="/assets/images/shape0308.png" alt="Shape Thumb">
            </div>
            <div class="shape-image shape-image-3">
