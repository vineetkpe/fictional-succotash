---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';

// ===== FAQ Structured Data for Google SEO Rich Snippets =====
const aiDomainFaqs = [
  {
    question: "How does the AI Domain Name Generator work?",
    answer: "Hostamble's AI Domain Name Generator uses advanced Google Gemini AI to analyze your keywords, brand concept, and industry niche. It generates catchy, pronounceable, high-converting domain name variations paired with top commercial domain extensions (.com, .in, .ai, .store) ready for instant registration."
  },
  {
    question: "Is this AI Domain Name Generator free to use?",
    answer: "Yes, 100% free with unlimited searches. You can generate as many domain names as you want with zero sign-ups or hidden charges. When you find a domain you like, you can register it directly through Hostamble at wholesale rates."
  },
  {
    question: "How do I check if an AI-suggested domain name is available?",
    answer: "Every suggested domain card has a direct 'Check' button. Clicking it instantly queries the global WHOIS database through Hostamble's secure domain checker, telling you immediately if the domain is available to register."
  },
  {
    question: "Should I register a .com or a .in domain for my business?",
    answer: "If your target audience is in India, registering a .in or .co.in domain provides a significant local SEO advantage on Google India (google.co.in). If you are building a global brand or international SaaS product, .com or .ai is ideal. We recommend securing both to protect your brand from competitors."
  },
  {
    question: "Do I get free WHOIS domain privacy protection with my registration?",
    answer: "Yes. Hostamble provides free lifetime WHOIS Privacy Protection on all supported domain extensions. Your personal name, residential address, phone number, and email are completely hidden from public databases."
  },
  {
    question: "Can I connect my domain to Shopify, WordPress, or external hosting?",
    answer: "Yes. Every domain registered at Hostamble includes full Anycast DNS management. You can easily create and update A, CNAME, MX, TXT, and SPF records to point your domain to Shopify, WordPress, Wix, or any VPS anytime."
  }
];

const aiDomainFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": aiDomainFaqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout 
  title="AI Domain Name Generator | Smart Brand Ideas & Instant Availability"
  description="Generate smart, brandable, high-converting domain names in seconds with Hostamble's AI Domain Generator. Powered by Google AI with instant WHOIS availability."
  keywords="ai domain generator, domain name generator, smart domain suggestions, business name generator, buy domain name india, check domain availability"
>

<!-- =========================================================
     BLOCK 1: Hero Block (Copied from domain-search.astro theme)
     ========================================================= -->
<div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800 position-relative overflow-hidden" id="plans">
    <!-- Interactive Ambient 3D Letters Canvas -->
    <canvas id="domainLettersCanvas" class="domain-hero-canvas" aria-hidden="true"></canvas>

    <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
        <div class="row">
            <div class="col-lg-12">
                <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <div class="content" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                            AI Domain Name Generator
                        </h1>
                        <p class="description max-w-750 mx-auto" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                            Type your business idea or keywords below. Our AI analyzes your brand intent to generate catchy, high-converting domain names with instant availability.
                        </p>
                    </div>

                    <!-- Native Theme Search Form Adaption -->
                    <div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
                        <form id="aiDomainForm" class="input-box text-start" onsubmit="return false;">
                            <input id="aiDomainInput" class="large-input-box" type="search" placeholder="Type keywords for AI domain ideas (e.g. cloud, pay, flow, craft)..." value="novaflow" name="domain" autocomplete="off" required>
                            <div class="mail-icon">
                                <i class="ri-magic-line"></i>
                            </div>
                            <button type="submit" id="aiGenerateBtn" class="ace-btn">
                                <span id="btnText">Generate Ideas</span><i class="icon-arrow-right-line-right"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Native Theme TLD Pills Row -->
                    <ul class="select-tlds">
                       {domainPricing.searchTlds.map((tld) => (
                           <li>
                               <span class="name">{tld.name}</span>
                               <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                               <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                           </li>
                       ))}
                       <li class="bg-none border-0 p-0 box-shadow-none">
                           <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                       </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
            <div class="shape-image shape-image-1"><img src="/assets/images/www.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-2"><img src="/assets/images/www2.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-3"><img src="/assets/images/www3.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-4"><img src="/assets/images/www4.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-5"><img src="/assets/images/www5.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-6"><img src="/assets/images/www6.png" alt="Shape Thumb"></div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 2: AI Generated Domain Results (Using Theme Cards)
     ========================================================= -->
<div class="ace-services-area bg-image ace-section-gap" id="resultsArea" style="background: #fafafa; border-bottom: 1px solid #f1f5f9;">
    <div class="container aceorbit-animated-shape">
        <div class="row g-5">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title" id="resultsCountTag">AI SUGGESTIONS</span>
                    <h3 class="title" id="resultsTitle">Smart AI Domain Suggestions</h3>
                    <p class="description max-w-750 mx-auto mt-2 text-muted">
                        Click 'Check' on any domain below to verify live WHOIS availability and lock it in before anyone else does.
                    </p>
                </div>
            </div>
        </div>

        <!-- Filter Pills Using Native Theme Button Styling -->
        <div class="row justify-content-center mt-3 mb-4">
            <div class="col-lg-8 col-12 text-center">
                <div class="d-flex flex-wrap justify-content-center gap-2" id="aiFilterTabs">
                    <button type="button" class="tld-filter-pill active" data-filter="all">All (18)</button>
                    <button type="button" class="tld-filter-pill" data-filter="com">.com</button>
                    <button type="button" class="tld-filter-pill" data-filter="in">.in</button>
                    <button type="button" class="tld-filter-pill" data-filter="ai">.ai</button>
                    <button type="button" class="tld-filter-pill" data-filter="store">.store</button>
                    <button type="button" class="tld-filter-pill" data-filter="short">Short (&lt;8)</button>
                </div>
            </div>
        </div>

        <!-- Dynamic Results Grid Using Native service-card-3 Structure -->
        <div class="row aceorbit-about-one-service g-4 mt--10 justify-content-center" id="aiResultsGrid">
            <!-- Dynamically populated via client script -->
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 3: Features Block (Copied from domain-search.astro)
     ========================================================= -->
<div class="ace-services-area bg-image ace-section-gap position-relative overflow-hidden">
    <div class="container aceorbit-animated-shape">
        <div class="row g-5">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">Features</span>
                    <h3 class="title">How AI Helps You Find the Perfect Domain</h3>
                </div>
            </div>
        </div>

        <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">
            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-brain-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">AI Brand Synthesis</h6>
                            <p class="description">Our AI pairs your core ideas with high-converting prefixes, tech affixes, and rhythm patterns that roll off the tongue.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-2 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-shield-check-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">Brand Protection &amp; WHOIS</h6>
                            <p class="description">Protect your business name by locking in brandable domains with free lifetime WHOIS privacy and theft protection.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 h-100">
                    <div class="inner">
                        <div class="icon">
                            <span><i class="ri-global-line"></i></span>
                        </div>
                        <div class="content">
                            <h6 class="title">Instant Global Registration</h6>
                            <p class="description">Check real-time WHOIS availability instantly and register your chosen domain with 0 hidden fees and Anycast DNS.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
            <div class="shape-image shape-image-1"><img src="/assets/images/shape32.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-2"><img src="/assets/images/shape0308.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-3"><img src="/assets/images/shape2701.png" alt="Shape Thumb"></div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 4: Help CTA Block (Theme Component)
     ========================================================= -->
<HelpCtaBlock 
    title="Need help choosing or registering your domain?" 
    description="Have questions about domain registration, Anycast DNS setup, free site migration, or finding the right name? Our in-house technical team in India is ready to assist you on WhatsApp and Live Chat."
/>

<!-- =========================================================
     BLOCK 5: Free Services (Copied from domain-search.astro)
     ========================================================= -->
<div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
    <div class="container aceorbit-animated-shape">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">Free Services</span>
                    <h3 class="title">What you can do with your Domain Name!</h3>
                </div>
            </div>
        </div>
        <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">
            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-mail-line-2"></i></span></div>
                        <div class="content">
                            <h6 class="title">Email Account</h6>
                            <p class="description">You can connect your business email with your domain to reach next level of professionalism</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-Browser"></i></span></div>
                        <div class="content">
                            <h6 class="title">Domain Forwarding</h6>
                            <p class="description">Point your domain name to another website for free! Redirect users when they type your domain name into a browser (with/without domain masking &amp; SEO)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-book-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Nameserver Management</h6>
                            <p class="description">You will get free domain nameserver management, With the help of this feature you can connect your domain to any hosting.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-lock-password-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Domain Theft Protection</h6>
                            <p class="description">Protect your Domain from being transferred out accidentally or without your permission with our free Domain Theft Protection.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-mail-open-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Mail Forwards</h6>
                            <p class="description">Create email forwards and automatically redirect your email to existing email accounts.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-Lock"></i></span></div>
                        <div class="content">
                            <h6 class="title">Easy to use Control Panel</h6>
                            <p class="description">Use our intuitive Control Panel to manage your domain name, configure email accounts, renew your domain name and buy more services.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                    <div class="inner">
                        <div class="icon"><span><i class="icon-account-circle-line"></i></span></div>
                        <div class="content">
                            <h6 class="title">Bulk Tools</h6>
                            <p class="description">Easy-to-use bulk tools to help you Register, Renew, Transfer and make other changes to several Domain Names in a single step.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
            <div class="shape-image shape-image-1"><img src="/assets/images/shape29.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-2"><img src="/assets/images/shape0306.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-3"><img src="/assets/images/shape0206.png" alt="Shape Thumb"></div>
            <div class="shape-image shape-image-4"><img src="/assets/images/shape19.png" alt="Shape Thumb"></div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 6: Pre-Register CTA Banner (Copied from theme)
     ========================================================= -->
<div class="ace-domain-area domain-overlay-to-another">
    <div class="container domain-style-5 bg-color-primary">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="inner">
                    <div class="section-title text-start text-white" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <span class="pre-title">Ready to launch your brand online?</span>
                        <h3 class="title">Register your domain with Hostamble today</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="cta-btn text-start text-lg-end">
                    <a class="ace-btn btn-white" href="/domain-search">Search More Domains<i class="icon-arrow-right-line-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     BLOCK 7: FAQ Block (Theme Accordion)
     ========================================================= -->
<div class="ace-section-gap bg-color-white position-relative border-top-1" id="ai-domain-faqs">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 col-12">
                <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                    <span class="pre-title">COMMON QUESTIONS</span>
                    <h3 class="title">AI Domain Generator FAQs</h3>
                    <p class="description max-w-750 mx-auto mt-2 text-muted">
                        Clear, honest answers about our AI domain generator, availability, and registration.
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-9 col-12">
                <div class="ai-faq-accordion-stack" id="aiFaqStack">
                    {aiDomainFaqs.map((faq, idx) => (
                        <div class={`ai-faq-card ${idx === 0 ? 'is-open' : ''}`}>
                            <button 
                                type="button" 
                                class="ai-faq-trigger" 
                                aria-expanded={idx === 0 ? 'true' : 'false'}
                            >
                                <span class="ai-faq-num">0{idx + 1}</span>
                                <span class="ai-faq-q">{faq.question}</span>
                                <span class="ai-faq-chevron"><i class="ri-arrow-down-s-line"></i></span>
                            </button>
                            <div 
                                class="ai-faq-collapse"
                                style={idx === 0 ? "max-height: 400px; opacity: 1;" : "max-height: 0px; opacity: 0;"}
                            >
                                <div class="ai-faq-body">
                                    <p>{faq.answer}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Schema.org FAQPage Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(aiDomainFaqSchema)} />

<style>
  /* =========================================================
     Exact Theme Design Styles
     ========================================================= */
  .domain-hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .aceorbit-domain-search {
    position: relative;
    overflow: hidden;
  }

  .aceorbit-domain-search .shape-image {
    opacity: 0.35;
  }

  .max-w-750 {
    max-width: 750px;
  }

  /* Filter Pills */
  .tld-filter-pill {
    padding: 7px 18px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    font-size: 13px;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tld-filter-pill:hover {
    border-color: #ff501a;
    color: #ff501a;
  }

  .tld-filter-pill.active {
    background: #ff501a;
    border-color: #ff501a;
    color: #ffffff;
  }

  /* Generated Domain Result Cards (Using theme's service-card-3) */
  .ai-result-card {
    background: #ffffff;
    border: 1px solid #eef2f6;
    border-radius: 6px;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    position: relative;
    z-index: 2;
  }

  .ai-result-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
    border-color: rgba(255, 80, 26, 0.35);
  }

  .domain-item-title {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }

  .domain-item-tld {
    color: #ff501a;
  }

  .domain-item-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: #fff4f0;
    color: #ff501a;
    display: inline-block;
  }

  .domain-item-price {
    font-size: 13.5px;
    font-weight: 700;
    color: #ff501a;
  }

  .btn-check-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    border-radius: 6px;
    background: #ff501a;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .btn-check-pill:hover {
    background: #e04414;
    transform: translateY(-1px);
    color: #ffffff !important;
  }

  .btn-copy-pill {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #64748b;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .btn-copy-pill:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* FAQ Accordion */
  .ai-faq-accordion-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-faq-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-faq-card.is-open {
    border-color: #ff501a;
    box-shadow: 0 4px 16px rgba(255, 80, 26, 0.06);
  }

  .ai-faq-trigger {
    width: 100%;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ai-faq-trigger:hover {
    background: #fafafa;
  }

  .ai-faq-num {
    font-size: 13px;
    font-weight: 800;
    color: #ff501a;
    background: #fff4f0;
    padding: 4px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .ai-faq-q {
    flex-grow: 1;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
  }

  .ai-faq-chevron {
    font-size: 20px;
    color: #64748b;
    transition: transform 0.3s ease, color 0.3s ease;
    flex-shrink: 0;
  }

  .ai-faq-card.is-open .ai-faq-chevron {
    transform: rotate(180deg);
    color: #ff501a;
  }

  .ai-faq-collapse {
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }

  .ai-faq-body {
    padding: 0 22px 20px 58px;
    font-size: 14.5px;
    line-height: 1.6;
    color: #475569;
  }

  @media (max-width: 575px) {
    .ai-faq-body {
      padding: 0 16px 16px 16px;
    }
  }

  .ai-faq-body p {
    margin-bottom: 0;
  }
</style>

<script is:inline>
  (function () {
    /* ════════════════════════════════════════════════════════════════
       3D Floating TLD Canvas Background (Copied from domain-search)
       ════════════════════════════════════════════════════════════════ */
    function initDomainHeroScene() {
      const canvas = document.getElementById("domainLettersCanvas");
      const hero = document.getElementById("plans");
      if (!canvas || !hero) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = (canvas.width = hero.offsetWidth);
      let height = (canvas.height = hero.offsetHeight);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      function resize() {
        width = hero.offsetWidth;
        height = hero.offsetHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.scale(dpr, dpr);
      }
      resize();
      window.addEventListener("resize", resize, { passive: true });

      const mouse = { x: -9999, y: -9999, active: false, tiltX: 0, tiltY: 0, targetTiltX: 0, targetTiltY: 0 };
      function updateMouse(e) {
        const rect = hero.getBoundingClientRect();
        const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches && e.touches.length > 0 ? e.touches[0].clientY : e.clientY;
        mouse.x = clientX - rect.left;
        mouse.y = clientY - rect.top;
        mouse.active = true;
        mouse.targetTiltX = (mouse.x / width - 0.5) * 12;
        mouse.targetTiltY = (mouse.y / height - 0.5) * 8;
      }

      hero.addEventListener("mousemove", updateMouse, { passive: true });
      hero.addEventListener("mouseleave", function () {
        mouse.active = false;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      const tldSpecs = [
        { text: ".com", color: "#ff501a", size: 16, isBold: true },
        { text: ".in", color: "#ff501a", size: 15, isBold: true },
        { text: ".ai", color: "#ff6e3a", size: 15, isBold: true },
        { text: ".org", color: "#16a34a", size: 14, isBold: false },
        { text: ".store", color: "#16a34a", size: 13, isBold: false },
        { text: ".xyz", color: "#0284c7", size: 13, isBold: false },
        { text: ".io", color: "#8b5cf6", size: 14, isBold: true },
        { text: ".tech", color: "#ff501a", size: 13, isBold: false },
      ];

      const isMobile = window.innerWidth < 768;
      const count = isMobile ? 6 : tldSpecs.length;
      const sprites = [];
      for (let i = 0; i < count; i++) {
        const spec = tldSpecs[i % tldSpecs.length];
        const isRight = i % 2 === 1;
        const bandMinX = isRight ? 0.74 * width : 0.04 * width;
        const bandMaxX = isRight ? 0.95 * width : 0.26 * width;
        const x = bandMinX + Math.random() * (bandMaxX - bandMinX);
        const y = 0.12 * height + Math.random() * (0.76 * height);
        const z = -2.5 + Math.random() * 5.0;
        const angle = Math.random() * Math.PI * 2;
        const speed = 0.05 + Math.random() * 0.06;

        sprites.push({
          text: spec.text,
          color: spec.color,
          baseSize: spec.size,
          isBold: spec.isBold,
          x: x, y: y, z: z,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseVx: Math.cos(angle) * speed,
          baseVy: Math.sin(angle) * speed,
          isRight: isRight,
          wobbleSpeed: 0.006 + Math.random() * 0.008,
          wobbleAmp: 0.06 + Math.random() * 0.08,
          wobbleOffset: Math.random() * 100,
        });
      }

      let tick = 0;
      let isRunning = true;
      function render() {
        if (!isRunning) return;
        tick++;
        ctx.clearRect(0, 0, width, height);
        mouse.tiltX += (mouse.targetTiltX - mouse.tiltX) * 0.04;
        mouse.tiltY += (mouse.targetTiltY - mouse.tiltY) * 0.04;

        for (let i = 0; i < sprites.length; i++) {
          const sp = sprites[i];
          if (mouse.active) {
            const dx = sp.x - mouse.x;
            const dy = sp.y - mouse.y;
            const dist = Math.hypot(dx, dy);
            if (dist < 90 && dist > 1) {
              const force = Math.pow(1 - dist / 90, 1.4) * 1.5;
              sp.vx += (dx / dist) * force;
              sp.vy += (dy / dist) * force;
            }
          }

          sp.vx += (sp.baseVx - sp.vx) * 0.025;
          sp.vy += (sp.baseVy - sp.vy) * 0.025;
          sp.x += sp.vx;
          sp.y += sp.vy + Math.sin(tick * sp.wobbleSpeed + sp.wobbleOffset) * sp.wobbleAmp;

          const bandMinX = sp.isRight ? 0.70 * width : 0.02 * width;
          const bandMaxX = sp.isRight ? 0.98 * width : 0.30 * width;
          if (sp.x < bandMinX) { sp.x = bandMinX; sp.vx = Math.abs(sp.vx) * 0.75; }
          else if (sp.x > bandMaxX) { sp.x = bandMaxX; sp.vx = -Math.abs(sp.vx) * 0.75; }

          if (sp.y < 0.08 * height) { sp.y = 0.08 * height; sp.vy = Math.abs(sp.vy) * 0.75; }
          else if (sp.y > 0.88 * height) { sp.y = 0.88 * height; sp.vy = -Math.abs(sp.vy) * 0.75; }

          const depthFactor = 0.9 + (sp.z + 2.5) * 0.08;
          const opacity = Math.min(0.42, Math.max(0.18, 0.20 + (sp.z + 2.5) * 0.04));
          const fontSize = Math.round(sp.baseSize * depthFactor);
          const renderX = sp.x + mouse.tiltX * (0.4 + (sp.z + 2.5) * 0.1);
          const renderY = sp.y + mouse.tiltY * (0.4 + (sp.z + 2.5) * 0.1);

          ctx.save();
          ctx.font = `${sp.isBold ? "700" : "600"} ${fontSize}px "Space Mono", monospace`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.globalAlpha = opacity;
          ctx.shadowColor = sp.color;
          ctx.shadowBlur = 8;
          ctx.fillStyle = sp.color;
          ctx.fillText(sp.text, renderX, renderY);
          ctx.restore();
        }
        requestAnimationFrame(render);
      }
      requestAnimationFrame(render);

      document.addEventListener("visibilitychange", function () {
        isRunning = !document.hidden;
        if (isRunning) requestAnimationFrame(render);
      });
    }

    /* ════════════════════════════════════════════════════════════════
       AI Domain Generator Logic (Server Endpoint + Smart Fallback)
       ════════════════════════════════════════════════════════════════ */
    const tldRates = {
      ".com": { inr: "₹999", usd: "$11.99" },
      ".in": { inr: "₹499", usd: "$5.95" },
      ".co.in": { inr: "₹399", usd: "$4.75" },
      ".ai": { inr: "₹6499", usd: "$77.99" },
      ".store": { inr: "₹299", usd: "$3.59" },
      ".org": { inr: "₹1199", usd: "$14.30" },
      ".tech": { inr: "₹399", usd: "$4.79" },
      ".io": { inr: "₹3499", usd: "$41.99" }
    };

    const form = document.getElementById("aiDomainForm");
    const input = document.getElementById("aiDomainInput");
    const btn = document.getElementById("aiGenerateBtn");
    const btnText = document.getElementById("btnText");
    const grid = document.getElementById("aiResultsGrid");
    const countTag = document.getElementById("resultsCountTag");
    const filterTabs = document.querySelectorAll(".tld-filter-pill");

    let currentList = [];
    let currentFilter = "all";

    // Clean keyword
    function cleanWord(str) {
      return (str || "").toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 20);
    }

    // Algorithmic Fallback Synthesizer
    function generateAlgorithmicList(raw) {
      const root = cleanWord(raw) || "novaflow";
      const affixes = ["flow", "stack", "pulse", "craft", "base", "hub", "nexus", "sync", "scale", "byte", "loop", "grid"];
      const prefixes = ["get", "try", "go", "my", "the", "run", "hey"];
      const suffixes = ["ly", "ify", "io", "ix", "hq", "lab", "box", "zone"];
      const adjs = ["nova", "swift", "prime", "apex", "vital", "bold"];

      const pool = [".com", ".in", ".ai", ".store", ".co.in", ".tech", ".org", ".io"];
      const results = [];
      const seen = new Set();

      function pushItem(name, tld, tag) {
        const full = `${name}${tld}`;
        if (!seen.has(full)) {
          seen.add(full);
          results.push({ name, tld, full, tag, price: tldRates[tld] || { inr: "₹499", usd: "$5.95" } });
        }
      }

      suffixes.forEach((s, idx) => pushItem(`${root}${s}`, pool[idx % pool.length], "Brandable"));
      prefixes.forEach((p, idx) => pushItem(`${p}${root}`, pool[(idx + 2) % pool.length], "Action"));
      affixes.forEach((a, idx) => pushItem(`${root}${a}`, pool[(idx + 1) % pool.length], "Compound"));
      adjs.forEach((j, idx) => pushItem(`${j}${root}`, pool[(idx + 3) % pool.length], "Premium"));

      return results.slice(0, 18);
    }

    // Main fetch handler
    async function fetchAiDomains(keyword) {
      if (btnText) btnText.textContent = "Synthesizing...";
      if (btn) btn.disabled = true;

      try {
        // Call the secure server-side PHP endpoint (where Gemini API key is completely hidden on server)
        const response = await fetch("/api/generate-domains.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ keyword: keyword })
        });

        if (response.ok) {
          const data = await response.json();
          if (data && data.success && Array.isArray(data.domains) && data.domains.length > 0) {
            currentList = data.domains.map(d => {
              const full = `${d.name}${d.tld}`;
              return {
                name: d.name,
                tld: d.tld,
                full: full,
                tag: d.tag || "AI Suggested",
                price: tldRates[d.tld] || { inr: "₹499", usd: "$5.95" }
              };
            });
            renderResults();
            return;
          }
        }
      } catch (err) {
        console.warn("Server API not reachable, using smart algorithmic synthesizer:", err);
      } finally {
        if (btnText) btnText.textContent = "Generate Ideas";
        if (btn) btn.disabled = false;
      }

      // Seamless fallback if API fails or running locally in static preview
      currentList = generateAlgorithmicList(keyword);
      renderResults();
    }

    function renderResults() {
      if (!grid) return;

      const filtered = currentList.filter(item => {
        if (currentFilter === "all") return true;
        if (currentFilter === "com") return item.tld === ".com";
        if (currentFilter === "in") return item.tld === ".in" || item.tld === ".co.in";
        if (currentFilter === "ai") return item.tld === ".ai" || item.tld === ".io" || item.tld === ".tech";
        if (currentFilter === "store") return item.tld === ".store";
        if (currentFilter === "short") return item.name.length <= 8;
        return true;
      });

      if (countTag) {
        countTag.textContent = `${filtered.length} SUGGESTIONS AVAILABLE`;
      }

      grid.innerHTML = filtered.map(item => {
        const orderUrl = `https://hostamble.com/dash/domainchecker.php?search=${encodeURIComponent(item.full)}`;
        return `
          <div class="col-lg-4 col-md-6 col-12">
            <div class="ai-result-card">
              <div style="min-width: 0;">
                <div class="domain-item-title text-truncate">
                  ${item.name}<span class="domain-item-tld">${item.tld}</span>
                </div>
                <div class="d-flex align-items-center gap-2 mt-1">
                  <span class="domain-item-badge">${item.tag}</span>
                  <span class="domain-item-price prices" data-inr="${item.price.inr}" data-usd="${item.price.usd}">${item.price.inr}</span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <button type="button" class="btn-copy-pill" data-domain="${item.full}" title="Copy domain">
                  <i class="ri-file-copy-line"></i>
                </button>
                <a href="${orderUrl}" target="_blank" rel="noopener noreferrer" class="btn-check-pill" title="Check live availability">
                  <span>Check</span> <i class="ri-arrow-right-s-line"></i>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join("");

      // Copy buttons
      grid.querySelectorAll(".btn-copy-pill").forEach(btn => {
        btn.addEventListener("click", function () {
          const dom = this.getAttribute("data-domain");
          if (dom) {
            navigator.clipboard.writeText(dom).then(() => {
              const icon = this.querySelector("i");
              if (icon) {
                icon.className = "ri-check-line text-success";
                setTimeout(() => { icon.className = "ri-file-copy-line"; }, 1500);
              }
            });
          }
        });
      });
    }

    // Filter pill events
    filterTabs.forEach(tab => {
      tab.addEventListener("click", function () {
        filterTabs.forEach(t => t.classList.remove("active"));
        this.classList.add("active");
        currentFilter = this.getAttribute("data-filter") || "all";
        renderResults();
      });
    });

    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const kw = input ? input.value.trim() : "novaflow";
        fetchAiDomains(kw);
      });
    }

    // Initial load
    fetchAiDomains("novaflow");

    // ==========================================
    // Accordion Logic for FAQ Block
    // ==========================================
    const faqStack = document.getElementById("aiFaqStack");
    if (faqStack) {
      const cards = faqStack.querySelectorAll(".ai-faq-card");
      cards.forEach(card => {
        const trigger = card.querySelector(".ai-faq-trigger");
        const collapse = card.querySelector(".ai-faq-collapse");
        if (!trigger || !collapse) return;

        trigger.addEventListener("click", function () {
          const isOpen = card.classList.contains("is-open");

          cards.forEach(c => {
            c.classList.remove("is-open");
            const btn = c.querySelector(".ai-faq-trigger");
            const col = c.querySelector(".ai-faq-collapse");
            if (btn) btn.setAttribute("aria-expanded", "false");
            if (col) {
              col.style.maxHeight = "0px";
              col.style.opacity = "0";
            }
          });

          if (!isOpen) {
            card.classList.add("is-open");
            trigger.setAttribute("aria-expanded", "true");
            collapse.style.maxHeight = collapse.scrollHeight + 30 + "px";
            collapse.style.opacity = "1";
          }
        });
      });
    }

    initDomainHeroScene();
  })();
</script>
</Layout>
