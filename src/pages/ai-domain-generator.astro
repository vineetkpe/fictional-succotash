---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';

// ===== FAQ Structured Data for Google SEO Rich Snippets =====
const aiDomainFaqs = [
  {
    id: "faq-how-ai-generator-works",
    question: "How does Hostamble's AI Domain Name Generator suggest names?",
    answer: "Hostamble's AI domain generator takes your core seed keywords and applies linguistic rules, semantic synonyms, compound word combinations, and modern affixes (like -ly, -ify, -stack, -flow). It pairs these variations with top commercial domain extensions (.com, .in, .ai, .store) to create memorable, brandable names ready for instant registration."
  },
  {
    id: "faq-is-generator-free",
    question: "Is the AI Domain Name Generator free to use?",
    answer: "Yes, 100% free with unlimited searches. You can test as many keywords, niches, and naming styles as you want without creating an account or paying any fees. When you find a domain name you love, you can register it directly through Hostamble at wholesale rates."
  },
  {
    id: "faq-how-to-check-availability",
    question: "How do I check if an AI-generated domain name is available?",
    answer: "Every suggested domain card has a direct 'Check' button. Clicking it instantly queries the global WHOIS registry database via Hostamble's secure domain checker, telling you immediately if the domain is available to register or transfer."
  },
  {
    id: "faq-brandable-vs-exact-match",
    question: "Do brandable domain names rank well on Google?",
    answer: "Yes. Google's modern search algorithms favor memorable, brandable domain names over spammy, hyphenated exact-match domains. A brandable name (e.g. Canva, Spotify, Hostamble) builds trust, earns organic backlinks, drives higher click-through rates (CTR) in search results, and scales as your business grows."
  },
  {
    id: "faq-com-vs-in-domain",
    question: "Should I register a .com or a .in domain for my business?",
    answer: "If your target audience is primarily in India, registering a .in or .co.in domain gives you a strong local SEO advantage on Google India (google.co.in). If you are building a global SaaS, international eCommerce brand, or tech startup, .com or .ai is ideal. Whenever possible, we recommend registering both .com and .in to protect your brand identity from competitors."
  },
  {
    id: "faq-instant-registration-time",
    question: "How quickly does my domain become active after registration?",
    answer: "Domain registration is instantaneous upon completing checkout. Anycast DNS propagation begins immediately and typically resolves across worldwide ISP networks within 15 to 30 minutes, allowing you to connect web hosting or business email right away."
  },
  {
    id: "faq-external-hosting-connect",
    question: "Can I connect my AI-generated domain to external platforms like Shopify or WordPress?",
    answer: "Yes. Every domain registered at Hostamble includes full access to our automated DNS Management portal. You can create and edit A, AAAA, CNAME, MX, TXT, and SPF records anytime to link your domain to Shopify, WordPress, Wix, Blogger, GitHub Pages, or any VPS."
  },
  {
    id: "faq-free-whois-privacy",
    question: "Does Hostamble provide free WHOIS privacy protection?",
    answer: "Yes. All eligible domain extensions registered through Hostamble include free lifetime WHOIS Privacy Protection. Your personal name, phone number, physical address, and private email remain completely masked from public ICANN databases with zero renewal surcharges."
  }
];

const aiDomainFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": aiDomainFaqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout 
  title="Free AI Domain Name Generator | Smart Brand Ideas & Instant Availability"
  description="Generate catchy, brandable, high-converting domain names in seconds with Hostamble's smart AI domain generator. Instant availability checks, free WHOIS privacy, and low renewal rates."
  keywords="ai domain generator, domain name generator, smart domain suggestions, business name generator, buy domain name india, check domain availability, brandable domain generator"
>

<!-- =========================================================
     BLOCK 1: Hero Block & Interactive AI Domain Generator Console
     ========================================================= -->
<div class="ai-hero-area bg-image banner position-relative overflow-hidden" id="generator-tool">
  <div class="container position-relative" style="z-index: 2;">
    
    <!-- Hero Title & Explanatory SEO Copy -->
    <div class="row justify-content-center text-center">
      <div class="col-lg-9 col-12">
        <div class="hero-badge-tag mb-3" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <i class="ri-magic-line"></i> SMART AI BRANDING SUITE
        </div>
        <h1 class="hero-main-title text-white" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          AI Domain Name Generator &amp; Brand Suggester
        </h1>
        <p class="hero-subtext text-white-90 max-w-750 mx-auto mt-3" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          Turn your idea, product, or keywords into high-converting, brandable domain names in seconds. Powered by smart semantic expansion, niche-tailored naming patterns, and instant availability checks.
        </p>
      </div>
    </div>

    <!-- Generator Control Console Box -->
    <div class="row justify-content-center mt-4">
      <div class="col-lg-10 col-12">
        <div class="ai-console-card p-4 p-md-5" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
          
          <form id="aiDomainForm" class="ai-input-form" onsubmit="return false;">
            <!-- Main Keyword Input Bar -->
            <div class="row g-3 align-items-center">
              <div class="col-lg-8 col-md-7 col-12">
                <div class="console-input-wrap">
                  <i class="ri-search-2-line input-search-icon"></i>
                  <input 
                    type="text" 
                    id="aiKeywordsInput" 
                    class="console-main-input" 
                    placeholder="Enter keywords or brand idea (e.g. cloud, pay, flow, craft, fit)..." 
                    value="novaflow"
                    autocomplete="off"
                    required
                  />
                  <button type="button" id="clearKeywordBtn" class="console-clear-btn d-none" aria-label="Clear Input">
                    <i class="ri-close-line"></i>
                  </button>
                </div>
              </div>

              <div class="col-lg-4 col-md-5 col-12">
                <button type="submit" id="generateBtn" class="ace-btn w-100 justify-content-center btn-generator">
                  <i class="ri-magic-line me-1"></i> Generate Domains
                </button>
              </div>
            </div>

            <!-- Niche & Style Customizer Controls (Row 2) -->
            <div class="row g-3 mt-2 pt-2 border-top border-secondary-subtle">
              <div class="col-lg-4 col-md-6 col-12">
                <label for="nicheSelect" class="console-filter-label"><i class="ri-building-line me-1"></i> Industry / Niche</label>
                <select id="nicheSelect" class="console-select">
                  <option value="all">All Industries (General)</option>
                  <option value="tech" selected>Tech, AI &amp; SaaS</option>
                  <option value="ecommerce">E-Commerce &amp; Retail</option>
                  <option value="finance">Fintech &amp; Finance</option>
                  <option value="agency">Agency &amp; Consulting</option>
                  <option value="health">Health &amp; Wellness</option>
                </select>
              </div>

              <div class="col-lg-4 col-md-6 col-12">
                <label for="styleSelect" class="console-filter-label"><i class="ri-sparkling-line me-1"></i> Naming Style</label>
                <select id="styleSelect" class="console-select">
                  <option value="brandable" selected>Brandable &amp; Catchy (-ly, -ify, -io)</option>
                  <option value="short">Short &amp; Punchy (&lt; 8 Chars)</option>
                  <option value="action">Action Prefixes (get-, try-, go-)</option>
                  <option value="compound">Compound Power Words</option>
                </select>
              </div>

              <div class="col-lg-4 col-md-12 col-12">
                <label for="extensionSelect" class="console-filter-label"><i class="ri-global-line me-1"></i> Extension Preference</label>
                <select id="extensionSelect" class="console-select">
                  <option value="all" selected>All Top TLDs (.com, .in, .ai, .store)</option>
                  <option value="com">.com Only (Global Standard)</option>
                  <option value="in">.in &amp; .co.in (India #1)</option>
                  <option value="tech">.ai &amp; Tech (.ai, .io, .tech)</option>
                </select>
              </div>
            </div>
          </form>

        </div>
      </div>
    </div>

    <!-- Live Generated Results Dashboard -->
    <div class="row justify-content-center mt-5" id="resultsSection">
      <div class="col-lg-10 col-12">
        
        <!-- Results Bar: Count + Quick Filter Buttons -->
        <div class="results-header-bar d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
          <div class="d-flex align-items-center gap-2">
            <span class="results-count-badge" id="resultsCountBadge">24 Suggestions</span>
            <span class="text-white-70 small d-none d-sm-inline">Click any domain to check live availability</span>
          </div>

          <!-- Quick Tab Filters -->
          <div class="results-filter-pills d-flex flex-wrap gap-2">
            <button type="button" class="result-tab active" data-filter="all">All</button>
            <button type="button" class="result-tab" data-filter="com">.com</button>
            <button type="button" class="result-tab" data-filter="in">.in</button>
            <button type="button" class="result-tab" data-filter="tech">.ai / Tech</button>
            <button type="button" class="result-tab" data-filter="short">Short (&lt;8)</button>
          </div>
        </div>

        <!-- Dynamic Results Grid -->
        <div class="row g-3" id="domainsOutputGrid">
          <!-- Populated dynamically via client script -->
        </div>

      </div>
    </div>

  </div>
</div>

