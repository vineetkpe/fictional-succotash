---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { domainPricing } from '../data/pricing';

// ===== High-Intent SEO FAQs for Domain Search (Home Page Unified Structure) =====
const domainSearchFaqs = [
  {
    id: "faq-search-registration-steps",
    category: "registration",
    categoryLabel: "Registration & TLDs",
    question: "How do I search and register a new domain name?",
    answer: "Searching and registering a domain at Hostamble is simple: (1) Type your desired brand name or keywords into the domain search box above. (2) Review live WHOIS availability and wholesale pricing across extensions like .com, .in, .ai, or .store. (3) Click 'Search Now' and add the domain to your cart. (4) Complete our instant checkout via UPI, Net Banking, Card, or PayPal. Your domain is provisioned and active within minutes.",
    defaultOpen: true
  },
  {
    id: "faq-best-tld-choice",
    category: "registration",
    categoryLabel: "Registration & TLDs",
    question: "Which domain extension (TLD) is best for my business?",
    answer: "Your choice depends on your target market: For businesses targeting clients within India, a .in or .co.in extension signals strong local trust and improves Google India local search rankings. For international products, technology companies, and global eCommerce, .com remains the gold standard. For artificial intelligence startups and SaaS platforms, .ai and .io offer high prestige and availability."
  },
  {
    id: "faq-dns-propagation-speed",
    category: "performance",
    categoryLabel: "Speed & Anycast DNS",
    question: "How long does domain activation and Anycast DNS propagation take?",
    answer: "At Hostamble, domain registrations are activated immediately upon payment confirmation. Powered by our global Tier-IV Anycast DNS network, standard nameserver updates and record changes (A, CNAME, MX) propagate globally within 10 to 30 minutes, compared to up to 24–48 hours on conventional registrars."
  },
  {
    id: "faq-free-whois-privacy-forever",
    category: "security",
    categoryLabel: "Privacy & Security",
    question: "Is WHOIS Privacy Protection really 100% free forever?",
    answer: "Yes, absolutely. Unlike other registrars that charge high annual fees for privacy, Hostamble includes free lifetime WHOIS Privacy Protection on all eligible domain extensions. Your personal name, residential address, telephone number, and private email are shielded from public spam harvesters and telemarketers."
  },
  {
    id: "faq-domain-transfer-to-hostamble",
    category: "transfers",
    categoryLabel: "Transfers & Renewals",
    question: "Can I transfer my domain to Hostamble from another registrar?",
    answer: "Yes. Transferring your domain to Hostamble is straightforward with zero downtime. Simply unlock your domain at your current registrar (e.g. GoDaddy, Namecheap, Google Domains), obtain the EPP authorization code, and submit a transfer on our Domain Transfer page. Our team assists you throughout to ensure your website and emails remain uninterrupted."
  },
  {
    id: "faq-shopify-wordpress-setup",
    category: "hosting",
    categoryLabel: "Hosting & Setup",
    question: "Can I connect my Hostamble domain to Shopify, WordPress, or external hosting?",
    answer: "Yes. Hostamble provides a full-featured DNS management console. You can easily point your domain to Shopify, WordPress.com, Wix, Squarespace, Webflow, GitHub Pages, or any VPS by configuring A records, CNAME records, and custom nameservers in seconds."
  },
  {
    id: "faq-anycast-dns-advantage",
    category: "performance",
    categoryLabel: "Speed & Anycast DNS",
    question: "What is Anycast DNS and why is it faster than standard DNS?",
    answer: "Anycast DNS is an advanced routing technology where the same IP address is advertised across dozens of geographically dispersed server locations worldwide. When a user visits your domain, their DNS request is automatically routed to the closest physical server, drastically reducing lookup latency and improving website loading speeds."
  },
  {
    id: "faq-business-email-routing",
    category: "hosting",
    categoryLabel: "Hosting & Setup",
    question: "Can I create custom business email addresses with my domain?",
    answer: "Yes. You can either use our free built-in email forwarding tools to redirect emails like contact@yourdomain.com to your personal Gmail or Outlook inbox, or pair your domain with Hostamble Business Email hosting to send and receive encrypted business emails with dedicated cPanel webmail."
  },
  {
    id: "faq-transparent-renewals",
    category: "transfers",
    categoryLabel: "Transfers & Renewals",
    question: "Are there hidden fees or renewal price hikes after the first year?",
    answer: "None at all. Hostamble is committed to honest, transparent pricing. What you see on our pricing table is what you pay. We never apply deceptive introductory price tricks or triple your invoice at renewal. You can check renewal rates for every TLD in advance on our TLD Pricing page."
  },
  {
    id: "faq-domain-theft-lock",
    category: "security",
    categoryLabel: "Privacy & Security",
    question: "What is Domain Theft Protection (Registrar Lock)?",
    answer: "Domain Theft Protection (Registrar Lock) is an essential security safeguard that prevents unauthorized or accidental transfer requests for your domain name. While the lock is active, your domain cannot be transferred out even if someone attempts to initiate a transfer without your explicit dashboard verification."
  }
];

const domainSearchCategories = [
  { id: "all", label: "All Questions" },
  { id: "registration", label: "Registration & TLDs" },
  { id: "performance", label: "Speed & Anycast DNS" },
  { id: "security", label: "Privacy & Security" },
  { id: "hosting", label: "Hosting & Setup" },
  { id: "transfers", label: "Transfers & Renewals" }
];
---

<Layout 
  title="Domain Name Search & Instant Availability Checker | Hostamble"
  description="Search and register your ideal domain name at the lowest prices. Instant registration with free DNS management, privacy protection, and dedicated WhatsApp assistance."
  keywords="domain search, check domain name, buy domain, cheap domain registration india, com domain search"
>
<!--first block-->
         
         <div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800 position-relative overflow-hidden" id="plans">
            <!-- Interactive Ambient 3D Letters Canvas (Drifting in Depth + Mouse Parallax) -->
            <canvas id="domainLettersCanvas" class="domain-hero-canvas" aria-hidden="true"></canvas>

            <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <div class="content" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                
                                
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                              Domain Name Registration
                           </h1>
                           <p class="description max-w-750 mx-auto" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              Search, compare, and register top-level domain names instantly. Enjoy transparent wholesale pricing, free Anycast DNS management, and lifetime WHOIS privacy protection.
                           </p>
                            </div>
                            <div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
                                <form class="input-box text-start" method="post" action="https://hostamble.com/dash/domainchecker.php">
                                    <input class="large-input-box" type="search" placeholder="Find Your Ideal Domain Name ..."  name="domain">
                                    <div class="mail-icon">
                                        <i class="icon-Browser"></i>
                                    </div>
                                    <button type="submit" class="ace-btn">Search Now<i class="icon-arrow-right-line-right"></i></button>
                                </form>
                            </div>
                            <ul class="select-tlds">
                               {domainPricing.searchTlds.map((tld) => (
                                   <li>
                                       <span class="name">{tld.name}</span>
                                       <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                                       <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                                   </li>
                               ))}
                               <li class="bg-none border-0 p-0 box-shadow-none">
                                   <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                               </li>
                               <li class="bg-none border-0 p-0 box-shadow-none">
                                   <a class="m-auto border-0 ace-btn btn-small" style="background: #1e293b;" href="/ai-domain-generator"><i class="ri-magic-line me-1"></i> AI Generator</a>
                               </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/www.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/www2.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/www3.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/www4.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-5">
                        <img src="/assets/images/www5.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-6">
                        <img src="/assets/images/www6.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>

         

         <div class="ace-services-area bg-image ace-section-gap position-relative overflow-hidden" id="domain-features-flow">
            <!-- Flowing Ambient Gradient Mesh Overlay -->
            <div class="features-ambient-flow" aria-hidden="true">
                <div class="flow-glow-orb orb-1"></div>
                <div class="flow-glow-orb orb-2"></div>
            </div>

            <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
                <div class="row g-5">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Features </span>
                            <h3 class="title"> See What You Can Do With Domain</h3>
                        </div>
                    </div>
                </div>

                <!-- Cards Row with Connected Flow Stream -->
                <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center position-relative features-flow-row">

                    <!-- Flowing Streamline Connector (Desktop) -->
                    <div class="features-flow-stream d-none d-lg-block" aria-hidden="true">
                        <svg class="flow-stream-svg" viewBox="0 0 1000 40" fill="none" preserveAspectRatio="none">
                            <path class="flow-track-path" d="M 120 20 L 880 20" stroke="url(#flowLineGrad)" stroke-width="2" stroke-dasharray="6 6" />
                            <circle class="flow-pulse-particle" r="4" fill="#ff501a">
                                <animateMotion path="M 120 20 L 880 20" dur="4.5s" repeatCount="indefinite" />
                            </circle>
                            <defs>
                                <linearGradient id="flowLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#ff501a" stop-opacity="0.25" />
                                    <stop offset="50%" stop-color="#0284c7" stop-opacity="0.45" />
                                    <stop offset="100%" stop-color="#ff501a" stop-opacity="0.25" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    
                    <div class="col-lg-4 col-md-6 col-12 d-flex" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left flow-enhanced-card w-100">
                            <span class="card-flow-num" aria-hidden="true">01</span>
                            <div class="card-shimmer-sheen" aria-hidden="true"></div>
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-earth-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Build Your Global Brand</h6>
                                    <p class="description">A distinct domain name establishes brand authority, drives organic rankings on Google, and creates a trusted digital home for your business.</p>
                                    <div class="card-feature-tag">
                                        <i class="ri-shield-star-line"></i> Brand Authority
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-4 col-md-6 col-12 d-flex" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left flow-enhanced-card w-100">
                            <span class="card-flow-num" aria-hidden="true">02</span>
                            <div class="card-shimmer-sheen" aria-hidden="true"></div>
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-shield-check-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Protect Your Trademark</h6>
                                    <p class="description">Secure your business name across key extensions (.com, .in, .co.in, .ai) to prevent brand hijacking, competitors, and copycat sites.</p>
                                    <div class="card-feature-tag">
                                        <i class="ri-lock-line"></i> WHOIS Privacy Included
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-lg-4 col-md-6 col-12 d-flex" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left flow-enhanced-card w-100">
                            <span class="card-flow-num" aria-hidden="true">03</span>
                            <div class="card-shimmer-sheen" aria-hidden="true"></div>
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                       <i class="ri-global-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Seamless Domain Transfers</h6>
                                    <p class="description">Transfer existing domains to Hostamble effortlessly with standard EPP codes, automated Anycast DNS preservation, and zero service downtime.</p>
                                    <div class="card-feature-tag">
                                        <i class="ri-flashlight-line"></i> Zero Downtime Migration
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape32.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0308.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape2701.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
         </div>

        <HelpCtaBlock />

        


        <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
            <div class="container aceorbit-animated-shape">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Free Services</span>
                            <h3 class="title">What You Can Do With Your Domain Name!</h3>
                            <p class="description max-w-750 mx-auto mt-2">
                                Every domain registered at Hostamble includes complete DNS control, privacy protection, and enterprise tools at no extra fee.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row aceorbit-about-one-service g-4 mt--20 justify-content-center">

                    <!-- Card 1: Free WHOIS Privacy -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-shield-user-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Free WHOIS Privacy</h6>
                                    <p class="description">Mask your personal name, phone number, physical address, and email from public ICANN databases with zero renewal surcharges.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Business Email Account -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-mail-send-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Email Account</h6>
                                    <p class="description">Connect your custom business email (e.g. info@yourdomain.com) to present verified authority to prospective clients and partners.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Card 3: Anycast Nameserver Management -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-flashlight-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Nameserver Management</h6>
                                    <p class="description">Get free Anycast DNS nameserver management. Easily route your domain to Shopify, WordPress, cPanel, or any external VPS.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <!-- Card 4: Free Domain Forwarding -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-share-forward-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Domain Forwarding</h6>
                                    <p class="description">Point your domain name to another website for free. Redirect visitors with or without URL masking and preserve search engine signals.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 5: Domain Theft Protection -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-lock-2-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Domain Theft Lock</h6>
                                    <p class="description">Protect your domain against accidental or unauthorized transfers with free registrar locking and instant email security verification.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 6: Free Email Forwarding -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-mail-open-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Email Forwarding</h6>
                                    <p class="description">Create catch-all email forwarders and route incoming emails to your existing personal Gmail, Outlook, or corporate inbox for free.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 7: Easy-to-use Control Panel -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-dashboard-3-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Intuitive Control Panel</h6>
                                    <p class="description">Manage DNS records, configure nameservers, renew domains, and purchase hosting addons from one unified dashboard.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 8: Bulk Domain Management Tools -->
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-stack-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Bulk Domain Tools</h6>
                                    <p class="description">Register, renew, transfer, and update DNS records for multiple domain names in a single fast, synchronized bulk workflow.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape29.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0306.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape0206.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/shape19.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>

        

        <div class="ace-domain-area domain-overlay-to-another">
            <div class="container domain-style-5 bg-color-primary">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7">
                        <div class="inner">
                            <div class="section-title text-start text-white" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                <span class="pre-title">LOOKING FOR MORE OPTIONS?</span>
                                <h3 class="title">Explore 500+ Top-Level Domain Extensions</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="cta-btn text-start text-lg-end d-flex flex-wrap gap-3 justify-content-lg-end">
                            <a class="ace-btn btn-white" href="/tld-pricing">View All TLDs<i class="icon-arrow-right-line-right ms-2"></i></a>
                            <a class="ace-btn" style="background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3); color: #ffffff;" href="/ai-domain-generator"><i class="ri-magic-line me-1"></i> AI Generator</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Frequently Asked Questions (Home Page Unified Design) -->
        <FaqBlock 
          preTitle="COMMON QUESTIONS"
          title="Frequently Asked Questions"
          description="Everything you need to know about registering domains, Anycast DNS, free WHOIS privacy, and transferring domains to Hostamble."
          items={domainSearchFaqs}
          categories={domainSearchCategories}
          searchPlaceholder="Search domain questions (e.g., registration, WHOIS, Anycast, WordPress, transfer)..."
          whatsAppText="Hi Hostamble, I have a question about domain registration and DNS"
          conciergeTitle="Still have questions or need custom setup?"
          conciergeDesc="Talk directly with our in-house domain team. We speak Hindi & English and reply in under 3 minutes."
        />

<style>
  /* =========================================================
     Interactive 3D Depth Floating TLD Canvas
     ========================================================= */
  .domain-hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .aceorbit-domain-search {
    position: relative;
    overflow: hidden;
  }

  .aceorbit-domain-search .shape-image {
    opacity: 0.35;
  }

  /* =========================================================
     Features Block Flow & Transition Enhancements
     ========================================================= */
  #domain-features-flow {
    position: relative;
    overflow: hidden;
  }

  /* Ambient Flow Gradient Orbs Overlay */
  .features-ambient-flow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .flow-glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
    pointer-events: none;
    animation: orbFloatingFlow 14s ease-in-out infinite alternate;
  }

  .flow-glow-orb.orb-1 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.16) 0%, rgba(255, 80, 26, 0) 70%);
    top: 10%;
    left: -100px;
  }

  .flow-glow-orb.orb-2 {
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(2, 132, 199, 0.14) 0%, rgba(2, 132, 199, 0) 70%);
    bottom: 5%;
    right: -100px;
    animation-delay: -7s;
  }

  @keyframes orbFloatingFlow {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(40px, -30px) scale(1.1);
    }
    100% {
      transform: translate(-30px, 25px) scale(0.95);
    }
  }

  /* Desktop Flowing Connector Stream */
  .features-flow-row {
    position: relative;
  }

  .features-flow-stream {
    position: absolute;
    top: 55px;
    left: 0;
    width: 100%;
    height: 40px;
    z-index: 1;
    pointer-events: none;
  }

  .flow-stream-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .flow-pulse-particle {
    filter: drop-shadow(0 0 6px #ff501a);
  }

  /* ════════════════════════════════════════════════════════════════
     ENHANCED DOMAIN FEATURE CARDS: Modern Finish & Equal Heights
     ════════════════════════════════════════════════════════════════ */
  .flow-enhanced-card {
    position: relative !important;
    overflow: hidden !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 16px !important;
    background: #ffffff !important;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04) !important;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    padding: 38px 30px !important;
    z-index: 2 !important;
  }

  /* Interactive Cursor Spotlight Glow */
  .flow-enhanced-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 240px at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(255, 80, 26, 0.08), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
    border-radius: inherit;
  }

  .flow-enhanced-card:hover::before {
    opacity: 1;
  }

  .flow-enhanced-card:hover {
    transform: translateY(-8px) !important;
    border-color: rgba(255, 80, 26, 0.4) !important;
    box-shadow: 0 18px 36px -8px rgba(255, 80, 26, 0.12), 
                0 4px 12px rgba(0, 0, 0, 0.04) !important;
  }

  .flow-enhanced-card .inner {
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    text-align: left !important;
  }

  /* Modern Rounded Icon Badge (Overrides old tombstone arch) */
  .flow-enhanced-card .inner .icon {
    margin-bottom: 22px !important;
    display: block !important;
  }

  .flow-enhanced-card .inner .icon span {
    width: 60px !important;
    height: 60px !important;
    border-radius: 14px !important;
    background: rgba(255, 80, 26, 0.08) !important;
    border: 1px solid rgba(255, 80, 26, 0.2) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
  }

  .flow-enhanced-card .inner .icon span i {
    font-size: 26px !important;
    color: #ff501a !important;
    line-height: 1 !important;
    transition: color 0.3s ease !important;
  }

  .flow-enhanced-card:hover .inner .icon span {
    background: #ff501a !important;
    border-color: #ff501a !important;
    transform: scale(1.08) rotate(4deg) !important;
    box-shadow: 0 10px 24px rgba(255, 80, 26, 0.35) !important;
  }

  .flow-enhanced-card:hover .inner .icon span i {
    color: #ffffff !important;
  }

  /* Title & Description */
  .flow-enhanced-card .inner .content {
    flex-grow: 1 !important;
    display: flex !important;
    flex-direction: column !important;
  }

  .flow-enhanced-card .inner .content .title {
    font-size: 19.5px !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    margin-bottom: 12px !important;
    line-height: 1.35 !important;
  }

  .flow-enhanced-card .inner .content .description {
    font-size: 14.5px !important;
    line-height: 1.65 !important;
    color: #64748b !important;
    margin-bottom: 20px !important;
  }

  /* Card Feature Tag (Aligned to Bottom) */
  .card-feature-tag {
    margin-top: auto !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 12.5px !important;
    font-weight: 700 !important;
    color: #ff501a !important;
    background: rgba(255, 80, 26, 0.06) !important;
    border: 1px solid rgba(255, 80, 26, 0.16) !important;
    padding: 6px 14px !important;
    border-radius: 9999px !important;
    width: fit-content !important;
    transition: all 0.25s ease !important;
  }

  .flow-enhanced-card:hover .card-feature-tag {
    background: rgba(255, 80, 26, 0.12) !important;
    border-color: rgba(255, 80, 26, 0.3) !important;
    transform: translateX(3px);
  }

  /* Card Flow Watermark Number */
  .card-flow-num {
    position: absolute !important;
    top: 22px !important;
    right: 24px !important;
    font-family: 'Space Mono', monospace, sans-serif !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    line-height: 1 !important;
    color: rgba(15, 23, 42, 0.08) !important;
    user-select: none !important;
    pointer-events: none !important;
    transition: color 0.35s ease, transform 0.35s ease !important;
  }

  .flow-enhanced-card:hover .card-flow-num {
    color: rgba(255, 80, 26, 0.22) !important;
    transform: translateY(-2px) scale(1.05) !important;
  }

  /* Shimmer Sheen Diagonal Light Sweep */
  .card-shimmer-sheen {
    position: absolute;
    top: -60%;
    left: -60%;
    width: 220%;
    height: 220%;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(255, 80, 26, 0.06) 52%,
      transparent 65%
    );
    transform: rotate(25deg) translateY(-120%);
    pointer-events: none;
    transition: transform 0.85s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 3;
  }

  .flow-enhanced-card:hover .card-shimmer-sheen {
    transform: rotate(25deg) translateY(120%);
  }
</style>

<script is:inline>
  (function () {
    /* ════════════════════════════════════════════════════════════════
       ThePowerHost-Style 3D Depth Floating TLD Canvas with Parallax
       ════════════════════════════════════════════════════════════════ */
    function initDomainHeroScene() {
      const canvas = document.getElementById("domainLettersCanvas");
      const hero = document.getElementById("plans");
      if (!canvas || !hero) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = (canvas.width = hero.offsetWidth);
      let height = (canvas.height = hero.offsetHeight);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      function resize() {
        width = hero.offsetWidth;
        height = hero.offsetHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.scale(dpr, dpr);
      }
      resize();
      window.addEventListener("resize", resize, { passive: true });

      // Mouse & Parallax State
      const mouse = {
        x: -9999,
        y: -9999,
        active: false,
        tiltX: 0,
        tiltY: 0,
        targetTiltX: 0,
        targetTiltY: 0,
      };

      function updateMouse(e) {
        const rect = hero.getBoundingClientRect();
        const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches && e.touches.length > 0 ? e.touches[0].clientY : e.clientY;
        mouse.x = clientX - rect.left;
        mouse.y = clientY - rect.top;
        mouse.active = true;

        // Subtle 3D parallax tilt (like thepowerhost.in orbit-scene)
        mouse.targetTiltX = (mouse.x / width - 0.5) * 12;
        mouse.targetTiltY = (mouse.y / height - 0.5) * 8;
      }

      hero.addEventListener("mousemove", updateMouse, { passive: true });
      hero.addEventListener("mouseenter", updateMouse, { passive: true });
      hero.addEventListener("mouseleave", function () {
        mouse.active = false;
        mouse.x = -9999;
        mouse.y = -9999;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      hero.addEventListener("touchstart", updateMouse, { passive: true });
      hero.addEventListener("touchmove", updateMouse, { passive: true });
      hero.addEventListener("touchend", function () {
        mouse.active = false;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      // TLD Sprites List (Hostamble palette + subtle compact size)
      const tldSpecs = [
        { text: ".com", color: "#ff501a", size: 16, isBold: true },
        { text: ".in", color: "#ff501a", size: 15, isBold: true },
        { text: ".org", color: "#16a34a", size: 14, isBold: false },
        { text: ".xyz", color: "#0284c7", size: 13, isBold: false },
        { text: ".net", color: "#8b5cf6", size: 13, isBold: false },
        { text: ".ai", color: "#ff6e3a", size: 15, isBold: true },
        { text: ".co.in", color: "#ff501a", size: 13, isBold: false },
        { text: ".store", color: "#16a34a", size: 13, isBold: false },
        { text: ".app", color: "#0284c7", size: 14, isBold: false },
        { text: ".io", color: "#8b5cf6", size: 14, isBold: true },
        { text: ".tech", color: "#ff501a", size: 13, isBold: false },
        { text: ".dev", color: "#64748b", size: 13, isBold: false },
      ];

      // Spawn in left & right side bands (away from the center text column, just like thepowerhost.in)
      const isMobile = window.innerWidth < 768;
      const count = isMobile ? 6 : tldSpecs.length;

      const sprites = [];
      for (let i = 0; i < count; i++) {
        const spec = tldSpecs[i % tldSpecs.length];
        const isRight = i % 2 === 1;

        // Band limits: left band 4%-26%, right band 74%-96%
        const bandMinX = isRight ? 0.74 * width : 0.04 * width;
        const bandMaxX = isRight ? 0.95 * width : 0.26 * width;

        const x = bandMinX + Math.random() * (bandMaxX - bandMinX);
        const y = 0.12 * height + Math.random() * (0.76 * height);
        const z = -2.5 + Math.random() * 5.0; // depth coordinate

        const angle = Math.random() * Math.PI * 2;
        const speed = 0.05 + Math.random() * 0.06;

        sprites.push({
          text: spec.text,
          color: spec.color,
          baseSize: spec.size,
          isBold: spec.isBold,
          x: x,
          y: y,
          z: z,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseVx: Math.cos(angle) * speed,
          baseVy: Math.sin(angle) * speed,
          isRight: isRight,
          wobbleSpeed: 0.006 + Math.random() * 0.008,
          wobbleAmp: 0.06 + Math.random() * 0.08,
          wobbleOffset: Math.random() * 100,
        });
      }

      // Ambient Star / Dust Points (SphereCloud-style)
      const starsCount = isMobile ? 20 : 35;
      const stars = [];
      for (let s = 0; s < starsCount; s++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          radius: 0.7 + Math.random() * 1.0,
          alpha: 0.10 + Math.random() * 0.20,
          vx: (Math.random() - 0.5) * 0.05,
          vy: (Math.random() - 0.5) * 0.05,
          color: s % 3 === 0 ? "rgba(255, 80, 26, 0.25)" : "rgba(148, 163, 184, 0.20)",
        });
      }

      // Animation Loop
      let tick = 0;
      let isRunning = true;

      function render() {
        if (!isRunning) return;
        tick++;

        // Clear canvas
        ctx.clearRect(0, 0, width, height);

        // Smooth parallax lerp
        mouse.tiltX += (mouse.targetTiltX - mouse.tiltX) * 0.04;
        mouse.tiltY += (mouse.targetTiltY - mouse.tiltY) * 0.04;

        // 1. Draw Ambient Dust Stars
        for (let s = 0; s < stars.length; s++) {
          const star = stars[s];
          star.x += star.vx;
          star.y += star.vy;

          if (star.x < 0) star.x = width;
          if (star.x > width) star.x = 0;
          if (star.y < 0) star.y = height;
          if (star.y > height) star.y = 0;

          const px = star.x + mouse.tiltX * 0.2;
          const py = star.y + mouse.tiltY * 0.2;

          ctx.beginPath();
          ctx.arc(px, py, star.radius, 0, Math.PI * 2);
          ctx.fillStyle = star.color;
          ctx.fill();
        }

        // 2. Draw Floating TLD Letters
        for (let i = 0; i < sprites.length; i++) {
          const sp = sprites[i];

          // Mouse repel physics
          if (mouse.active) {
            const dx = sp.x - mouse.x;
            const dy = sp.y - mouse.y;
            const dist = Math.hypot(dx, dy);
            const repelRadius = 90;

            if (dist < repelRadius && dist > 1) {
              const force = Math.pow(1 - dist / repelRadius, 1.4) * 1.5;
              sp.vx += (dx / dist) * force;
              sp.vy += (dy / dist) * force;
            }
          }

          // Restore to ambient base speed
          sp.vx += (sp.baseVx - sp.vx) * 0.025;
          sp.vy += (sp.baseVy - sp.vy) * 0.025;

          // Organic sine wobble
          const wobbleY = Math.sin(tick * sp.wobbleSpeed + sp.wobbleOffset) * sp.wobbleAmp;
          sp.x += sp.vx;
          sp.y += sp.vy + wobbleY;

          // Band constraint bounce (stay in side bands, keep center clear)
          const bandMinX = sp.isRight ? 0.70 * width : 0.02 * width;
          const bandMaxX = sp.isRight ? 0.98 * width : 0.30 * width;

          if (sp.x < bandMinX) {
            sp.x = bandMinX;
            sp.vx = Math.abs(sp.vx) * 0.75;
            sp.baseVx = Math.abs(sp.baseVx);
          } else if (sp.x > bandMaxX) {
            sp.x = bandMaxX;
            sp.vx = -Math.abs(sp.vx) * 0.75;
            sp.baseVx = -Math.abs(sp.baseVx);
          }

          const topMinY = 0.08 * height;
          const botMaxY = 0.88 * height;
          if (sp.y < topMinY) {
            sp.y = topMinY;
            sp.vy = Math.abs(sp.vy) * 0.75;
            sp.baseVy = Math.abs(sp.baseVy);
          } else if (sp.y > botMaxY) {
            sp.y = botMaxY;
            sp.vy = -Math.abs(sp.vy) * 0.75;
            sp.baseVy = -Math.abs(sp.baseVy);
          }

          // Depth scaling & Parallax offset
          const depthFactor = 0.9 + (sp.z + 2.5) * 0.08;
          const opacity = Math.min(0.42, Math.max(0.18, 0.20 + (sp.z + 2.5) * 0.04));
          const fontSize = Math.round(sp.baseSize * depthFactor);

          const renderX = sp.x + mouse.tiltX * (0.4 + (sp.z + 2.5) * 0.1);
          const renderY = sp.y + mouse.tiltY * (0.4 + (sp.z + 2.5) * 0.1);

          // Draw TLD Sprite with Soft Glow
          ctx.save();
          ctx.font = `${sp.isBold ? "700" : "600"} ${fontSize}px "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.globalAlpha = opacity;
          ctx.shadowColor = sp.color;
          ctx.shadowBlur = 8;
          ctx.fillStyle = sp.color;
          ctx.fillText(sp.text, renderX, renderY);
          ctx.restore();
        }

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);

      // Tab visibility pause to save CPU
      document.addEventListener("visibilitychange", function () {
        isRunning = !document.hidden;
        if (isRunning) requestAnimationFrame(render);
      });
    }

    /* ════════════════════════════════════════════════════════════════
       Card Cursor Spotlight Glow Tracking for Features Block
       ════════════════════════════════════════════════════════════════ */
    function initCardSpotlight() {
      const cards = document.querySelectorAll(".flow-enhanced-card");
      cards.forEach(function (card) {
        card.addEventListener("mousemove", function (e) {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty("--mouse-x", x + "px");
          card.style.setProperty("--mouse-y", y + "px");
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function () {
        initDomainHeroScene();
        initCardSpotlight();
      });
    } else {
      initDomainHeroScene();
      initCardSpotlight();
    }
  })();
</script>
</Layout>
