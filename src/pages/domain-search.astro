<style>
  /* =========================================================
     ThePowerHost-Inspired Domain Hero Section
     ========================================================= */
  .domain-hero-section {
    position: relative;
    background: radial-gradient(circle at 50% 25%, rgba(255, 80, 26, 0.06) 0%, rgba(250, 251, 252, 0.8) 60%, #fafbfc 100%);
    padding: 130px 0 95px 0;
    min-height: 700px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* 3D Depth Floating Letters Canvas */
  .domain-hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Eyebrow Kick */
  .domain-kick {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(255, 80, 26, 0.08);
    border: 1px solid rgba(255, 80, 26, 0.22);
    color: var(--color-primary, #ff501a);
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 22px;
    box-shadow: 0 2px 8px rgba(255, 80, 26, 0.06);
  }

  .domain-kick .kick-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff501a;
    box-shadow: 0 0 10px rgba(255, 80, 26, 0.9);
    display: inline-block;
    animation: kickPulse 2s infinite ease-in-out;
  }

  @keyframes kickPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .domain-kick .kick-sep {
    color: #ff501a;
    opacity: 0.6;
    margin: 0 2px;
  }

  .domain-kick em {
    font-style: normal;
    color: #0f172a;
    font-weight: 800;
  }

  /* Headline */
  .domain-h1 {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: clamp(36px, 5.2vw, 62px);
    font-weight: 850;
    line-height: 1.14;
    letter-spacing: -0.025em;
    color: #0f172a;
    margin: 0 auto 18px;
    max-width: 820px;
  }

  .domain-h1 .gradient-text {
    background: linear-gradient(135deg, #ff501a 0%, #ff6e3a 50%, #ea580c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Subtitle */
  .domain-sub {
    font-size: clamp(16px, 1.8vw, 18px);
    color: #556277;
    max-width: 680px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  /* Command-Style Search Box */
  .domain-cmd-box {
    max-width: 680px;
    margin: 0 auto;
    position: relative;
    z-index: 3;
  }

  .domain-cmd-form {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 999px;
    padding: 6px 7px 6px 18px;
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08), 0 2px 6px rgba(15, 23, 42, 0.04);
    transition: all 0.25s ease;
  }

  .domain-cmd-form:focus-within {
    border-color: #ff501a;
    box-shadow: 0 16px 42px rgba(255, 80, 26, 0.16), 0 0 0 4px rgba(255, 80, 26, 0.1);
    transform: translateY(-2px);
  }

  .domain-cmd-prefix {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 13.5px;
    font-weight: 700;
    color: #ff501a;
    background: #fff5f0;
    padding: 5px 11px;
    border-radius: 999px;
    user-select: none;
    margin-right: 12px;
    white-space: nowrap;
    border: 1px solid rgba(255, 80, 26, 0.15);
  }

  .domain-cmd-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 17px;
    font-weight: 600;
    color: #0f172a;
    padding: 8px 0;
    min-width: 0;
  }

  .domain-cmd-input::placeholder {
    color: #94a3b8;
    font-weight: 500;
  }

  .domain-cmd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #ff501a 0%, #ff6b3d 100%);
    color: #ffffff;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 15.5px;
    font-weight: 750;
    border: none;
    border-radius: 999px;
    padding: 13px 26px;
    cursor: pointer;
    transition: all 0.22s ease;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(255, 80, 26, 0.32);
  }

  .domain-cmd-btn:hover {
    background: linear-gradient(135deg, #e04414 0%, #ff501a 100%);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(255, 80, 26, 0.42);
  }

  /* TLD Checkbox Chips directly under Search */
  .domain-tld-chips {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .domain-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 13.5px;
    font-weight: 700;
    color: #334155;
    user-select: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .domain-chip:hover {
    border-color: #ff501a;
    color: #ff501a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 80, 26, 0.1);
  }

  .domain-chip.is-active {
    background: #fff5f0;
    border-color: #ff501a;
    color: #ff501a;
    box-shadow: 0 3px 10px rgba(255, 80, 26, 0.12);
  }

  .domain-chip input[type="checkbox"] {
    accent-color: #ff501a;
    cursor: pointer;
    width: 14px;
    height: 14px;
    margin: 0;
  }

  .domain-chip .chip-name {
    line-height: 1;
  }

  .domain-chip .chip-price {
    font-size: 12px;
    color: #16a34a;
    font-weight: 800;
    background: rgba(22, 163, 74, 0.08);
    padding: 2px 6px;
    border-radius: 6px;
  }

  .domain-chip.is-active .chip-price {
    background: rgba(255, 80, 26, 0.1);
    color: #ff501a;
  }

  .domain-chip-view-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .domain-chip-view-all:hover {
    background: #e2e8f0;
    color: #0f172a;
    transform: translateY(-1px);
  }

  /* Trust Reassurance Bar */
  .domain-hero-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
    font-size: 13.5px;
    font-weight: 600;
    color: #64748b;
  }

  .domain-hero-trust span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .domain-hero-trust .trust-sep {
    color: #cbd5e1;
    font-weight: 900;
  }

  /* Responsive Adjustments */
  @media only screen and (max-width: 767px) {
    .domain-hero-section {
      padding: 90px 0 60px 0;
      min-height: auto;
    }

    .domain-cmd-form {
      padding: 6px 8px;
      border-radius: 18px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .domain-cmd-prefix {
      display: none;
    }

    .domain-cmd-input {
      width: 100%;
      height: 44px;
      padding: 0 10px;
    }

    .domain-cmd-btn {
      width: 100%;
      justify-content: center;
      border-radius: 12px;
      padding: 12px 20px;
    }

    .domain-hero-trust {
      flex-direction: column;
      gap: 8px;
    }

    .domain-hero-trust .trust-sep {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    /* ════════════════════════════════════════════════════════════════
       ThePowerHost-Style 3D Depth Floating TLD Canvas with Parallax
       ════════════════════════════════════════════════════════════════ */
    function initDomainHeroScene() {
      const canvas = document.getElementById("domainLettersCanvas");
      const hero = document.getElementById("plans");
      if (!canvas || !hero) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = (canvas.width = hero.offsetWidth);
      let height = (canvas.height = hero.offsetHeight);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      function resize() {
        width = hero.offsetWidth;
        height = hero.offsetHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.scale(dpr, dpr);
      }
      resize();
      window.addEventListener("resize", resize, { passive: true });

      // Mouse & Parallax State
      const mouse = {
        x: -9999,
        y: -9999,
        active: false,
        tiltX: 0,
        tiltY: 0,
        targetTiltX: 0,
        targetTiltY: 0,
      };

      function updateMouse(e) {
        const rect = hero.getBoundingClientRect();
        const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches && e.touches.length > 0 ? e.touches[0].clientY : e.clientY;
        mouse.x = clientX - rect.left;
        mouse.y = clientY - rect.top;
        mouse.active = true;

        // Subtle 3D parallax tilt (like thepowerhost.in orbit-scene)
        mouse.targetTiltX = (mouse.x / width - 0.5) * 26;
        mouse.targetTiltY = (mouse.y / height - 0.5) * 18;
      }

      hero.addEventListener("mousemove", updateMouse, { passive: true });
      hero.addEventListener("mouseenter", updateMouse, { passive: true });
      hero.addEventListener("mouseleave", function () {
        mouse.active = false;
        mouse.x = -9999;
        mouse.y = -9999;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      hero.addEventListener("touchstart", updateMouse, { passive: true });
      hero.addEventListener("touchmove", updateMouse, { passive: true });
      hero.addEventListener("touchend", function () {
        mouse.active = false;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      // TLD Sprites List (Hostamble palette + glowing accents)
      const tldSpecs = [
        { text: ".com", color: "#ff501a", size: 36, isBold: true },
        { text: ".in", color: "#ff501a", size: 34, isBold: true },
        { text: ".org", color: "#16a34a", size: 30, isBold: false },
        { text: ".xyz", color: "#0284c7", size: 28, isBold: false },
        { text: ".net", color: "#8b5cf6", size: 28, isBold: false },
        { text: ".ai", color: "#ff6e3a", size: 32, isBold: true },
        { text: ".co.in", color: "#ff501a", size: 26, isBold: false },
        { text: ".store", color: "#16a34a", size: 26, isBold: false },
        { text: ".app", color: "#0284c7", size: 28, isBold: false },
        { text: ".io", color: "#8b5cf6", size: 30, isBold: true },
        { text: ".tech", color: "#ff501a", size: 26, isBold: false },
        { text: ".dev", color: "#64748b", size: 26, isBold: false },
      ];

      // Spawn in left & right side bands (away from the center text column, just like thepowerhost.in)
      const isMobile = window.innerWidth < 768;
      const count = isMobile ? 6 : tldSpecs.length;

      const sprites = [];
      for (let i = 0; i < count; i++) {
        const spec = tldSpecs[i % tldSpecs.length];
        const isRight = i % 2 === 1;

        // Band limits: left band 4%-26%, right band 74%-96%
        const bandMinX = isRight ? 0.74 * width : 0.04 * width;
        const bandMaxX = isRight ? 0.95 * width : 0.26 * width;

        const x = bandMinX + Math.random() * (bandMaxX - bandMinX);
        const y = 0.12 * height + Math.random() * (0.76 * height);
        const z = -2.5 + Math.random() * 5.0; // depth coordinate

        const angle = Math.random() * Math.PI * 2;
        const speed = 0.3 + Math.random() * 0.35;

        sprites.push({
          text: spec.text,
          color: spec.color,
          baseSize: spec.size,
          isBold: spec.isBold,
          x: x,
          y: y,
          z: z,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseVx: Math.cos(angle) * speed,
          baseVy: Math.sin(angle) * speed,
          isRight: isRight,
          wobbleSpeed: 0.012 + Math.random() * 0.015,
          wobbleAmp: 0.2 + Math.random() * 0.3,
          wobbleOffset: Math.random() * 100,
        });
      }

      // Ambient Star / Dust Points (SphereCloud-style)
      const starsCount = isMobile ? 30 : 65;
      const stars = [];
      for (let s = 0; s < starsCount; s++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          radius: 0.8 + Math.random() * 1.6,
          alpha: 0.15 + Math.random() * 0.35,
          vx: (Math.random() - 0.5) * 0.2,
          vy: (Math.random() - 0.5) * 0.2,
          color: s % 3 === 0 ? "rgba(255, 80, 26, 0.4)" : "rgba(148, 163, 184, 0.35)",
        });
      }

      // Animation Loop
      let tick = 0;
      let isRunning = true;

      function render() {
        if (!isRunning) return;
        tick++;

        // Clear canvas
        ctx.clearRect(0, 0, width, height);

        // Smooth parallax lerp
        mouse.tiltX += (mouse.targetTiltX - mouse.tiltX) * 0.05;
        mouse.tiltY += (mouse.targetTiltY - mouse.tiltY) * 0.05;

        // 1. Draw Ambient Dust Stars
        for (let s = 0; s < stars.length; s++) {
          const star = stars[s];
          star.x += star.vx;
          star.y += star.vy;

          if (star.x < 0) star.x = width;
          if (star.x > width) star.x = 0;
          if (star.y < 0) star.y = height;
          if (star.y > height) star.y = 0;

          const px = star.x + mouse.tiltX * 0.3;
          const py = star.y + mouse.tiltY * 0.3;

          ctx.beginPath();
          ctx.arc(px, py, star.radius, 0, Math.PI * 2);
          ctx.fillStyle = star.color;
          ctx.fill();
        }

        // 2. Draw Floating TLD Letters
        for (let i = 0; i < sprites.length; i++) {
          const sp = sprites[i];

          // Mouse repel physics
          if (mouse.active) {
            const dx = sp.x - mouse.x;
            const dy = sp.y - mouse.y;
            const dist = Math.hypot(dx, dy);
            const repelRadius = 140;

            if (dist < repelRadius && dist > 1) {
              const force = Math.pow(1 - dist / repelRadius, 1.4) * 4.8;
              sp.vx += (dx / dist) * force;
              sp.vy += (dy / dist) * force;
            }
          }

          // Restore to ambient base speed
          sp.vx += (sp.baseVx - sp.vx) * 0.035;
          sp.vy += (sp.baseVy - sp.vy) * 0.035;

          // Organic sine wobble
          const wobbleY = Math.sin(tick * sp.wobbleSpeed + sp.wobbleOffset) * sp.wobbleAmp;
          sp.x += sp.vx;
          sp.y += sp.vy + wobbleY;

          // Band constraint bounce (stay in side bands, keep center clear)
          const bandMinX = sp.isRight ? 0.70 * width : 0.02 * width;
          const bandMaxX = sp.isRight ? 0.98 * width : 0.30 * width;

          if (sp.x < bandMinX) {
            sp.x = bandMinX;
            sp.vx = Math.abs(sp.vx) * 0.75;
            sp.baseVx = Math.abs(sp.baseVx);
          } else if (sp.x > bandMaxX) {
            sp.x = bandMaxX;
            sp.vx = -Math.abs(sp.vx) * 0.75;
            sp.baseVx = -Math.abs(sp.baseVx);
          }

          const topMinY = 0.08 * height;
          const botMaxY = 0.88 * height;
          if (sp.y < topMinY) {
            sp.y = topMinY;
            sp.vy = Math.abs(sp.vy) * 0.75;
            sp.baseVy = Math.abs(sp.baseVy);
          } else if (sp.y > botMaxY) {
            sp.y = botMaxY;
            sp.vy = -Math.abs(sp.vy) * 0.75;
            sp.baseVy = -Math.abs(sp.baseVy);
          }

          // Depth scaling & Parallax offset
          const depthFactor = 0.85 + (sp.z + 2.5) * 0.12;
          const opacity = Math.min(0.85, Math.max(0.25, 0.32 + (sp.z + 2.5) * 0.1));
          const fontSize = Math.round(sp.baseSize * depthFactor);

          const renderX = sp.x + mouse.tiltX * (0.6 + (sp.z + 2.5) * 0.15);
          const renderY = sp.y + mouse.tiltY * (0.6 + (sp.z + 2.5) * 0.15);

          // Draw TLD Sprite with Glow
          ctx.save();
          ctx.font = `${sp.isBold ? "800" : "700"} ${fontSize}px "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.globalAlpha = opacity;
          ctx.shadowColor = sp.color;
          ctx.shadowBlur = 18;
          ctx.fillStyle = sp.color;
          ctx.fillText(sp.text, renderX, renderY);
          ctx.restore();
        }

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);

      // Tab visibility pause to save CPU
      document.addEventListener("visibilitychange", function () {
        isRunning = !document.hidden;
        if (isRunning) requestAnimationFrame(render);
      });
    }

    /* ════════════════════════════════════════════════════════════════
       Search Form & TLD Checkbox Chips Integration
       ════════════════════════════════════════════════════════════════ */
    function initDomainSearchInteractions() {
      const searchForm = document.getElementById("domainCmdForm");
      const searchInput = document.getElementById("domainSearchInput");
      const chips = document.querySelectorAll(".domain-chip");

      if (!searchForm || !searchInput) return;

      // Toggle Chip Active state
      chips.forEach(function (chip) {
        const checkbox = chip.querySelector("input[type='checkbox']");
        if (!checkbox) return;

        checkbox.addEventListener("change", function () {
          chip.classList.toggle("is-active", this.checked);
        });

        // Clicking the chip text/label also updates input if user wants
        chip.addEventListener("click", function (e) {
          if (e.target !== checkbox) {
            checkbox.checked = !checkbox.checked;
            chip.classList.toggle("is-active", checkbox.checked);
          }
        });
      });

      // Submit formatting: auto-append active TLD if user just typed a name (e.g. "mybrand")
      searchForm.addEventListener("submit", function (e) {
        let val = searchInput.value.trim();
        if (!val) {
          e.preventDefault();
          searchInput.focus();
          return;
        }

        // If no dot in the query, append the first checked extension
        if (!val.includes(".")) {
          const activeCheckbox = document.querySelector(".domain-chip.is-active input[type='checkbox']");
          const extension = activeCheckbox ? activeCheckbox.value : ".com";
          searchInput.value = val + (extension.startsWith(".") ? extension : "." + extension);
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function () {
        initDomainHeroScene();
        initDomainSearchInteractions();
      });
    } else {
      initDomainHeroScene();
      initDomainSearchInteractions();
    }
  })();
</script>
</Layout>
