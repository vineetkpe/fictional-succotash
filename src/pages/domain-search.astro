<style>
  /* =========================================================
     Interactive 3D Depth Floating TLD Canvas
     ========================================================= */
  .domain-hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .aceorbit-domain-search {
    position: relative;
    overflow: hidden;
  }

  .aceorbit-domain-search .shape-image {
    opacity: 0.35;
  }
</style>

<script is:inline>
  (function () {
    /* ════════════════════════════════════════════════════════════════
       ThePowerHost-Style 3D Depth Floating TLD Canvas with Parallax
       ════════════════════════════════════════════════════════════════ */
    function initDomainHeroScene() {
      const canvas = document.getElementById("domainLettersCanvas");
      const hero = document.getElementById("plans");
      if (!canvas || !hero) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = (canvas.width = hero.offsetWidth);
      let height = (canvas.height = hero.offsetHeight);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      function resize() {
        width = hero.offsetWidth;
        height = hero.offsetHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.scale(dpr, dpr);
      }
      resize();
      window.addEventListener("resize", resize, { passive: true });

      // Mouse & Parallax State
      const mouse = {
        x: -9999,
        y: -9999,
        active: false,
        tiltX: 0,
        tiltY: 0,
        targetTiltX: 0,
        targetTiltY: 0,
      };

      function updateMouse(e) {
        const rect = hero.getBoundingClientRect();
        const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches && e.touches.length > 0 ? e.touches[0].clientY : e.clientY;
        mouse.x = clientX - rect.left;
        mouse.y = clientY - rect.top;
        mouse.active = true;

        // Subtle 3D parallax tilt (like thepowerhost.in orbit-scene)
        mouse.targetTiltX = (mouse.x / width - 0.5) * 12;
        mouse.targetTiltY = (mouse.y / height - 0.5) * 8;
      }

      hero.addEventListener("mousemove", updateMouse, { passive: true });
      hero.addEventListener("mouseenter", updateMouse, { passive: true });
      hero.addEventListener("mouseleave", function () {
        mouse.active = false;
        mouse.x = -9999;
        mouse.y = -9999;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      hero.addEventListener("touchstart", updateMouse, { passive: true });
      hero.addEventListener("touchmove", updateMouse, { passive: true });
      hero.addEventListener("touchend", function () {
        mouse.active = false;
        mouse.targetTiltX = 0;
        mouse.targetTiltY = 0;
      });

      // TLD Sprites List (Hostamble palette + subtle compact size)
      const tldSpecs = [
        { text: ".com", color: "#ff501a", size: 16, isBold: true },
        { text: ".in", color: "#ff501a", size: 15, isBold: true },
        { text: ".org", color: "#16a34a", size: 14, isBold: false },
        { text: ".xyz", color: "#0284c7", size: 13, isBold: false },
        { text: ".net", color: "#8b5cf6", size: 13, isBold: false },
        { text: ".ai", color: "#ff6e3a", size: 15, isBold: true },
        { text: ".co.in", color: "#ff501a", size: 13, isBold: false },
        { text: ".store", color: "#16a34a", size: 13, isBold: false },
        { text: ".app", color: "#0284c7", size: 14, isBold: false },
        { text: ".io", color: "#8b5cf6", size: 14, isBold: true },
        { text: ".tech", color: "#ff501a", size: 13, isBold: false },
        { text: ".dev", color: "#64748b", size: 13, isBold: false },
      ];

      // Spawn in left & right side bands (away from the center text column, just like thepowerhost.in)
      const isMobile = window.innerWidth < 768;
      const count = isMobile ? 6 : tldSpecs.length;

      const sprites = [];
      for (let i = 0; i < count; i++) {
        const spec = tldSpecs[i % tldSpecs.length];
        const isRight = i % 2 === 1;

        // Band limits: left band 4%-26%, right band 74%-96%
        const bandMinX = isRight ? 0.74 * width : 0.04 * width;
        const bandMaxX = isRight ? 0.95 * width : 0.26 * width;

        const x = bandMinX + Math.random() * (bandMaxX - bandMinX);
        const y = 0.12 * height + Math.random() * (0.76 * height);
        const z = -2.5 + Math.random() * 5.0; // depth coordinate

        const angle = Math.random() * Math.PI * 2;
        const speed = 0.05 + Math.random() * 0.06;

        sprites.push({
          text: spec.text,
          color: spec.color,
          baseSize: spec.size,
          isBold: spec.isBold,
          x: x,
          y: y,
          z: z,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseVx: Math.cos(angle) * speed,
          baseVy: Math.sin(angle) * speed,
          isRight: isRight,
          wobbleSpeed: 0.006 + Math.random() * 0.008,
          wobbleAmp: 0.06 + Math.random() * 0.08,
          wobbleOffset: Math.random() * 100,
        });
      }

      // Ambient Star / Dust Points (SphereCloud-style)
      const starsCount = isMobile ? 20 : 35;
      const stars = [];
      for (let s = 0; s < starsCount; s++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          radius: 0.7 + Math.random() * 1.0,
          alpha: 0.10 + Math.random() * 0.20,
          vx: (Math.random() - 0.5) * 0.05,
          vy: (Math.random() - 0.5) * 0.05,
          color: s % 3 === 0 ? "rgba(255, 80, 26, 0.25)" : "rgba(148, 163, 184, 0.20)",
        });
      }

      // Animation Loop
      let tick = 0;
      let isRunning = true;

      function render() {
        if (!isRunning) return;
        tick++;

        // Clear canvas
        ctx.clearRect(0, 0, width, height);

        // Smooth parallax lerp
        mouse.tiltX += (mouse.targetTiltX - mouse.tiltX) * 0.04;
        mouse.tiltY += (mouse.targetTiltY - mouse.tiltY) * 0.04;

        // 1. Draw Ambient Dust Stars
        for (let s = 0; s < stars.length; s++) {
          const star = stars[s];
          star.x += star.vx;
          star.y += star.vy;

          if (star.x < 0) star.x = width;
          if (star.x > width) star.x = 0;
          if (star.y < 0) star.y = height;
          if (star.y > height) star.y = 0;

          const px = star.x + mouse.tiltX * 0.2;
          const py = star.y + mouse.tiltY * 0.2;

          ctx.beginPath();
          ctx.arc(px, py, star.radius, 0, Math.PI * 2);
          ctx.fillStyle = star.color;
          ctx.fill();
        }

        // 2. Draw Floating TLD Letters
        for (let i = 0; i < sprites.length; i++) {
          const sp = sprites[i];

          // Mouse repel physics
          if (mouse.active) {
            const dx = sp.x - mouse.x;
            const dy = sp.y - mouse.y;
            const dist = Math.hypot(dx, dy);
            const repelRadius = 90;

            if (dist < repelRadius && dist > 1) {
              const force = Math.pow(1 - dist / repelRadius, 1.4) * 1.5;
              sp.vx += (dx / dist) * force;
              sp.vy += (dy / dist) * force;
            }
          }

          // Restore to ambient base speed
          sp.vx += (sp.baseVx - sp.vx) * 0.025;
          sp.vy += (sp.baseVy - sp.vy) * 0.025;

          // Organic sine wobble
          const wobbleY = Math.sin(tick * sp.wobbleSpeed + sp.wobbleOffset) * sp.wobbleAmp;
          sp.x += sp.vx;
          sp.y += sp.vy + wobbleY;

          // Band constraint bounce (stay in side bands, keep center clear)
          const bandMinX = sp.isRight ? 0.70 * width : 0.02 * width;
          const bandMaxX = sp.isRight ? 0.98 * width : 0.30 * width;

          if (sp.x < bandMinX) {
            sp.x = bandMinX;
            sp.vx = Math.abs(sp.vx) * 0.75;
            sp.baseVx = Math.abs(sp.baseVx);
          } else if (sp.x > bandMaxX) {
            sp.x = bandMaxX;
            sp.vx = -Math.abs(sp.vx) * 0.75;
            sp.baseVx = -Math.abs(sp.baseVx);
          }

          const topMinY = 0.08 * height;
          const botMaxY = 0.88 * height;
          if (sp.y < topMinY) {
            sp.y = topMinY;
            sp.vy = Math.abs(sp.vy) * 0.75;
            sp.baseVy = Math.abs(sp.baseVy);
          } else if (sp.y > botMaxY) {
            sp.y = botMaxY;
            sp.vy = -Math.abs(sp.vy) * 0.75;
            sp.baseVy = -Math.abs(sp.baseVy);
          }

          // Depth scaling & Parallax offset
          const depthFactor = 0.9 + (sp.z + 2.5) * 0.08;
          const opacity = Math.min(0.42, Math.max(0.18, 0.20 + (sp.z + 2.5) * 0.04));
          const fontSize = Math.round(sp.baseSize * depthFactor);

          const renderX = sp.x + mouse.tiltX * (0.4 + (sp.z + 2.5) * 0.1);
          const renderY = sp.y + mouse.tiltY * (0.4 + (sp.z + 2.5) * 0.1);

          // Draw TLD Sprite with Soft Glow
          ctx.save();
          ctx.font = `${sp.isBold ? "700" : "600"} ${fontSize}px "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.globalAlpha = opacity;
          ctx.shadowColor = sp.color;
          ctx.shadowBlur = 8;
          ctx.fillStyle = sp.color;
          ctx.fillText(sp.text, renderX, renderY);
          ctx.restore();
        }

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);

      // Tab visibility pause to save CPU
      document.addEventListener("visibilitychange", function () {
        isRunning = !document.hidden;
        if (isRunning) requestAnimationFrame(render);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDomainHeroScene);
    } else {
      initDomainHeroScene();
    }
  })();
</script>
</Layout>
