---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';
---

<Layout 
  title="Domain Name Search & Instant Availability Checker | Hostamble"
  description="Search and register your ideal domain name at the lowest prices. Instant registration with free DNS management, privacy protection, and dedicated WhatsApp assistance."
  keywords="domain search, check domain name, buy domain, cheap domain registration india, com domain search"
>
<!-- First Block: Modern ThePowerHost-inspired Hero with 3D Depth TLD Letters Canvas -->
<section class="domain-hero-section position-relative overflow-hidden" id="plans">
  <!-- Interactive Ambient 3D Letters Canvas (Drifting in Depth + Mouse Parallax) -->
  <canvas id="domainLettersCanvas" class="domain-hero-canvas" aria-hidden="true"></canvas>

  <div class="container position-relative" style="z-index: 2;">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-12 text-center">
        
        <!-- Eyebrow Kick -->
        <div class="domain-kick" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <i class="kick-dot" aria-hidden="true"></i>
          <span>domains <span class="kick-sep">▸</span> <em>claim your name</em></span>
        </div>

        <!-- Headline -->
        <h1 class="domain-h1" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <span class="d-block">Every empire starts</span>
          <span class="d-block">with <span class="gradient-text">a perfect domain.</span></span>
        </h1>

        <!-- Subtitle -->
        <p class="domain-sub" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          Live WHOIS availability, transparent renewal pricing, and instant checkout — with free lifetime WHOIS privacy and zero hidden renewal markups.
        </p>

        <!-- Command-Style Search Box -->
        <div class="domain-cmd-box" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
          <form 
            class="domain-cmd-form" 
            method="post" 
            action="https://hostamble.com/dash/domainchecker.php" 
            id="domainCmdForm"
          >
            <span class="domain-cmd-prefix" aria-hidden="true">~$ claim</span>
            <input 
              id="domainSearchInput" 
              class="domain-cmd-input" 
              type="text" 
              autocomplete="off" 
              spellcheck="false" 
              placeholder="yourbrand.com" 
              name="domain" 
              required
              aria-label="Search for a domain name"
            />
            <button id="searchButton" type="submit" class="domain-cmd-btn">
              <span>Search</span>
              <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </button>
          </form>

          <!-- TLD Checkbox Chips directly under Search (like thepowerhost.in) -->
          <div class="domain-tld-chips" id="tldChips" aria-label="Select extensions to search">
            {domainPricing.searchTlds.map((tld, idx) => (
              <label class={`domain-chip ${idx < 4 ? 'is-active' : ''}`} data-tld={tld.name.toLowerCase()}>
                <input 
                  type="checkbox" 
                  name="tlds[]" 
                  value={tld.name.toLowerCase()} 
                  checked={idx < 4}
                />
                <span class="chip-name">{tld.name.toLowerCase()}</span>
                <span class="chip-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
              </label>
            ))}
            <a href="/tld-pricing" class="domain-chip-view-all">
              <span>View All TLDs</span>
              <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
            </a>
          </div>

          <!-- Bottom Trust Reassurance Strip -->
          <div class="domain-hero-trust">
            <span><i class="ri-shield-check-fill text-success"></i> Free Lifetime WHOIS Privacy</span>
            <span class="trust-sep">·</span>
            <span><i class="ri-flashlight-fill text-primary-accent"></i> Instant Anycast DNS</span>
            <span class="trust-sep">·</span>
            <span><i class="ri-lock-fill text-success"></i> Automated Free SSL</span>
            <span class="trust-sep">·</span>
            <span><i class="ri-checkbox-circle-fill text-primary-accent"></i> Zero Renewal Surprises</span>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

         

