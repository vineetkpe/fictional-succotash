---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';
---

<Layout 
  title="Domain Name Search & Instant Availability Checker | Hostamble"
  description="Search and register your ideal domain name at the lowest prices. Instant registration with free DNS management, privacy protection, and dedicated WhatsApp assistance."
  keywords="domain search, check domain name, buy domain, cheap domain registration india, com domain search"
>
<!--first block-->
         
         <div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800 position-relative overflow-hidden" id="plans">
            <!-- Interactive Ambient 3D Letters Canvas (Drifting in Depth + Mouse Parallax) -->
            <canvas id="domainLettersCanvas" class="domain-hero-canvas" aria-hidden="true"></canvas>

            <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <div class="content" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                
                                
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                              Domain Name Registration
                           </h1>
                           <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              To search for domains, type your desired domains name on a separate line and choose your extensions
                           </p>
                            </div>
                            <div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
                                <form class="input-box text-start" method="post" action="https://hostamble.com/dash/domainchecker.php">
                                    <input class="large-input-box" type="search" placeholder="Find Your Ideal Domain Name ..."  name="domain">
                                    <div class="mail-icon">
                                        <i class="icon-Browser"></i>
                                    </div>
                                    <button type="submit" class="ace-btn">Search Now<i class="icon-arrow-right-line-right"></i></button>
                                </form>
                            </div>
                            <ul class="select-tlds">
                               {domainPricing.searchTlds.map((tld) => (
                                   <li>
                                       <span class="name">{tld.name}</span>
                                       <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                                       <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                                   </li>
                               ))}
                               <li class="bg-none border-0 p-0 box-shadow-none">
                                   <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                               </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/www.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/www2.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/www3.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/www4.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-5">
                        <img src="/assets/images/www5.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-6">
                        <img src="/assets/images/www6.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>

         

         <div class="ace-services-area bg-image ace-section-gap">

