<style>
  /* =========================================================
     Interactive Domain Extension Particles with Mouse Repel
     ========================================================= */
  .domain-particle-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .aceorbit-domain-search .shape-image {
    opacity: 0.35;
  }

  .floating-tld {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.2px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(226, 232, 240, 0.75);
    color: #475569;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    user-select: none;
    pointer-events: none;
    opacity: 0.82;
    transform: translate3d(0, 0, 0);
  }

  .floating-tld.accent-primary {
    background: rgba(255, 245, 240, 0.9);
    border-color: rgba(255, 80, 26, 0.3);
    color: #ff501a;
    font-weight: 800;
  }

  .floating-tld.accent-highlight {
    background: rgba(240, 253, 244, 0.9);
    border-color: rgba(34, 197, 94, 0.3);
    color: #16a34a;
  }

  .floating-tld.accent-blue {
    background: rgba(239, 246, 255, 0.9);
    border-color: rgba(59, 130, 246, 0.3);
    color: #2563eb;
  }

  .floating-tld.size-sm {
    font-size: 11px;
    padding: 3px 8px;
    opacity: 0.65;
  }

  .floating-tld.size-md {
    font-size: 12.5px;
    padding: 4px 11px;
    opacity: 0.85;
  }

  .floating-tld.size-lg {
    font-size: 14px;
    padding: 5px 13px;
    font-weight: 800;
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-tld {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    function initDomainParticles() {
      const hero = document.getElementById("plans");
      const field = document.getElementById("domainParticleField");
      if (!hero || !field) return;

      // Avoid re-initialization
      if (field.children.length > 0) return;

      const tlds = [
        { name: ".com", type: "accent-primary", size: "size-lg" },
        { name: ".in", type: "accent-primary", size: "size-lg" },
        { name: ".org", type: "accent-highlight", size: "size-md" },
        { name: ".ai", type: "accent-blue", size: "size-md" },
        { name: ".net", type: "", size: "size-md" },
        { name: ".io", type: "accent-blue", size: "size-md" },
        { name: ".co.in", type: "accent-primary", size: "size-sm" },
        { name: ".xyz", type: "", size: "size-sm" },
        { name: ".tech", type: "accent-blue", size: "size-sm" },
        { name: ".store", type: "accent-highlight", size: "size-md" },
        { name: ".online", type: "", size: "size-sm" },
        { name: ".app", type: "accent-primary", size: "size-sm" },
        { name: ".dev", type: "", size: "size-sm" },
        { name: ".me", type: "", size: "size-sm" },
        { name: ".co", type: "", size: "size-sm" },
        { name: ".shop", type: "accent-highlight", size: "size-sm" },
        { name: ".site", type: "", size: "size-sm" },
        { name: ".cloud", type: "accent-blue", size: "size-sm" },
        { name: ".live", type: "", size: "size-sm" },
        { name: ".agency", type: "", size: "size-sm" },
        { name: ".pro", type: "", size: "size-sm" },
        { name: ".biz", type: "", size: "size-sm" },
        { name: ".club", type: "", size: "size-sm" },
        { name: ".space", type: "accent-blue", size: "size-sm" },
      ];

      let width = hero.offsetWidth || window.innerWidth;
      let height = hero.offsetHeight || 800;

      const mouse = {
        x: -9999,
        y: -9999,
        active: false,
      };

      const particles = [];
      const cols = 6;
      const rows = 4;

      tlds.forEach(function (tld, i) {
        const el = document.createElement("div");
        el.className = `floating-tld ${tld.type} ${tld.size}`;
        el.textContent = tld.name;
        field.appendChild(el);

        // Grid-based initial distribution with random jitter
        const col = i % cols;
        const row = Math.floor(i / cols);
        const cellW = width / cols;
        const cellH = height / rows;

        const initialX = Math.max(15, Math.min(width - 70, col * cellW + Math.random() * (cellW - 50)));
        const initialY = Math.max(15, Math.min(height - 40, row * cellH + Math.random() * (cellH - 30)));

        const angle = Math.random() * Math.PI * 2;
        const speed = 0.25 + Math.random() * 0.35;
        const baseVx = Math.cos(angle) * speed;
        const baseVy = Math.sin(angle) * speed;

        particles.push({
          el: el,
          x: initialX,
          y: initialY,
          vx: baseVx,
          vy: baseVy,
          baseVx: baseVx,
          baseVy: baseVy,
          w: 50,
          h: 26,
          wobbleSpeed: 0.015 + Math.random() * 0.02,
          wobbleAmp: 0.15 + Math.random() * 0.25,
          wobbleOffset: Math.random() * 100,
        });
      });

      function updateMouse(e) {
        const rect = hero.getBoundingClientRect();
        const clientX = e.touches && e.touches.length > 0 ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches && e.touches.length > 0 ? e.touches[0].clientY : e.clientY;
        mouse.x = clientX - rect.left;
        mouse.y = clientY - rect.top;
        mouse.active = true;
      }

      hero.addEventListener("mousemove", updateMouse, { passive: true });
      hero.addEventListener("mouseenter", updateMouse, { passive: true });
      hero.addEventListener("mouseleave", function () {
        mouse.active = false;
        mouse.x = -9999;
        mouse.y = -9999;
      });

      hero.addEventListener("touchstart", updateMouse, { passive: true });
      hero.addEventListener("touchmove", updateMouse, { passive: true });
      hero.addEventListener("touchend", function () {
        mouse.active = false;
      });

      window.addEventListener("resize", function () {
        width = hero.offsetWidth || window.innerWidth;
        height = hero.offsetHeight || 800;
      }, { passive: true });

      requestAnimationFrame(function () {
        particles.forEach(function (p) {
          p.w = p.el.offsetWidth || 50;
          p.h = p.el.offsetHeight || 26;
        });
      });

      let tick = 0;
      function animate() {
        tick++;
        const repelRadius = 140;
        const repelForce = 5.2;

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];

          // Mouse repel calculation
          if (mouse.active) {
            const centerX = p.x + p.w / 2;
            const centerY = p.y + p.h / 2;
            const dx = centerX - mouse.x;
            const dy = centerY - mouse.y;
            const dist = Math.hypot(dx, dy);

            if (dist < repelRadius && dist > 1) {
              const power = Math.pow(1 - dist / repelRadius, 1.4) * repelForce;
              const nx = dx / dist;
              const ny = dy / dist;
              p.vx += nx * power;
              p.vy += ny * power;
            }
          }

          // Gentle restore to ambient float velocity
          p.vx += (p.baseVx - p.vx) * 0.035;
          p.vy += (p.baseVy - p.vy) * 0.035;

          // Organic wobble
          const wobbleX = Math.sin(tick * p.wobbleSpeed + p.wobbleOffset) * p.wobbleAmp;
          const wobbleY = Math.cos(tick * p.wobbleSpeed + p.wobbleOffset) * p.wobbleAmp;

          p.x += p.vx + wobbleX;
          p.y += p.vy + wobbleY;

          // Soft boundary bounce
          const pad = 12;
          if (p.x < pad) {
            p.x = pad;
            p.vx = Math.abs(p.vx) * 0.7;
            p.baseVx = Math.abs(p.baseVx);
          } else if (p.x > width - p.w - pad) {
            p.x = width - p.w - pad;
            p.vx = -Math.abs(p.vx) * 0.7;
            p.baseVx = -Math.abs(p.baseVx);
          }

          if (p.y < pad) {
            p.y = pad;
            p.vy = Math.abs(p.vy) * 0.7;
            p.baseVy = Math.abs(p.baseVy);
          } else if (p.y > height - p.h - pad) {
            p.y = height - p.h - pad;
            p.vy = -Math.abs(p.vy) * 0.7;
            p.baseVy = -Math.abs(p.baseVy);
          }

          p.el.style.transform = `translate3d(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px, 0)`;
        }

        requestAnimationFrame(animate);
      }

      requestAnimationFrame(animate);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDomainParticles);
    } else {
      initDomainParticles();
    }
  })();
</script>
</Layout>
