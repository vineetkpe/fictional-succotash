---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';
---

<Layout 
  title="Domain Name Search & Instant Availability Checker | Hostamble"
  description="Search and register your ideal domain name at the lowest prices. Instant registration with free DNS management, privacy protection, and 24/7 assistance."
  keywords="domain search, check domain name, buy domain, cheap domain registration india, com domain search"
>
<!--first block-->
         
         <div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center  height-800" id="plans">
            <div class="container aceorbit-animated-shape">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <div class="content" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                
                                
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                              Domain Name Registration
                           </h1>
                           <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              To search for domains, type your desired domains name on a separate line and choose your extensions
                           </p>
                            </div>
                            <div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
                                <form class="input-box text-start" method="post" action="https://hostamble.com/dash/domainchecker.php">
                                    <input class="large-input-box" type="search" placeholder="Find Your Ideal Domain Name ..."  name="domain">
                                    <div class="mail-icon">
                                        <i class="icon-Browser"></i>
                                    </div>
                                    <button type="submit" class="ace-btn">Search Now<i class="icon-arrow-right-line-right"></i></button>
                                </form>
                            </div>
                            <ul class="select-tlds">
                               {domainPricing.searchTlds.map((tld) => (
                                   <li>
                                       <span class="name">{tld.name}</span>
                                       <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                                       <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                                   </li>
                               ))}
                               <li class="bg-none border-0 p-0 box-shadow-none">
                                   <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                               </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/www.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/www2.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/www3.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/www4.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-5">
                        <img src="/assets/images/www5.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-6">
                        <img src="/assets/images/www6.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>

         

         <div class="ace-services-area bg-image ace-section-gap">

         <div class="container aceorbit-animated-shape">
            <div class="row g-5">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Features </span>
                            <h3 class="title"> See What You Can Do With Domain</h3>
                        </div>
                    </div>
                </div>


                 <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">

                    
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-earth-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Build Your Online Presence</h6>
                                    <p class="description">With the help of domain you can take your business online and make digital presence of your business, which attract more customer.</p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-shield-check-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Protect Your Domain</h6>
                                    <p class="description">Protect your business name by buying domain name for your business and make presence of your business everywhere .</p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                       <i class="ri-global-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Transfer Your Domain</h6>
                                    <p class="description">You can transfer your domain anywhere just create ticket and get your epp code and transfer your domain wherever you want.</p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



             <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape32.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0308.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape2701.png" alt="Shape Thumb">
                    </div>
                </div>
         </div>
           
        </div>

        <HelpCtaBlock />

        


        <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
            <div class="container aceorbit-animated-shape">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Free Services</span>
                            <h3 class="title">What you can do with your Domain Name!</h3>
                        </div>
                    </div>
                </div>
                <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">

                    
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-mail-line-2"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title"> Email Account</h6>
                                    <p class="description"> You can connect your business email with your domain to reach next level of professionalism</p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-Browser"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Domain Forwarding</h6>
                                    <p class="description">Point your domain name to another website for free! Redirect users when they type your domain name into a browser (with/without domain masking & SEO) </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-book-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Nameserver Management</h6>
                                    <p class="description">You will get free domain nameserver management, With the help of this feature you can connect your domain to any hosting. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-lock-password-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Domain Theft Protection</h6>
                                    <p class="description">Protect your Domain from being transferred out accidentally or without your permission with our free Domain Theft Protection. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-mail-open-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Mail Forwards</h6>
                                    <p class="description">Create email forwards and automatically redirect your email to existing email accounts. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-Lock"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Easy to use Control Panel</h6>
                                    <p class="description">Use our intuitive Control Panel to manage your domain name, configure email accounts, renew your domain name and buy more services. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-account-circle-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Bulk Tools</h6>
                                    <p class="description">Easy-to-use bulk tools to help you Register, Renew, Transfer and make other changes to several Domain Names in a single step. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape29.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0306.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape0206.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/shape19.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>

        

        <div class="ace-domain-area domain-overlay-to-another">
            <div class="container domain-style-5 bg-color-primary">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7">
                        <div class="inner">
                            <div class="section-title text-start text-white" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                <span class="pre-title">Pre-register now to get the domain of your choice</span>
                                <h3 class="title">1000s of new domains are coming soon</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="cta-btn text-start text-lg-end">
                            <a class="ace-btn btn-white" href="#">Learn More<i class="icon-arrow-right-line-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</Layout>
