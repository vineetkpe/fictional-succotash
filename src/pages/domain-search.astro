---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';
---

<Layout 
  title="Domain Name Search & Instant Availability Checker | Hostamble"
  description="Search and register your ideal domain name at the lowest prices. Instant registration with free DNS management, privacy protection, and dedicated WhatsApp assistance."
  keywords="domain search, check domain name, buy domain, cheap domain registration india, com domain search"
>
<!-- First Block: Modern Interactive Domain Search Hero -->
<div class="domain-hero-section position-relative overflow-hidden" id="plans">
  <!-- Ambient background glow elements -->
  <div class="domain-hero-ambient-glow" aria-hidden="true"></div>
  <div class="domain-hero-grid-pattern" aria-hidden="true"></div>

  <!-- Floating Moving Glassmorphism Trust Badges -->
  <div class="floating-badge badge-top-left d-none d-lg-flex" aria-hidden="true">
    <span class="badge-dot-live"></span>
    <div class="badge-icon-box text-success">
      <i class="ri-shield-user-fill"></i>
    </div>
    <div class="badge-meta">
      <span class="badge-title">Free WHOIS Privacy</span>
      <span class="badge-sub">Masks your personal data</span>
    </div>
  </div>

  <div class="floating-badge badge-top-right d-none d-lg-flex" aria-hidden="true">
    <div class="badge-icon-box text-warning">
      <i class="ri-flashlight-fill"></i>
    </div>
    <div class="badge-meta">
      <span class="badge-title">Instant DNS Activation</span>
      <span class="badge-sub">Global Anycast routing</span>
    </div>
  </div>

  <div class="floating-badge badge-bottom-right d-none d-xl-flex" aria-hidden="true">
    <div class="badge-icon-box text-primary">
      <i class="ri-lock-2-fill"></i>
    </div>
    <div class="badge-meta">
      <span class="badge-title">Automated SSL</span>
      <span class="badge-sub">Free lifetime HTTPS</span>
    </div>
  </div>

  <div class="container position-relative z-index-2">
    <div class="row justify-content-center text-center">
      <div class="col-xl-9 col-lg-10 col-12">
        
        <!-- Hostamble Eyebrow Pill -->
        <div class="domain-hero-eyebrow mb-3" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <span class="eyebrow-pulse-dot"></span>
          <span class="eyebrow-text">INSTANT DOMAIN SEARCH</span>
          <span class="eyebrow-divider">•</span>
          <span class="eyebrow-tag">FREE WHOIS PRIVACY FOR LIFE</span>
        </div>

        <!-- Main Hero Title with Signature Orange Highlight -->
        <h1 class="domain-hero-title mb-3" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          Find &amp; Secure Your <span class="hero-title-orange">Perfect Domain</span>
        </h1>

        <!-- Subtitle -->
        <p class="domain-hero-desc mb-4" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          Check live availability across 500+ extensions with instant DNS activation, automated setup, and transparent renewal rates.
        </p>

        <!-- Interactive Domain Search Input Form -->
        <div class="domain-search-box-wrap position-relative" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
          <form class="domain-search-form" method="post" action="https://hostamble.com/dash/domainchecker.php" id="domainSearchForm">
            <div class="domain-input-group">
              <span class="search-leading-icon" aria-hidden="true">
                <i class="ri-search-2-line"></i>
              </span>

              <input 
                class="domain-input-field" 
                type="text" 
                id="domainInput" 
                name="domain" 
                placeholder="Search your brand name (e.g. mycompany, techhub)..." 
                autocomplete="off" 
                spellcheck="false" 
                required 
              />

              <!-- Active TLD indicator tag -->
              <span class="active-tld-badge" id="activeTldBadge" title="Selected extension">.com</span>

              <!-- Clear search button -->
              <button type="button" class="domain-clear-btn d-none" id="domainClearBtn" aria-label="Clear input">
                <i class="ri-close-line"></i>
              </button>

              <!-- Submit button with arrow animation -->
              <button type="submit" class="domain-btn-submit" id="domainSubmitBtn">
                <span>Search</span>
                <i class="ri-arrow-right-line" aria-hidden="true"></i>
              </button>
            </div>
          </form>

          <!-- Interactive Live Preview Dropdown (Appears smoothly as user types) -->
          <div class="domain-live-preview-panel d-none" id="domainLivePreview">
            <div class="preview-panel-header">
              <span class="preview-header-label">
                <i class="ri-flashlight-line text-warning me-1"></i> Instant Extension Matches
              </span>
              <span class="preview-header-hint">Click to register immediately</span>
            </div>
            <div class="preview-matches-list" id="previewMatchesList">
              <!-- Populated dynamically via client-side script -->
            </div>
          </div>
        </div>

        <!-- Interactive Popular TLD Chips Strip -->
        <div class="domain-tlds-strip mt-4" data-sal="slide-up" data-sal-delay="300" data-sal-duration="800">
          <div class="tlds-chips-wrapper">
            {domainPricing.searchTlds.map((tld, idx) => (
              <button 
                type="button" 
                class={`tld-chip-card ${idx === 0 ? 'is-active' : ''}`}
                data-tld-name={tld.name.toLowerCase()}
                title={`Select ${tld.name} extension`}
              >
                <span class="tld-name">{tld.name}</span>
                <span class="tld-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                <span class="tld-original prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
              </button>
            ))}
            <a class="tld-view-all-chip" href="/tld-pricing">
              <span>All 500+ TLDs</span>
              <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <!-- Hero Bottom Trust Metric Bar -->
        <div class="domain-hero-trust-bar mt-4 pt-2" data-sal="slide-up" data-sal-delay="350" data-sal-duration="800">
          <div class="trust-item">
            <i class="ri-checkbox-circle-fill text-success" aria-hidden="true"></i>
            <span>Free Lifetime WHOIS Privacy</span>
          </div>
          <div class="trust-sep" aria-hidden="true">·</div>
          <div class="trust-item">
            <i class="ri-checkbox-circle-fill text-success" aria-hidden="true"></i>
            <span>Instant Anycast DNS Management</span>
          </div>
          <div class="trust-sep" aria-hidden="true">·</div>
          <div class="trust-item">
            <i class="ri-checkbox-circle-fill text-success" aria-hidden="true"></i>
            <span>Zero Hidden Renewal Price Markups</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Decorative background shapes (preserved from original theme) -->
  <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none" aria-hidden="true">
    <div class="shape-image shape-image-1"><img src="/assets/images/www.png" alt="Decorative WWW" /></div>
    <div class="shape-image shape-image-2"><img src="/assets/images/www2.png" alt="Decorative WWW" /></div>
    <div class="shape-image shape-image-3"><img src="/assets/images/www3.png" alt="Decorative WWW" /></div>
    <div class="shape-image shape-image-4"><img src="/assets/images/www4.png" alt="Decorative WWW" /></div>
    <div class="shape-image shape-image-5"><img src="/assets/images/www5.png" alt="Decorative WWW" /></div>
    <div class="shape-image shape-image-6"><img src="/assets/images/www6.png" alt="Decorative WWW" /></div>
  </div>
</div>

<!-- Client-side Interactive Script for Typewriter, TLD Switching & Live Preview -->
<script is:inline define:vars={{ searchTlds: domainPricing.searchTlds }}>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("domainInput");
    const clearBtn = document.getElementById("domainClearBtn");
    const tldBadge = document.getElementById("activeTldBadge");
    const tldChips = document.querySelectorAll(".tld-chip-card");
    const previewPanel = document.getElementById("domainLivePreview");
    const previewList = document.getElementById("previewMatchesList");
    const form = document.getElementById("domainSearchForm");

    // Dynamic typewriter domain placeholders
    const suggestions = [
      "yourbrandname",
      "creativeagency",
      "startupapp",
      "cloudservice",
      "onlinestore",
      "techhub",
      "designstudio"
    ];

    let currentSugIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let typewriterTimer = null;
    let isUserTyping = false;
    let activeTld = ".com";

    function runTypewriter() {
      if (isUserTyping || document.activeElement === input) return;

      const currentWord = suggestions[currentSugIndex];

      if (isDeleting) {
        charIndex--;
        input.setAttribute("placeholder", `Search your brand name (e.g. ${currentWord.substring(0, charIndex)})...`);
        if (charIndex <= 0) {
          isDeleting = false;
          currentSugIndex = (currentSugIndex + 1) % suggestions.length;
          typewriterTimer = setTimeout(runTypewriter, 500);
          return;
        }
        typewriterTimer = setTimeout(runTypewriter, 50);
      } else {
        charIndex++;
        input.setAttribute("placeholder", `Search your brand name (e.g. ${currentWord.substring(0, charIndex)})...`);
        if (charIndex >= currentWord.length) {
          isDeleting = true;
          typewriterTimer = setTimeout(runTypewriter, 2200); // pause at full word
          return;
        }
        typewriterTimer = setTimeout(runTypewriter, 100);
      }
    }

    // Start typewriter
    typewriterTimer = setTimeout(runTypewriter, 1000);

    // Stop typewriter on focus or input
    input.addEventListener("focus", function () {
      isUserTyping = true;
      clearTimeout(typewriterTimer);
      input.setAttribute("placeholder", "Type your domain name here...");
    });

    input.addEventListener("blur", function () {
      if (input.value.trim() === "") {
        isUserTyping = false;
        charIndex = 0;
        isDeleting = false;
        typewriterTimer = setTimeout(runTypewriter, 1200);
      }
    });

    // Helper: Clean raw domain input
    function sanitizeDomainInput(val) {
      return val
        .trim()
        .toLowerCase()
        .replace(/^(https?:\/\/)?(www\.)?/, "")
        .replace(/[^a-z0-9\-.]/g, "");
    }

    // Render Live Instant Preview Matches
    function updateLivePreview(val) {
      const clean = sanitizeDomainInput(val);
      if (!clean || clean.length < 2) {
        if (previewPanel) previewPanel.classList.add("d-none");
        return;
      }

      // Strip existing extension if typed
      const baseName = clean.split(".")[0];
      if (!baseName) return;

      const extensions = [
        { ext: ".com", inr: "₹999", usd: "$11.99", badge: "Popular" },
        { ext: ".in", inr: "₹499", usd: "$5.95", badge: "India Fast" },
        { ext: ".net", inr: "₹1399", usd: "$16.65" },
        { ext: ".online", inr: "₹299", usd: "$3.59", badge: "Best Value" },
        { ext: ".org", inr: "₹1199", usd: "$14.30" },
      ];

      let html = "";
      extensions.forEach(item => {
        const fullDomain = `${baseName}${item.ext}`;
        const isSelected = activeTld === item.ext;
        const cartUrl = `https://hostamble.com/dash/cart.php?a=add&domain=register&query=${encodeURIComponent(fullDomain)}`;

        html += `
          <div class="preview-match-row ${isSelected ? 'row-selected' : ''}">
            <div class="preview-domain-info">
              <span class="preview-domain-name">
                <span class="preview-base">${baseName}</span><span class="preview-ext">${item.ext}</span>
              </span>
              <span class="preview-avail-badge">
                <i class="ri-checkbox-circle-fill"></i> Available
              </span>
              ${item.badge ? `<span class="preview-micro-tag">${item.badge}</span>` : ""}
            </div>
            <div class="preview-action-block">
              <span class="preview-price-text">${item.inr} <small>/yr</small></span>
              <a href="${cartUrl}" class="preview-register-btn" target="_blank" rel="noopener noreferrer">
                <span>Register</span>
                <i class="ri-arrow-right-line"></i>
              </a>
            </div>
          </div>
        `;
      });

      if (previewList) previewList.innerHTML = html;
      if (previewPanel) previewPanel.classList.remove("d-none");
    }

    // Input Typing Handler
    input.addEventListener("input", function () {
      const val = this.value;
      if (clearBtn) {
        if (val.length > 0) {
          clearBtn.classList.remove("d-none");
        } else {
          clearBtn.classList.add("d-none");
        }
      }
      updateLivePreview(val);
    });

    // Clear Button Handler
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        input.value = "";
        clearBtn.classList.add("d-none");
        if (previewPanel) previewPanel.classList.add("d-none");
        input.focus();
      });
    }

    // TLD Chip Click Handler
    tldChips.forEach(chip => {
      chip.addEventListener("click", function () {
        tldChips.forEach(c => c.classList.remove("is-active"));
        this.classList.add("is-active");

        const selectedExt = this.getAttribute("data-tld-name") || ".com";
        activeTld = selectedExt.startsWith(".") ? selectedExt : `.${selectedExt}`;

        if (tldBadge) tldBadge.textContent = activeTld;

        // If user already typed a domain, update or append extension
        if (input.value.trim().length > 0) {
          const base = input.value.split(".")[0].trim();
          input.value = `${base}${activeTld}`;
          updateLivePreview(input.value);
        }

        input.focus();
      });
    });

    // Hide preview on outside click
    document.addEventListener("click", function (e) {
      if (!e.target.closest(".domain-search-box-wrap")) {
        if (previewPanel) previewPanel.classList.add("d-none");
      }
    });

    // Hide preview on Escape key
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        if (previewPanel) previewPanel.classList.add("d-none");
      }
    });
  });
</script>

<style>
  /* =========================================================
     Hostamble Domain Search Hero Block
     - Aligned with Hostamble Warm Orange Theme (#ff501a)
     - Interactive Typewriter + TLD Selectors + Live Preview
     - Organic Floating Micro-Trust Badges
     ========================================================= */

  .domain-hero-section {
    position: relative;
    background-color: #fafbfc;
    padding: 120px 0 100px 0;
    min-height: 720px;
    display: flex;
    align-items: center;
  }

  .domain-hero-ambient-glow {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 520px;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.055) 0%, rgba(250, 251, 252, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .domain-hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(17, 20, 29, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
  }

  /* Eyebrow Pill */
  .domain-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid rgba(255, 80, 26, 0.25);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: var(--color-primary, #ff501a);
    box-shadow: 0 4px 14px rgba(255, 80, 26, 0.08);
  }

  .eyebrow-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary, #ff501a);
    box-shadow: 0 0 10px rgba(255, 80, 26, 0.9);
    animation: pulseDot 2s infinite ease-in-out;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .eyebrow-divider {
    color: rgba(255, 80, 26, 0.4);
    font-size: 14px;
  }

  .eyebrow-tag {
    color: #475569;
    font-weight: 700;
  }

  /* Main Title */
  .domain-hero-title {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 900;
    line-height: 1.15;
    color: var(--color-heading, #17181c);
    letter-spacing: -0.025em;
  }

  .hero-title-orange {
    color: var(--color-primary, #ff501a);
    position: relative;
    display: inline-block;
  }

  .domain-hero-desc {
    font-size: 17.5px;
    line-height: 1.6;
    color: #5c6678;
    max-width: 680px;
    margin: 0 auto;
  }

  /* Search Box Container */
  .domain-search-box-wrap {
    max-width: 760px;
    margin: 0 auto;
    z-index: 10;
  }

  .domain-search-form {
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 999px;
    padding: 6px 8px 6px 20px;
    box-shadow: 0 10px 32px rgba(18, 22, 33, 0.06);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .domain-search-form:focus-within {
    border-color: var(--color-primary, #ff501a);
    box-shadow: 0 12px 38px rgba(255, 80, 26, 0.16);
    transform: translateY(-2px);
  }

  .domain-input-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-leading-icon {
    font-size: 22px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .domain-input-field {
    flex-grow: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: 17px;
    font-weight: 600;
    color: #1e293b;
    outline: none;
    height: 52px;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
  }

  .domain-input-field::placeholder {
    color: #94a3b8;
    font-weight: 500;
  }

  .active-tld-badge {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #475569;
    font-size: 13.5px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .domain-clear-btn {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 20px;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .domain-clear-btn:hover {
    color: #0f172a;
  }

  .domain-btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 52px;
    padding: 0 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #ff501a 0%, #ff6e36 100%);
    color: #ffffff;
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 16px;
    font-weight: 800;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(255, 80, 26, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .domain-btn-submit:hover {
    background: linear-gradient(135deg, #e64512 0%, #ff501a 100%);
    box-shadow: 0 8px 24px rgba(255, 80, 26, 0.45);
    transform: translateY(-1px);
  }

  .domain-btn-submit:hover i {
    transform: translateX(4px);
  }

  .domain-btn-submit i {
    font-size: 18px;
    transition: transform 0.2s ease;
  }

  /* Live Preview Dropdown Panel */
  .domain-live-preview-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 20px 48px -10px rgba(18, 22, 33, 0.16);
    overflow: hidden;
    z-index: 50;
    animation: slideDownPreview 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideDownPreview {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .preview-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
    font-size: 12.5px;
  }

  .preview-header-label {
    font-weight: 700;
    color: #334155;
    display: flex;
    align-items: center;
  }

  .preview-header-hint {
    color: #64748b;
    font-size: 11.5px;
  }

  .preview-matches-list {
    display: flex;
    flex-direction: column;
  }

  :global(.preview-match-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid #f8fafc;
    transition: background 0.18s ease;
  }

  :global(.preview-match-row:last-child) {
    border-bottom: none;
  }

  :global(.preview-match-row:hover),
  :global(.preview-match-row.row-selected) {
    background: #fff8f5;
  }

  :global(.preview-domain-info) {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  :global(.preview-domain-name) {
    font-family: var(--font-primary, 'Urbanist', sans-serif);
    font-size: 16px;
    font-weight: 700;
    color: #17181c;
  }

  :global(.preview-domain-name .preview-ext) {
    color: var(--color-primary, #ff501a);
    font-weight: 800;
  }

  :global(.preview-avail-badge) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11.5px;
    font-weight: 700;
    color: #16a34a;
    background: #f0fdf4;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid #bbf7d0;
  }

  :global(.preview-micro-tag) {
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #475569;
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
  }

  :global(.preview-action-block) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  :global(.preview-price-text) {
    font-size: 15px;
    font-weight: 800;
    color: #1e293b;
  }

  :global(.preview-price-text small) {
    font-size: 11.5px;
    color: #64748b;
    font-weight: 600;
  }

  :global(.preview-register-btn) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--color-primary, #ff501a);
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  :global(.preview-register-btn:hover) {
    background: #e64512;
    transform: translateY(-1px);
  }

  /* Popular TLD Chips Strip */
  .domain-tlds-strip {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .tlds-chips-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
