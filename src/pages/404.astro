---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 - Page Not Found | Hostamble" noindex={true}>
  <div class="error-area ace-section-gap bg-color-white" style="padding: 120px 0;">
      <div class="container">
          <div class="row justify-content-center">
              <div class="col-lg-8 text-center">
                  <div class="error-image mb--30">
                      <img src="/assets/images/404.png" alt="404 Not Found" style="max-width: 480px; width: 100%;">
                  </div>
                  <h2 class="title" style="margin-top: 30px; font-weight: 700;">Oops! Page Not Found</h2>
                  <p class="description" style="color: #65676b; max-width: 500px; margin: 15px auto 30px;">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
                  <a href="/" class="ace-btn">Back To Homepage <i class="icon-arrow-right-line-right"></i></a>
              </div>
          </div>
      </div>
  </div>
</Layout>
