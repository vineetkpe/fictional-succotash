<script is:inline>
  function switchN8nBilling(duration) {
    document.querySelectorAll('.pricing-billing-duration .nav-link').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`n8n-${duration}-btn`);
    if (activeBtn) activeBtn.classList.add('active');

    document.querySelectorAll('.n8n-pricing-opt').forEach(el => el.style.display = 'none');
    document.querySelectorAll(`.n8n-${duration}`).forEach(el => el.style.display = 'block');
  }

  function filterTemplates(cat, btn) {
    document.querySelectorAll('.template-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.template-item').forEach(item => {
      if (cat === 'all' || item.getAttribute('data-cat') === cat) {
        item.style.display = 'block';
      } else {
        item.style.display = 'none';
      }
    });
  }
</script>
