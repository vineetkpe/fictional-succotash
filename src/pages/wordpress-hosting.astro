<!-- Multi-Duration Switcher for WordPress Pricing -->
<script is:inline>
  function switchWpPricing(plan) {
    if (window.updatePricing) {
      window.updatePricing(plan);
      return;
    }
    const plans = ['monthly', 'quarterly', 'semiannual', 'annual'];
    plans.forEach(p => {
      document.querySelectorAll('.' + p + '-pricing').forEach(el => {
        el.style.setProperty('display', 'none', 'important');
      });
      const btn = document.getElementById(p + '-plan-btn');
      if (btn) btn.classList.remove('active');
    });
    document.querySelectorAll('.' + plan + '-pricing').forEach(el => {
      el.style.setProperty('display', 'block', 'important');
    });
    const activeBtn = document.getElementById(plan + '-plan-btn');
    if (activeBtn) activeBtn.classList.add('active');

    const showFreeDomain = (plan === 'semiannual' || plan === 'annual');
    document.querySelectorAll('.free-domain').forEach(el => {
      el.style.setProperty('display', showFreeDomain ? 'block' : 'none', 'important');
    });
  }
  window.switchWpPricing = switchWpPricing;
</script>

