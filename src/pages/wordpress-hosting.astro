<script>
  import '../scripts/pricing';

  function initWpStackingMovement() {
    const list = document.querySelector<HTMLElement>('.wp-stack-list');
    if (!list) return;

    const cards = Array.from(list.querySelectorAll<HTMLElement>('.stack-card'));
    if (!cards.length) return;

    let isTicking = false;

    function onScroll() {
      if (window.innerWidth < 992) {
        cards.forEach(card => {
          card.style.transform = '';
          card.style.filter = '';
        });
        isTicking = false;
        return;
      }

      const listRect = list!.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Update vertical progress line
      const triggerStart = viewportHeight * 0.7;
      const totalTravel = listRect.height;
      const currentScroll = triggerStart - listRect.top;
      const progressPercent = Math.max(0, Math.min(100, (currentScroll / totalTravel) * 100));
      list!.style.setProperty('--scroll-progress', `${progressPercent}%`);

      // Find active card index based on scroll position
      const threshold = 170;
      let activeIndex = 0;

      cards.forEach((card, i) => {
        const rect = card.getBoundingClientRect();
        if (rect.top <= threshold) {
          activeIndex = i;
        }
      });

      // Apply stacking depth scaling to moving cards
      cards.forEach((card, i) => {
        const isActive = (i === activeIndex);
        card.classList.toggle('is-active', isActive);

        if (i < activeIndex) {
          const depth = activeIndex - i;
          const scale = Math.max(0.93, 1 - depth * 0.025);
          const brightness = Math.max(0.92, 1 - depth * 0.03);
          card.style.transform = `scale(${scale})`;
          card.style.filter = `brightness(${brightness})`;
        } else {
          card.style.transform = 'scale(1)';
          card.style.filter = 'brightness(1)';
        }
      });

      isTicking = false;
    }

    function requestScroll() {
      if (!isTicking) {
        window.requestAnimationFrame(onScroll);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', requestScroll, { passive: true });
    window.addEventListener('resize', requestScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWpStackingMovement);
  } else {
    initWpStackingMovement();
  }
  document.addEventListener('astro:page-load', initWpStackingMovement);
</script>



