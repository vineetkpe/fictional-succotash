---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import InteractiveHeroIllustration from '../components/InteractiveHeroIllustration.astro';
import { wordpressHosting, wordpressPlanSpecs } from '../data/pricing';
import PlanSpecsTable from '../components/PlanSpecsTable.astro';

const plans = wordpressHosting.plans;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between WordPress hosting and standard shared web hosting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WordPress hosting is specifically pre-configured and optimized for the WordPress CMS stack. Unlike generic shared hosting, WordPress hosting includes dedicated server-level caching (such as LiteSpeed LSCache and Redis), isolated CloudLinux PHP memory pools (256MB–512MB+), automated core and plugin updates with safety rollback checkpoints, and WordPress-specific firewall rules blocking XML-RPC exploits and brute-force login attempts."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need specialized WordPress hosting, or can I use regular web hosting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While WordPress can technically run on basic web hosting, specialized WordPress hosting significantly improves website speed, Core Web Vitals, and search engine rankings. It eliminates complex manual configurations by automating database optimization, SSL certificate provisioning, staging sandboxes, daily backups, and server-side object caching out of the box."
      }
    },
    {
      "@type": "Question",
      "name": "How does LiteSpeed Enterprise Web Server accelerate WordPress site speed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LiteSpeed Enterprise replaces traditional Apache web servers with an event-driven architecture that consumes minimal RAM and CPU. Combined with native LiteSpeed Cache (LSCache) and HTTP/3 QUIC protocol support, dynamic PHP pages are cached as static HTML directly at the server level, cutting server response times (TTFB) to under 100ms and handling up to 10x more concurrent visitors without slowdowns."
      }
    },
    {
      "@type": "Question",
      "name": "How much SSD storage and RAM does an active WordPress website need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A standard WordPress blog or portfolio website typically uses 2 GB to 5 GB of storage including themes, core files, and plugins. An eCommerce store using WooCommerce with 500+ product images typically needs 8 GB to 25 GB of NVMe SSD storage. For memory, 256MB to 512MB of dedicated PHP memory_limit ensures seamless execution of heavy page builders like Elementor without memory exhaustion errors."
      }
    },
    {
      "@type": "Question",
      "name": "Can I migrate an existing WordPress site without any downtime or data loss?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Zero-downtime WordPress migration is achieved by copying your WordPress files (public_html) and exporting your MySQL database to the new server while your old host remains active. You can preview and test the transferred website using a temporary URL or hosts file modification before updating your domain nameservers (DNS), ensuring zero visitor interruption."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best security practices to protect a WordPress website from hackers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Essential WordPress security requires multi-layered defense: an automated Web Application Firewall (WAF) to filter malicious requests, real-time kernel-level malware scanners like Imunify360, brute-force login throttling, automated Let's Encrypt SSL encryption, disabling XML-RPC pingbacks, enforcing strong admin passwords with 2FA, and running regular offsite backups."
      }
    },
    {
      "@type": "Question",
      "name": "What is WordPress 1-Click Staging and why is it important?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "1-Click Staging creates an exact, private clone of your live WordPress website in an isolated sandbox. This allows you to safely test major WordPress core updates, new WooCommerce plugins, custom PHP functions, or theme redesigns without risking crashes on your live production site. Once validated, you can push the staged changes to your live site in a single click."
      }
    },
    {
      "@type": "Question",
      "name": "Why is server TTFB (Time to First Byte) critical for WordPress SEO rankings?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Google's Core Web Vitals prioritize fast-loading websites, and Time to First Byte (TTFB) measures how quickly your server responds to a browser request. A slow TTFB delays Largest Contentful Paint (LCP) and First Input Delay (FID). Hosting WordPress on enterprise AMD EPYC CPUs with PCIe 4.0 NVMe SSDs and LiteSpeed caching keeps TTFB under 200ms, directly improving crawl efficiency and organic search rank."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run WooCommerce on standard WordPress hosting plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, provided the WordPress hosting plan provides sufficient hardware isolation, high PHP memory allocation (minimum 256MB, recommended 512MB+), modern PHP 8.2/8.3 execution, and OPcache. WooCommerce requires dynamic cart operations that cannot be fully cached, so enterprise NVMe storage and fast database query execution are vital for fast checkout processing."
      }
    },
    {
      "@type": "Question",
      "name": "Can I host multiple WordPress websites on one hosting account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Multi-domain WordPress hosting plans allow you to host multiple distinct websites (from 3 to 10+ domains) under a single management dashboard. Each domain maintains its own independent root directory, dedicated MySQL database, separate FTP/SFTP credentials, and auto-renewing SSL certificate."
      }
    }
  ]
};
