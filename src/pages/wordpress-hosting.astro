---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import InteractiveHeroIllustration from '../components/InteractiveHeroIllustration.astro';
import { wordpressHosting } from '../data/pricing';

const plans = wordpressHosting.plans;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What makes Hostamble Managed WordPress Hosting faster than standard web hosting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hostamble WordPress Hosting is provisioned on enterprise AMD EPYC processors with PCIe 4.0 NVMe SSD storage in high-redundancy RAID-10. Each account is accelerated by the LiteSpeed Enterprise Web Server with native LSCache and Redis object caching, bypassing standard PHP bottlenecks to deliver up to 10x faster dynamic page serving, sub-second TTFB, and 99.9% uptime."
      }
    },
    {
      "@type": "Question",
      "name": "Is genuine cPanel access and 1-Click Staging included with WordPress Hosting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Unlike proprietary hosting providers that lock you into restricted dashboards, Hostamble provides official cPanel access alongside the Softaculous 1-Click Installer. You get dedicated staging and cloning environments to test plugins, themes, and PHP updates safely in private before pushing them live in a single click."
      }
    },
    {
      "@type": "Question",
      "name": "Does Hostamble provide free WordPress website migration?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100% free migration is included with every WordPress Hosting plan. Our dedicated WordPress technical team migrates your files, MySQL databases, plugins, themes, and email accounts from your current host with zero downtime and complete data integrity."
      }
    },
    {
      "@type": "Question",
      "name": "How does Imunify360 protect my WordPress website against malware and hackers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every WordPress plan includes integrated Imunify360 AI Security with proactive real-time malware scanning, automated malicious file cleanup, and a smart Web Application Firewall (WAF). Imunify360 actively blocks brute-force login attempts, SQL injections, cross-site scripting (XSS), and zero-day threats directly at the kernel level."
      }
    },
    {
      "@type": "Question",
      "name": "Can I run a WooCommerce store on Hostamble WordPress Hosting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Hostamble WordPress hosting is fully optimized for WooCommerce, offering high PHP memory limits (up to 512MB+), MariaDB query acceleration, HTTP/3 QUIC protocol support, and dedicated CloudLinux LVE CPU/RAM allocations, ensuring blazing-fast shopping cart checkout and order processing even during heavy traffic surges."
      }
    },
    {
      "@type": "Question",
      "name": "Are automated backups included and how do I restore my website?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Automated daily offsite snapshots are powered by JetBackup 5. You can restore individual WordPress files, specific MySQL database tables, email inboxes, or your entire account with a single click directly from your cPanel dashboard at no additional charge."
      }
    },
    {
      "@type": "Question",
      "name": "Where are Hostamble datacenters located, and can I get low latency in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hostamble operates Tier-III high-speed datacenters in India as well as premier global locations equipped with redundant multi-homed 10Gbps fiber uplinks. This ensures ultra-low ping latency (<18ms across India), fast edge routing, and optimal local search engine performance."
      }
    },
    {
      "@type": "Question",
      "name": "What versions of PHP are supported on WordPress Hosting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can select and switch between PHP 8.0, 8.1, 8.2, 8.3, and 8.4 instantly using the Multi-PHP Selector in cPanel. You can also customize PHP extensions (OPcache, Redis, Imagick, IonCube) and php.ini directives to match your exact plugin requirements."
      }
    },
    {
      "@type": "Question",
      "name": "Is a Free SSL Certificate and Free Domain included?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Automated Let's Encrypt Wildcard SSL certificates are generated and auto-renewed every 90 days for all primary domains and subdomains. Additionally, annual and multi-year subscriptions on qualifying plans include a Free Domain Name registration."
      }
    },
    {
      "@type": "Question",
      "name": "What is Hostamble's refund and money-back guarantee policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hostamble provides an unconditional 30-day money-back guarantee on all annual and multi-year WordPress hosting plans. If you are not completely satisfied with our performance, speed, or support within the first 30 days, you can request a prompt, hassle-free refund."
      }
    }
  ]
};
---

<Layout 
  title="Optimized WordPress Hosting with LiteSpeed & Free Domain | Hostamble"
  description="Accelerate your WordPress site with LiteSpeed Turbo caching, pure NVMe SSDs, automated updates, 1-click staging, and dedicated WordPress support."
  keywords="wordpress hosting, managed wordpress hosting, cheap wordpress hosting india, litespeed wordpress, fastest wordpress host"
>
  <!-- SEO & AI Chatbot Structured Data (FAQPage Schema) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- =========================================================
       HERO SECTION: High-Performance Managed WordPress (Matches Home Page)
       ========================================================= -->
  <div class="slider-area banner bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <!-- Left: Headline & Offer Action -->
        <div class="col-lg-6 col-md-12">
          <div class="inner">
            <div class="content">
              <!-- Eyebrow Pill -->
              <div class="hero-eyebrow-pill mb-3" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
                <span class="eyebrow-dot"></span>
                <span class="eyebrow-label">MANAGED WORDPRESS HOSTING</span>
                <span class="eyebrow-sep">•</span>
                <span class="eyebrow-tag">STARTS AT <span data-inr={wordpressHosting.heroStartPrice.inr} data-usd={wordpressHosting.heroStartPrice.usd}>{wordpressHosting.heroStartPrice.inr}</span></span>
              </div>

              <!-- Perfectly Aligned Headline (Refined Size & Single Baseline) -->
              <h1 class="hero-wp-title mb-3" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Accelerate Your WordPress Site with <span class="wp-accent-text">LiteSpeed Turbo &amp; NVMe</span>
              </h1>

              <p class="hero-lead-text mb-4" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                Engineered for ultra-fast load times, 1-click staging, automated core updates, and 24/7 proactive security. Support for 100k+ plugins and high-converting WooCommerce stores.
              </p>

              <!-- Features Pill List -->
              <div class="hero-features-list mb-4 d-flex flex-wrap gap-2" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                <div class="hero-pill-badge">
                  <i class="ri-flashlight-fill text-primary-accent"></i>
                  <span>LiteSpeed Turbo</span>
                </div>
                <div class="hero-pill-badge">
                  <i class="ri-shield-check-fill text-success-accent"></i>
                  <span>Imunify360 AI Shield</span>
                </div>
                <div class="hero-pill-badge">
                  <i class="ri-git-merge-line text-warning"></i>
                  <span>1-Click Staging</span>
                </div>
                <div class="hero-pill-badge">
                  <i class="ri-whatsapp-fill text-success"></i>
                  <span>24/7 Expert Support</span>
                </div>
              </div>

              <!-- Action Bar: Offer CTA Pill & Scroll Button -->
              <div class="hero-action-bar mb-4" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a href="#plans" class="hero-offer-cta">
                  <span class="offer-tag">SPECIAL DEAL</span>
                  <span class="offer-label">
                    <span>Get Started for ₹59/mo</span>
                    <i class="ri-arrow-right-line offer-arrow"></i>
                  </span>
                </a>
                <a href="#plans" class="hero-scroll-btn" title="Explore WordPress Plans" aria-label="Explore WordPress Plans">
                  <i class="ri-arrow-down-line"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: 3D Parallax Illustration with Transparent No-BG Theme PNG -->
        <div class="col-lg-6">
          <InteractiveHeroIllustration 
            image="/assets/images/banner11.png"
            alt="Hostamble High-Performance Managed WordPress Hosting Platform"
            badge1Label="LiteSpeed LSCache"
            badge1Value="10x Faster PHP Speed"
            badge1Icon="ri-flashlight-fill"
            badge2Label="1-Click Staging"
            badge2Value="Instant Clone & Push"
            badge2Tag="MANAGED WP"
            badge2Icon="ri-git-merge-line"
            badge3Label="Imunify360 AI"
            badge3Value="Zero-Day WAF Protected"
            badge3Icon="ri-shield-flash-fill"
            badge4Label="Pure NVMe RAID-10"
            badge4Value="3,500 MB/s Read / Write"
            badge4Icon="ri-hard-drive-2-fill"
          />
        </div>
      </div>

      <!-- Animated Shape Accents -->
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1">
          <img src="/assets/images/shape19.png" alt="Shape Thumb">
        </div>
        <div class="shape-image shape-image-2">
          <img src="/assets/images/shape0501.png" alt="Shape Thumb">
        </div>
        <div class="shape-image shape-image-3">
          <img src="/assets/images/shape1901.png" alt="Shape Thumb">
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       PRICING SECTION: Choose Your Pricing Plan (Top-Priced 4 Durations)
       ========================================================= -->
  <div class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image" id="plans">
    <div class="container-fluid aceorbit-animated-shape px-md-5 px-sm-5">
      <div class="row g-5">
        <div class="col-lg-6 col-md-6">
          <div class="section-title text-start" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Pricing Plan</span>
            <h3 class="title">Choose Your Pricing Plan</h3>
          </div>
        </div>
        <div class="col-lg-6 col-md-6">
          <div class="pricing-billing-duration">
            <ul>
              <li class="nav-item">
                <button
                  class="nav-link active"
                  id="monthly-plan-btn"
                  onclick="switchWpPricing('monthly')"
                  type="button">Monthly</button>
              </li>
              <li class="nav-item">
                <button
                  class="nav-link"
                  id="quarterly-plan-btn"
                  onclick="switchWpPricing('quarterly')"
                  type="button">Quarterly</button>
              </li>
              <li class="nav-item">
                <button
                  class="nav-link"
                  id="semiannual-plan-btn"
                  onclick="switchWpPricing('semiannual')"
                  type="button">Semi-Annual</button>
              </li>
              <li class="nav-item">
                <button
                  class="nav-link"
                  id="annual-plan-btn"
                  onclick="switchWpPricing('annual')"
                  type="button">Annual</button>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="row g-5 mt--20 four-planss">
        <!-- Starter Plan -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="princing-table-two">
            <div class="inner">
              <div class="card-plan-header">
                <h4 class="name">Starter</h4>
                <div class="card-price-top">
                  <div class="monthly-pricing" style="display: block;">
                    <span class="amount" data-inr={plans.starter.pricing.monthly.inr} data-usd={plans.starter.pricing.monthly.usd}>{plans.starter.pricing.monthly.inr}</span>
                    <span class="duration">/Month</span>
                  </div>
                  <div class="quarterly-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.starter.pricing.quarterly.inr} data-usd={plans.starter.pricing.quarterly.usd}>{plans.starter.pricing.quarterly.inr}</span>
                    <span class="duration">/Quarter</span>
                  </div>
                  <div class="semiannual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.starter.pricing.semiannual.inr} data-usd={plans.starter.pricing.semiannual.usd}>{plans.starter.pricing.semiannual.inr}</span>
                    <span class="duration">/6 Months</span>
                  </div>
                  <div class="annual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.starter.pricing.annual.inr} data-usd={plans.starter.pricing.annual.usd}>{plans.starter.pricing.annual.inr}</span>
                    <span class="duration">/Year</span>
                    <span class="free-domain-badge free-domain" style="display: none;">+ Free Domain Included</span>
                  </div>
                </div>
              </div>
              <ul class="list-item">
                <li>1 Domain</li>
                <li>1 SubDomain</li>
                <li>4 GB SSD Storage</li>
                <li>Imunify360 Security</li>
                <li>1 Email Accounts</li>
                <li>Jetbackup 5</li>
                <li>2 MySql</li>
                <li>Free SSL Certificate</li>
              </ul>
              <div class="pricing-btn">
                <a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/wordpresshosting/starter">Buy Now<i class="icon-arrow-right-line-right"></i></a>
              </div>
            </div>
          </div>
        </div>

        <!-- Essential Plan -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="princing-table-two featured-plan">
            <div class="inner">
              <div class="card-plan-header">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <h4 class="name mb-0">Essential</h4>
                  <span class="plan-popular-pill">Most Popular</span>
                </div>
                <div class="card-price-top">
                  <div class="monthly-pricing" style="display: block;">
                    <span class="amount" data-inr={plans.essential.pricing.monthly.inr} data-usd={plans.essential.pricing.monthly.usd}>{plans.essential.pricing.monthly.inr}</span>
                    <span class="duration">/Month</span>
                  </div>
                  <div class="quarterly-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.essential.pricing.quarterly.inr} data-usd={plans.essential.pricing.quarterly.usd}>{plans.essential.pricing.quarterly.inr}</span>
                    <span class="duration">/Quarter</span>
                  </div>
                  <div class="semiannual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.essential.pricing.semiannual.inr} data-usd={plans.essential.pricing.semiannual.usd}>{plans.essential.pricing.semiannual.inr}</span>
                    <span class="duration">/6 Months</span>
                  </div>
                  <div class="annual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.essential.pricing.annual.inr} data-usd={plans.essential.pricing.annual.usd}>{plans.essential.pricing.annual.inr}</span>
                    <span class="duration">/Year</span>
                    <span class="free-domain-badge free-domain" style="display: none;">+ Free Domain Included</span>
                  </div>
                </div>
              </div>
              <ul class="list-item">
                <li>3 Domain</li>
                <li>2 SubDomain</li>
                <li>8 GB SSD Storage</li>
                <li>Imunify360 Security</li>
                <li>2 Email Accounts</li>
                <li>Jetbackup 5</li>
                <li>5 MySql</li>
                <li>Free SSL Certificate</li>
              </ul>
              <div class="pricing-btn">
                <a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/wordpresshosting/essential">Buy Now<i class="icon-arrow-right-line-right"></i></a>
              </div>
            </div>
          </div>
        </div>

        <!-- Growth Plan -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="princing-table-two">
            <div class="inner">
              <div class="card-plan-header">
                <h4 class="name">Growth</h4>
                <div class="card-price-top">
                  <div class="monthly-pricing" style="display: block;">
                    <span class="amount" data-inr={plans.growth.pricing.monthly.inr} data-usd={plans.growth.pricing.monthly.usd}>{plans.growth.pricing.monthly.inr}</span>
                    <span class="duration">/Month</span>
                  </div>
                  <div class="quarterly-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.growth.pricing.quarterly.inr} data-usd={plans.growth.pricing.quarterly.usd}>{plans.growth.pricing.quarterly.inr}</span>
                    <span class="duration">/Quarter</span>
                  </div>
                  <div class="semiannual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.growth.pricing.semiannual.inr} data-usd={plans.growth.pricing.semiannual.usd}>{plans.growth.pricing.semiannual.inr}</span>
                    <span class="duration">/6 Months</span>
                  </div>
                  <div class="annual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.growth.pricing.annual.inr} data-usd={plans.growth.pricing.annual.usd}>{plans.growth.pricing.annual.inr}</span>
                    <span class="duration">/Year</span>
                    <span class="free-domain-badge free-domain" style="display: none;">+ Free Domain Included</span>
                  </div>
                </div>
              </div>
              <ul class="list-item">
                <li>Upto 5 Domain</li>
                <li>3 SubDomain</li>
                <li>15 GB SSD Storage</li>
                <li>Imunify360 Security</li>
                <li>3 Email Accounts</li>
                <li>Jetbackup 5</li>
                <li>10 MySql</li>
                <li>Free SSL Certificate</li>
              </ul>
              <div class="pricing-btn">
                <a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/wordpresshosting/growth">Buy Now<i class="icon-arrow-right-line-right"></i></a>
              </div>
            </div>
          </div>
        </div>

        <!-- Prime Plan -->
        <div class="col-xl-3 col-lg-6 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="princing-table-two">
            <div class="inner">
              <div class="card-plan-header">
                <h4 class="name">Prime</h4>
                <div class="card-price-top">
                  <div class="monthly-pricing" style="display: block;">
                    <span class="amount" data-inr={plans.prime.pricing.monthly.inr} data-usd={plans.prime.pricing.monthly.usd}>{plans.prime.pricing.monthly.inr}</span>
                    <span class="duration">/Month</span>
                  </div>
                  <div class="quarterly-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.prime.pricing.quarterly.inr} data-usd={plans.prime.pricing.quarterly.usd}>{plans.prime.pricing.quarterly.inr}</span>
                    <span class="duration">/Quarter</span>
                  </div>
                  <div class="semiannual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.prime.pricing.semiannual.inr} data-usd={plans.prime.pricing.semiannual.usd}>{plans.prime.pricing.semiannual.inr}</span>
                    <span class="duration">/6 Months</span>
                  </div>
                  <div class="annual-pricing" style="display: none;">
                    <span class="amount" data-inr={plans.prime.pricing.annual.inr} data-usd={plans.prime.pricing.annual.usd}>{plans.prime.pricing.annual.inr}</span>
                    <span class="duration">/Year</span>
                    <span class="free-domain-badge free-domain" style="display: none;">+ Free Domain Included</span>
                  </div>
                </div>
              </div>
              <ul class="list-item">
                <li>10 Domain</li>
                <li>5 SubDomain</li>
                <li>25 GB SSD Storage</li>
                <li>Imunify360 Security</li>
                <li>5 Email Accounts</li>
                <li>Jetbackup 5</li>
                <li>Unlimited MySql</li>
                <li>Free SSL Certificate</li>
              </ul>
              <div class="pricing-btn">
                <a class="ace-btn btn-dark" href="https://hostamble.com/dash/store/wordpresshosting/prime">Buy Now<i class="icon-arrow-right-line-right"></i></a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row mt-4">
        <div class="col-12 text-center">
          <p class="text-muted small mb-0">
            <i class="feather-check-circle text-success me-1"></i> Free Domain registration is included with Annual billing plans. All plans include automated daily backups, 24/7 technical support, and a 30-day money-back guarantee.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       FEATURES: "It Just Works Auto-magically" (Theme-Native 6-Card Grid)
       ========================================================= -->
  <div class="ace-services-area bg-image ace-section-gap border-bottom">
    <div class="container aceorbit-animated-shape">
      <div class="row g-5">
        <div class="col-lg-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">MANAGED AUTOMATION</span>
            <h3 class="title">WordPress Hosting That Just Works — Auto-Magically</h3>
            <p class="description mx-auto mt-2" style="max-width: 680px;">
              No manual server configuration, complex terminal commands, or security headaches. Every technical task is handled automatically under the hood so you can focus on building your business.
            </p>
          </div>
        </div>
      </div>

      <div class="row aceorbit-about-one-service g-4 mt-3 justify-content-center">
        <!-- 1: Auto-Setup -->
        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 h-100">
            <div class="inner">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon m-0">
                  <span><i class="ri-magic-line"></i></span>
                </div>
                <span class="badge bg-light text-primary px-3 py-1 rounded-pill small font-weight-bold">ZERO CONFIG</span>
              </div>
              <div class="content">
                <h6 class="title font-weight-bold">1-Click Auto-Setup</h6>
                <p class="description">
                  Pre-configured with the latest stable WordPress, PHP 8.3, and optimized MariaDB databases. Your website is ready for content within 60 seconds of checkout.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2: Auto-Updates -->
        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 h-100">
            <div class="inner">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon m-0">
                  <span><i class="ri-refresh-line"></i></span>
                </div>
                <span class="badge bg-light text-secondary px-3 py-1 rounded-pill small font-weight-bold">SAFE UPDATES</span>
              </div>
              <div class="content">
                <h6 class="title font-weight-bold">Smart Auto-Updates</h6>
                <p class="description">
                  WordPress core, themes, and plugins update automatically in the background. Automated restore checkpoints ensure immediate rollback if any plugin conflicts arise.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 3: Auto-Caching -->
        <div class="col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 h-100">
            <div class="inner">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="icon m-0">
                  <span><i class="ri-flashlight-line"></i></span>
                </div>
                <span class="badge bg-light text-primary px-3 py-1 rounded-pill small font-weight-bold">10X FASTER</span>
