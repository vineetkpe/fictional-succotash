---
import Layout from '../layouts/Layout.astro';
import { sslCertificates } from '../data/pricing';
const { heroStartPrice, plans } = sslCertificates;
---

<Layout title="SSL Certificates — 256-Bit Encryption & Padlock Security | Hostamble">

  <!-- Block 1: Hero Area -->
  <div class="slider-area banner img2 bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-6 col-md-12">
          <div class="inner">
            <div class="content">
              <span class="pre-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Trusted 256-Bit Encryption • Starts at <span data-inr={heroStartPrice.inr} data-usd={heroStartPrice.usd}>{heroStartPrice.inr}</span>
              </span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                SSL Certificates for Unbreakable Web Security
              </h1>
              <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Protect sensitive customer data, eliminate browser "Not Secure" warnings, and boost Google search rankings with trusted SHA-256 SSL certificates from Sectigo and DigiCert.
              </p>
              <div class="read-more-btn" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a class="ace-btn" href="#ssl-plans">Choose SSL Certificate <i class="icon-arrow-right-line-right"></i></a>
              </div>
              <div class="arrow-sign d-lg-block d-none">
                <img src="/assets/images/arrow.png" alt="Arrow Indicator" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="banner-thumbnail text-center">
            <img class="img-thumb" src="/assets/images/banner02.png" alt="SSL Security Padlock" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
          </div>
        </div>
      </div>
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape19.png" alt="Shape"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0501.png" alt="Shape"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1901.png" alt="Shape"></div>
      </div>
    </div>
  </div>

  <!-- Block 2: SSL Pricing Plans -->
  <div class="ace-pricing-area aceorbit-pricing-plan-page ace-section-gap bg-image" id="ssl-plans">
    <div class="container aceorbit-animated-shape">
      <div class="row g-5 align-items-center mb-4">
        <div class="col-lg-12 text-center">
          <div class="section-title">
            <span class="pre-title">Industry-Standard Security</span>
            <h3 class="title">Choose Your SSL Protection Tier</h3>
            <p class="description max-w-700 mx-auto mt-2">
              All certificates feature 256-bit encryption, 99.9% universal browser compatibility, and free installation assistance by our technical team.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-5 mt--20">
        <!-- SSL Tier 1: PositiveSSL (Single Domain DV) -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="100" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">{plans.positiveSsl.name}</h3>
              <p class="text-muted small">{plans.positiveSsl.subtitle}</p>
              <div class="price-wrap">
                <span class="amount" data-inr={plans.positiveSsl.price.inr} data-usd={plans.positiveSsl.price.usd}>{plans.positiveSsl.price.inr}</span>
                <span class="duration">/year</span>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">Secures 1 Domain (www &amp; non-www)</li>
                <li style="color: #000; font-weight: bold;">256-Bit Industry Encryption</li>
                <li style="color: #000; font-weight: bold;">Issued in Under 10 Minutes</li>
                <li>Domain Validation (No Paperwork)</li>
                <li>99.9% Browser &amp; Mobile Trust</li>
                <li>$10,000 Relying Party Warranty</li>
                <li>Free Unlimited Re-issuances</li>
                <li>Free Installation Assistance</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/ssl-certificates">Order PositiveSSL</a>
            </div>
          </div>
        </div>

        <!-- SSL Tier 2: Wildcard SSL (Recommended) -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
          <div class="pricing-table featured-plan h-100" style="border: 2px solid #ff501a; position: relative;">
            <div class="plan-badge" style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #ff501a; color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 14px; border-radius: 20px; letter-spacing: 0.05em;">Most Popular Value</div>
            <div class="pricing-header">
              <h3 class="title">{plans.wildcardSsl.name}</h3>
              <p class="text-muted small">{plans.wildcardSsl.subtitle}</p>
              <div class="price-wrap">
                <span class="amount" data-inr={plans.wildcardSsl.price.inr} data-usd={plans.wildcardSsl.price.usd}>{plans.wildcardSsl.price.inr}</span>
                <span class="duration">/year</span>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">Secures *.yourdomain.com</li>
                <li style="color: #000; font-weight: bold;">Unlimited Subdomains Included</li>
                <li style="color: #000; font-weight: bold;">256-Bit SHA-2 Encryption</li>
                <li>Issued in 15 Minutes</li>
                <li>99.9% Browser &amp; Mobile Trust</li>
                <li>$250,000 Relying Party Warranty</li>
                <li>Dynamic Sectigo Site Seal Badge</li>
                <li>Ideal for SaaS &amp; Multi-Tenant Apps</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn" href="https://hostamble.com/dash/index.php/store/ssl-certificates">Order Wildcard SSL</a>
            </div>
          </div>
        </div>

        <!-- SSL Tier 3: EV Business SSL -->
        <div class="col-xl-4 col-lg-6 col-md-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
          <div class="pricing-table h-100">
            <div class="pricing-header">
              <h3 class="title">{plans.evSsl.name}</h3>
              <p class="text-muted small">{plans.evSsl.subtitle}</p>
              <div class="price-wrap">
                <span class="amount" data-inr={plans.evSsl.price.inr} data-usd={plans.evSsl.price.usd}>{plans.evSsl.price.inr}</span>
                <span class="duration">/year</span>
              </div>
            </div>
            <div class="pricing-body">
              <ul class="list-item">
                <li style="color: #000; font-weight: bold;">Highest Trust Level Available</li>
                <li style="color: #000; font-weight: bold;">Verified Legal Company Identity</li>
                <li style="color: #000; font-weight: bold;">$1,750,000 Comprehensive Warranty</li>
                <li>Green Address Bar Indicator</li>
                <li>Rigorous Business Vetting (1-3 days)</li>
                <li>PCI-DSS eCommerce Compliance</li>
                <li>Priority Certificate Verification</li>
                <li>Dedicated Enterprise Account Support</li>
              </ul>
            </div>
            <div class="pricing-footer text-center">
              <a class="ace-btn btn-border" href="https://hostamble.com/dash/index.php/store/ssl-certificates">Order EV SSL</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 3: Interactive SSL Comparison Matrix -->
  <div class="ace-section-gap bg-image bg-color-light">
    <div class="container">
      <div class="row align-items-center mb-5">
        <div class="col-lg-12 text-center">
          <div class="section-title">
            <span class="pre-title">Feature Comparison</span>
            <h3 class="title">Compare DV vs Wildcard vs Extended Validation</h3>
          </div>
        </div>
      </div>

      <div class="table-responsive bg-white rounded-3 shadow-sm border p-3">
        <table class="table table-hover align-middle mb-0 text-center">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-start" style="width: 30%;">Certificate Feature</th>
              <th scope="col" style="width: 23%;">PositiveSSL (DV)</th>
              <th scope="col" style="width: 23%; color: #ff501a; font-weight: bold;">Wildcard SSL (DV)</th>
              <th scope="col" style="width: 24%;">EV Business SSL</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="text-start"><strong>Validation Level</strong></td>
              <td>Domain Email Validation</td>
              <td>Domain Email Validation</td>
              <td><span class="text-success font-weight-bold">Full Legal Business Vetting</span></td>
            </tr>
            <tr>
              <td class="text-start"><strong>Subdomains Included</strong></td>
              <td>1 (www &amp; non-www)</td>
              <td><span class="badge bg-success text-white">UNLIMITED (*.domain)</span></td>
              <td>1 Domain (Multi-domain available)</td>
            </tr>
            <tr>
              <td class="text-start"><strong>Issuance Time</strong></td>
              <td>&lt; 10 Minutes</td>
              <td>&lt; 15 Minutes</td>
              <td>1 – 3 Business Days</td>
            </tr>
            <tr>
              <td class="text-start"><strong>Warranty Value</strong></td>
              <td>$10,000 USD</td>
              <td>$250,000 USD</td>
              <td><strong class="text-success">$1,750,000 USD</strong></td>
            </tr>
            <tr>
              <td class="text-start"><strong>Browser Trust Rating</strong></td>
              <td>99.9% Universal</td>
              <td>99.9% Universal</td>
              <td>99.9% Universal</td>
            </tr>
            <tr>
              <td class="text-start"><strong>Best Suited For</strong></td>
              <td>Blogs &amp; Portfolios</td>
              <td>SaaS &amp; Subdomains</td>
              <td>eCommerce &amp; Enterprise</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Block 4: Why SSL is Essential (4 Cards) -->
  <div class="ace-feature-area ace-section-gap bg-image">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Maximum Protection</span>
            <h3 class="title">Why Your Website Needs an SSL Certificate</h3>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6 col-12">
          <div class="p-4 bg-white border rounded-3 text-center shadow-sm h-100">
            <div class="icon mb-3 fs-1 text-success"><i class="ri-google-line"></i></div>
            <h5 class="title font-weight-bold">Google SEO Boost</h5>
            <p class="description small mb-0">Google explicitly ranks HTTPS websites higher in search results than unencrypted HTTP websites.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
          <div class="p-4 bg-white border rounded-3 text-center shadow-sm h-100">
            <div class="icon mb-3 fs-1 text-primary"><i class="ri-shield-keyhole-line"></i></div>
            <h5 class="title font-weight-bold">256-Bit SHA-2 Encryption</h5>
            <p class="description small mb-0">Renders customer credit card numbers, passwords, and form data completely unreadable to hackers.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
          <div class="p-4 bg-white border rounded-3 text-center shadow-sm h-100">
            <div class="icon mb-3 fs-1 text-danger"><i class="ri-error-warning-line"></i></div>
            <h5 class="title font-weight-bold">No "Not Secure" Warnings</h5>
            <p class="description small mb-0">Prevent Google Chrome and Safari from flashing scary red security warnings to your prospective buyers.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
          <div class="p-4 bg-white border rounded-3 text-center shadow-sm h-100">
            <div class="icon mb-3 fs-1 text-warning"><i class="ri-bank-card-line"></i></div>
            <h5 class="title font-weight-bold">PCI-DSS Compliance</h5>
            <p class="description small mb-0">Mandatory requirement for accepting online credit card payments via Razorpay, Stripe, and PayPal.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 5: Free Installation Assistance Banner -->
  <div class="ace-help-area bg-image domain-style-3 ace-section-gap bg-color-primary">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7">
          <div class="inner">
            <div class="section-title text-white text-start">
              <span class="pre-title">100% Free Assisted Setup</span>
              <h3 class="title">Never installed an SSL certificate before?</h3>
              <p class="content">Our server engineers will generate your CSR, complete domain validation, and install your certificate on cPanel, Plesk, Nginx, or Apache with zero extra charges.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="domain-right-content d-block d-sm-flex align-items-center justify-content-start justify-content-lg-end">
            <div class="contact-btn mr--15 mr_sm--0 mb_sm--10">
              <a class="ace-btn btn-white" href="/contacts">Request Free SSL Install <i class="icon-arrow-right-line-right"></i></a>
            </div>
            <div class="contact-info">
              <a href="tel:+916284719083"><i class="icon-Headphone"></i> (+91) 628 471 9083</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 6: SSL FAQs Accordion -->
  <div class="aceorbit-progress ace-service-area ace-section-gap bg-image faq">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Common Inquiries</span>
            <h3 class="title">Frequently Asked Questions About SSL Certificates</h3>
          </div>
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="accordion accordion-flush" id="sslFaqs">
            <div class="accordion-item">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#ssl-faq-1" aria-expanded="true">
                What is the difference between free Let's Encrypt SSL and commercial Sectigo SSL?
              </button>
              <div id="ssl-faq-1" class="accordion-collapse collapse show" data-bs-parent="#sslFaqs">
                <div class="accordion-body">
                  While Let's Encrypt provides basic encryption, commercial Sectigo certificates include substantial warranty protection (up to $1,750,000), support wildcard subdomains on any hosting environment, provide dynamic trust badges, and offer Organization Validation (OV) and Extended Validation (EV) which free automated certificates cannot provide.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ssl-faq-2" aria-expanded="false">
                What is a Wildcard SSL Certificate?
              </button>
              <div id="ssl-faq-2" class="accordion-collapse collapse" data-bs-parent="#sslFaqs">
                <div class="accordion-body">
                  A Wildcard SSL certificate allows you to secure your root domain and an unlimited number of first-level subdomains under one single certificate (e.g. `yourdomain.com`, `app.yourdomain.com`, `shop.yourdomain.com`, `blog.yourdomain.com`).
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ssl-faq-3" aria-expanded="false">
                How fast is an SSL certificate issued?
              </button>
              <div id="ssl-faq-3" class="accordion-collapse collapse" data-bs-parent="#sslFaqs">
                <div class="accordion-body">
                  Domain Validation (DV) certificates like PositiveSSL and Wildcard SSL are issued automatically within 10 to 15 minutes once you complete the simple DNS or email verification check. Extended Validation (EV) requires company registration verification and typically takes 1 to 3 business days.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ssl-faq-4" aria-expanded="false">
                Can I install a Hostamble SSL certificate on third-party hosting?
              </button>
              <div id="ssl-faq-4" class="accordion-collapse collapse" data-bs-parent="#sslFaqs">
                <div class="accordion-body">
                  Yes, our SSL certificates are standard X.509 format and can be installed on any hosting provider, VPS, AWS, Cloudflare, or dedicated server anywhere in the world.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ssl-faq-5" aria-expanded="false">
                Do I need a dedicated IP address to install an SSL certificate?
              </button>
              <div id="ssl-faq-5" class="accordion-collapse collapse" data-bs-parent="#sslFaqs">
                <div class="accordion-body">
                  No, modern web servers use Server Name Indication (SNI), allowing you to install multiple SSL certificates on a shared IP address without any complications.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>
