---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';
---

<Layout 
  title="Transfer Your Domain to Hostamble — Seamless & Zero Downtime | Hostamble"
  description="Transfer your domain to Hostamble easily with zero downtime. Enjoy automatic 1-year renewal extension, free DNS hosting, and 24/7 dedicated support."
  keywords="transfer domain, domain transfer, migrate domain to hostamble, move domain registrar india"
>
<!--first block -->
         
         <div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center  height-800" id="plans">
            <div class="container aceorbit-animated-shape">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <div class="content" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                                
                                
                           <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                              Domain Name Transfer
                           </h1>
                           <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                              Browse our step-by-step guide for domain transfers to ensure a quick and easy transfer. 
                           </p>
                            </div>
                            <div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
                                <form class="input-box text-start" method="post" action="https://hostamble.com/dash/cart.php?a=add&amp;domain=transfer">
                                    
                                    <input type="search" name="sld" class="large-input-box" placeholder="Find Your Ideal Domain Name ...">
                                    <div class="mail-icon">
                                        <i class="icon-Browser"></i>
                                    </div>
                                    <button type="submit" class="ace-btn">Transfer Now<i class="icon-arrow-right-line-right"></i></button>
                                </form>
                            </div>
                            <ul class="select-tlds">
                               {domainPricing.transferTlds.map((tld) => (
                                   <li>
                                       <span class="name">{tld.name}</span>
                                       <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                                       <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                                   </li>
                               ))}
                               <li class="bg-none border-0 p-0 box-shadow-none">
                                   <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                               </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/www.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/www2.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/www3.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/www4.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-5">
                        <img src="/assets/images/www5.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-6">
                        <img src="/assets/images/www6.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>

          <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1">
            <div class="container aceorbit-animated-shape">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Free Services</span>
                            <h3 class="title">FREE Add-ons with every Domain Name!</h3>
                        </div>
                    </div>
                </div>
                <div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">

                    
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-mail-line-2"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Free Whois Protection</h6>
                                    <p class="description">We provide free whois proetct to hide your persoanl details from getting multiple marketing emails and calls.  </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-Browser"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Domain Forwarding</h6>
                                    <p class="description">Point your domain name to another website for free! Redirect users when they type your domain name into a browser (with/without domain masking & SEO) </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-book-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">DNS Management</h6>
                                    <p class="description">Dns Record managemet is paid feature in your domain in order to get record management you have to pay some extra charge.  </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-lock-password-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Domain Theft Protection</h6>
                                    <p class="description">Protect your Domain from being transferred out accidentally or without your permission with our free Domain Theft Protection. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-mail-open-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Free Nameserver Management</h6>
                                    <p class="description"> We provide free nameservers management with every domain to point your domain to any hosting privider or Hostamble itself. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-2 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-Lock"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Easy to use Control Panel</h6>
                                    <p class="description">Use our intuitive Control Panel to manage your domain name, configure email accounts, renew your domain name and buy more services. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-3 text-left shape-bg-1 bg-grey">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="icon-account-circle-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Bulk Tools</h6>
                                    <p class="description">Easy-to-use bulk tools to help you Register, Renew, Transfer and make other changes to several Domain Names in a single step. </p>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape29.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0306.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape0206.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-4">
                        <img src="/assets/images/shape19.png" alt="Shape Thumb">
                    </div>
                </div>
            </div>
        </div>


       



        <HelpCtaBlock />


        
         <div class="aceorbit-progress ace-service-area ace-section-gap bg-image">
            <div class="container aceorbit-animated-shape">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                            <span class="pre-title">Features</span>
                            <h3 class="title">Three Simple Steps To Tranfer Your Domain</h3>
                        </div>
                    </div>
                </div>
                <div class="row g-5 mt--20">
              
                    <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-7 shape-bg-1">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-global-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Enter Your Website Name</h6>
                                    <p class="description">Enter your domain name which you already have registered from any other platform with same domain extention.</p>
                                </div>
                            </div>
                        </div>
                    </div>
               
                    <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-7 shape-bg-2">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-key-2-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Enter Authentication Code</h6>
                                    <p class="description">Unlock Your domain name and enter your correct epp code to initiate domain transfer from your old domain registrar.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="service-card service-card-7 shape-bg-3">
                            <div class="inner">
                                <div class="icon">
                                    <span>
                                        <i class="ri-search-line"></i>
                                    </span>
                                </div>
                                <div class="content">
                                    <h6 class="title">Search on Browser</h6>
                                    <p class="description">After 5 days you will able to manage your domain because transferring domain takes 5 day minimum to get domain.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
                    <div class="shape-image shape-image-1">
                        <img src="/assets/images/shape0702.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-2">
                        <img src="/assets/images/shape0407.png" alt="Shape Thumb">
                    </div>
                    <div class="shape-image shape-image-3">
                        <img src="/assets/images/shape1311.png" alt="Shape Thumb">
                    </div>
                </div>

            </div>
           
        </div>
</Layout>
