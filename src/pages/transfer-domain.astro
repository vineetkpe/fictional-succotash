        </div>
      </div>
      <div class="row aceorbit-about-one-service g-4 mt--20 justify-content-center">

        <!-- Card 1: Free WHOIS Privacy -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-shield-user-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Free WHOIS Privacy</h6>
                <p class="description">Mask your personal name, phone number, physical address, and email from public ICANN databases with zero renewal surcharges.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Free Email Forwarding -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-mail-send-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Email Forwarding</h6>
                <p class="description">Create catch-all email forwarders and route incoming emails to your existing personal Gmail, Outlook, or corporate inbox for free.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3: Anycast Nameserver Management -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-flashlight-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Nameserver Management</h6>
                <p class="description">Get free Anycast DNS nameserver management. Easily route your domain to Shopify, WordPress, cPanel, or any external VPS.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4: Free Domain Forwarding -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-share-forward-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Domain Forwarding</h6>
                <p class="description">Point your domain name to another website for free. Redirect visitors with or without URL masking and preserve search engine signals.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 5: Domain Theft Protection -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-lock-2-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Domain Theft Lock</h6>
                <p class="description">Protect your domain against accidental or unauthorized transfers with free registrar locking and instant email security verification.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 6: Mail Forwards Routing -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-mail-open-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Catch-All Routing</h6>
                <p class="description">Automatically forward all incoming domain alias emails to existing email accounts without managing complex email server infrastructure.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 7: Easy-to-use Control Panel -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-dashboard-3-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Intuitive Control Panel</h6>
                <p class="description">Manage DNS records, configure nameservers, renew domains, and purchase hosting addons from one unified dashboard.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 8: Bulk Domain Management Tools -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-stack-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Bulk Domain Tools</h6>
                <p class="description">Register, renew, transfer, and update DNS records for multiple domain names in a single fast, synchronized bulk workflow.</p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape29.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0306.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape0206.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-4"><img src="/assets/images/shape19.png" alt="Shape Thumb"></div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 5: Cross-Link Banner (New Domain Options)
       ========================================================= -->
  <div class="ace-domain-area domain-overlay-to-another">
    <div class="container domain-style-5 bg-color-primary">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <div class="inner">
            <div class="section-title text-start text-white" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
              <span class="pre-title">LOOKING TO REGISTER A BRAND-NEW DOMAIN?</span>
              <h3 class="title">Explore 500+ Top-Level Domain Extensions</h3>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="cta-btn text-start text-lg-end d-flex flex-wrap gap-3 justify-content-lg-end">
            <a class="ace-btn btn-white" href="/domain-search">Search Domains<i class="icon-arrow-right-line-right ms-2"></i></a>
            <a class="ace-btn" style="background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3); color: #ffffff;" href="/ai-domain-generator"><i class="ri-magic-line me-1"></i> AI Generator</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 6: Concierge Help & Support Block
       ========================================================= -->
  <HelpCtaBlock 
    title="Need help transferring your domain? We're here 24/7."
    description="Have questions about EPP authorization codes, registrar unlocking, or preserving DNS records? Our dedicated technical team in India is ready to assist you directly on WhatsApp and Live Chat with fast, human-first guidance."
  />

  <!-- =========================================================
       BLOCK 7: Frequently Asked Questions (Home Page Unified Design)
       ========================================================= -->
  <section class="hostamble-faq-section" id="faq" aria-labelledby="faq-main-heading">
    <!-- Subtle ambient decorative glow -->
    <div class="faq-ambient-glow" aria-hidden="true"></div>

    <div class="container position-relative">
      <!-- Standard Centered Section Header -->
      <div class="row justify-content-center mb-4">
        <div class="col-lg-8 col-12 text-center">
          <div class="section-title text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
            <span class="pre-title">FAQ</span>
            <h2 id="faq-main-heading" class="title">Frequently Asked Questions</h2>
            <p class="description mt-2">
              Everything you need to know about domain transfers, EPP authorization codes, zero-downtime migrations, and 1-year registration extensions.
            </p>
          </div>
        </div>
      </div>

