---
import Layout from '../layouts/Layout.astro';
import HelpCtaBlock from '../components/HelpCtaBlock.astro';
import { domainPricing } from '../data/pricing';

// ===== High-Intent SEO FAQs for Domain Transfer =====
const transferFaqs = [
  {
    category: "Zero Downtime",
    question: "Will my website or business email experience downtime during the transfer?",
    answer: "No, absolutely not. A domain transfer is strictly an administrative registry record update between registrars. Your existing nameservers, DNS records, website hosting, and active business email routing continue running uninterrupted throughout the entire process. Your visitors and customers will not experience any downtime."
  },
  {
    category: "1-Year Extension",
    question: "Do I lose any remaining registration time when transferring my domain?",
    answer: "Never. According to ICANN regulations, all remaining prepaid days and months on your current domain registration carry over in full to Hostamble. In addition, every standard domain transfer (.com, .net, .org, .in, etc.) includes an automatic 1-year registration renewal extension added to your current expiration date."
  },
  {
    category: "Preparation",
    question: "What do I need to prepare before transferring my domain to Hostamble?",
    answer: "You only need 3 quick steps at your current registrar: (1) Ensure your domain is unlocked (disable Registrar Lock / Transfer Lock). (2) Copy or request your Authorization Code (also known as EPP Code or Transfer Secret). (3) Temporarily disable WHOIS privacy protection if required by your old provider so you can receive the registry authorization email."
  },
  {
    category: "Transfer Time",
    question: "How long does a domain transfer take to complete?",
    answer: "Standard gTLD transfers (such as .com, .net, .org) typically complete in 5 to 7 calendar days. This standard window allows the losing registrar to confirm the transfer with you. Many registrars (including GoDaddy and Namecheap) allow you to manually approve the outgoing transfer in their control panel, which speeds up the transfer to under 30 minutes. Transfers for .in domains usually finalize within 3 to 5 days."
  },
  {
    category: "60-Day Lock Rule",
    question: "Can I transfer a domain that was recently registered or transferred?",
    answer: "Under ICANN regulations, gTLD domains (.com, .net, .org, .biz, .info) are subject to a mandatory 60-day transfer lock following initial registration or a previous registrar transfer. Once 60 days have passed, you are free to transfer your domain to Hostamble anytime. Note that ccTLD extensions such as .in and .co.in may have different registry transfer windows."
  },
  {
    category: "EPP Code",
    question: "What is an EPP authorization code and how do I get it?",
    answer: "An EPP authorization code (also referred to as Auth-Code or Transfer Secret) is a secure, unique passcode generated by your current registrar to verify that only the authentic owner can authorize a domain transfer. You can find it inside your current registrar's domain settings or request it with one click from their domain management console."
  },
  {
    category: "Pricing & Renewals",
    question: "Are there hidden transfer fees or unexpected renewal price increases?",
    answer: "None whatsoever. Hostamble is committed to 100% transparent pricing. What you see is what you pay: our transfer rate covers the migration and includes a full 1-year registration extension. Furthermore, we never lure you with cheap entry rates and then triple your renewal invoice. You can verify renewal prices anytime on our TLD Pricing page."
  },
  {
    category: "WHOIS Privacy",
    question: "Is WHOIS Privacy Protection really 100% free forever on transferred domains?",
    answer: "Yes. While many popular registrars charge between ₹600 and ₹1,200 annually for privacy protection, Hostamble provides free lifetime WHOIS Privacy Protection on all eligible domain extensions. Your personal name, residential address, telephone number, and private email remain shielded from public spammers and telemarketers."
  },
  {
    category: "Expired Domains",
    question: "Can I transfer an expired domain to Hostamble?",
    answer: "Yes, in most cases you can transfer an expired domain as long as it is still within the standard 30-day Grace Period allowed by your current registrar. However, if the domain has entered the Redemption Period, additional registry restore fees may apply. We strongly recommend initiating your domain transfer at least 7 to 10 days before its expiration date to avoid registry complications."
  },
  {
    category: "DNS & Hosting Setup",
    question: "How do I connect my domain to my hosting after the transfer is complete?",
    answer: "Once transferred, your domain is instantly manageable in your Hostamble client area. You can retain your external hosting nameservers (e.g. for Shopify, WordPress.com, Wix, AWS) or switch to Hostamble's high-speed global Anycast DNS. If you have hosting with Hostamble, 1-click DNS templates will automatically connect your domain with zero technical hassle."
  }
];

const transferFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": transferFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout 
  title="Transfer Your Domain to Hostamble — Zero Downtime & 1-Year Extension Included | Hostamble"
  description="Transfer your domain to Hostamble easily with zero downtime. Enjoy automatic 1-year renewal extension, free lifetime WHOIS privacy, Anycast DNS, and direct WhatsApp support."
  keywords="transfer domain, domain transfer, migrate domain to hostamble, move domain registrar india, godaddy transfer, zero downtime domain transfer"
>
  <!-- =========================================================
       BLOCK 1: Hero Transfer Search
       ========================================================= -->
  <div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800" id="plans">
    <div class="container aceorbit-animated-shape">
      <div class="row">
        <div class="col-lg-12">
          <div class="inner text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <div class="content" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
              <span class="pre-title text-primary font-weight-bold letter-spacing-1">ZERO DOWNTIME DOMAIN MIGRATION</span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                Transfer Your Domain Name to Hostamble
              </h1>
              <p class="description max-w-750 mx-auto" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Move your existing domain to Hostamble seamlessly. Keep all your remaining registration time, receive an automatic 1-year extension, and unlock free lifetime WHOIS privacy.
              </p>
            </div>

            <div class="domain-form domain-form-style-1 mt--50 mt_md--30 mt_sm--30 position-relative">
              <form class="input-box text-start" method="post" action="https://hostamble.com/dash/cart.php?a=add&amp;domain=transfer">
                <input type="search" name="sld" class="large-input-box" placeholder="Enter your domain name (e.g. mybusiness.com) ..." required>
                <div class="mail-icon">
                  <i class="icon-Browser"></i>
                </div>
                <button type="submit" class="ace-btn">Transfer Now<i class="icon-arrow-right-line-right"></i></button>
              </form>
            </div>

            <ul class="select-tlds">
              {domainPricing.transferTlds.map((tld) => (
                <li>
                  <span class="name">{tld.name}</span>
                  <span class="original-price prices" data-inr={tld.original.inr} data-usd={tld.original.usd}>{tld.original.inr}</span>
                  <span class="discount-price prices" data-inr={tld.discount.inr} data-usd={tld.discount.usd}>{tld.discount.inr}</span>
                </li>
              ))}
              <li class="bg-none border-0 p-0 box-shadow-none d-flex gap-2 align-items-center">
                <a class="m-auto border-0 ace-btn btn-small" href="/tld-pricing">View All TLDs</a>
                <a class="m-auto border-0 ace-btn btn-small" style="background: #1e293b;" href="/ai-domain-generator"><i class="ri-magic-line me-1"></i> AI Generator</a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/www.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/www2.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/www3.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-4"><img src="/assets/images/www4.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-5"><img src="/assets/images/www5.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-6"><img src="/assets/images/www6.png" alt="Shape Thumb"></div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 2: Three Simple Steps to Transfer Your Domain
       ========================================================= -->
  <div class="aceorbit-progress ace-service-area ace-section-gap bg-image">
    <div class="container aceorbit-animated-shape">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">HOW IT WORKS</span>
            <h3 class="title">Three Simple Steps to Transfer Your Domain</h3>
            <p class="description max-w-750 mx-auto mt-2">
              Our automated transfer engine handles the registry handshake with zero downtime to your live website or email accounts.
            </p>
          </div>
        </div>
      </div>
      <div class="row g-5 mt--20">
        <!-- Step 1 -->
        <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-7 shape-bg-1 h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-global-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">1. Enter Your Domain Name</h6>
                <p class="description">Enter your existing registered domain name in the search bar above to verify live transfer eligibility with registry databases.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-7 shape-bg-2 h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-key-2-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">2. Enter EPP Auth Code</h6>
                <p class="description">Unlock your domain at your current registrar and provide your unique EPP authorization code to verify ownership and authorize transfer.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-7 shape-bg-3 h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-checkbox-circle-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">3. Zero-Downtime Activation</h6>
                <p class="description">We complete the registry handover with zero downtime. Keep all remaining days on your domain plus receive an automatic 1-year extension.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape0702.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0407.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1311.png" alt="Shape Thumb"></div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 3 (NEW BLOCK): The Hostamble Transfer Advantage
       ========================================================= -->
  <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
    <div class="container aceorbit-animated-shape">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8 col-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">THE HOSTAMBLE ADVANTAGE</span>
            <h3 class="title">Why Thousands of Domains Move to Hostamble</h3>
            <p class="description max-w-750 mx-auto mt-2">
              Say goodbye to deceptive renewal rate spikes, paid WHOIS privacy addons, and frustrating chatbot loops. Enjoy genuine registrar peace of mind.
            </p>
          </div>
        </div>
      </div>

      <div class="row aceorbit-about-one-service g-4 mt--20 justify-content-center">
        <!-- Pillar 1: Zero Service Downtime -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-shield-flash-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Zero Service Downtime</h6>
                <p class="description">Your website, active DNS records, and business email accounts stay 100% online throughout the entire registry migration process.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Pillar 2: 1-Year Extension Included -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-calendar-check-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">1-Year Extension Included</h6>
                <p class="description">Keep every single remaining day of your current registration, plus receive an automatic 365-day extension upon successful transfer.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Pillar 3: Free Lifetime WHOIS Privacy -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-user-secret-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Free WHOIS Privacy Forever</h6>
                <p class="description">We shield your personal name, phone number, and residential address from marketing spammers and aggregators at ₹0/year forever.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Pillar 4: Transparent Wholesale Renewals -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner">
              <div class="icon">
                <span>
                  <i class="ri-price-tag-3-line"></i>
                </span>
              </div>
              <div class="content">
                <h6 class="title">Transparent Wholesale Renewals</h6>
                <p class="description">No sudden 300% renewal rate hikes. Hostamble guarantees honest, flat renewal rates for every TLD in our registry catalog.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape32.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0308.png" alt="Shape Thumb"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape2701.png" alt="Shape Thumb"></div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 4: Free Included Tools & Services (Balanced 8-Card Grid)
       ========================================================= -->
  <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
    <div class="container aceorbit-animated-shape">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Free Services</span>
            <h3 class="title">FREE Add-ons Included with Every Domain Transfer!</h3>
            <p class="description max-w-750 mx-auto mt-2">
              Every domain migrated to Hostamble receives our complete suite of enterprise DNS, forwarding, and security tools at no extra fee.
