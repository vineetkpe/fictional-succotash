</style>

<script is:inline>
  (function () {
    /* ════════════════════════════════════════════════════════════════
       FAQ Accordion Toggle Handler
       ════════════════════════════════════════════════════════════════ */
    function initFaqAccordion() {
      const cards = document.querySelectorAll("#faqCardsStack .faq-item-card");
      cards.forEach(card => {
        const trigger = card.querySelector(".faq-header-trigger");
        const collapse = card.querySelector(".faq-answer-collapse");
        if (!trigger || !collapse) return;

        trigger.addEventListener("click", () => {
          const isOpen = card.classList.contains("is-open");

          // Close all cards
          cards.forEach(otherCard => {
            otherCard.classList.remove("is-open");
            const otherTrigger = otherCard.querySelector(".faq-header-trigger");
            const otherCollapse = otherCard.querySelector(".faq-answer-collapse");
            if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
            if (otherCollapse) otherCollapse.style.display = "none";
          });

          // Toggle current
          if (!isOpen) {
            card.classList.add("is-open");
            trigger.setAttribute("aria-expanded", "true");
            collapse.style.display = "block";
          }
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFaqAccordion);
    } else {
      initFaqAccordion();
    }
  })();
</script>
