<style>
  /* =========================================================
     Hostamble FAQ Section - Authentic Theme Styling
     ========================================================= */
  .hostamble-faq-section {
    position: relative;
    background-color: #fafbfc;
    padding: 90px 0 100px 0;
    overflow: hidden;
  }

  .faq-ambient-glow {
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 500px;
    background: radial-gradient(circle, rgba(255, 80, 26, 0.04) 0%, rgba(250, 251, 252, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Centered Accordion Stack */
  .faq-accordion-container {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Accordion Item Card - Subtle curves (6px) */
  .faq-item-card {
    background: #ffffff;
    border: 1px solid #e8edf5;
    border-radius: 6px;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .faq-item-card:hover {
    border-color: rgba(255, 80, 26, 0.35);
    box-shadow: 0 6px 20px -8px rgba(255, 80, 26, 0.12);
    transform: translateY(-1px);
  }

  .faq-item-card.is-open {
    border-color: rgba(255, 80, 26, 0.38);
    box-shadow: 0 10px 28px -10px rgba(255, 80, 26, 0.14);
    background: #ffffff;
  }

  /* Header Trigger */
  .faq-header-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 24px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
  }

  .faq-question-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
    min-width: 0;
  }

  .faq-cat-label {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #8c97a8;
    transition: color 0.2s ease;
  }

  .faq-item-card.is-open .faq-cat-label {
    color: #ff501a;
  }

  .faq-question-text {
    margin: 0;
    font-size: 17.5px;
    font-weight: 700;
    line-height: 1.35;
    color: #17181c;
    transition: color 0.2s ease;
  }

  .faq-header-trigger:hover .faq-question-text {
    color: #ff501a;
  }

  .faq-item-card.is-open .faq-question-text {
    color: #ff501a;
  }

  /* Plus / Minus Toggle Pod */
  .faq-toggle-icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: #f4f6fa;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.22s ease;
    font-size: 18px;
  }

  .faq-toggle-icon .icon-minus {
    display: none;
  }

  .faq-header-trigger:hover .faq-toggle-icon {
    background: #fff0eb;
    color: #ff501a;
  }

  .faq-item-card.is-open .faq-toggle-icon {
    background: #ff501a;
    color: #ffffff;
  }

  .faq-item-card.is-open .faq-toggle-icon .icon-plus {
    display: none;
  }

  .faq-item-card.is-open .faq-toggle-icon .icon-minus {
    display: block;
  }

  /* Answer Collapse */
  .faq-answer-collapse {
