---
import Layout from '../layouts/Layout.astro';
import { domainPricing } from '../data/pricing';
const { heroStartPrice, allTlds } = domainPricing;
---

<Layout title="Domain TLD Pricing List — Register, Transfer & Renew | Hostamble">

  <!-- Block 1: Hero Area -->
  <div class="slider-area banner img2 bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7 col-md-12">
          <div class="inner">
            <div class="content">
              <span class="pre-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Transparent Pricing • Free Privacy Protection • Starts at <span data-inr={heroStartPrice.inr} data-usd={heroStartPrice.usd}>{heroStartPrice.inr}</span>
              </span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                Complete Domain TLD Pricing List
              </h1>
              <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Compare registration, renewal, and transfer rates across popular top-level domain extensions. Free DNS management, email forwarding, and privacy protection included with every domain.
              </p>
              <div class="mt-4" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a class="ace-btn" href="#tld-table">View All TLD Prices <i class="icon-arrow-right-line-right"></i></a>
                <a class="ace-btn btn-border ml--15" href="/domain-search">Domain Search</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="banner-thumbnail text-center">
            <img class="img-thumb" src="/assets/images/banner01.png" alt="Domain TLD Search" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
          </div>
        </div>
      </div>
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape19.png" alt="Shape"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0501.png" alt="Shape"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1901.png" alt="Shape"></div>
      </div>
    </div>
  </div>

  <!-- Block 2: Interactive Searchable TLD Table -->
  <div class="ace-section-gap bg-image" id="tld-table">
    <div class="container aceorbit-animated-shape">
      <div class="row align-items-center mb-4">
        <div class="col-lg-6 col-md-12 mb-3 mb-lg-0">
          <div class="section-title text-start">
            <span class="pre-title">Live Rate Card</span>
            <h3 class="title">All Domain Extensions &amp; Rates</h3>
          </div>
        </div>
        <div class="col-lg-6 col-md-12">
          <div class="d-flex align-items-center justify-content-lg-end gap-2">
            <div class="input-group" style="max-width: 320px;">
              <span class="input-group-text bg-white border-end-0"><i class="ri-search-line text-muted"></i></span>
              <input 
                type="text" 
                id="tldFilterInput" 
                class="form-control border-start-0 ps-0" 
                placeholder="Filter TLD e.g. .com, .in, tech..." 
                onkeyup="filterTldTable()"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Filter Category Buttons -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="d-flex flex-wrap gap-2" id="tldCategoryPills">
            <button type="button" class="btn btn-sm btn-dark px-3 py-2 rounded-pill tld-cat-btn active" onclick="filterTldCategory('all', this)">All Extensions</button>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill tld-cat-btn" onclick="filterTldCategory('popular', this)">🔥 Popular</button>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill tld-cat-btn" onclick="filterTldCategory('india', this)">🇮🇳 India (.IN)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill tld-cat-btn" onclick="filterTldCategory('tech', this)">💻 Tech &amp; Dev</button>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill tld-cat-btn" onclick="filterTldCategory('business', this)">🏢 Business &amp; Commerce</button>
          </div>
        </div>
      </div>

      <!-- TLD Table -->
      <div class="table-responsive bg-white rounded-3 shadow-sm border p-3">
        <table class="table table-hover align-middle mb-0" id="domainTldPricingTable">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 22%;">Domain TLD</th>
              <th scope="col" style="width: 18%;">Category</th>
              <th scope="col" style="width: 20%;">Register (1st Year)</th>
              <th scope="col" style="width: 20%;">Renew (Annual)</th>
              <th scope="col" style="width: 20%;">Transfer</th>
              <th scope="col" class="text-end" style="width: 15%;">Action</th>
            </tr>
          </thead>
          <tbody id="tldTableBody">
            {allTlds.map((item) => (
              <tr data-tld={item.tld} data-category={item.category}>
                <td>
                  <strong class="text-dark fs-6">{item.tld}</strong>
                  {item.badge && (
                    <span class={`badge ${item.badge === 'Hot' ? 'bg-danger' : item.badge === 'India' ? 'bg-primary' : item.badge === 'Startup' ? 'bg-warning text-dark' : 'bg-info'} text-white ms-1`}>
                      {item.badge}
                    </span>
                  )}
                </td>
                <td><span class="badge bg-light text-dark text-capitalize">{item.category}</span></td>
                <td>
                  <span class="text-success font-weight-bold" data-inr={item.register.inr} data-usd={item.register.usd}>{item.register.inr}</span>
                  {item.originalRegister && (
                    <del class="text-muted small ms-1" data-inr={item.originalRegister.inr} data-usd={item.originalRegister.usd}>{item.originalRegister.inr}</del>
                  )}
                </td>
                <td><span data-inr={item.renew.inr} data-usd={item.renew.usd}>{item.renew.inr}</span></td>
                <td><span data-inr={item.transfer.inr} data-usd={item.transfer.usd}>{item.transfer.inr}</span></td>
                <td class="text-end"><a class="ace-btn btn-small" href="/domain-search">Register</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Block 3: Included Free With Every Domain (4 Cards) -->
  <div class="ace-feature-area ace-section-gap bg-image bg-color-light">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Zero Hidden Fees</span>
            <h3 class="title">Everything Included Free with Your Domain</h3>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100 p-4 bg-white border rounded-3 text-center">
            <div class="icon mb-3 fs-1 text-primary"><i class="ri-shield-user-line"></i></div>
            <h5 class="title font-weight-bold">Free WHOIS Privacy</h5>
            <p class="description small mb-0">Mask your personal phone number, home address, and email from public spam harvesters at no extra cost.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100 p-4 bg-white border rounded-3 text-center">
            <div class="icon mb-3 fs-1 text-success"><i class="ri-global-line"></i></div>
            <h5 class="title font-weight-bold">Anycast DNS Manager</h5>
            <p class="description small mb-0">Instant DNS record changes for A, CNAME, MX, TXT, and SPF records backed by globally distributed Anycast nameservers.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-1 h-100 p-4 bg-white border rounded-3 text-center">
            <div class="icon mb-3 fs-1 text-warning"><i class="ri-mail-forward-line"></i></div>
            <h5 class="title font-weight-bold">2 Free Email Accounts</h5>
            <p class="description small mb-0">Create custom branded email forwarders (e.g. `hello@yourdomain.com`) routed straight to your existing personal inbox.</p>
          </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
          <div class="service-card service-card-3 shape-bg-2 h-100 p-4 bg-white border rounded-3 text-center">
            <div class="icon mb-3 fs-1 text-danger"><i class="ri-lock-2-line"></i></div>
            <h5 class="title font-weight-bold">Domain Theft Lock</h5>
            <p class="description small mb-0">Prevent unauthorized domain hijacking or accidental transfer with automated registrar-level security locking.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 1: High-Impact TLD Spotlight & Use Cases -->
  <div class="ace-section-gap bg-image" style="background: #0d0d12; color: #fff;">
    <div class="container">
      <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start mb-4">
            <span class="pre-title" style="color: #ff501a;">Strategic Branding</span>
            <h3 class="title text-white">Find the Exact Extension That Defines Your Mission</h3>
            <p class="description text-muted">
              Your domain extension is your brand's first impression. Modern founders pick niche TLDs to signal innovation, sector authority, and instant credibility.
            </p>
          </div>

          <div class="row g-3">
            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary h-100" style="background: rgba(255,255,255,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fs-4 font-weight-bold text-danger">.ai</span>
                  <span class="badge bg-danger">Trending</span>
                </div>
                <h6 class="text-white mb-1">Artificial Intelligence</h6>
                <p class="small text-muted mb-0">The universal badge of innovation for LLM agents, robotics, and tech pioneers.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary h-100" style="background: rgba(255,255,255,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fs-4 font-weight-bold text-info">.io</span>
                  <span class="badge bg-info text-dark">Developer</span>
                </div>
                <h6 class="text-white mb-1">Tech &amp; SaaS Platforms</h6>
                <p class="small text-muted mb-0">Short, memorable, and globally embraced by developers and digital startups.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary h-100" style="background: rgba(255,255,255,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fs-4 font-weight-bold text-success">.in</span>
                  <span class="badge bg-success">National</span>
                </div>
                <h6 class="text-white mb-1">India Digital Economy</h6>
                <p class="small text-muted mb-0">Rank higher locally in Indian search results and build deep local trust with 1.4B consumers.</p>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="p-3 rounded-3 border border-secondary h-100" style="background: rgba(255,255,255,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="fs-4 font-weight-bold text-warning">.store</span>
                  <span class="badge bg-warning text-dark">E-Commerce</span>
                </div>
                <h6 class="text-white mb-1">D2C &amp; Online Retail</h6>
                <p class="small text-muted mb-0">Tell shoppers exactly what you do. Boost sales conversion for Shopify &amp; WooCommerce.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6 text-center" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="position-relative">
            <img src="/assets/images/tld-domains-showcase.jpg" alt="Hostamble Domain Registration Hub" class="img-fluid rounded-4 shadow-lg border border-secondary" style="max-height: 440px; object-fit: cover; width: 100%;" />
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 bg-dark rounded-pill border border-danger text-white small" style="white-space: nowrap;">
              <i class="ri-check-double-line text-danger me-1"></i> Official ICANN Accredited Domain Partner
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 2: Renewal Price-Lock Transparency & No Hidden Fees Guarantee -->
  <div class="ace-section-gap bg-image">
    <div class="container">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">100% Transparent</span>
            <h3 class="title">Zero Renewal Bait-and-Switch Guarantees</h3>
            <p class="description max-w-700 mx-auto mt-2">
              Unlike legacy registrars who lure you in with ₹99 introductory rates and then silently charge ₹2,999 on renewal, Hostamble commits to clear, upfront, honest pricing for life.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-3 col-md-6" data-sal-delay="100" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white border rounded-3 shadow-sm text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-lock-unlock-line"></i></div>
            <h5 class="mb-2 font-weight-bold">No Transfer-Out Lock</h5>
            <p class="small text-muted mb-0">You own your domain outright. Generate your EPP auth code anytime directly from the dashboard with zero lock-in penalties.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white border rounded-3 shadow-sm text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-price-tag-3-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Clear Renewal Table</h5>
            <p class="small text-muted mb-0">Our full renewal rates are published in plain sight in our TLD directory before you purchase. No surprise credit card renewals.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white border rounded-3 shadow-sm text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-user-unfollow-line"></i></div>
            <h5 class="mb-2 font-weight-bold">Free WHOIS Forever</h5>
            <p class="small text-muted mb-0">We never charge for privacy in Year 2. Your contact details remain shielded from scrapers, spam bots, and unsolicited cold calls.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 bg-white border rounded-3 shadow-sm text-center h-100">
            <div class="mb-3 text-danger fs-1"><i class="ri-coupon-3-line"></i></div>
            <h5 class="mb-2 font-weight-bold">No Hidden ICANN Fees</h5>
            <p class="small text-muted mb-0">Every mandatory registry fee and ICANN fee is completely included in the quoted checkout price. What you see is what you pay.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Block 3: The $45+ Free Domain Extras Value Stack -->
  <div class="ace-section-gap bg-image" style="background: #f8f9fa;">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-5" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start">
            <span class="pre-title">Included Free of Charge</span>
            <h3 class="title">Over $45 Worth of Complimentary Tools with Every Domain</h3>
            <p class="description">
              Other registrars charge extra fees for basic features. At Hostamble, we include enterprise-grade security and DNS management tools with every single registered domain.
            </p>
            <div class="mt-4">
              <a href="#tld-table" class="ace-btn">Register Your Domain Today</a>
            </div>
          </div>
        </div>

        <div class="col-lg-7" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border">
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
              <div>
                <h6 class="mb-0 font-weight-bold">Enterprise Anycast DNS Hosting</h6>
                <small class="text-muted">High-availability global DNS cluster</small>
              </div>
              <div>
                <span class="text-muted text-decoration-line-through me-2">$10/yr</span>
                <span class="badge bg-success text-white">FREE</span>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
              <div>
                <h6 class="mb-0 font-weight-bold">WHOIS Privacy Masking</h6>
                <small class="text-muted">Guards your identity against scrapers</small>
              </div>
              <div>
                <span class="text-muted text-decoration-line-through me-2">$12/yr</span>
                <span class="badge bg-success text-white">FREE</span>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
              <div>
                <h6 class="mb-0 font-weight-bold">Registrar-Lock Theft Shield</h6>
                <small class="text-muted">Blocks unauthorized transfer attempts</small>
              </div>
              <div>
                <span class="text-muted text-decoration-line-through me-2">$15/yr</span>
                <span class="badge bg-success text-white">FREE</span>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3">
              <div>
                <h6 class="mb-0 font-weight-bold">Email &amp; URL Forwarding</h6>
                <small class="text-muted">Route branded emails to Gmail or Outlook</small>
              </div>
              <div>
                <span class="text-muted text-decoration-line-through me-2">$8/yr</span>
                <span class="badge bg-success text-white">FREE</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 4: Domain Lifecycle & Easy 3-Step Process -->
  <div class="ace-section-gap bg-image">
    <div class="container">
      <div class="row text-center mb-5">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Simple Steps</span>
            <h3 class="title">How to Register or Transfer Your Domain</h3>
          </div>
        </div>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6 col-12 text-center">
          <div class="p-4 bg-white rounded-3 border shadow-sm h-100">
            <div class="step-num bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; font-weight: bold; font-size: 20px;">1</div>
            <h5 class="font-weight-bold">Search Domain Name</h5>
            <p class="text-muted small">Type your desired brand or business name into our real-time search engine to verify instant availability.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12 text-center">
          <div class="p-4 bg-white rounded-3 border shadow-sm h-100">
            <div class="step-num bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; font-weight: bold; font-size: 20px;">2</div>
            <h5 class="font-weight-bold">Select TLD &amp; Configure</h5>
            <p class="text-muted small">Choose your extension (.com, .in, etc.) and add free DNS management and WHOIS privacy with a single click.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12 text-center">
          <div class="p-4 bg-white rounded-3 border shadow-sm h-100">
            <div class="step-num bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; font-weight: bold; font-size: 20px;">3</div>
            <h5 class="font-weight-bold">Instant Activation</h5>
            <p class="text-muted small">Complete checkout with secure Indian UPI, cards, or international payment methods. Your domain is active in minutes.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 5: Transfer Domain Help Banner -->
  <div class="ace-help-area bg-image domain-style-3 ace-section-gap bg-color-primary">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7">
          <div class="inner">
            <div class="section-title text-white text-start">
              <span class="pre-title">Transfer &amp; Save</span>
              <h3 class="title">Have domains registered elsewhere?</h3>
              <p class="content">Consolidate your domains with Hostamble and save up to 40% on annual renewal rates with zero interruption to your website or business email.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="domain-right-content d-block d-sm-flex align-items-center justify-content-start justify-content-lg-end">
            <div class="contact-btn mr--15 mr_sm--0 mb_sm--10">
              <a class="ace-btn btn-white" href="/transfer-domain">Transfer Domain Now <i class="icon-arrow-right-line-right"></i></a>
            </div>
            <div class="contact-info">
              <a href="/contacts"><i class="icon-Headphone"></i> Help Desk</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 6: Domain FAQs Accordion -->
  <div class="aceorbit-progress ace-service-area ace-section-gap bg-image faq">
    <div class="container aceorbit-animated-shape">
      <div class="row mb-5 text-center">
        <div class="col-lg-12">
          <div class="section-title">
            <span class="pre-title">Got Questions?</span>
            <h3 class="title">Frequently Asked Questions About Domain Pricing</h3>
          </div>
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="accordion accordion-flush" id="tldFaqs">
            <div class="accordion-item">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#tld-faq-1" aria-expanded="true">
                Are there any hidden fees or ICANN charges added at checkout?
              </button>
              <div id="tld-faq-1" class="accordion-collapse collapse show" data-bs-parent="#tldFaqs">
                <div class="accordion-body">
                  No. Hostamble practices transparent pricing. The price you see includes all mandatory registry fees and standard ICANN fees. What you see is what you pay.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tld-faq-2" aria-expanded="false">
                Is WHOIS domain privacy protection really free?
              </button>
              <div id="tld-faq-2" class="accordion-collapse collapse" data-bs-parent="#tldFaqs">
                <div class="accordion-body">
                  Yes, WHOIS privacy protection is 100% free forever for all eligible TLDs (.com, .net, .org, .co, etc.) where registry regulations allow privacy masking.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tld-faq-3" aria-expanded="false">
                How does transferring a domain to Hostamble work?
              </button>
              <div id="tld-faq-3" class="accordion-collapse collapse" data-bs-parent="#tldFaqs">
