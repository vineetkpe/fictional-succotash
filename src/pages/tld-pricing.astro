---
import Layout from '../layouts/Layout.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { domainPricing } from '../data/pricing';
const { heroStartPrice, allTlds } = domainPricing;

const tldFaqs = [
  {
    category: "Pricing & Fees",
    question: "Are there any hidden fees or ICANN charges added at checkout?",
    answer: "No. Hostamble practices 100% transparent pricing. The price you see includes all mandatory registry fees and standard ICANN charges. What you see is the exact amount you pay at checkout."
  },
  {
    category: "Privacy Protection",
    question: "Is WHOIS domain privacy protection really free forever?",
    answer: "Yes, WHOIS privacy protection is 100% free forever for all eligible TLDs (.com, .net, .org, .co, etc.) where registry regulations allow privacy masking. We never introduce surprise privacy renewal fees in Year 2."
  },
  {
    category: "Transfers",
    question: "How does transferring a domain to Hostamble work?",
    answer: "Simply unlock your domain at your current registrar, obtain the EPP/Auth code, and submit the transfer request on our Domain Transfer page. Most transfers include an additional 1-year registration extension with zero website downtime."
  },
  {
    category: "Hosting & Setup",
    question: "Can I register a domain without purchasing web hosting?",
    answer: "Yes! You can register and hold domains independently. You get full access to our free Anycast DNS Manager, URL forwarding, and custom email forwarding controls anytime."
  },
  {
    category: "Payment Methods",
    question: "What payment methods are supported for domain purchases?",
    answer: "We accept UPI (Google Pay, PhonePe, Paytm), Indian Netbanking, Debit & Credit Cards, International Visa/Mastercard/Amex, and PayPal."
  }
];
---

<Layout 
  title="Domain TLD Pricing List — Register, Transfer & Renew Cheap Domains | Hostamble"
  description="Compare transparent domain registration, renewal, and transfer pricing across all major TLDs (.com, .in, .org, .net, .shop, .online) at Hostamble."
  keywords="domain tld pricing, cheap domain registration, domain renewal cost, domain transfer rates, buy com domain india"
>

  <!-- Block 1: Hero Area -->
  <div class="slider-area banner img2 bg-image d-flex align-items-center">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7 col-md-12">
          <div class="inner">
            <div class="content">
              <span class="pre-title" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                Transparent Pricing • Free Privacy Protection • Starts at <span data-inr={heroStartPrice.inr} data-usd={heroStartPrice.usd}>{heroStartPrice.inr}</span>
              </span>
              <h1 class="title" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
                Complete Domain TLD Pricing List
              </h1>
              <p class="description" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
                Compare registration, renewal, and transfer rates across popular top-level domain extensions. Free DNS management, email forwarding, and privacy protection included with every domain.
              </p>
              <div class="mt-4" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
                <a class="ace-btn" href="#tld-table">View All TLD Prices <i class="icon-arrow-right-line-right"></i></a>
                <a class="ace-btn btn-border ml--15" href="/domain-search">Domain Search</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="banner-thumbnail text-center">
            <img class="img-thumb" src="/assets/images/banner01.png" alt="Domain TLD Search" data-sal-delay="150" data-sal="fade" data-sal-duration="800">
          </div>
        </div>
      </div>
      <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
        <div class="shape-image shape-image-1"><img src="/assets/images/shape19.png" alt="Shape"></div>
        <div class="shape-image shape-image-2"><img src="/assets/images/shape0501.png" alt="Shape"></div>
        <div class="shape-image shape-image-3"><img src="/assets/images/shape1901.png" alt="Shape"></div>
      </div>
    </div>
  </div>

  <!-- Block 2: Interactive Searchable TLD Table -->
  <div class="ace-section-gap bg-image" id="tld-table">
    <div class="container aceorbit-animated-shape">
      <div class="row align-items-center mb-4">
        <div class="col-lg-6 col-md-12 mb-3 mb-lg-0">
          <div class="section-title text-start">
            <span class="pre-title">Live Rate Card</span>
            <h3 class="title">All Domain Extensions &amp; Rates</h3>
          </div>
        </div>
        <div class="col-lg-6 col-md-12">
          <div class="d-flex align-items-center justify-content-lg-end gap-2">
            <div class="input-group" style="max-width: 320px;">
              <span class="input-group-text bg-white border-end-0"><i class="ri-search-line text-muted"></i></span>
              <input 
                type="text" 
                id="tldFilterInput" 
                class="form-control border-start-0 ps-0" 
                placeholder="Filter TLD e.g. .com, .in, tech..." 
                onkeyup="filterTldTable()"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Filter Category Navigation Pills (Theme Unified) -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="faq-categories-nav justify-content-start my-2" id="tldCategoryPills" style="display: flex; flex-wrap: wrap; gap: 8px;">
            <button type="button" class="faq-cat-pill tld-cat-btn active" onclick="filterTldCategory('all', this)"><span>All Extensions</span></button>
            <button type="button" class="faq-cat-pill tld-cat-btn" onclick="filterTldCategory('popular', this)"><span>Popular</span></button>
            <button type="button" class="faq-cat-pill tld-cat-btn" onclick="filterTldCategory('india', this)"><span>India (.IN)</span></button>
            <button type="button" class="faq-cat-pill tld-cat-btn" onclick="filterTldCategory('tech', this)"><span>Tech &amp; Dev</span></button>
            <button type="button" class="faq-cat-pill tld-cat-btn" onclick="filterTldCategory('business', this)"><span>Business &amp; Commerce</span></button>
          </div>
        </div>
      </div>

      <!-- TLD Table -->
      <div class="table-responsive bg-white rounded-3 shadow-sm border p-3">
        <table class="table table-hover align-middle mb-0" id="domainTldPricingTable">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 22%;">Domain TLD</th>
              <th scope="col" style="width: 18%;">Category</th>
              <th scope="col" style="width: 20%;">Register (1st Year)</th>
              <th scope="col" style="width: 20%;">Renew (Annual)</th>
              <th scope="col" style="width: 20%;">Transfer</th>
              <th scope="col" class="text-end" style="width: 15%;">Action</th>
            </tr>
          </thead>
          <tbody id="tldTableBody">
            {allTlds.map((item) => (
              <tr data-tld={item.tld} data-category={item.category}>
                <td>
                  <strong class="text-dark fs-6">{item.tld}</strong>
                  {item.badge && (
                    <span class={`badge ${item.badge === 'Hot' ? 'bg-danger' : item.badge === 'India' ? 'bg-primary' : item.badge === 'Startup' ? 'bg-warning text-dark' : 'bg-info'} text-white ms-1`}>
                      {item.badge}
                    </span>
                  )}
                </td>
                <td><span class="badge bg-light text-dark text-capitalize">{item.category}</span></td>
                <td>
                  <span class="text-success font-weight-bold" data-inr={item.register.inr} data-usd={item.register.usd}>{item.register.inr}</span>
                  {item.originalRegister && (
                    <del class="text-muted small ms-1" data-inr={item.originalRegister.inr} data-usd={item.originalRegister.usd}>{item.originalRegister.inr}</del>
                  )}
                </td>
                <td><span data-inr={item.renew.inr} data-usd={item.renew.usd}>{item.renew.inr}</span></td>
                <td><span data-inr={item.transfer.inr} data-usd={item.transfer.usd}>{item.transfer.inr}</span></td>
                <td class="text-end"><a class="ace-btn btn-small" href="/domain-search">Register</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 3: Strategic Branding (Top TLD Extensions Spotlight)
       ========================================================= -->
  <div class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1 bottom-overlays">
    <div class="container aceorbit-animated-shape position-relative" style="z-index: 2;">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8 col-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Strategic Branding</span>
            <h3 class="title">Find the Exact Extension That Defines Your Mission</h3>
            <p class="description max-w-750 mx-auto mt-2">
              Your domain extension is your brand's digital identity. Choose an extension tailored for commercial authority, tech innovation, and search visibility.
            </p>
          </div>
        </div>
      </div>

      <div class="row aceorbit-about-one-service g-4 mt--20 justify-content-center">
        <!-- Card 1: .com -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner d-flex flex-column h-100 justify-content-between">
              <div>
                <div class="icon">
                  <span><i class="ri-global-line"></i></span>
                </div>
                <div class="content">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="title mb-0">.com Domain</h6>
                    <span class="badge-theme-tld">Universal</span>
                  </div>
                  <p class="description">The worldwide gold standard of digital credibility. High recall for global startups and enterprises.</p>
                </div>
              </div>
              <div class="tld-card-pricing-row pt-3 border-top mt-auto d-flex align-items-center justify-content-between">
                <div>
                  <span class="tld-price-val prices" data-inr="₹999" data-usd="$11.99">₹999</span>
                  <span class="tld-price-unit d-block text-muted">/1st Year</span>
                </div>
                <a href="/domain-search" class="ace-btn btn-small">Register</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: .in -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner d-flex flex-column h-100 justify-content-between">
              <div>
                <div class="icon">
                  <span><i class="ri-map-pin-user-line"></i></span>
                </div>
                <div class="content">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="title mb-0">.in Domain</h6>
                    <span class="badge-theme-tld">India SEO</span>
                  </div>
                  <p class="description">Rank higher on Google India (google.co.in) and build direct localized trust with 1.4B Indian consumers.</p>
                </div>
              </div>
              <div class="tld-card-pricing-row pt-3 border-top mt-auto d-flex align-items-center justify-content-between">
                <div>
                  <span class="tld-price-val prices" data-inr="₹499" data-usd="$5.99">₹499</span>
                  <span class="tld-price-unit d-block text-muted">/1st Year</span>
                </div>
                <a href="/domain-search" class="ace-btn btn-small">Register</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3: .ai -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
            <div class="inner d-flex flex-column h-100 justify-content-between">
              <div>
                <div class="icon">
                  <span><i class="ri-cpu-line"></i></span>
                </div>
                <div class="content">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="title mb-0">.ai Domain</h6>
                    <span class="badge-theme-tld">Tech Alpha</span>
                  </div>
                  <p class="description">The undisputed category flag for artificial intelligence, machine learning, autonomous agents, and SaaS.</p>
                </div>
              </div>
              <div class="tld-card-pricing-row pt-3 border-top mt-auto d-flex align-items-center justify-content-between">
                <div>
                  <span class="tld-price-val prices" data-inr="₹6,499" data-usd="$79.99">₹6,499</span>
                  <span class="tld-price-unit d-block text-muted">/1st Year</span>
                </div>
                <a href="/domain-search" class="ace-btn btn-small">Register</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4: .store -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
            <div class="inner d-flex flex-column h-100 justify-content-between">
              <div>
                <div class="icon">
                  <span><i class="ri-shopping-bag-3-line"></i></span>
                </div>
                <div class="content">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="title mb-0">.store Domain</h6>
                    <span class="badge-theme-tld">E-Commerce</span>
                  </div>
                  <p class="description">High commercial purchase intent that signals retail instantly. Ideal for D2C brands, boutiques, and Shopify stores.</p>
                </div>
              </div>
              <div class="tld-card-pricing-row pt-3 border-top mt-auto d-flex align-items-center justify-content-between">
                <div>
                  <span class="tld-price-val prices" data-inr="₹299" data-usd="$3.99">₹299</span>
                  <span class="tld-price-unit d-block text-muted">/1st Year</span>
                </div>
                <a href="/domain-search" class="ace-btn btn-small">Register</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Background Shapes -->
    <div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
      <div class="shape-image shape-image-1"><img src="/assets/images/shape29.png" alt="Shape"></div>
      <div class="shape-image shape-image-2"><img src="/assets/images/shape0306.png" alt="Shape"></div>
      <div class="shape-image shape-image-3"><img src="/assets/images/shape0206.png" alt="Shape"></div>
      <div class="shape-image shape-image-4"><img src="/assets/images/shape19.png" alt="Shape"></div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 4: 100% Transparent Zero Renewal Bait-and-Switch Guarantees
       ========================================================= -->
  <div class="aceorbit-service ace-service-area ace-section-gap bg-color-light position-relative border-bottom-1">
    <div class="container aceorbit-animated-shape">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8 col-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">100% Transparent</span>
            <h3 class="title">Zero Renewal Bait-and-Switch Guarantees</h3>
            <p class="description max-w-750 mx-auto mt-2">
              Unlike legacy registrars who lure you in with promotional rates and silently hike renewal fees by 500%, Hostamble commits to clear, upfront, honest pricing for life.
            </p>
          </div>
        </div>
      </div>

      <div class="row aceorbit-about-one-service g-4 mt--20 justify-content-center">
        <!-- Feature 1: No Transfer Lock -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-white h-100">
            <div class="inner">
              <div class="icon">
                <span><i class="ri-lock-unlock-line"></i></span>
              </div>
              <div class="content">
                <h6 class="title">No Transfer-Out Lock</h6>
                <p class="description">You own your domain outright. Generate your EPP auth code 24/7 directly from your dashboard with zero penalty fees or artificial holdbacks.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 2: Published Renewal Table -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-white h-100">
            <div class="inner">
              <div class="icon">
                <span><i class="ri-price-tag-3-line"></i></span>
              </div>
              <div class="content">
                <h6 class="title">Clear Renewal Table</h6>
                <p class="description">All renewal rates are published in plain sight in our rate card before you checkout. Never experience surprise credit card renewals.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 3: Free WHOIS Privacy Forever -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="250" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-1 bg-white h-100">
            <div class="inner">
              <div class="icon">
                <span><i class="ri-shield-user-line"></i></span>
              </div>
              <div class="content">
                <h6 class="title">Free WHOIS Privacy Forever</h6>
                <p class="description">We never charge for privacy in subsequent years. Your personal phone and address remain shielded from spammers and scrapers for life.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 4: No Hidden ICANN Fees -->
        <div class="col-lg-3 col-md-6 col-12" data-sal-delay="300" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-3 text-left shape-bg-2 bg-white h-100">
            <div class="inner">
              <div class="icon">
                <span><i class="ri-checkbox-circle-line"></i></span>
              </div>
              <div class="content">
                <h6 class="title">All Registry &amp; ICANN Fees Included</h6>
                <p class="description">Mandatory ICANN and registry surcharges are already factored into our quoted prices. The price you see is the exact amount you pay.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 5: Included Free of Charge (Complimentary Domain Tools)
       ========================================================= -->
  <div class="ace-feature-area ace-section-gap bg-color-white position-relative border-bottom-1">
    <div class="container aceorbit-animated-shape">
      <div class="row align-items-center g-5">
        <div class="col-lg-5" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="section-title text-start">
            <span class="pre-title">Included Free of Charge</span>
            <h3 class="title">Over ₹3,500 ($45+) Worth of Free Tools Included with Every Domain</h3>
            <p class="description mt-3">
              While other registrars charge separate annual add-on fees for basic functionality, Hostamble bundles enterprise-grade Anycast DNS, WHOIS identity masking, branded email forwarders, and theft locks free with every single domain.
            </p>
            <div class="mt-4">
              <a href="#tld-table" class="ace-btn">View All Domain Rates <i class="icon-arrow-right-line-right"></i></a>
            </div>
          </div>
        </div>

        <div class="col-lg-7" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="row g-4">
            <!-- Tool 1 -->
            <div class="col-sm-6 col-12">
              <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                <div class="inner">
                  <div class="icon">
                    <span><i class="ri-flashlight-line"></i></span>
                  </div>
                  <div class="content">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <h6 class="title mb-0">Anycast DNS Control</h6>
                      <span class="badge-free-included">FREE</span>
                    </div>
                    <p class="description">Instant propagation across globally distributed Tier-IV edge nameservers for lightning-fast speeds.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tool 2 -->
            <div class="col-sm-6 col-12">
              <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                <div class="inner">
                  <div class="icon">
                    <span><i class="ri-shield-keyhole-line"></i></span>
                  </div>
                  <div class="content">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <h6 class="title mb-0">WHOIS Privacy Shield</h6>
                      <span class="badge-free-included">FREE</span>
                    </div>
                    <p class="description">Guards your personal name, address, and mobile number from scrapers, marketing bots, and cold calls.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tool 3 -->
            <div class="col-sm-6 col-12">
              <div class="service-card service-card-3 text-left shape-bg-2 bg-grey h-100">
                <div class="inner">
                  <div class="icon">
                    <span><i class="ri-lock-2-line"></i></span>
                  </div>
                  <div class="content">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <h6 class="title mb-0">Domain Theft Lock</h6>
                      <span class="badge-free-included">FREE</span>
                    </div>
                    <p class="description">Registrar-level security guard prevents accidental transfers or unauthorized hijacking attempts.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tool 4 -->
            <div class="col-sm-6 col-12">
              <div class="service-card service-card-3 text-left shape-bg-1 bg-grey h-100">
                <div class="inner">
                  <div class="icon">
                    <span><i class="ri-mail-send-line"></i></span>
                  </div>
                  <div class="content">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <h6 class="title mb-0">Email Forwarders</h6>
                      <span class="badge-free-included">FREE</span>
                    </div>
                    <p class="description">Create custom branded forwarders (e.g. info@yourdomain.com) routed straight to your existing inbox.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       BLOCK 6: Simple Steps (Authentic Theme service-card-7 Sequence)
       ========================================================= -->
  <div class="aceorbit-progress ace-service-area ace-section-gap bg-color-light position-relative">
    <div class="container aceorbit-animated-shape">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title text-center" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
            <span class="pre-title">Simple Steps</span>
            <h3 class="title">How to Register or Transfer Your Domain</h3>
            <p class="description max-w-750 mx-auto mt-2">
              Get your domain registered and live in three simple steps with automated instant provisioning and zero technical friction.
            </p>
          </div>
        </div>
      </div>
      <div class="row g-5 mt--20 justify-content-center">
        <!-- Step 1 -->
        <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-7 shape-bg-1">
            <div class="inner">
              <div class="icon">
                <span><i class="ri-search-2-line"></i></span>
              </div>
              <div class="content">
                <h6 class="title">1. Search Domain Name</h6>
                <p class="description">Type your desired brand or business name into our real-time search engine to check instant availability across 400+ extensions.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="service-card-single col-lg-4 col-md-6 col-12" data-sal-delay="200" data-sal="slide-up" data-sal-duration="800">
          <div class="service-card service-card-7 shape-bg-2">
            <div class="inner">
              <div class="icon">
                <span><i class="ri-shield-check-line"></i></span>
              </div>
              <div class="content">
                <h6 class="title">2. Select TLD &amp; Configure</h6>
